---
import { SITE, CONTACT } from '../config';
import { CATEGORY_ORDER } from '../data/site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Motion from '../components/Motion.astro';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Set on article pages to show the reading-progress bar under the header. */
  progress?: boolean;
  /** Overrides og:type — articles set this to "article". */
  ogType?: 'website' | 'article';
  /**
   * Set on writing pages. Turns the page's schema node into a BlogPosting and
   * emits the article:* Open Graph tags, so a crawler can tell an article from
   * a landing page and knows when it was published.
   */
  article?: {
    published: Date;
    /** The topic chip — becomes articleSection / article:section. */
    tag: string;
    wordCount?: number;
  };
  /**
   * Trail for BreadcrumbList, in order, excluding Home — that is prepended.
   * Search results render this in place of a bare URL.
   */
  breadcrumbs?: readonly { label: string; href: string }[];
  /**
   * Root-relative path to this page's link-preview image, overriding the site
   * card. Articles point at their own card in `public/og/`. Whatever it is, it
   * has to be 1200x630 — the width and height are declared in the tags below,
   * and scripts/build-og-image.mjs is what guarantees the geometry.
   */
  ogImage?: string;
  /** Set when the page's last section is a full-bleed band — see SiteFooter. */
  footerFlush?: boolean;
  /**
   * The two service pages — Web Design and Consulting — opt out of the site
   * chrome: each ships its own nav, footer and motion, deliberately unlike
   * the rest of the site. Analytics and the consent banner stay — GA runs
   * site-wide either way.
   */
  standalone?: boolean;
}

const {
  title,
  description = SITE.description,
  progress = false,
  ogType = 'website',
  article,
  breadcrumbs,
  ogImage,
  footerFlush = false,
  standalone = false,
} = Astro.props;

const pageTitle = title
  ? `${title} ${SITE.titleSeparator} ${SITE.title}`
  : `${SITE.title} — ${SITE.role}`;
const origin = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, origin);
const ogImagePath = ogImage ?? SITE.ogImage;
const ogImageUrl = ogImagePath ? new URL(ogImagePath, origin) : null;
/* The card an article points at carries its own headline, so describing it as
   the site card would be wrong. */
const ogImageAlt = article ? `${title} — ${SITE.author}` : `${SITE.author} — ${SITE.role}`;

/* Structured data so a search result for Miguel's name shows the role and
   employer rather than just a page title.
 *
 * One @graph rather than several loose scripts, with stable @ids, so a crawler
 * reads one person who authored every article rather than a fresh unnamed
 * author per page. The ids are fragments on the origin and never change.
 */
const personId = `${origin.href}#person`;
const siteId = `${origin.href}#website`;

const person = {
  '@type': 'Person',
  '@id': personId,
  name: SITE.author,
  jobTitle: SITE.role,
  description: SITE.description,
  email: `mailto:${CONTACT.email}`,
  url: origin.href,
  address: { '@type': 'PostalAddress', addressLocality: 'Vancouver', addressRegion: 'BC', addressCountry: 'CA' },
  sameAs: [CONTACT.linkedin],
  /* The consulting entity, and the four categories the work is filed under —
     both read from data rather than described here, so neither can claim
     something the site doesn't. */
  worksFor: { '@type': 'Organization', name: CONTACT.entity, address: { '@type': 'PostalAddress', addressLocality: 'Vancouver', addressRegion: 'BC', addressCountry: 'CA' } },
  knowsAbout: CATEGORY_ORDER,
  ...(ogImageUrl ? { image: ogImageUrl.href } : {}),
};

const website = {
  '@type': 'WebSite',
  '@id': siteId,
  url: origin.href,
  name: SITE.title,
  description: SITE.description,
  inLanguage: SITE.lang,
  publisher: { '@id': personId },
};

/* No dateModified: nothing records when a post was last edited, and inventing
   one is a claim about freshness that search engines act on. Omitted until the
   frontmatter carries it. */
const articleNode = article
  ? {
      '@type': 'BlogPosting',
      '@id': `${canonical.href}#article`,
      headline: title,
      description,
      url: canonical.href,
      datePublished: article.published.toISOString(),
      articleSection: article.tag,
      inLanguage: SITE.lang,
      author: { '@id': personId },
      publisher: { '@id': personId },
      isPartOf: { '@id': siteId },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
      ...(article.wordCount ? { wordCount: article.wordCount } : {}),
      ...(ogImageUrl ? { image: ogImageUrl.href } : {}),
    }
  : null;

const breadcrumbNode = breadcrumbs?.length
  ? {
      '@type': 'BreadcrumbList',
      '@id': `${canonical.href}#breadcrumbs`,
      itemListElement: [{ label: 'Home', href: '/' }, ...breadcrumbs].map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.label,
        item: new URL(crumb.href, origin).href,
      })),
    }
  : null;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [person, website, articleNode, breadcrumbNode].filter(Boolean),
};
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      Raster icons, not SVG. A favicon is rasterised in a context where system
      fonts aren't guaranteed, so the previous SVG — which drew its monogram
      with a <text> element — rendered as an empty tile. Built from the brand
      mark by scripts/build-icons.mjs.
    */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} — Writing`} href="/rss.xml" />

    {/* The two weights above the fold. 700 is the display weight, 400 the body. */}
    <link rel="preload" href="/fonts/general-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/general-sans-700.woff2" as="font" type="font/woff2" crossorigin />

    <slot name="head" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_CA" />
    {
      /* Dimensions are safe to state here because scripts/build-og-image.mjs
         fails rather than writing anything other than 1200x630. Declaring them
         lets a scraper reserve the right space before the image arrives. */
    }
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:alt" content={ogImageAlt} />}
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article && <meta property="article:section" content={article.tag} />}
    {article && <meta property="article:author" content={SITE.author} />}

    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

    <Analytics />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {!standalone && <SiteHeader progress={progress} />}

    <main id="main">
      <slot />
    </main>

    {!standalone && <SiteFooter flush={footerFlush} />}

    {!standalone && <Motion />}
    <ConsentBanner />
  </body>
</html>
