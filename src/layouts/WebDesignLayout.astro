---
import BaseLayout from './BaseLayout.astro';
import WebDesignNav from '../components/WebDesignNav.astro';
import { CONTACT } from '../config';

/**
 * The shell for the web design sub-pages — `/web-design/work/`, `/process/`
 * and `/pricing/`.
 *
 * v13 split the web design offer into four pages. This layout carries the
 * sub-brand for the three new ones: the `--wd-*` palette, Archivo
 * + Caveat, the grain and the footer.
 *
 * The nav is **not** here. `web-design.astro` is deliberately not migrated
 * onto this layout — 2,800 lines of hand-tuned page whose only v13 change was
 * copy — so the nav lives in `WebDesignNav.astro` and both render the same
 * one. It used to exist twice and the copies drifted, which made the header
 * jump on every click between the main page and a sub-page.
 *
 * The `.wd` tokens below are still duplicated in web-design.astro's own scoped
 * block, and the two must stay in step. That is the remaining deliberate
 * duplication in this section.
 */
interface Props {
  title: string;
  description: string;
  /** Marks the current item in the section nav. */
  current: 'work' | 'process' | 'pricing';
}

const { title, description, current } = Astro.props;

const phoneHref = `tel:${CONTACT.phone.replace(/[^+\d]/g, '')}`;
---

<BaseLayout title={title} description={description} standalone>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=Caveat:wght@600;700&family=IBM+Plex+Mono:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="wd">
    <div class="wd__grain" aria-hidden="true"></div>

    <WebDesignNav current={current} />

    <slot />

    <footer class="wdfoot">
      <div class="wdfoot__inner">
        <span>
          <strong class="wdfoot__m">M.</strong> Sites that sell.
          <span class="wdfoot__sub">by Miguel Monzones</span>
        </span>
        <span>MNM Alaminos Consulting Ltd.</span>
        <span class="wdfoot__links">
          <a href={CONTACT.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          <a href={phoneHref}>{CONTACT.phone}</a>
          <a href="#cookie-settings" data-cookie-settings>Cookie settings</a>
          <a href="/">mnmonzones.com ↗</a>
        </span>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>

  /* --------------------------------------------------------- reveals ---- */
  /* Starting states are written here, never in CSS, with a failsafe that
     shows everything if the observer never fires — the same discipline
     Motion.astro and web-design.astro follow. */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];

  if (!reduced && typeof IntersectionObserver === 'function' && targets.length) {
    const pending = new Set<HTMLElement>(targets);

    for (const el of targets) {
      el.style.opacity = '0';
      el.style.transform =
        el.dataset.reveal === 'pop' ? 'translateY(20px) scale(.96)' : 'translateY(28px)';
      el.style.transition = 'opacity .7s ease, transform .8s cubic-bezier(.2,.8,.2,1)';
    }

    const show = (el: HTMLElement) => {
      if (!pending.delete(el)) return;
      el.style.opacity = '1';
      el.style.transform = 'none';
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          show(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );

    targets.forEach((el) => io.observe(el));

    const flush = () => {
      io.disconnect();
      for (const el of [...pending]) {
        el.style.transition = '';
        show(el);
      }
    };

    window.setTimeout(flush, 4000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') flush();
    });
  }
</script>

<style is:global>
  /* Namespaced under `.wd`, and global because scoped rules can't reach the
     page markup that arrives through <slot />. */
  .wd {
    /* v13 palette. The web design section was re-skinned in v13: Archivo
       replaces Bricolage Grotesque, the paper cools, and the peach/blue pair
       is gone entirely. `--wd-peach` and `--wd-blue*` are kept as aliases
       onto their v13 replacements so nothing referencing them renders an
       invalid colour, but new work should use the named tokens below. */
    --wd-paper: #f4f1ea;
    --wd-card: #fcfbf7;
    --wd-bright: #fcfbf7;
    --wd-ink: #171310;
    --wd-ink-deep: #14100c;
    --wd-ink-soft: #3a3327;
    --wd-muted: #6e675c;
    --wd-faint: #a89f8d;
    --wd-rule: #ddd6c7;
    --wd-rule-strong: #c9c2b2;
    --wd-yellow: #f5d44a;
    --wd-coral: #ee4a11;
    --wd-coral-deep: #d8400c;
    --wd-scribble: #d8400c;
    --wd-butter: #f5d44a;
    --wd-gold: #f5d44a;
    --wd-peach: #f5d44a;
    --wd-blue: #ddd6c7;
    --wd-blueband: #e5dfd0;
    --wd-bluelink: #d8400c;
    --wd-font: 'Archivo', 'Helvetica Neue', sans-serif;
    --wd-hand: 'Caveat', cursive;
    --wd-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

    position: relative;
    min-width: 320px;
    background: var(--wd-paper);
    color: var(--wd-ink);
    font-family: var(--wd-font);
    overflow-x: clip;
  }

  /* Archivo is a variable font with a width axis, and v13 sets headings wide.
     This is a large part of why the section reads as its own brand. */
  .wd h1,
  .wd h2,
  .wd h3,
  .wd h4 {
    font-stretch: 125%;
  }

  .wd a {
    color: inherit;
    text-decoration: none;
    transition: color 220ms ease;
  }

  .wd :focus-visible {
    outline: 2px solid var(--wd-coral);
    outline-offset: 3px;
  }

  .wd__grain {
    position: fixed;
    inset: 0;
    z-index: 99;
    pointer-events: none;
    opacity: 0.04;
    mix-blend-mode: multiply;
    background-size: 200px 200px;
    background-image: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='200' height='200'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85 .4' numOctaves='3' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='200' height='200' filter='url(%23g)'/%3E%3C/svg%3E");
  }

  /* ----------------------------------------------------------- layout -- */
  .wd .wdwrap {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: clamp(18px, 4vw, 44px);
  }

  .wd .wdsec {
    padding-block: clamp(56px, 7vw, 104px);
  }

  .wd .wdkick {
    display: block;
    font-family: var(--wd-hand);
    font-size: clamp(20px, 2vw, 26px);
    color: var(--wd-coral-deep);
  }

  /* Uppercase, 900, and much larger than the previous design ran them — the
     three W sub-pages all use this one scale. */
  .wd .wdh2 {
    margin-top: 8px;
    font-size: clamp(38px, 5vw, 68px);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .wd .wdh2 em {
    font-style: italic;
    color: var(--wd-coral);
  }

  /* The closing CTA heading is a step larger again on every sub-page. */
  .wd .wdcta .wdh2 {
    font-size: clamp(38px, 5.4vw, 72px);
    line-height: 0.96;
    letter-spacing: -0.025em;
  }

  .wd .wdcta .wdh2 em {
    color: var(--wd-ink);
  }

  .wd .wdlede {
    margin-top: 16px;
    max-width: 66ch;
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.65;
    color: var(--wd-muted);
    text-wrap: pretty;
  }

  .wd .wdnote {
    margin-top: 16px;
    font-family: var(--wd-hand);
    font-size: clamp(19px, 1.9vw, 24px);
    color: var(--wd-coral-deep);
  }

  .wd .wdcard {
    background: var(--wd-bright);
    border: 2px solid var(--wd-ink);
    border-radius: 22px;
    padding: clamp(22px, 2.6vw, 32px);
    box-shadow: 6px 6px 0 var(--wd-ink);
  }

  .wd .wdbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 15px 24px;
    border: 2px solid var(--wd-ink);
    border-radius: 999px;
    font-size: 15px;
    font-weight: 700;
    transition:
      transform 0.25s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  .wd .wdbtn--solid {
    background: var(--wd-coral);
    color: var(--wd-bright);
  }

  .wd .wdbtn--solid:hover,
  .wd .wdbtn--solid:focus-visible {
    transform: translateY(-3px);
    background: var(--wd-ink);
    color: var(--wd-bright);
  }

  .wd .wdbtn--ghost {
    background: var(--wd-bright);
  }

  .wd .wdbtn--ghost:hover,
  .wd .wdbtn--ghost:focus-visible {
    transform: translateY(-3px);
    background: var(--wd-butter);
  }

  .wd .wdctarow {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Wide tables scroll inside their own box rather than the page. */
  .wd .wdtable {
    margin-top: 28px;
    overflow-x: auto;
    border: 2px solid var(--wd-ink);
    border-radius: 18px;
    background: var(--wd-bright);
  }

  .wd .wdtable table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }

  .wd .wdtable th,
  .wd .wdtable td {
    padding: 14px 16px;
    text-align: left;
    border-bottom: 1px solid rgb(23 19 16 / 12%);
    vertical-align: top;
    min-width: 150px;
  }

  .wd .wdtable th {
    font-weight: 700;
    background: var(--wd-butter);
  }

  .wd .wdtable tr:last-child td {
    border-bottom: 0;
  }

  .wd .wdtable small {
    display: block;
    margin-top: 4px;
    font-size: 13px;
    color: var(--wd-faint);
  }

  /* ----------------------------------------------------------- footer -- */
  .wd .wdfoot {
    border-top: 2px solid var(--wd-ink);
    padding-block: clamp(28px, 4vw, 44px);
  }

  .wd .wdfoot__inner {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: clamp(18px, 4vw, 44px);
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
    color: var(--wd-muted);
  }

  .wd .wdfoot__m {
    font-size: 18px;
    font-weight: 800;
    color: var(--wd-ink);
  }

  .wd .wdfoot__sub {
    font-family: var(--wd-hand);
    font-size: 16px;
    color: var(--wd-coral-deep);
  }

  .wd .wdfoot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }

  .wd .wdfoot__links a:hover,
  .wd .wdfoot__links a:focus-visible {
    color: var(--wd-coral-deep);
  }

  @media (max-width: 719px) {
    .wd .wdfoot__links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wd *,
    .wd *::before,
    .wd *::after {
      transition-duration: 1ms !important;
      animation: none !important;
    }
  }
</style>
