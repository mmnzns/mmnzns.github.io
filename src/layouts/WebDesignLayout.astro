---
import BaseLayout from './BaseLayout.astro';
import WebDesignNav from '../components/WebDesignNav.astro';
import { CONTACT } from '../config';

/**
 * The shell for the web design sub-pages — `/web-design/work/`, `/process/`
 * and `/pricing/`.
 *
 * v13 split the web design offer into four pages; v14 restyled the three
 * sub-pages. This layout carries the sub-brand for them: the `--wd-*` palette,
 * Archivo + Caveat + IBM Plex Mono, the grain, the footer, and every class more
 * than one of the three pages uses. Those live in an `is:global` block on
 * purpose — scoped styles cannot reach markup passed through a `<slot />`.
 *
 * The nav is **not** here. `web-design.astro` is deliberately not migrated
 * onto this layout — 2,700 lines of hand-tuned page — so the nav lives in
 * `WebDesignNav.astro` and both render the same one. It used to exist twice
 * and the copies drifted, which made the header jump on every click between
 * the main page and a sub-page.
 *
 * The `.wd` tokens below are still duplicated in web-design.astro's own scoped
 * block, and the two must stay in step. That is the remaining deliberate
 * duplication in this section.
 *
 * Values are the v14 export's (`Monzones-W-Work`, `-Process`, `-Pricing`).
 */
interface Props {
  title: string;
  description: string;
  /** Marks the current item in the section nav. */
  current: 'work' | 'process' | 'pricing';
}

const { title, description, current } = Astro.props;
---

<BaseLayout title={title} description={description} standalone>
  <Fragment slot="head">
    {/* Caveat is self-hosted (see global.css) and preloaded, because the
        `cursive` fallback is 40% wider and flashed on every navigation. */}
    <link
      rel="preload"
      href="/fonts/caveat-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=IBM+Plex+Mono:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="wd">
    <div class="wd__grain" aria-hidden="true"></div>

    <WebDesignNav current={current} />

    <slot />

    {/* The export's footer has LinkedIn and the HQ link; the cookie link is
        this site's — it sets analytics cookies and the banner has to stay
        reachable from every page. Same three links as the main page's footer. */}
    <footer class="wdfoot">
      <div class="wdfoot__inner">
        <span>
          <strong class="wdfoot__m">M.</strong> Sites that sell.
          <span class="wdfoot__sub">by Miguel Monzones</span>
        </span>
        <span>{CONTACT.entity}</span>
        <span class="wdfoot__links">
          <a href={CONTACT.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href="#cookie-settings" data-cookie-settings>Cookie settings</a>
          <a href="/">mnmonzones.com ↗</a>
        </span>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  /* --------------------------------------------------------- reveals ---- */
  /* Starting states are written here, never in CSS, with a failsafe that
     shows everything if the observer never fires — the same discipline
     Motion.astro and web-design.astro follow. */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];

  if (!reduced && typeof IntersectionObserver === 'function' && targets.length) {
    const pending = new Set<HTMLElement>(targets);

    for (const el of targets) {
      el.style.opacity = '0';
      el.style.transform =
        el.dataset.reveal === 'pop' ? 'translateY(20px) scale(.96)' : 'translateY(28px)';
      el.style.transition = 'opacity .7s ease, transform .8s cubic-bezier(.2,.8,.2,1)';
    }

    const show = (el: HTMLElement) => {
      if (!pending.delete(el)) return;
      el.style.opacity = '1';
      el.style.transform = 'none';
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          show(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );

    targets.forEach((el) => io.observe(el));

    const flush = () => {
      io.disconnect();
      for (const el of [...pending]) {
        el.style.transition = '';
        show(el);
      }
    };

    window.setTimeout(flush, 4000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') flush();
    });
  }
</script>

<style is:global>
  /* Namespaced under `.wd`, and global because scoped rules can't reach the
     page markup that arrives through <slot />. */
  .wd {
    /* The section's palette, by the role each colour plays in the export.
       `--wd-peach` and `--wd-blue*` are aliases left over from the pre-v13
       palette so nothing referencing them renders an invalid colour; new work
       should use the named tokens. */
    --wd-paper: #f4f1ea;
    --wd-card: #fcfbf7;
    --wd-bright: #fcfbf7;
    --wd-ink: #171310;
    --wd-ink-deep: #14100c;
    --wd-ink-soft: #3a3327;
    --wd-muted: #6e675c;
    --wd-faint: #a89f8d;
    --wd-rule: #ddd6c7;
    --wd-rule-strong: #c9c2b2;
    --wd-rule-soft: #d9d2c2;
    --wd-yellow: #f5d44a;
    --wd-coral: #ee4a11;
    --wd-coral-deep: #d8400c;
    --wd-scribble: #d8400c;
    --wd-butter: #f5d44a;
    --wd-gold: #f5d44a;
    --wd-peach: #f5d44a;
    --wd-blue: #ddd6c7;
    --wd-blueband: #e5dfd0;
    --wd-body: #3e3931;
    --wd-body-soft: #4a443b;
    --wd-card-dark: #241d13;
    --wd-card-darker: #201b14;
    --wd-card-warm: #2a2015;
    --wd-on-dark: #c7beac;
    --wd-on-dark-soft: #d5cdbb;
    --wd-bluelink: #d8400c;
    /* The accent a kicker, label or note takes; the dark band remaps these. */
    --wd-kick: #d8400c;
    --wd-label: #d8400c;
    --wd-note: #d8400c;
    --wd-heading: #171310;
    --wd-link: #171310;
    --wd-font: 'Archivo', 'Helvetica Neue', sans-serif;
    --wd-hand: 'Caveat', cursive;
    --wd-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

    position: relative;
    min-width: 320px;
    background: var(--wd-paper);
    color: var(--wd-ink);
    font-family: var(--wd-font);
    /* The export's body sets neither size nor leading, so it runs on the
       browser defaults. Without this reset the section inherits global.css's
       17px/1.65, which is why every line box here sat taller than the design.
       Both `.wd` blocks must carry this. */
    font-size: 16px;
    line-height: normal;
    overflow-x: clip;
  }

  /* Archivo is a variable font with a width axis, and the export sets headings
     wide. This is a large part of why the section reads as its own brand. */
  .wd h1,
  .wd h2,
  .wd h3,
  .wd h4 {
    font-stretch: 125%;
  }

  .wd a {
    color: inherit;
    text-decoration: none;
    transition: color 220ms ease;
  }

  .wd :focus-visible {
    outline: 2px solid var(--wd-coral);
    outline-offset: 3px;
  }

  .wd__grain {
    position: fixed;
    inset: 0;
    z-index: 99;
    pointer-events: none;
    opacity: 0.04;
    mix-blend-mode: multiply;
    background-size: 200px 200px;
    background-image: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='200' height='200'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85 .4' numOctaves='3' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='200' height='200' filter='url(%23g)'/%3E%3C/svg%3E");
  }

  /* ------------------------------------------------------------- hero -- */
  /* 1180 of content inside 24px of side padding; border-box, so the wrapper
     is 1228 wide. */
  .wd .wdwrap {
    max-width: 1228px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .wd .wdhero {
    padding-block: 96px 84px;
  }

  .wd .wdhero__tags {
    margin: 0 0 26px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .wd .wdtag {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px 7px;
    border: 1px solid var(--wd-ink);
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .wd .wdtag--butter {
    background: var(--wd-yellow);
    border-color: var(--wd-yellow);
  }

  .wd .wdhero__title {
    margin: 0;
    font-size: clamp(40px, 6vw, 92px);
    font-weight: 900;
    line-height: 0.94;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .wd .wdhero__title em {
    font-style: italic;
    color: var(--wd-coral);
  }

  .wd .wdhero__body {
    margin: 26px 0 0;
    max-width: 680px;
    font-size: 18.5px;
    line-height: 1.65;
    color: var(--wd-muted);
    text-wrap: pretty;
  }

  .wd .wdhero__body strong {
    color: var(--wd-ink);
  }

  /* On-page jump links: hairline pills in the soft rule colour, coral on hover. */
  .wd .wdjumps {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .wd .wdjumps a {
    display: inline-flex;
    align-items: center;
    padding: 12px 17px;
    border: 1px solid var(--wd-rule-strong);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .wd .wdjumps a:hover,
  .wd .wdjumps a:focus-visible {
    border-color: var(--wd-coral);
    color: var(--wd-coral);
  }

  /* ------------------------------------------------------------ bands -- */
  /* Full-bleed bands, paper or near-black, 104px tall by default. A ruled band
     drops its top padding and draws a hairline above its content instead, so
     two paper sections read as one page with a divider. */
  .wd .wdband {
    padding: 104px 24px;
  }

  .wd .wdband--112 {
    padding-block: 112px;
  }

  .wd .wdband--92 {
    padding-block: 92px;
  }

  .wd .wdband--rule {
    padding-top: 0;
  }

  .wd .wdband--rule > .wdband__inner {
    border-top: 1px solid var(--wd-rule-strong);
    padding-top: 80px;
  }

  .wd .wdband__inner {
    max-width: 1180px;
    margin-inline: auto;
  }

  .wd .wdband__inner--1000 {
    max-width: 1000px;
  }

  .wd .wdband__inner--900 {
    max-width: 900px;
  }

  .wd .wdband--paper {
    background: var(--wd-paper);
  }

  /* Inside a dark band the inks flip to their light-on-dark counterparts.
     Remapping the tokens rather than restating every selector means a rule
     written for paper stays legible here. `--wd-ink` is deliberately NOT
     remapped: it draws the black CTA pill, not body text. */
  .wd .wdband--dark {
    background: var(--wd-ink-deep);
    --wd-muted: #a89f8d;
    --wd-body: #c7beac;
    --wd-body-soft: #c7beac;
    --wd-heading: #f4f1ea;
    --wd-kick: #ee4a11;
    --wd-label: #f5d44a;
    --wd-note: #f5d44a;
    --wd-link: #f4f1ea;
  }

  /* ------------------------------------------------------------- type -- */
  .wd .wdkick {
    display: block;
    margin: 0 0 14px;
    font-family: var(--wd-hand);
    font-size: 27px;
    font-weight: 400;
    color: var(--wd-kick);
    transform: rotate(-1deg);
  }

  .wd .wdh2 {
    margin: 0 0 18px;
    font-size: clamp(38px, 5vw, 68px);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--wd-heading);
    text-wrap: balance;
  }

  .wd .wdh2 em {
    font-style: italic;
    color: var(--wd-coral);
  }

  /* Two smaller scales the export uses for secondary sections. */
  .wd .wdh2--md {
    font-size: clamp(34px, 4.6vw, 60px);
    line-height: 1;
  }

  .wd .wdh2--sm {
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1;
  }

  /* A heading with a short aside on its baseline ("The smaller three" ·
     "hand-built or platform"). */
  .wd .wdhead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 18px;
    margin-bottom: 8px;
  }

  .wd .wdhead .wdh2 {
    margin: 0;
  }

  .wd .wdhead__sub {
    font-size: 15px;
    font-weight: 700;
    color: var(--wd-muted);
  }

  .wd .wdh3 {
    margin: 0 0 12px;
    font-size: 25px;
    font-weight: 900;
    letter-spacing: -0.01em;
    color: var(--wd-heading);
  }

  .wd .wdlede {
    margin: 0;
    max-width: 700px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--wd-muted);
    text-wrap: pretty;
  }

  .wd .wdlede strong {
    color: var(--wd-heading);
  }

  .wd .wdlede--17 {
    font-size: 17px;
  }

  .wd .wdlede--18 {
    font-size: 18px;
    color: var(--wd-body);
  }

  .wd .wdbody {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--wd-body);
    text-wrap: pretty;
  }

  .wd .wdbody strong {
    color: var(--wd-heading);
  }

  .wd .wdbody--sm {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--wd-muted);
  }

  /* Small-caps label above a block: coral on paper, yellow on the dark band. */
  .wd .wdlabel {
    display: block;
    margin: 0 0 5px;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--wd-label);
  }

  /* Mono meta line: "Fintech platform · Webflow · five sites". */
  .wd .wdmono {
    display: block;
    margin: 0;
    font-family: var(--wd-mono);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--wd-muted);
  }

  /* Handwritten aside under a block. */
  .wd .wdnote {
    display: block;
    margin: 0;
    font-family: var(--wd-hand);
    font-size: 24px;
    color: var(--wd-note);
    transform: rotate(-0.6deg);
  }

  /* The underlined link: heavy, ink (paper on the dark band), a coral rule
     beneath that carries across both bands. */
  .wd .wdlink {
    display: inline-block;
    padding-bottom: 3px;
    border-bottom: 2.5px solid var(--wd-coral);
    font-size: 16px;
    font-weight: 800;
    color: var(--wd-link);
  }

  .wd .wdlink:hover,
  .wd .wdlink:focus-visible {
    color: var(--wd-coral);
  }

  /* A link inside running text. */
  .wd .wdinline {
    color: var(--wd-coral-deep);
    font-weight: 700;
  }

  .wd .wdinline:hover,
  .wd .wdinline:focus-visible {
    color: var(--wd-ink);
  }

  /* ------------------------------------------------------------ cards -- */
  .wd .wdcard {
    background: var(--wd-card);
    border: 1px solid var(--wd-ink);
    border-radius: 12px;
    padding: 28px 26px;
  }

  .wd .wdcard--14 {
    border-radius: 14px;
  }

  /* On the dark band a card takes its own darker face and a soft ink border. */
  .wd .wdband--dark .wdcard {
    background: var(--wd-card-dark);
    border-color: var(--wd-ink-soft);
  }

  /* Outlined pill: a logo or a payment method. */
  .wd .wdchip {
    display: inline-flex;
    align-items: center;
    padding: 9px 15px 8px;
    border: 1px solid var(--wd-ink);
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .wd .wdband--dark .wdchip {
    padding: 11px 18px 10px;
    border-color: var(--wd-ink-soft);
    color: var(--wd-paper);
    font-size: 14.5px;
  }

  .wd .wdgrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .wd .wdgrid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  /* Wide tables scroll inside their own box rather than the page. */
  .wd .wdtable {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .wd .wdtable table {
    width: 100%;
    border-collapse: collapse;
  }

  .wd .wdtable th {
    padding: 12px 16px;
    border-bottom: 2px solid var(--wd-ink);
    text-align: left;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--wd-ink);
  }

  .wd .wdtable td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--wd-rule);
    text-align: left;
    vertical-align: top;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--wd-muted);
  }

  .wd .wdtable tr:last-child td {
    border-bottom: 0;
  }

  .wd .wdtable td:first-child {
    font-size: 15px;
    font-weight: 800;
    color: var(--wd-ink);
  }

  /* ------------------------------------------------------------- the CTA -- */
  /* All three sub-pages close on the same coral band. */
  .wd .wdcta {
    position: relative;
    overflow: hidden;
    background: var(--wd-coral-deep);
    color: var(--wd-card);
    padding: 104px 24px;
    text-align: center;
  }

  .wd .wdcta__inner {
    position: relative;
    max-width: 900px;
    margin-inline: auto;
  }

  /* The oversized mark bleeding off the corner. Decorative only. */
  .wd .wdcta__m {
    position: absolute;
    top: -60px;
    right: -40px;
    font-size: 560px;
    font-weight: 900;
    font-style: italic;
    line-height: 0.8;
    color: rgb(255 255 255 / 10%);
    pointer-events: none;
    user-select: none;
  }

  .wd .wdcta .wdh2 {
    margin-bottom: 20px;
    font-size: clamp(38px, 5.4vw, 72px);
    line-height: 0.96;
    letter-spacing: -0.025em;
    color: var(--wd-card);
  }

  .wd .wdcta .wdh2 em {
    color: var(--wd-ink);
  }

  .wd .wdcta .wdlede {
    margin: 0 auto 12px;
    max-width: 580px;
    font-size: 18px;
    line-height: 1.6;
    color: rgb(255 251 247 / 92%);
  }

  .wd .wdcta .wdnote {
    margin: 0 0 32px;
    font-size: 25px;
    color: var(--wd-card);
    transform: rotate(-1deg);
  }

  .wd .wdctarow {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .wd .wdbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    padding: 17px 30px 16px;
    border-radius: 999px;
    font-size: 16.5px;
    font-weight: 800;
    white-space: nowrap;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  /* One filled black, the rest outlined in the band's own paper; the third
     is quieter still. */
  .wd .wdbtn--solid {
    background: var(--wd-ink);
    color: var(--wd-card);
  }

  .wd .wdbtn--solid:hover,
  .wd .wdbtn--solid:focus-visible {
    transform: translateY(-2px);
    color: var(--wd-card);
  }

  .wd .wdbtn--ghost {
    padding: 16px 30px 15px;
    border: 1.5px solid var(--wd-card);
    color: var(--wd-card);
  }

  .wd .wdbtn--ghost + .wdbtn--ghost {
    border-color: rgb(252 251 247 / 50%);
  }

  .wd .wdbtn--ghost:hover,
  .wd .wdbtn--ghost:focus-visible {
    background: var(--wd-card);
    color: var(--wd-coral-deep);
  }

  /* ----------------------------------------------------------- footer -- */
  .wd .wdfoot {
    background: var(--wd-ink-deep);
    color: var(--wd-faint);
    padding: 36px 24px;
  }

  .wd .wdfoot__inner {
    max-width: 1180px;
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 32px;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
    line-height: 1.6;
  }

  .wd .wdfoot__m {
    color: var(--wd-paper);
  }

  .wd .wdfoot__sub {
    font-family: var(--wd-hand);
    font-size: 17px;
    color: var(--wd-coral);
  }

  .wd .wdfoot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  .wd .wdfoot__links a {
    color: var(--wd-paper);
  }

  .wd .wdfoot__links a:hover,
  .wd .wdfoot__links a:focus-visible {
    color: var(--wd-butter);
  }

  /* ------------------------------------------------------- responsive -- */
  @media (max-width: 900px) {
    .wd .wdgrid,
    .wd .wdgrid--3 {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 760px) {
    .wd .wdwrap {
      padding-inline: 18px;
    }

    .wd .wdhero {
      padding-block: 64px 72px;
    }

    /* A long tag wraps rather than running off a phone screen. */
    .wd .wdtag {
      white-space: normal;
      line-height: 1.2;
    }

    /* v15 opens the phone rhythm up to 96px a band. */
    .wd .wdband,
    .wd .wdband--112,
    .wd .wdband--92,
    .wd .wdcta {
      padding: 96px 18px;
    }

    .wd .wdband--rule {
      padding-top: 0;
    }

    .wd .wdctarow {
      flex-direction: column;
      align-items: stretch;
    }

    .wd .wdctarow .wdbtn {
      justify-content: center;
    }

