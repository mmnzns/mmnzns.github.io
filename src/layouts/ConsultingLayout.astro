---
import BaseLayout from './BaseLayout.astro';
import { CONTACT } from '../config';
import { FOOTER_LINE } from '../data/consulting';
import logoMark from '../assets/logo-mark.png';

/**
 * The shell for `/consulting/` and its three sub-pages.
 *
 * Consulting is a sub-brand, the same bargain `web-design.astro` makes: it
 * lives on this domain for the traffic, but looks nothing like the main site.
 * Warm cream instead of paper, Clash Display and Switzer instead of General
 * Sans, terracotta and deep green instead of the four accents, and its own
 * nav that goes sideways across the section rather than back to the site.
 * Don't restyle it to match global.css — see the note there.
 *
 * It exists as a layout rather than being repeated per page because there are
 * four pages: without it the palette, the header, the footer and the reveal
 * script would be copied four times and drift on the second edit.
 *
 * The page opts out of the site chrome through BaseLayout's `standalone`
 * flag. Analytics and the consent banner still come from BaseLayout, because
 * GA runs site-wide and the footer's "Cookie settings" link has to reach it.
 */
interface Props {
  title: string;
  description: string;
  /** Marks the current item in the section nav. */
  current: 'home' | 'services' | 'results' | 'process';
}

const { title, description, current } = Astro.props;

/*
 * Home is in this list on every page, including the home page itself.
 *
 * The v13 design disagrees with itself here: `Monzones-C-Services`,
 * `-Process` and `-Results` all carry a Home link, and `Monzones-C-Home`
 * omits it — so in the export the item appears and disappears as you move
 * around the section. Miguel asked for it to be consistently present, which
 * is also the reading the three sub-pages already agree on.
 */
const NAV = [
  { label: 'Home', href: '/consulting/', key: 'home' },
  { label: 'Services', href: '/consulting/services/', key: 'services' },
  { label: 'Results', href: '/consulting/results/', key: 'results' },
  { label: 'Process', href: '/consulting/process/', key: 'process' },
] as const;

const phoneHref = `tel:${CONTACT.phone.replace(/[^+\d]/g, '')}`;
---

<BaseLayout title={title} description={description} standalone>
  <Fragment slot="head">
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link
      href="https://api.fontshare.com/v2/css?f%5B%5D=clash-display@500,600,700&f%5B%5D=switzer@400,500,600,700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  {/* The three sub-pages share a slightly smaller type scale and hero than the home page. */}
  <div class:list={['c', { 'c--sub': current !== 'home' }]}>
    <div class="c__grain" aria-hidden="true"></div>

    <header class="cnav">
      <nav class="cnav__bar" aria-label="Consulting">
        <a class="cnav__brand" href="/consulting/">
          <span class="cnav__markbox">
            <img class="cnav__mark" src={logoMark.src} alt="" width="26" height="20" />
          </span>
          <span class="cnav__names">
            <span class="disp cnav__name">Miguel Monzones</span>
            <span class="cnav__sub">Consulting</span>
          </span>
        </a>

        <div class="cnav__links">
          <a class="cnav__hq" href="/" title="Back to mnmonzones.com">← back to HQ</a>
          <span class="cnav__pipe" aria-hidden="true"></span>
          {
            NAV.map((item) => (
              <a
                class="cnav__link"
                href={item.href}
                aria-current={current === item.key ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <a class="cnav__cta" href="/consulting/#contact">Book a call</a>
        </div>

        <button
          class="cnav__burger"
          type="button"
          aria-expanded="false"
          aria-controls="consulting-menu"
          aria-label="Menu"
          data-cnav-toggle
        >
          <span class="cnav__bars" aria-hidden="true"></span>
        </button>
      </nav>

      <div class="cnav__panel" id="consulting-menu" hidden data-cnav-panel>
        {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="cnav__panel-hq" href="/">← back to HQ</a>
        <a class="cnav__panel-cta" href="/consulting/#contact">Book a call</a>
      </div>
    </header>

    <slot />

    <footer class="cfoot">
      <div class="cfoot__inner">
        <p class="cfoot__line">{FOOTER_LINE}</p>
        <div class="cfoot__links">
          <a href="/">mnmonzones.com</a>
          <a href="#cookie-settings" data-cookie-settings>Cookie settings</a>
          <a class="cfoot__reach" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          {/* Not in the export's footer, kept because it is a real way to reach him. */}
          <a class="cfoot__reach" href={phoneHref}>{CONTACT.phone}</a>
          <a class="cfoot__reach" href={CONTACT.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  /* ------------------------------------------------------------- nav ---- */
  const toggle = document.querySelector<HTMLButtonElement>('[data-cnav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-cnav-panel]');

  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });

    /* Escape closes it, and so does following a link inside it — the panel is
       position: static, so a same-page #contact link would otherwise leave it
       hanging open over the section it just scrolled to. */
    panel.addEventListener('click', (event) => {
      if (!(event.target instanceof HTMLAnchorElement)) return;
      toggle.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      toggle.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
      toggle.focus();
    });
  }

  /* --------------------------------------------------------- reveals ---- */
  /* Same discipline as Motion.astro and web-design.astro: the hidden starting
     state is written here, never in CSS, so a page whose script never runs
     shows everything instead of nothing. The failsafe below clears anything
     still pending if the observer never fires — which is what happens in a
     background tab, where callbacks and rAF are throttled to nothing. */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];

  if (!reduced && typeof IntersectionObserver === 'function' && targets.length) {
    const pending = new Set<HTMLElement>(targets);

    for (const el of targets) {
      el.style.opacity = '0';
      el.style.translate = '0 26px';
      el.style.transition =
        'opacity .7s cubic-bezier(.2,.8,.25,1), translate .7s cubic-bezier(.2,.8,.25,1)';
    }

    const show = (el: HTMLElement) => {
      if (!pending.delete(el)) return;
      el.style.opacity = '1';
      el.style.translate = 'none';
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          show(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
    );

    targets.forEach((el) => io.observe(el));

    const flush = () => {
      io.disconnect();
      for (const el of [...pending]) {
        el.style.transition = '';
        show(el);
      }
    };

    window.setTimeout(flush, 4000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') flush();
    });
  }
</script>

<style is:global>
  /* Scoped styles can't reach the page content passed through <slot />, and
     every consulting page shares this vocabulary, so the section's stylesheet
     lives here as one global block namespaced under `.c`. Nothing outside a
     `.c` ancestor is touched.

     Every value here is the v14 export's (`Monzones-C-*`), read off its inline
     styles. The four pages share one system: a 1260px container with 28px
     gutters, pill kickers, an overlapping stats card that hangs 96px into the
     green band below it, and a terracotta contact band and footer. */
  .c {
    --c-paper: #f4efe6;
    --c-card: #fffdf9;
    --c-ink: #221e1a;
    /* The export's three quieter inks: body copy, labels, notes. */
    --c-ink-2: #5e574f;
    --c-ink-3: #6b635a;
    --c-ink-4: #8a8178;
    --c-terra: #c0603c;
    --c-green: #2f5d50;
    --c-butter: #f6e7b2;
    --c-line: rgb(34 30 26 / 10%);

    --c-raised:
      0 1px 2px rgb(34 30 26 / 7%), 0 24px 48px -20px rgb(34 30 26 / 16%),
      inset 0 1px 0 rgb(255 255 255 / 90%);
    --c-float:
      0 1px 2px rgb(34 30 26 / 8%), 0 44px 80px -28px rgb(34 30 26 / 32%),
      inset 0 1px 0 rgb(255 255 255 / 90%);
    /* Cards on the green band throw a green-tinted shadow. */
    --c-raised-green:
      0 1px 2px rgb(34 30 26 / 8%), 0 24px 48px -20px rgb(14 30 26 / 40%),
      inset 0 1px 0 rgb(255 255 255 / 90%);
    --c-float-green:
      0 1px 2px rgb(34 30 26 / 10%), 0 48px 90px -30px rgb(14 30 26 / 55%),
      inset 0 1px 0 rgb(255 255 255 / 90%);

    --c-disp: 'Clash Display', 'General Sans', 'Helvetica Neue', sans-serif;
    --c-body: 'Switzer', 'General Sans', 'Helvetica Neue', sans-serif;

    position: relative;
    min-width: 320px;
    max-width: 100vw;
    overflow-x: clip;
    background: var(--c-paper);
    color: var(--c-ink);
    font-family: var(--c-body);
    -webkit-font-smoothing: antialiased;
  }

  .c ::selection {
    background: var(--c-butter);
    color: var(--c-ink);
  }

  .c .disp {
    font-family: var(--c-disp);
  }

  .c a {
    color: inherit;
    text-decoration: none;
  }

  .c :focus-visible {
    outline: 2px solid var(--c-terra);
    outline-offset: 3px;
  }

  /* The paper grain. Fixed and pointer-events:none so it sits over the whole
     section without intercepting a single click. */
  .c__grain {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
    opacity: 0.035;
    mix-blend-mode: multiply;
    background-size: 220px 220px;
    background-image: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='220' height='220'%3E%3Cfilter id='f'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9 .45' numOctaves='3' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='220' height='220' filter='url(%23f)'/%3E%3C/svg%3E");
  }

  /* ----------------------------------------------------------- layout -- */
  /* The export pads the section 28px and centres a 1260px div inside it, so
     the content is 1260 wide. With border-box that is 1260 + 2×28 here. */
  .c .cwrap {
    max-width: 1316px;
    margin-inline: auto;
    padding-inline: 28px;
  }

  .c .csection {
    padding-block: clamp(64px, 8vw, 116px);
  }

  /* The section right after a hero: a short top, and its card (`.cstats`)
     hangs 96px into the band below. The band that follows makes room. */
  .c .csection--overlap {
    position: relative;
    z-index: 2;
    padding-block: clamp(20px, 3vw, 40px) 0;
  }

  .c .csection--after-overlap {
    padding-block: calc(96px + clamp(56px, 7vw, 104px)) clamp(72px, 9vw, 128px);
  }

  .c .csection--flush-top {
    padding-top: 0;
  }

  .c .csection--deep {
    padding-bottom: clamp(72px, 9vw, 128px);
  }

  /* The kicker is a pill, green on paper. */
  .c .ckicker {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    border: 1px solid rgb(34 30 26 / 15%);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-green);
  }

  .c .ctitle {
    margin: 14px 0 0;
    font-size: clamp(32px, 4.2vw, 64px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .c .clede {
    margin-top: 18px;
    max-width: 640px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--c-ink-2);
    text-wrap: pretty;
  }

  /* ------------------------------------------------- shared components -- */
  /* These live here rather than in a page because all four consulting pages
     use them. Page-scoped styles also can't reach markup passed through
     <slot />, so anything a sub-page needs has to be global anyway. */

  /* The quiet button: a hairline pill that fills green on hover. */
  .c .cbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 26px;
    border-radius: 999px;
    border: 1px solid rgb(34 30 26 / 15%);
    background: transparent;
    color: var(--c-ink);
    font-size: 15px;
    font-weight: 600;
    transition:
      transform 0.3s cubic-bezier(0.2, 0.8, 0.25, 1),
      box-shadow 0.3s cubic-bezier(0.2, 0.8, 0.25, 1),
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .c .cbtn:hover,
  .c .cbtn:focus-visible {
    transform: translateY(-2px);
    background: var(--c-green);
    border-color: var(--c-green);
    color: var(--c-card);
  }

  /* The hero pair: bigger, with the raised shadow. */
  .c .cbtn--solid {
    padding: 18px 34px;
    background: var(--c-terra);
    border-color: var(--c-terra);
    color: var(--c-card);
    font-size: 16px;
    box-shadow:
      0 1px 2px rgb(34 30 26 / 7%), 0 24px 48px -20px rgb(192 96 60 / 45%);
  }

  .c .cbtn--solid:hover,
  .c .cbtn--solid:focus-visible {
    transform: translateY(-3px);
    background: var(--c-ink);
    border-color: var(--c-ink);
    color: var(--c-card);
    box-shadow:
      0 1px 2px rgb(34 30 26 / 10%), 0 32px 56px -20px rgb(34 30 26 / 35%);
  }

  .c .cbtn--ghost {
    padding: 18px 34px;
    background: var(--c-card);
    border-color: rgb(34 30 26 / 12%);
    color: var(--c-ink);
    font-size: 16px;
    box-shadow: 0 1px 2px rgb(34 30 26 / 7%);
  }

  .c .cbtn--ghost:hover,
  .c .cbtn--ghost:focus-visible {
    transform: translateY(-3px);
    background: var(--c-card);
    border-color: var(--c-green);
    color: var(--c-green);
    box-shadow: var(--c-raised);
  }

  /* The ink button that closes the services list. */
  .c .cbtn--ink {
    padding: 16px 30px;
    background: var(--c-ink);
    border-color: var(--c-ink);
    color: var(--c-paper);
    box-shadow: 0 1px 2px rgb(34 30 26 / 7%), 0 16px 32px -16px rgb(34 30 26 / 40%);
  }

  .c .cbtn--ink:hover,
  .c .cbtn--ink:focus-visible {
    transform: translateY(-3px);
    background: var(--c-green);
    border-color: var(--c-green);
    color: var(--c-paper);
  }

  .c .ctarow {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* A section head with a link on the right. */
  .c .chead {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: clamp(28px, 3vw, 40px);
  }

  .c .csection--green .chead {
    margin-bottom: clamp(36px, 4.5vw, 60px);
  }

  /* The head's link is a green pill on paper, and an outlined one on green. */
  .c .clink {
    display: inline-flex;
    align-items: center;
    padding: 14px 26px;
    border: 1px solid var(--c-green);
    border-radius: 999px;
    background: var(--c-green);
    color: var(--c-paper);
    font-size: 15px;
    font-weight: 600;
    box-shadow: 0 1px 2px rgb(34 30 26 / 7%), 0 16px 32px -16px rgb(47 93 80 / 50%);
    transition:
      transform 0.3s cubic-bezier(0.2, 0.8, 0.25, 1),
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .c .clink:hover,
  .c .clink:focus-visible {
    transform: translateY(-2px);
    background: var(--c-ink);
    border-color: var(--c-ink);
    color: var(--c-paper);
  }

  .c .csection--green {
    background: var(--c-green);
    color: var(--c-paper);
  }

  .c .csection--green .ckicker {
    border-color: rgb(244 239 230 / 25%);
    color: rgb(244 239 230 / 75%);
  }

  .c .csection--green .clink {
    background: transparent;
    border-color: rgb(244 239 230 / 30%);
    color: var(--c-paper);
    box-shadow: none;
  }

  .c .csection--green .clink:hover,
  .c .csection--green .clink:focus-visible {
    background: var(--c-paper);
    border-color: var(--c-paper);
    color: var(--c-green);
  }

  .c .csection--green .clede {
    color: rgb(244 239 230 / 76%);
  }

  .c .csection--green .cbtn {
    border-color: rgb(244 239 230 / 30%);
    color: var(--c-paper);
  }

  .c .csection--green .cbtn:hover,
  .c .csection--green .cbtn:focus-visible {
    background: var(--c-paper);
    border-color: var(--c-paper);
    color: var(--c-green);
  }

  /* The terracotta band every page ends on, its top corners rounded off the
     paper above. The footer continues the colour. */
  .c .csection--terra {
    background: var(--c-terra);
    color: var(--c-ink);
    border-radius: clamp(28px, 4vw, 52px) clamp(28px, 4vw, 52px) 0 0;
    padding-block: clamp(64px, 8vw, 112px) clamp(64px, 8vw, 104px);
  }

  /* The sub-pages' closing CTA sizes; the home contact band runs bigger and
     overrides these in consulting.astro. */
  .c .csection--terra .ctitle {
    max-width: 900px;
    font-size: clamp(36px, 4.8vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.028em;
    color: var(--c-card);
  }

  .c .csection--terra .clede {
    margin: 22px 0 0;
    max-width: 600px;
    font-size: clamp(16px, 1.6vw, 18px);
    color: rgb(255 253 249 / 82%);
  }

  .c .csection--terra .ctarow {
    margin-top: 34px;
    align-items: center;
  }

  /* On terracotta the solid button goes cream with terracotta text, and the
     ghost is a cream hairline. */
  .c .csection--terra .cbtn--solid {
    background: var(--c-card);
    border-color: var(--c-card);
    color: var(--c-terra);
    box-shadow:
      0 1px 2px rgb(34 30 26 / 10%), 0 24px 48px -20px rgb(60 20 10 / 45%),
      inset 0 1px 0 rgb(255 255 255 / 90%);
  }

  .c .csection--terra .cbtn--solid:hover,
  .c .csection--terra .cbtn--solid:focus-visible {
    background: var(--c-ink);
    border-color: var(--c-ink);
    color: var(--c-card);
  }

  .c .csection--terra .cbtn--ghost {
    background: transparent;
    border-color: rgb(255 253 249 / 50%);
    color: var(--c-card);
    box-shadow: none;
  }

  .c .csection--terra .cbtn--ghost:hover,
  .c .csection--terra .cbtn--ghost:focus-visible {
    background: transparent;
    border-color: var(--c-card);
    color: var(--c-card);
    box-shadow: none;
  }

  /* The four-figure card, on both the home and results pages. It hangs 96px
     below its section into the green band that follows. */
  .c .cstats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(18px, 2.2vw, 32px);
    padding: clamp(28px, 3.2vw, 44px);
    margin-bottom: -96px;
    border: 1px solid rgb(34 30 26 / 8%);
    border-radius: 30px;
    background: var(--c-card);
    color: var(--c-ink);
    box-shadow: var(--c-float);
  }

  .c .cstat__rule {
    display: block;
    width: 34px;
    height: 3px;
    border-radius: 2px;
    background: var(--c-terra);
  }

  .c .cstat__num {
    margin-top: 20px;
    font-size: clamp(34px, 3.4vw, 52px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .c .cstat__label {
    margin-top: 14px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--c-ink-3);
    text-wrap: pretty;
  }

  /* The practice tabs, on both the home and services pages: a pill tray. */
  .c .cprac {
    margin-top: 30px;
  }

  .c .cprac__tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 24px;
    padding: 6px;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    background: var(--c-card);
    box-shadow: 0 1px 2px rgb(34 30 26 / 7%), inset 0 1px 0 rgb(255 255 255 / 90%);
  }

  .c .cprac__tab {
    padding: 13px 24px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--c-ink);
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      box-shadow 0.3s cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .c .cprac__tab[aria-selected='true'] {
    background: var(--c-green);
    color: var(--c-paper);
    box-shadow:
      0 1px 2px rgb(34 30 26 / 10%),
      0 10px 20px -10px rgb(47 93 80 / 60%);
  }

  .c .cprac__panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 3vw, 48px);
    padding: clamp(28px, 3.4vw, 52px);
    border: 1px solid rgb(34 30 26 / 8%);
    border-radius: 32px;
    background: var(--c-card);
    color: var(--c-ink);
    box-shadow: var(--c-raised);
  }

  /* Without a script the panels stack, so each needs its own separation. */
  .c .cprac__panel + .cprac__panel {
    margin-top: 20px;
  }

  /* On the services page the panel hangs into the green band below it. */
  .c .cprac__panel--overlap {
    margin-bottom: -88px;
    box-shadow: var(--c-float);
  }

  .c .csteps--overlap {
    margin-bottom: -88px;
  }

  .c .csteps--overlap .cstep {
    border-color: rgb(34 30 26 / 8%);
  }

  .c .cprac__panel > div {
    display: flex;
