---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT } from '../config';
import { PROJECTS } from '../data/site';

const POST_COUNT = (await getCollection('thinking', ({ data }) => !data.draft)).length;

/*
 * Counts are read from the data rather than typed, so a page that says
 * "thirteen write-ups" can't drift out of date the next time one is added.
 */
const spell = (n: number) =>
  ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve', 'thirteen', 'fourteen'][n] ?? String(n);

const destinations = [
  {
    href: '/work/',
    title: 'The work',
    body: `${spell(PROJECTS.length).replace(/^./, (c) => c.toUpperCase())} write-ups: what I was handed, what I found, and what moved.`,
  },
  {
    href: '/consulting/',
    title: 'Consulting',
    body: 'What I take on, how it gets scoped, and who it is not for.',
  },
  {
    href: '/thinking/',
    title: 'Writing',
    body: `Lifecycle, AI and how search is changing. ${spell(POST_COUNT).replace(/^./, (c) => c.toUpperCase())} pieces so far.`,
  },
  {
    href: '/about/',
    title: 'About',
    body: 'Where I came from, how I work, and what I am like to work with.',
  },
];
---

<BaseLayout title="Page not found" description="That page doesn't exist.">
  <section class="section--first wrap notfound">
    <p class="eyebrow notfound__eyebrow">404</p>
    <h1 class="page-title">This page is not here.</h1>
    <p class="lede notfound__lede">
      Either it moved or the link was wrong, and neither of those is your fault. Here is where most
      people are heading anyway.
    </p>

    <nav class="notfound__links" aria-label="Site sections">
      {
        destinations.map((item) => (
          <a class="card card--interactive notfound__card" href={item.href}>
            <span class="notfound__card-title">{item.title}</span>
            <span class="notfound__card-body">{item.body}</span>
          </a>
        ))
      }
    </nav>

    <p class="notfound__report">
      Landed here from a link on my site? <a href={`mailto:${CONTACT.email}`}>Tell me</a> and I’ll fix
      it.
    </p>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-bottom: clamp(64px, 10vw, 140px);
  }

  .notfound__eyebrow {
    margin-bottom: 26px;
  }

  .notfound__report {
    margin-top: 44px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-3);
  }

  .notfound__report a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .notfound__lede {
    margin-top: 30px;
    max-width: 520px;
  }

  .notfound__links {
    margin-top: 52px;
    max-width: 820px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .notfound__card {
    padding: 30px 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .notfound__card-title {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.012em;
  }

  .notfound__card-body {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  @media (min-width: 760px) {
    .notfound__links {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
