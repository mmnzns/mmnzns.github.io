---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactBand from '../../components/ContactBand.astro';
import { PROJECTS, CATEGORY_ORDER, CATEGORY_ACCENT, type Category } from '../../data/site';

/** Anchor id for a category, e.g. "Leadership & Operations" → "leadership-operations". */
function anchor(category: Category) {
  return category
    .toLowerCase()
    .replace(/&/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

const groups = CATEGORY_ORDER.map((category) => ({
  category,
  id: anchor(category),
  accent: CATEGORY_ACCENT[category],
  items: PROJECTS.filter((project) => project.category === category),
})).filter((group) => group.items.length > 0);
---

<BaseLayout
  title="The Work"
  description="Thirteen systems I diagnosed, decided on, and built — lifecycle, AI automation, web operations and team building across fintech, SaaS and ecommerce."
>
  <section class="section--first wrap">
    <p class="eyebrow work-hero__eyebrow">What I’ve built</p>
    <h1 class="page-title work-hero__title">Here’s the work, and how each one actually went.</h1>
    <p class="lede work-hero__lede">
      They tend to follow the same arc: work out what’s really going on, agree on what should exist
      instead, pick the number that will show whether it worked, and then go build it. I’ve written
      each one up in that order, so read as far as you like and stop whenever you’ve got what you
      came for.
    </p>

    <nav class="work-hero__jump" aria-label="Jump to a category">
      {groups.map((group) => <a class="chip chip--pill" href={`#${group.id}`}>{group.category}</a>)}
    </nav>
  </section>

  <div class="work-groups">
    {
      groups.map((group) => (
        <section class="wrap work-group" id={group.id}>
          <div class="work-group__head">
            <p class="label-row work-group__count">
              <span class="accent-bar" style={`--bar:${group.accent}`} />
              <span class="eyebrow">
                {group.items.length} {group.items.length === 1 ? 'case' : 'cases'}
              </span>
            </p>
            <h2 class="work-group__title">{group.category}</h2>
          </div>

          <div class="work-group__list">
            {group.items.map((project) => (
              <a class="card card--interactive work-card" href={`/work/${project.slug}/`}>
                <div class="work-card__inner">
                  <div>
                    <p class="eyebrow work-card__tags">{project.tags.join(' / ')}</p>
                    <h3 class="work-card__title">{project.title}</h3>
                    <p class="work-card__summary">{project.problem}</p>
                  </div>

                  <div class="work-card__metrics">
                    {project.metrics.slice(0, 2).map((metric) => (
                      <div>
                        <p class="work-card__metric">
                          {metric.value ?? `${metric.from} → ${metric.to}`}
                        </p>
                        <p class="work-card__metric-label">{metric.label}</p>
                      </div>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <ContactBand />
</BaseLayout>

<style>
  .work-hero__eyebrow {
    margin-bottom: 26px;
  }

  .work-hero__title {
    max-width: 1000px;
  }

  .work-hero__lede {
    margin-top: 30px;
    max-width: 620px;
  }

  .work-hero__jump {
    margin-top: 44px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .work-groups {
    margin-top: clamp(64px, 9vw, 110px);
  }

  .work-group {
    padding-bottom: clamp(64px, 8vw, 96px);
    scroll-margin-top: calc(var(--header-h) + 40px);
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .work-group__count {
    margin-bottom: 14px;
  }

  .work-group__title {
    font-size: clamp(24px, 2.8vw, 32px);
    line-height: 1.1;
  }

  .work-group__list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .work-card {
    padding: clamp(26px, 3vw, 32px) clamp(26px, 3vw, 34px);
  }

  .work-card__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
    align-items: start;
  }

  .work-card__tags {
    font-size: 11px;
  }

  .work-card__title {
    margin-top: 12px;
    font-size: 23px;
    line-height: 1.2;
  }

  .work-card__summary {
    margin-top: 12px;
    max-width: 560px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .work-card__metrics {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .work-card__metric {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  .work-card__metric-label {
    margin-top: 3px;
    font-size: 13px;
    line-height: 1.4;
    color: var(--ink-3);
  }

  @media (min-width: 900px) {
    .work-group {
      grid-template-columns: 210px 1fr;
      gap: 44px;
    }
  }

  @media (min-width: 1100px) {
    .work-group {
      grid-template-columns: 250px 1fr;
      gap: 56px;
    }

    .work-card__inner {
      grid-template-columns: minmax(0, 1fr) 210px;
      gap: 36px;
      align-items: center;
    }
  }
</style>
