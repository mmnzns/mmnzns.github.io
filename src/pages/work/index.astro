---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactBand from '../../components/ContactBand.astro';
import { PROJECTS, CATEGORY_ORDER, CATEGORY_ACCENT, type Category } from '../../data/site';

/** Anchor id for a category, e.g. "Leadership & Operations" → "leadership-operations". */
function anchor(category: Category) {
  return category
    .toLowerCase()
    .replace(/&/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

const groups = CATEGORY_ORDER.map((category) => ({
  category,
  id: anchor(category),
  accent: CATEGORY_ACCENT[category],
  items: PROJECTS.filter((project) => project.category === category),
})).filter((group) => group.items.length > 0);
---

<BaseLayout
  title="The Work"
  description="Systems, journeys, and teams I've helped bring to life — lifecycle rebuilds, AI automation, web and analytics, and the operations behind them."
  breadcrumbs={[{ label: 'Work', href: '/work/' }]}
  footerFlush
>
  <section class="section--first wrap workhero" id="top">
    <div class="dotacc" aria-hidden="true"></div>

    <p class="eyebrow">What I’ve built</p>
    <h1 class="page-title workhero__title">
      A collection of systems, journeys, and teams I’ve helped bring to life.
    </h1>
    <p class="lede workhero__sub">
      Most of these projects began with a business problem that crossed more than one team. I’ve
      written each case around the same questions: What were we seeing? What did we learn? What did
      we decide to build? And how did we know whether it worked? Filter by area, or open any project
      for the full story.
    </p>

    <div class="jump">
      {
        groups.map((group) => (
          <a class="jump__link" href={`#${group.id}`}>
            <span class="jump__mark" style={`background:${group.accent}`} aria-hidden="true" />
            <span>{group.category}</span>
          </a>
        ))
      }
    </div>
  </section>

  <div class="spacer" aria-hidden="true"></div>

  {
    groups.map((group) => (
      <section class="wrap group" id={group.id}>
        <div class="group__rule" aria-hidden="true" />
        <div class="group__grid">
          <div>
            <p class="label-row group__label">
              <span class="accent-bar" style={`--bar:${group.accent}`} />
              <span class="eyebrow eyebrow--muted">
                {group.items.length} {group.items.length === 1 ? 'case' : 'cases'}
              </span>
            </p>
            <h2 class="section-title--sm">{group.category}</h2>
          </div>

          <div class="group__cases">
            {group.items.map((project) => (
              <a class="card card--interactive workcard" href={`/work/${project.slug}/`}>
                <div class="workcard__grid">
                  <div>
                    <p class="workcard__tags">{project.tags.join(' / ')}</p>
                    <h3 class="workcard__title">{project.title}</h3>
                    <p class="workcard__summary">{project.problem}</p>
                  </div>

                  <div class="workcard__metrics">
                    {project.metrics.map((metric) => (
                      <div>
                        <p class="workcard__value">
                          {metric.value ?? `${metric.from} → ${metric.to}`}
                        </p>
                        <p class="workcard__label">{metric.label}</p>
                      </div>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <ContactBand />
</BaseLayout>

<style>
  .workhero {
    position: relative;
  }

  .workhero__title {
    margin-top: 26px;
    max-width: 1000px;
  }

  .workhero__sub {
    margin-top: 30px;
    max-width: 620px;
    font-size: 18px;
    line-height: 1.65;
  }

  .jump {
    margin-top: 44px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .jump__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 12px 18px;
    border: var(--border);
    background: var(--paper);
    transition:
      background var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .jump__link:hover,
  .jump__link:focus-visible {
    background: var(--ink);
    color: var(--paper);
  }

  .jump__mark {
    width: 22px;
    height: 11px;
    flex: none;
  }

  .spacer {
    height: clamp(70px, 8vw, 110px);
  }

  .group {
    padding-bottom: 96px;
    scroll-margin-top: 110px;
  }

  .group__rule {
    height: 6px;
    background: var(--ink);
    margin-bottom: 34px;
  }

  .group__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 34px;
  }

  .group__label {
    margin-bottom: 14px;
  }

  .group__cases {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .workcard {
    padding: 32px clamp(17px, 4.5vw, 34px);
  }

  .workcard__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .workcard__tags {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .workcard__title {
    margin-top: 12px;
    font-size: 23px;
    line-height: 1.2;
    letter-spacing: -0.012em;
  }

  .workcard__summary {
    margin-top: 12px;
    max-width: 560px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .workcard__metrics {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .workcard__value {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  .workcard__label {
    margin-top: 3px;
    font-size: 13px;
    color: var(--ink-3);
    line-height: 1.4;
  }

  @media (min-width: 800px) {
    .group__grid {
      grid-template-columns: 0.62fr 1.38fr;
      gap: 48px;
    }

    .workcard__grid {
      grid-template-columns: 1fr 220px;
      gap: 40px;
    }
  }
</style>
