---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactBand from '../../components/ContactBand.astro';
import { PROJECTS, CATEGORY_ORDER, CATEGORY_ACCENT } from '../../data/site';
import { CASES } from '../../data/cases';

export const getStaticPaths = (() => {
  /* Ordered the same way the work index reads, so "next" walks the visitor
     through the site in the order it presents itself rather than in array
     order. Built inside the function because Astro hoists getStaticPaths out
     of the module, so it cannot close over module-level constants. */
  const ordered = CATEGORY_ORDER.flatMap((category) =>
    PROJECTS.filter((project) => project.category === category),
  );

  return ordered.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      previous: ordered[(index - 1 + ordered.length) % ordered.length],
      next: ordered[(index + 1) % ordered.length],
    },
  }));
}) satisfies GetStaticPaths;

const { project, previous, next } = Astro.props;
const study = CASES[project.slug];

if (!study) {
  throw new Error(
    `No case body for "${project.slug}". Add one to src/data/cases.ts or remove the project from src/data/site.ts.`,
  );
}

const accent = CATEGORY_ACCENT[project.category];
---

<BaseLayout
  title={study.title}
  description={study.deck}
  breadcrumbs={[
    { label: 'Work', href: '/work/' },
    { label: study.title, href: `/work/${project.slug}/` },
  ]}
>
  <section class="wrap casetop">
    <a class="casetop__back" href="/work/">← All work</a>
  </section>

  <section class="wrap casehead">
    <p class="label-row casehead__meta">
      <span class="accent-bar" style={`--bar:${accent}`}></span>
      <span class="eyebrow eyebrow--muted">{study.meta}</span>
    </p>
    <h1 class="page-title casehead__title">{study.title}</h1>
    <p class="casehead__deck">{study.deck}</p>
  </section>

  <section class="wrap arcs">
    {
      study.sections.map((section, i) => (
        <div class="arc">
          <div class="arc__head">
            <span class="arc__num" aria-hidden="true">
              0{i + 1}
            </span>
            <h2 class="arc__label">{section.label}</h2>
          </div>
          <div class="arc__body">
            {section.paras.map((para) => (
              <p>{para}</p>
            ))}
          </div>
        </div>
      ))
    }
  </section>

  <section class="numbers">
    <div class="wrap">
      <div class="numbers__stats">
        {
          study.stats.map((stat) => (
            <div>
              <p class="numbers__value">{stat.value}</p>
              <p class="numbers__label">{stat.label}</p>
            </div>
          ))
        }
      </div>
      <hr class="band-rule numbers__rule" />
      <p class="numbers__outcome">{study.outcome}</p>
    </div>
  </section>

  {
    study.tech.length > 0 && (
      <section class="wrap techsec">
        <div class="arc arc--tech">
          <div class="arc__head">
            <h2 class="arc__label">Tech</h2>
          </div>
          <div class="tech">
            {study.tech.map((tech) => (
              <div class="tech__row">
                <p class="tech__name">{tech.name}</p>
                <p class="tech__use">{tech.use}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="wrap pn">
    <a class="card card--interactive pn__link" href={`/work/${previous.slug}/`}>
      <p class="eyebrow eyebrow--muted">Previous</p>
      <p class="pn__title">{CASES[previous.slug]?.title ?? previous.title}</p>
    </a>
    <a class="card card--interactive pn__link pn__link--next" href={`/work/${next.slug}/`}>
      <p class="eyebrow eyebrow--muted">Next</p>
      <p class="pn__title">{CASES[next.slug]?.title ?? next.title}</p>
    </a>
  </section>

  <ContactBand variant="panel" />
</BaseLayout>

<style>
  .casetop {
    padding-top: 48px;
  }

  .casetop__back {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-2);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .casehead {
    padding-top: 24px;
  }

  .casehead__meta {
    margin-bottom: 26px;
  }

  .casehead__title {
    max-width: 960px;
  }

  .casehead__deck {
    margin-top: 32px;
    max-width: 660px;
    font-size: clamp(19px, 2.1vw, 24px);
    line-height: 1.5;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink-deck);
  }

  .arcs {
    padding-top: 96px;
  }

  .arc {
    padding: 46px 0;
    border-top: var(--border);
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
  }

  .arc__head {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .arc__num {
    font-size: 13px;
    font-weight: 700;
    color: #c0b8ae;
    font-variant-numeric: tabular-nums;
  }

  .arc__label {
    font-size: 20px;
    letter-spacing: -0.034em;
  }

  .arc__body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 680px;
  }

  .arc__body p {
    font-size: 18px;
    line-height: 1.66;
  }

  @media (min-width: 800px) {
    .arc {
      grid-template-columns: 0.85fr 2fr;
      gap: 48px;
    }
  }

  .numbers {
    margin-top: 90px;
    background: var(--dark);
    color: var(--on-dark);
    padding: clamp(70px, 8vw, 110px) 0;
  }

  .numbers__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 40px;
  }

  .numbers__value {
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--on-dark);
  }

  .numbers__label {
    margin-top: 14px;
    font-size: 14px;
    color: var(--on-dark-3);
    line-height: 1.5;
    max-width: 240px;
  }

  .numbers__rule {
    margin-block: clamp(44px, 5vw, 64px);
  }

  .numbers__outcome {
    max-width: 820px;
    font-size: clamp(19px, 2.2vw, 27px);
    line-height: 1.45;
    font-weight: 700;
    letter-spacing: -0.012em;
    color: var(--sun);
  }

  .techsec {
    padding-top: 110px;
  }

  .arc--tech {
    padding: 0;
    border-top: 0;
  }

  .tech {
    display: flex;
    flex-direction: column;
  }

  .tech__row {
    padding: 18px 0;
    border-bottom: var(--border);
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px;
  }

  .tech__name {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.005em;
  }

  .tech__use {
    font-size: 15px;
    color: var(--ink-2);
    line-height: 1.55;
  }

  @media (min-width: 800px) {
    .tech__row {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 32px;
    }
  }

  .pn {
    padding-top: 100px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .pn__link {
    padding: 28px 30px;
  }

  .pn__link--next {
    text-align: right;
  }

  .pn__title {
    margin-top: 10px;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  @media (min-width: 700px) {
    .pn {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
