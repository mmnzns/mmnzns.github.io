---
/**
 * A case study — v19 `Monzones-D-Case-V4`.
 *
 * The export is one hash-routed page (`#mogo-lifecycle`); here each case is
 * its own static route, so it can be linked, indexed and shared. Headline and
 * art come from the project record (site.ts), the body from cases.ts — the
 * same split the export makes between its INDEX and CASES arrays.
 */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROJECTS, CATEGORY_ORDER, CATEGORY_ACCENT } from '../../data/site';
import { CASES } from '../../data/cases';
import { art } from '../../data/art';
import tapeYellow from '../../assets/brand/tape-yellow.webp';
import tapeGreen from '../../assets/brand/tape-green.webp';

export const getStaticPaths = (() => {
  /* Built inside the function: Astro hoists getStaticPaths out of the module,
     so it cannot close over module-level constants. Work-index order, so
     "next" walks the visitor through the site the way it presents itself. */
  const ordered = CATEGORY_ORDER.flatMap((category) =>
    PROJECTS.filter((project) => project.category === category),
  );
  return ordered.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      index,
      total: ordered.length,
      previous: ordered[(index - 1 + ordered.length) % ordered.length],
      next: ordered[(index + 1) % ordered.length],
    },
  }));
}) satisfies GetStaticPaths;

const { project, index, total, previous, next } = Astro.props;
const study = CASES[project.slug];
if (!study) {
  throw new Error(
    `No case body for "${project.slug}". Add one to src/data/cases.ts or remove the project from src/data/site.ts.`,
  );
}

const pad = (n: number) => String(n).padStart(2, '0');
const [where, role, when] = study.meta.split(' · ');
const facts = [
  { k: 'Where', v: where },
  { k: 'Role', v: role },
  { k: 'When', v: when },
].filter((f) => f.v);
const STAT_INK = ['var(--amber)', 'var(--paper)', 'var(--sky-light)'];
const neighbours = [
  { label: '← Previous case', p: previous, tilt: '-3deg' },
  { label: 'Next case →', p: next, tilt: '3deg' },
];
---

<BaseLayout
  title={project.title}
  description={study.deck}
  current="Work"
  breadcrumbs={[
    { label: 'Work', href: '/work/' },
    { label: project.title, href: `/work/${project.slug}/` },
  ]}
>
  <section class="chead">
    <div class="mz-max">
      <div class="mz-head3" data-hero>
        <a href="/work/"><span aria-hidden="true">←</span> All the work</a>
        <span>Case file {pad(index + 1)} / {pad(total)}</span>
        <span class="chead__area"><span class="chead__dot" style={`background:${CATEGORY_ACCENT[project.category]}`}></span>{project.category}</span>
      </div>
      <div class="chead__grid">
        <div class="chead__copy">
          <h1 class="chead__h1" data-hero>{project.title}</h1>
          <p class="chead__deck" data-hero>{study.deck}</p>
          <dl class="chead__facts" data-hero>
            {
              facts.map((f) => (
                <>
                  <dt>{f.k}</dt>
                  <dd>{f.v}</dd>
                </>
              ))
            }
          </dl>
        </div>
        <div class="chead__art" data-hero>
          <span class="chead__frame">
            <span class="chead__paper">
              <span class:list={['chead__img', `chead__img--${project.artFit}`]}>
                <Image src={art(project.art)} alt="" widths={[480, 720, 1040]} sizes="(max-width: 1000px) 92vw, 600px" loading="eager" />
              </span>
            </span>
            <Image src={tapeYellow} alt="" aria-hidden="true" width={140} densities={[1, 2]} class="mz-tape chead__tape" />
          </span>
          <span class="stamp" aria-hidden="true"><span>Case</span><span class="stamp__n">{pad(index + 1)}</span><span>Solved</span></span>
        </div>
      </div>
    </div>
  </section>

  <section class="brief">
    <div class="brief__inner">
      <div class="brief__top">
        <h2 class="brief__h2" data-split>The brief, and what was <em>underneath.</em></h2>
        <span class="brief__hint">Tap the card to turn it over ↻</span>
      </div>
      <div class="brief__stage" data-rv>
        <Image src={tapeGreen} alt="" aria-hidden="true" width={145} densities={[1, 2]} class="mz-tape brief__tape" />
        <button type="button" class="flip" aria-pressed="false" data-flip>
          <span class="flip__side flip__front">
            <span class="flip__meta"><span>Exhibit A · What they asked for</span><span>Side 1 of 2</span></span>
            <span class="flip__brief">“{study.brief}”</span>
            <span class="flip__cue">Turn it over to see the real problem ↻</span>
          </span>
          <span class="flip__side flip__back">
            <span class="flip__meta flip__meta--back"><span>Exhibit B · What was underneath</span><span>Side 2 of 2</span></span>
            <span class="flip__read">{study.read}</span>
            <span class="flip__cue flip__cue--back">↺ Back to the brief</span>
          </span>
        </button>
      </div>
    </div>
  </section>

  <section class="chapters">
    <div class="mz-max">
      {
        study.sections.map((s, n) => (
          <div class="chapter">
            <div class="chapter__side">
              <div class="chapter__label">
                <span class="chapter__n">{pad(n + 1)}</span>
                <h3 class="chapter__h">{s.label}</h3>
              </div>
            </div>
            <div class="chapter__body" data-rv>
              {s.paras.map((t) => <p>{t}</p>)}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="score">
    <div class="mz-max">
      <p class="mz-kicker mz-kicker--dark score__kicker"><span>The scoreboard</span><span>{where}</span></p>
      <div class="score__stats">
        {
          study.stats.map((st, k) => (
            <div class="score__stat" data-rv data-delay={k * 120}>
              <div class="score__v" style={`color:${STAT_INK[k % 3]}`}>{st.value}</div>
              <div class="score__l">{st.label}</div>
            </div>
          ))
        }
      </div>
      <div class="score__outcome">
        <p class="score__changed">What changed</p>
        <p class="score__text" data-rv>{study.outcome}</p>
      </div>
    </div>
  </section>

  {
    study.tech.length > 0 && (
      <section class="kit">
        <div class="kit__grid">
          <h2 class="kit__h2" data-split>
            The <em>toolkit.</em>
          </h2>
          <div class="kit__list">
            {study.tech.map((t, k) => (
              <div class="kit__row" data-rv data-delay={k * 60}>
                <div class="kit__name">
                  <span class="kit__n">{pad(k + 1)}</span>
                  {t.name}
                </div>
                <div class="kit__use">{t.use}</div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="pn">
    <div class="pn__grid">
      {
        neighbours.map(({ label, p, tilt }, k) => (
          <a class="pn__card" href={`/work/${p.slug}/`} data-rv data-delay={k * 120} data-cursor="Open">
            <span class="pn__thumb" style={`rotate:${tilt}`}>
              <span class="pn__paper">
                <Image
                  src={art(p.art)}
                  alt=""
                  width={300}
                  height={300}
                  class:list={['pn__img', `pn__img--${p.artFit}`]}
                  loading="lazy"
                />
              </span>
            </span>
            <span class="pn__text">
              <span class="pn__label">{label}</span>
              <span class="pn__title">{p.title}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="cta">
    <div class="cta__row">
      <h2 class="cta__h2" data-split>Working through something <em>like this?</em></h2>
      <a href="/#contact" class="mz-btn mz-btn--cream" data-rv data-magnetic>Let's talk it through <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .chead {
    padding: clamp(28px, 4vw, 56px) var(--gutter) 0;
  }
  .chead__area {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .chead__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .chead__grid {
    margin-top: clamp(36px, 5vw, 72px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: clamp(48px, 6vw, 96px);
    align-items: center;
  }
  .chead__copy {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.4vw, 32px);
    min-width: 0;
  }
  .chead__h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(3rem, 6vw, 6.25rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .chead__deck {
    font-size: clamp(1.125rem, 1.5vw, 1.3125rem);
    line-height: 1.55;
    color: var(--body);
    max-width: 52ch;
    text-wrap: pretty;
  }
  .chead__facts {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    border-top: 1px solid var(--ink);
  }
  .chead__facts dt {
    padding: 12px 20px 12px 0;
    border-bottom: 1px solid rgba(31, 29, 43, 0.25);
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .chead__facts dd {
    padding: 12px 0;
    border-bottom: 1px solid rgba(31, 29, 43, 0.25);
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .chead__art {
    position: relative;
    padding: 18px 18px 34px;
  }
  .chead__frame {
    position: relative;
    display: block;
    transform: rotate(1.4deg);
    filter: drop-shadow(0 18px 26px rgba(31, 29, 43, 0.18));
  }
  .chead__paper {
    display: block;
    padding: 12px 12px 14px;
    background: var(--card);
    clip-path: var(--torn-frame);
  }
  .chead__img {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--card);
  }
  .chead__img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .chead__img--contain img {
    object-fit: contain;
    padding: 8%;
  }
  .chead__tape {
    top: -22px;
    left: 18%;
    width: 140px;
    rotate: -5deg;
  }
  .stamp {
    position: absolute;
    left: -4px;
    bottom: 0;
    width: clamp(104px, 10vw, 128px);
    height: clamp(104px, 10vw, 128px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    border: 2px solid var(--red);
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 5px var(--paper),
      inset 0 0 0 6px var(--red);
    background: var(--paper);
    color: var(--red);
    transform: rotate(-12deg);
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
  }
  .stamp__n {
    font-family: var(--serif);
    font-size: 2.5rem;
    line-height: 0.9;
    letter-spacing: 0;
  }

  .brief {
    padding: clamp(80px, 9vw, 140px) var(--gutter) 0;
  }
  .brief__inner {
    max-width: 67.5rem;
    margin: 0 auto;
  }
  .brief__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-bottom: 28px;
  }
  .brief__h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.25rem, 4vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .brief__hint {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .brief__stage {
    position: relative;
    perspective: 1800px;
  }
  .brief__tape {
    z-index: 2;
    top: -23px;
    left: 50%;
    width: 145px;
    margin-left: -72px;
    rotate: -2deg;
  }
  .flip {
    display: grid;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    transform-style: preserve-3d;
    transition: transform 1s var(--ease);
  }
  .flip[aria-pressed='true'] {
    transform: rotateY(180deg);
  }
  .flip__side {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 36px;
    min-height: clamp(280px, 26vw, 340px);
    padding: clamp(28px, 4vw, 56px);
    border-radius: 6px;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }
  .flip__front {
    background-color: var(--card);
    border: 1px solid rgba(31, 29, 43, 0.18);
    box-shadow: 0 18px 30px rgba(31, 29, 43, 0.12);
    background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 43px, rgba(59, 120, 190, 0.16) 43px, rgba(59, 120, 190, 0.16) 44px);
  }
  .flip__back {
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 18px 30px rgba(31, 29, 43, 0.2);
    transform: rotateY(180deg);
  }
  .flip__meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .flip__meta--back {
    color: var(--amber);
  }
  .flip__brief {
    font-family: var(--serif);
    font-size: clamp(1.875rem, 3.4vw, 3.125rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .flip__read {
    font-family: var(--serif);
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  .flip__cue {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--blue);
  }
  .flip__cue--back {
    color: var(--lav-2);
  }

  .chapters {
    padding: clamp(88px, 10vw, 150px) var(--gutter) 0;
  }
  .chapter {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 20px clamp(32px, 5vw, 96px);
    padding: clamp(36px, 4vw, 56px) 0;
    border-top: 1px solid var(--ink);
  }
  .chapter__side {
    min-width: 0;
  }
  .chapter__label {
    position: sticky;
    top: 100px;
    display: flex;
    align-items: baseline;
    gap: 18px;
  }
  .chapter__n {
    font-family: var(--serif);
    font-size: clamp(3.5rem, 6vw, 6rem);
    line-height: 0.8;
    color: var(--blue);
  }
  .chapter__h {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .chapter__body {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 42.5rem;
    min-width: 0;
  }
  .chapter__body p {
    font-size: 1.0625rem;
    line-height: 1.66;
    color: #3a3748;
    text-wrap: pretty;
  }
  .chapter__body p:first-child {
    font-size: clamp(1.1875rem, 1.5vw, 1.375rem);
    color: var(--ink);
  }
  @media (max-width: 699px) {
    .chapter__body {
      grid-column: auto;
    }
  }

  .score {
    margin-top: clamp(64px, 7vw, 110px);
    padding: clamp(64px, 7vw, 110px) var(--gutter);
    background: var(--ink);
    color: var(--paper);
  }
  .score__kicker {
    color: var(--lav-2);
  }
  .score__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }
  .score__stat {
    padding: clamp(28px, 3vw, 44px) clamp(0px, 2vw, 32px) clamp(28px, 3vw, 44px) 0;
    border-bottom: 1px solid rgba(248, 244, 236, 0.25);
  }
  .score__v {
    font-family: var(--serif);
    font-size: clamp(3.25rem, 5.4vw, 5.5rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
  }
  .score__l {
    margin-top: 14px;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--lav-2);
    max-width: 30ch;
  }
  .score__outcome {
    margin-top: clamp(44px, 5vw, 72px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 16px clamp(32px, 5vw, 96px);
  }
  .score__changed {
    font-family: var(--mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--amber);
  }
  .score__text {
    grid-column: span 2;
    font-family: var(--serif);
    font-size: clamp(1.75rem, 2.8vw, 2.625rem);
    line-height: 1.16;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  @media (max-width: 599px) {
    .score__text {
      grid-column: auto;
    }
  }

  .kit {
    padding: clamp(80px, 9vw, 140px) var(--gutter) 0;
  }
  .kit__grid {
    max-width: var(--max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 24px clamp(32px, 5vw, 96px);
  }
  .kit__h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.5rem, 4.4vw, 4.25rem);
    line-height: 0.96;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .kit__list {
    grid-column: span 2;
    border-top: 1px solid var(--ink);
  }
  @media (max-width: 699px) {
    .kit__list {
      grid-column: auto;
    }
  }
  .kit__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 4px 24px;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid rgba(31, 29, 43, 0.25);
  }
  .kit__name {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .kit__n {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--muted);
  }
  .kit__use {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--body);
  }

  .pn {
    padding: clamp(88px, 10vw, 150px) var(--gutter) clamp(72px, 8vw, 120px);
  }
  .pn__grid {
    max-width: var(--max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(24px, 3vw, 40px);
  }
  .pn__card {
    display: grid;
    grid-template-columns: clamp(96px, 11vw, 150px) minmax(0, 1fr);
    gap: clamp(18px, 2.4vw, 32px);
    align-items: center;
    padding: clamp(20px, 2.4vw, 32px);
    border: 1px solid var(--ink);
    border-radius: 6px;
    color: var(--ink);
    transition: background 0.3s;
  }
  .pn__card:hover {
    background: var(--card);
    color: var(--ink);
  }
  .pn__thumb {
    display: block;
    filter: drop-shadow(0 8px 12px rgba(31, 29, 43, 0.16));
  }
  .pn__paper {
    display: block;
    padding: 5px 5px 7px;
    background: var(--card);
    clip-path: var(--torn-thumb);
  }
  .pn__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  .pn__img--contain {
    object-fit: contain;
    padding: 8%;
  }
  .pn__text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .pn__label {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .pn__title {
    font-family: var(--serif);
    font-size: clamp(1.625rem, 2.2vw, 2.125rem);
    line-height: 1.04;
    text-wrap: balance;
  }

  .cta {
    padding: clamp(56px, 6vw, 96px) var(--gutter);
    background: var(--green);
    color: var(--paper);
  }
  .cta__row {
    max-width: var(--max);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 28px 48px;
  }
  .cta__h2 {
    max-width: 21ch;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.5rem, 5.4vw, 5.25rem);
    line-height: 0.96;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .cta__h2 em {
    color: var(--amber);
  }
</style>

<script>
  const flip = document.querySelector<HTMLButtonElement>('[data-flip]');
  flip?.addEventListener('click', () => {
    flip.setAttribute('aria-pressed', String(flip.getAttribute('aria-pressed') !== 'true'));
  });
</script>
