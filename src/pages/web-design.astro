    border: 0;
    background: none;
    padding: 0;
    text-align: left;
    font-family: inherit;
    transition: transform 0.25s ease;
  }

  .flip:hover {
    transform: rotate(0deg) translateY(-5px);
  }

  .flip__inner {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-height: 330px;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  .flip[aria-pressed='true'] .flip__inner {
    transform: rotateY(180deg);
  }

  .flip__front,
  .flip__back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    background: var(--wd-card);
    border: 2px solid var(--wd-ink);
    border-radius: 20px;
    padding: 26px;
    box-shadow: 5px 5px 0 var(--wd-ink);
    display: flex;
    flex-direction: column;
  }

  .flip__back {
    transform: rotateY(180deg);
  }

  .flip__title {
    margin-bottom: 10px;
    font-size: 22px;
    font-weight: 800;
  }

  .flip__copy {
    font-size: 16px;
    line-height: 1.55;
  }

  .flip__hint {
    margin-top: auto;
    font-family: var(--wd-hand);
    font-size: 21px;
    transform: rotate(-1deg);
  }

  .flip__backcopy {
    font-size: 15.5px;
    line-height: 1.55;
    font-weight: 500;
  }

  .flip__backhint {
    margin-top: auto;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ------------------------------------------------------------ ctaboxes -- */
  .disc {
    padding: 90px 24px 0;
  }

  .ctabox {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
    align-items: center;
    justify-content: space-between;
    border: 2px dashed var(--wd-ink);
    border-radius: 28px;
    background: var(--wd-card);
    padding: 44px 40px;
  }

  .ctabox--solid {
    border-style: solid;
    background: var(--wd-bright);
    box-shadow: 8px 8px 0 var(--wd-ink);
    padding: 56px 40px;
  }

  .ctabox__badge {
    position: absolute;
    top: -16px;
    right: 52px;
    background: var(--wd-butter);
    border: 1.5px solid var(--wd-ink);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 999px;
    transform: rotate(2deg);
  }

  .ctabox__text {
    max-width: 600px;
  }

  .ctabox__title {
    margin: 0 0 10px;
    font-size: clamp(28px, 3.6vw, 44px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .ctabox__body {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--wd-muted);
  }

  .midcta-wrap {
    padding: 0 24px;
  }

  .midcta {
    margin-bottom: 110px;
  }

  .midcta__star1 {
    top: -14px;
    left: 48px;
    font-size: 30px;
    color: var(--wd-coral);
    text-shadow: 1.5px 1.5px 0 var(--wd-ink);
    transform: rotate(-12deg);
  }

  .midcta__star2 {
    bottom: -12px;
    right: 64px;
    font-size: 24px;
    color: #D8400C;
    text-shadow: 1px 1px 0 var(--wd-ink);
    transform: rotate(15deg);
  }

  /* --------------------------------------------------------------- ladder -- */
  .ladder {
    position: relative;
    padding: 110px 24px;
    overflow: hidden;
  }

  .ladder__dot1 {
    top: 70px;
    right: 8%;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--wd-peach);
  }

  .ladder__dot2 {
    bottom: 120px;
    left: 5%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--wd-blue);
  }

  .ladder__sub {
    margin: 0 0 44px;
    font-size: 19px;
    max-width: 560px;
    line-height: 1.5;
  }

  .ladder__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }

  .rung {
    background: var(--wd-bright);
    border: 2.5px solid var(--wd-ink);
    border-radius: 22px;
    padding: 30px;
    box-shadow: 8px 8px 0 var(--rung, var(--wd-peach));
    transition:
      transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .rung:hover {
    transform: translate(-4px, -7px) rotate(-0.6deg);
    box-shadow: 14px 16px 0 var(--rung, var(--wd-peach));
  }

  .rung__num {
    margin: 0;
    font-size: 72px;
    font-weight: 800;
    line-height: 1;
  }

  .rung__title {
    margin: 14px 0 8px;
    font-size: 28px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .rung__body {
    margin: 0 0 14px;
    font-size: 16px;
    line-height: 1.55;
  }

  .rung__price {
    margin: 0;
    font-weight: 700;
    font-size: 17px;
  }

  .rung__scribble {
    margin: 8px 0 0;
    font-family: var(--wd-hand);
    font-size: 22px;
    color: var(--wd-bluelink);
    transform: rotate(-1.5deg);
  }

  .ladder__note {
    margin: 32px 0 0;
    font-size: 16px;
    max-width: 640px;
    line-height: 1.55;
  }

  /* ----------------------------------------------------------------- fork -- */
  .fork {
    background: var(--wd-blueband);
    border-top: 2px solid var(--wd-ink);
    border-bottom: 2px solid var(--wd-ink);
    padding: 110px 24px;
  }

  .fork__title {
    margin: 0 0 48px;
    font-size: clamp(36px, 5.6vw, 72px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    max-width: 900px;
    text-transform: uppercase;
    text-shadow: 3px 3px 0 var(--wd-card);
    text-wrap: balance;
  }

  .fork__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }

  .forkcard {
    background: var(--wd-card);
    border: 2px solid var(--wd-ink);
    border-radius: 24px;
    padding: 34px;
    transform: rotate(var(--tilt, 0deg));
    box-shadow: 6px 6px 0 var(--wd-ink);
    transition:
      transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .forkcard:hover {
    transform: rotate(0deg) translate(-4px, -6px);
    box-shadow: 12px 14px 0 var(--forkshadow, var(--wd-peach));
  }

  .forkcard__chip {
    display: inline-block;
    border: 1.5px solid var(--wd-ink);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 7px 14px;
    border-radius: 999px;
    margin: 0 0 18px;
  }

  .forkcard__title {
    margin: 0 0 12px;
    font-size: 30px;
    font-weight: 800;
    line-height: 1.05;
  }

  .forkcard__body {
    margin: 0 0 14px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--wd-muted);
  }

  .forkcard__price {
    margin: 4px 0 0;
    font-size: 22px;
    font-weight: 800;
  }

  .fork__note {
    margin: 36px auto 0;
    max-width: 760px;
    font-size: 18px;
    line-height: 1.55;
    text-align: center;
    font-weight: 600;
  }

  /* -------------------------------------------------------------- pricing -- */
  .pricing {
    background: var(--wd-ink-deep);
    color: var(--wd-paper);
    padding: 110px 24px;
  }

  .pricing .scribble {
    color: var(--wd-yellow);
  }

  .pricing__sub a {
    color: var(--wd-yellow);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pricing__label {
    color: var(--wd-faint);
  }

  .pricing__sub {
    margin: 0 0 26px;
    font-size: 19px;
    max-width: 620px;
    line-height: 1.5;
  }

  .pricing__label {
    margin: 34px 0 14px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--wd-faint, #A89F8D);
  }

  .pricing__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .pricerow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 18px 20px;
    background: var(--wd-bright);
    border: 2px solid var(--wd-ink);
    border-radius: 16px;
  }

  .pricerow__name {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.012em;
  }

  .pricerow__tag {
    margin-left: 8px;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--wd-butter);
    border: 1.5px solid var(--wd-ink);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    vertical-align: 2px;
  }

  .pricerow__sub {
    display: block;
    margin-top: 5px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--wd-muted);
  }

  .pricerow__price {
    flex: none;
    font-size: clamp(19px, 2vw, 24px);
    font-weight: 800;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .pricing__cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }

  .pricing__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 12px 20px;
    border: 2px solid var(--wd-ink);
    border-radius: 999px;
    background: var(--wd-butter);
    font-weight: 800;
    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .pricing__link:hover,
  .pricing__link:focus-visible {
    transform: translateY(-2px);
    background: var(--wd-peach);
  }

  @media (max-width: 760px) {
    .pricing__list {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Stacked, the price wants its own line rather than a squeezed column. */
    .pricerow {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }

  /* ----------------------------------------------------------------- work -- */
  .work {
    background: var(--wd-paper);
    border-top: 2px solid var(--wd-ink);
    border-bottom: 2px solid var(--wd-ink);
    padding: 110px 24px;
  }

  .work__title {
    margin: 0 0 48px;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: uppercase;
    text-shadow: 3px 3px 0 var(--wd-card);
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 430px), 1fr));
    gap: 30px;
  }

  .workpiece {
    position: relative;
    background: var(--wd-card);
    border: 2px solid var(--wd-ink);
    border-radius: 22px;
    padding: 18px 18px 26px;
    transform: rotate(var(--tilt, 0deg));
    display: flex;
    flex-direction: column;
    box-shadow: 6px 6px 0 var(--wd-ink);
    transition: transform 0.25s ease;
  }

  .workpiece:hover {
    transform: rotate(0deg) translateY(-4px);
  }

  .workpiece__tape {
    position: absolute;
    top: -13px;
    left: 34px;
    min-width: 92px;
    height: 28px;
    padding: 0 12px;
    border: 1.5px solid var(--wd-ink);
    transform: rotate(-4deg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--wd-hand);
    font-size: 19px;
    font-weight: 700;
    white-space: nowrap;
  }

  .workpiece__img {
    border-radius: 14px;
    overflow: hidden;
    background: #DDD6C7;
    border: 1.5px solid var(--wd-ink);
    height: 290px;
  }

  .workpiece__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .workpiece__name {
    margin: 20px 0 2px;
    font-size: 26px;
    font-weight: 800;
  }

  .workpiece__tag {
    margin: 0 0 10px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--wd-faint);
  }

  .workpiece__blurb {
    margin: 0 0 12px;
    font-size: 16px;
    line-height: 1.55;
  }

  .workpiece__stat {
    margin: 0 0 16px;
    font-family: var(--wd-hand);
    font-size: 23px;
    color: var(--wd-bluelink);
  }

  .workpiece__link {
    margin-top: auto;
    align-self: flex-start;
    font-weight: 700;
    font-size: 16px;
    color: var(--wd-ink);
    border-bottom: 3px solid var(--wd-gold);
  }

  .workpiece__link:hover,
  .workpiece__link:focus-visible {
    color: var(--wd-ink);
    border-bottom-color: var(--wd-bluelink);
  }

  .work__note {
    margin: 40px 0 0;
    font-size: 16px;
    max-width: 640px;
    line-height: 1.6;
    font-weight: 500;
  }

  /* -------------------------------------------------------------- awkward -- */
  .awkward {
    position: relative;
    padding: 110px 24px;
    overflow: hidden;
  }

  .awkward__dot1 {
    top: 90px;
    right: 10%;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--wd-butter);
  }

  .awkward__dot2 {
    bottom: 100px;
    left: 7%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--wd-peach);
  }

  .awkward__inner {
    position: relative;
    max-width: 900px;
    margin-inline: auto;
  }

  .awkward__title {
    margin: 0 0 28px;
    font-family: var(--wd-hand);
    font-size: clamp(44px, 7vw, 84px);
    font-weight: 700;
    line-height: 1;
    color: var(--wd-scribble);
    transform: rotate(-1.2deg);
  }

  .awkward__inner > p {
    margin: 0 0 18px;
    font-size: 20px;
    line-height: 1.6;
    color: #3A3327;
  }

  .awkward__punch {
    display: inline-block;
    background: var(--wd-butter);
    border: 2px solid var(--wd-ink);
    color: var(--wd-ink) !important;
    font-size: clamp(20px, 2.6vw, 28px) !important;
    font-weight: 800;
    line-height: 1.35 !important;
    padding: 16px 24px;
    border-radius: 14px;
    transform: rotate(-0.8deg);
    box-shadow: 5px 5px 0 var(--wd-ink);
    margin-top: 10px !important;
  }

  /* ------------------------------------------------------------ ownership -- */
  .own {
    background: var(--wd-blueband);
    border-top: 2px solid var(--wd-ink);
    border-bottom: 2px solid var(--wd-ink);
    padding: 96px 24px;
  }

  .own__title {
    margin: 0 0 44px;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: uppercase;
    text-shadow: 3px 3px 0 var(--wd-card);
  }

  .own__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }

  .owncard {
    background: var(--wd-card);
    border: 2px solid var(--wd-ink);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 5px 5px 0 var(--wd-ink);
  }

  .owncard h3 {
    margin: 0 0 8px;
    font-size: 22px;
    font-weight: 800;
  }

  .owncard p {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
  }

  /* ------------------------------------------------------------------ faq -- */
  .faq {
    padding: 110px 24px;
  }

  .faq__inner {
    max-width: 820px;
    margin-inline: auto;
  }

  .faq__list {
    border-top: 2px solid var(--wd-ink);
    margin-top: 40px;
  }

  .faq__item {
    border-bottom: 2px solid var(--wd-ink);
  }

  .faq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 4px;
    font-size: 19px;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    flex: none;
    font-size: 26px;
    font-weight: 500;
    color: var(--wd-scribble);
    transition: transform 0.25s ease;
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
  }

  .faq__a {
    padding: 0 4px 22px;
    font-size: 16.5px;
    line-height: 1.65;
    max-width: 700px;
    white-space: pre-line;
  }

  /* ---------------------------------------------------------------- start -- */
  .start {
    background: var(--wd-coral-deep);
    color: var(--wd-card);
    border-top: 2px solid var(--wd-ink);
    padding: 110px 24px 100px;
  }

  .start .scribble {
    color: var(--wd-yellow);
  }

  .start__inner {
    max-width: 1080px;
    margin-inline: auto;
  }

  .start__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 48px;
    align-items: start;
  }

  .start__title {
    margin: 0 0 20px;
    font-size: clamp(44px, 6.5vw, 88px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .start__lede {
    margin: 0 0 12px;
    font-size: 19px;
    line-height: 1.55;
    font-weight: 500;
    max-width: 440px;
  }

  .start__scribble {
    font-size: 26px;
    transform: rotate(-1deg);
    margin-bottom: 14px;
  }

  .start__routes {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 400px;
  }

  .startroute {
    display: flex;
    align-items: center;
    gap: 16px;
    background: var(--wd-bright);
    border: 2px solid var(--wd-ink);
    border-radius: 16px;
    padding: 16px 20px;
    color: var(--wd-ink);
    box-shadow: 4px 4px 0 var(--wd-ink);
    transform: rotate(var(--tilt, 0deg));
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .startroute:hover,
  .startroute:focus-visible {
    transform: rotate(0deg) translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--wd-ink);
    background: var(--wd-card);
    color: var(--wd-ink);
  }

  .startroute__icon {
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 2px solid var(--wd-ink);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .startroute__text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .startroute__label {
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--wd-faint);
  }

  .startroute__value {
    font-size: 17px;
    font-weight: 800;
  }

  .start__real {
    margin: 2px 0 0;
    font-size: 13.5px;
    color: var(--wd-muted);
    line-height: 1.5;
  }

  .startform {
    background: var(--wd-bright);
    border: 2.5px solid var(--wd-ink);
    border-radius: 24px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    box-shadow: 10px 10px 0 var(--wd-ink);
  }

  .startform__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .startform__field input,
  .startform__field select,
  .startform__field textarea {
    border: 2px solid var(--wd-ink);
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 16px;
    font-family: var(--wd-font);
    font-weight: 400;
    letter-spacing: normal;
    text-transform: none;
    background: #fff;
    color: var(--wd-ink);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .startform__field textarea {
    resize: vertical;
  }

  .startform__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .startform__submit {
    margin-top: 4px;
    border-radius: 999px;
    cursor: pointer;
    font-family: inherit;
  }

  .startform__status:empty {
    display: none;
  }

  .startform__status {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    font-weight: 600;
  }

  .startform__status[data-state='error'] {
    color: var(--wd-coral-deep);
  }

  .startform__note {
    margin: 0;
    font-size: 13px;
    color: #6E675C;
    line-height: 1.5;
    font-weight: 400;
    letter-spacing: normal;
    text-transform: none;
  }

  /* --------------------------------------------------------------- footer -- */
  .wdfoot {
    background: var(--wd-ink);
    color: #A89F8D;
    padding: 40px 24px;
  }

  .wdfoot__inner {
    max-width: 1180px;
    margin-inline: auto;
