    </section>

    {/* --------------------------------------------------- the awkward one -- */}
    <section class="awkward">
      <div class="awkward__inner">
        <h2 class="awkward__title" data-wd-reveal="tilt">“Couldn’t I just use AI for this?”</h2>
        <p data-wd-reveal="up">
