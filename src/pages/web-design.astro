---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import WebDesignNav from '../components/WebDesignNav.astro';
import { CONTACT, FORM_ENDPOINT } from '../config';
import { SUMMARY_EXTRAS, SUMMARY_TIERS } from '../data/web-design';
import shotII from '../assets/webdesign/intelligent-investing.jpg';
import shotDTC from '../assets/webdesign/dtc-newsletter.jpg';
import shotKatty from '../assets/webdesign/kattyco.jpg';
import shotSLP from '../assets/webdesign/east-van-slp.jpg';
import laptopFrame from '../assets/webdesign/hero-laptop-frame.png';
import iconSells from '../assets/webdesign/icon-sells.png';
import iconBuild from '../assets/webdesign/icon-build.png';
import iconAnalytics from '../assets/webdesign/icon-analytics.png';
import iconCare from '../assets/webdesign/icon-care.png';

/**
 * The web design service page — deliberately nothing like the rest of the
 * site. Its own palette (cool paper, coral and yellow; v13 dropped the peach
 * and powder blue the earlier version used), its own faces (Archivo, wide and
 * italic, + Caveat + IBM Plex Mono), its own nav and footer.
 * That difference is the point: it separates the offer from the lifecycle
 * consulting brand while still living on the same domain for the traffic.
 * Don't restyle it to match global.css — see the note there.
 *
 * The page opts out of the site chrome via BaseLayout's `standalone` flag and
 * carries everything itself. Only Analytics and the consent banner come from
 * the shared layout, because GA runs site-wide.
 *
 * One deliberate departure from the design export: its "Start a project" form
 * assembled a mailto: link. Here it POSTs to Formspree like every other form
 * on the site, so it works from devices with no mail client configured — and
 * the small line under the button says so instead of promising an email
 * window.
 */

const phoneHref = `tel:${CONTACT.phone.replace(/[^+\d]/g, '')}`;

const WHO = [
  {
    title: 'Local small businesses',
    bg: '#FCFBF7',
    tilt: '-1deg',
    front: 'Clinics, trades, restaurants, salons, studios. The site is ten years old, or doesn’t exist.',
    back: '46% of Google searches are looking for something local, and most people check a business online before calling. If the site is broken or missing, they call the next one on the list. A current site with accurate hours, services and a working form quietly wins you the customers your competitors lose.',
  },
  {
    title: 'Independent professionals',
    bg: '#F5D44A',
    tilt: '1deg',
    front: 'Consultants, therapists, coaches, designers. One credible page that isn’t LinkedIn.',
    back: 'Referrals still get googled. When a warm lead looks you up and finds only a LinkedIn profile, some of that trust leaks away. One well-written page (who you help, how it works, how to book) turns “I’ve heard of them” into “I’ve booked a call.”',
  },
  {
    title: 'Companies & startups',
    bg: '#FCFBF7',
    tilt: '-1deg',
    front: 'Real CMS, conversion tracking, structured content. Quoted properly, not priced off a menu.',
    back: 'Your website is usually the first thing an investor, partner or serious buyer checks, often before they reply to the email. A site with structure, tracking and content that answers their questions does diligence for you while you sleep.',
  },
  {
    title: 'Agencies',
    bg: '#FCFBF7',
    tilt: '1deg',
    front: 'White-label builds. You bring the design, I build it fast and quietly.',
    back: 'Overflow happens. When your dev bench is full, I build to your designs, in your client’s stack, under your name: clean handoff, no client contact unless you want it. You keep the margin and the relationship.',
  },
] as const;

const WORKS = [
  {
    name: 'Intelligent Investing',
    tag: 'Fintech platform · Webflow',
    tapeText: 'fintech',
    tape: '#F5D44A',
    tilt: '-1.2deg',
    img: shotII,
    blurb:
      'Five product websites rebuilt in Webflow for a publicly traded fintech, with SEO and tracking built into the structure, not added afterwards.',
    stat: 'qualified organic traffic doubled in 90 days',
    href: 'https://www.intelligentinvesting.ai/',
    link: 'intelligentinvesting.ai',
  },
  {
    name: 'DTC Newsletter',
    tag: 'Daily publication · Webflow CMS',
    tapeText: 'media',
    tape: '#E5DFD0',
    tilt: '1.1deg',
    img: shotDTC,
    blurb:
      'Three rebuilds of a five-times-a-week media brand, treated as a conversion system rather than a place to put articles.',
    stat: 'bounce rate 70% → 38% · organic signups +27%',
    href: 'https://www.directtoconsumer.co/',
    link: 'directtoconsumer.co',
  },
  {
    name: 'Katty & Co',
    tag: 'Pet care, Vancouver · hand-built',
    tapeText: 'local biz',
    tape: '#F5D44A',
    tilt: '1.3deg',
    img: shotKatty,
    blurb:
      'A small local business with real personality, built to take bookings directly: every route leads to a free meet and greet.',
    stat: 'mobile-first, fast, no platform subscription',
    href: 'https://kattyco.ca/',
    link: 'kattyco.ca',
  },
  {
    name: 'East Van SLP',
    tag: 'Speech-language pathology · hand-built, 5 pages',
    tapeText: 'clinic',
    tape: '#E5DFD0',
    tilt: '-1.1deg',
    img: shotSLP,
    blurb:
      'A twenty-year private practice given a site that explains the work clearly to worried parents: seven service areas, structured.',
    stat: 'hosted free: the $0/month option, live',
    href: 'https://east-van-slp.github.io/',
    link: 'east-van-slp.github.io',
  },
] as const;

const FAQS = [
  {
    q: 'How much does a website cost?',
    a: 'It depends on two things: how much site you need, and whether you want to edit it yourself. A single page starts at $305. A five-to-seven page site for a local business is $2,470. An online store is $4,015. Bigger company sites start at $8,240 and get properly quoted. On the three smaller sites, a platform build you can edit yourself is $100 more.\nIf none of that quite describes you, tell me what you’re trying to do and I’ll happily tell you what it should cost.',
  },
  {
    q: 'Why is the hand-built option so much cheaper?',
    a: 'There’s no platform behind it. No Squarespace or Webflow subscription, no monthly fee for as long as the site exists. I write it by hand and host it free, so the only thing you ever pay for is the build itself.\nThe trade-off is you can’t log in and change it yourself. If that matters to you, and for a lot of people it does, a platform build is the better fit, and it costs more because it genuinely does more.',
  },
  {
    q: 'Can I edit it myself?',
    a: 'On the platform builds, absolutely. That’s a good part of what you’re paying extra for. I’ll walk you through it and record the session so you can watch it back when you inevitably forget a step. Everyone does.\nOn the hand-built ones, no. Changes come through me: $30 an hour with a one-hour minimum, or the $50/mo Care plan.',
  },
  {
    q: 'Do I own my website?',
    a: 'Yes. All of it, once the final payment’s in. Files, code, design, the lot. On the hand-built sites I’ll hand you the actual files, and what you do with them after that is entirely up to you.',
  },
  {
    q: 'Who owns my domain?',
    a: 'You do, always. It’s registered in your name and you’re the legal owner. If I’m looking after it, I keep it in my registrar account so renewals, DNS and the security certificate get handled without you thinking about it. That’s $50 a year, billed separately from the care plans. Want to take it over? A few days and it’s done, no fee, and I’m happy to help with the move.',
  },
  {
    q: 'How long does it take?',
    a: 'A single page is about a week, or three to five days if it’s straightforward. A local business site is around four weeks. A store is closer to five. Bigger builds run eight to ten weeks.\nThose are start-to-finish, not build time. The build itself is the quick part. The rest is the calls, the copy, the photos, the creative, and testing everything properly before it goes live. So a one-pager isn’t a month of building; it’s a few days of building inside a week of getting it right.\nNone of it is set in stone either. A simple job can land early, a complicated one takes longer, and I’ll give you a firm date once I’ve seen the scope. One thing that does move the clock: timelines start the day I have your content, not the day you sign.',
  },
  {
    q: 'Will I show up on Google?',
    a: 'Every site gets the technical groundwork: proper structure, tags, sitemap, submitted to Google the right way, and your Google Business Profile sorted if you’re a local business. That’s the part in my control.\nWhat I won’t do is promise a specific ranking. Anyone who does is guessing.',
  },
  {
    q: 'What happens once it launches?',
    a: 'I’ll record a full walkthrough so you’ve got it to refer back to, and for the first 30 days I’ll fix anything that isn’t working properly, free. After that: care plans from $50/mo, or pay-as-you-go changes at $30/hr on sites I host.',
  },
  {
    q: 'You’re one person. What if something happens to you?',
    a: 'Fair thing to wonder about. Your domain is registered in your name, so it stays yours no matter what. You own your files. Nothing about your site depends on me still being around. Any competent developer can pick it up, and I keep things documented and tidy specifically so they can.',
  },
] as const;

const NEEDS = [
  'A new website',
  'A rebuild of an existing site',
  'Fixes or improvements to my current site',
  'Ongoing management of a site I already have',
  'Not sure yet',
] as const;

const EDIT_OPTIONS = [
  'Yes, I’d want to edit it myself',
  'No, I’d rather someone else handled that',
  'Not sure. What’s the difference?',
] as const;

const BUDGETS = [
  'Under $500',
  '$500–1,500',
  '$1,500–3,000',
  '$3,000–6,000',
  '$6,000+',
  'I don’t know. Tell me what this should cost',
] as const;
---

<BaseLayout
  title="Web Design"
  description="A website that gets you paid. For small businesses and independent professionals: hand-built and hosted free forever, or on a platform you can edit yourself. Fixed prices, agreed before anything starts. Vancouver & the Lower Mainland."
  breadcrumbs={[{ label: 'Web Design', href: '/web-design/' }]}
  standalone
>
  <Fragment slot="head">
    {/* Caveat is self-hosted (see global.css) and preloaded, because the
        `cursive` fallback is 40% wider and flashed on every navigation. */}
    <link
      rel="preload"
      href="/fonts/caveat-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=IBM+Plex+Mono:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="wd">
    <div class="wd__grain" aria-hidden="true"></div>

    <WebDesignNav current="home" />

    {/* -------------------------------------------------------------- hero -- */}
    {/*
      v13 rebuilt this hero as a two-column grid: the headline on the left, a
      laptop showing the live work on the right. In the export a single piece
      of state drives the rotating word AND the screenshot, so the word, the
      caption link and the active dot always agree. That pairing is the whole
      idea, so the script below advances all four together rather than running
      two independent timers.
    */}
    <header class="hero" id="top">
      <div class="hero__grid">
        <div>
          <div class="hero__badges">
            <span class="hero__badge">Vancouver &amp; the Lower Mainland</span>
            <span class="hero__badge hero__badge--fill">One person, not an agency</span>
          </div>

          <h1 class="hero__h1">
            <span class="hero__line">A website that</span>
            <span class="hero__line">gets you</span>
            <span class="hero__line"
              ><span class="hero__word-wrap"
                ><span class="hero__word" data-wd-word>found.</span><svg
                  viewBox="0 0 220 24"
                  preserveAspectRatio="none"
                  aria-hidden="true"
                  class="hero__underline"
                  ><path
                    d="M6 15 C 32 8, 56 19, 86 13 S 140 7, 164 15 S 198 18, 214 11"
                    fill="none"
                    stroke="#EE4A11"
                    stroke-width="7"
                    stroke-linecap="round"
                    vector-effect="non-scaling-stroke"></path></svg
                ></span
              ></span
            >
          </h1>

          <p class="hero__lede">
            For small businesses and independent professionals. Twelve years building sites inside
            companies (fintech, ecommerce, agency), now available directly.
          </p>

          <div class="hero__ctas">
            <span class="hero__scribble">hand-built or any platform, your call</span>
            <div class="hero__buttons">
              <a class="hero__btn hero__btn--solid" href="#start">Start a project ↗</a>
              <a class="hero__btn hero__btn--outline" href="#work">See the work</a>
            </div>
          </div>
        </div>

        <div>
          <div class="hero__device">
            <div class="hero__screen">
              {
                WORKS.map((work, i) => (
                  <Image
                    class:list={['hero__shot', i === 0 && 'is-on']}
                    src={work.img}
                    alt={`${work.name} · live site`}
                    widths={[560, 900]}
                    sizes="(max-width: 980px) 92vw, 46vw"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    data-wd-shot={i}
                  />
                ))
              }
            </div>
            <Image
              class="hero__frame"
              src={laptopFrame}
              alt=""
              widths={[760, 1280]}
              sizes="(max-width: 980px) 96vw, 48vw"
              loading="eager"
            />
            {/*
              The export pins this badge at a canvas pixel (`left: 1091px`),
              which only holds at the width it was drawn on. Anchoring it to
              the laptop's own top-right keeps it where the design puts it at
              every width.
            */}
            <span class="hero__stamp">Real sites. Live now.</span>
          </div>

          <div class="hero__shotbar">
            <span class="hero__shotlink">
              <a href={WORKS[0].href} target="_blank" rel="noopener" data-wd-shotlink
                >{WORKS[0].link} ↗</a
              >
            </span>
            <span class="hero__dots">
              {
                WORKS.map((work, i) => (
                  <button
                    type="button"
                    class:list={['hero__dot', i === 0 && 'is-on']}
                    data-wd-dot={i}
                    data-wd-href={work.href}
                    data-wd-link={work.link}
                    aria-label={`Show ${work.name}`}
                  >
                    <span aria-hidden="true" />
                  </button>
                ))
              }
            </span>
            <span class="hero__shotsp"></span>
          </div>
        </div>
      </div>

      <div class="hero__marquee" aria-hidden="true">
        <div class="hero__mq">
          {
            [0, 1, 2, 3].map(() => (
              <div class="hero__mqi">
                <span>Hand-coded &amp; hosted free, forever</span>
                <span class="hero__ast">✳</span>
                <span>Webflow</span>
                <span class="hero__ast">✳</span>
                <span>Shopify</span>
                <span class="hero__ast">✳</span>
                <span>WordPress</span>
                <span class="hero__ast">✳</span>
                <span>Squarespace</span>
                <span class="hero__ast">✳</span>
                <span>Framer</span>
                <span class="hero__ast">✳</span>
              </div>
            ))
          }
        </div>
      </div>
    </header>

    {/* ---------------------------------------------------- what you get -- */}
    <section class="keep">
      <div class="wd__inner">
        {/* The export pairs this heading with an animated mark on the right.
            GIFs live in public/ so Astro's image service leaves them animated. */}
        <div class="keep__head">
          <div>
            <p class="scribble" data-wd-reveal="up">what you get</p>
            <h2 class="wd__h2" data-wd-reveal="up">
              Everything a site needs to <em>earn its keep.</em>
            </h2>
          </div>
          <img class="keep__gif" src="/webdesign/keep.gif" alt="" width="280" height="280" loading="lazy" />
        </div>

        <div class="keep__grid" data-wd-stagger="up">
          <div class="keep__card">
            <Image class="keep__icon" src={iconSells} alt="" width={48} height={48} loading="lazy" />
            <h3 class="keep__title">Design that sells</h3>
            <p class="keep__body">
              No templates, no page-builder soup. A site designed around your customers and what
              they need to see before they reach for their wallet.
            </p>
          </div>
          <div class="keep__card">
            <Image class="keep__icon" src={iconBuild} alt="" width={48} height={48} loading="lazy" />
            <h3 class="keep__title">Build: hand-coded or any platform</h3>
            <p class="keep__body">
              Fast, accessible, and easy to edit. You pick the stack; I make sure it loads instantly
              and never breaks on a phone.
            </p>
          </div>
          <div class="keep__card">
            <Image class="keep__icon" src={iconAnalytics} alt="" width={48} height={48} loading="lazy" />
            <h3 class="keep__title">SEO &amp; analytics wired in</h3>
            <p class="keep__body">
              People have to find you before they can pay you. Local search setup, clean metadata,
              and analytics you can actually read.
            </p>
          </div>
          <div class="keep__card">
            <Image class="keep__icon" src={iconCare} alt="" width={48} height={48} loading="lazy" />
            <h3 class="keep__title">Care after launch</h3>
            <p class="keep__body">
              Updates, tweaks, and honest advice from the person who built it, not a support ticket
              queue.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------- who it's for -- */}
    <section class="who">
      <div class="wd__inner">
        <p class="scribble" data-wd-reveal="up">who it's for</p>
        <h2 class="who__title" data-wd-reveal="up">
          For people with better things to do <em>than fiddle with a website.</em>
        </h2>
        <div class="who__grid" data-wd-stagger="pop">
          {
            WHO.map((card, i) => (
              <button
                type="button"
                class="flip"
                style={`--tilt:${card.tilt}`}
                aria-pressed="false"
                data-wd-flip={i}
              >
                <span class="flip__inner">
                  <span class="flip__front" style={`background:${card.bg}`}>
                    <span class="flip__ast" aria-hidden="true">
                      ✳
                    </span>
                    <span class="flip__title">{card.title}</span>
                    <span class="flip__copy">{card.front}</span>
                    <span class="flip__hint">tap to flip: why bother? ↻</span>
                  </span>
                  <span class="flip__back" style={`background:${card.bg}`}>
                    <span class="flip__backcopy">{card.back}</span>
                    <span class="flip__backhint">↻ flip back</span>
                  </span>
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------------------------------------------------------- process -- */}
    <section class="steps" id="process">
      <div class="wd__inner">
        <p class="scribble" data-wd-reveal="up">how it works</p>
        <h2 class="wd__h2" data-wd-reveal="up">Three steps. <em>No mystery.</em></h2>

        {/*
          Step one is drawn as a raised card with a coral number and title, the
          other two sit quietly behind a rule. That is the export's default
          state, not a hover — the eye is meant to land on "a real conversation".
        */}
        <ol class="steps__list" data-wd-stagger="up">
          <li class="steps__row steps__row--live">
            <span class="steps__num" aria-hidden="true">1</span>
            <div class="steps__inner">
              <h3 class="steps__title">A real conversation</h3>
              <p class="steps__body">
                Thirty minutes about your business, your customers, and what “working” means for the
                site. No jargon.
              </p>
            </div>
          </li>
          <li class="steps__row">
            <span class="steps__num" aria-hidden="true">2</span>
            <div class="steps__inner">
              <h3 class="steps__title">Design in the open</h3>
              <p class="steps__body">
                You see the design early and often. Feedback is a conversation, not a form.
              </p>
            </div>
          </li>
          <li class="steps__row">
            <span class="steps__num" aria-hidden="true">3</span>
            <div class="steps__inner">
              <h3 class="steps__title">Launch &amp; handover</h3>
              <p class="steps__body">
                Live, fast, and yours. You get the keys, a walkthrough, and someone to call after.
              </p>
            </div>
          </li>
        </ol>

        <p class="steps__more" data-wd-reveal="up">
          That’s the short version. The <a href="/web-design/process/">full process page</a> lays out
          all ten steps, both approval gates, and exactly what I need from you and when.
        </p>
      </div>
    </section>

    {/* --------------------------------------------------- discovery call -- */}
    <section class="disc">
      <div class="wd__inner ctabox" data-wd-reveal="pop">
        <div class="ctabox__badge" aria-hidden="true">Free · no commitment</div>
        <div class="ctabox__text">
          <p class="scribble scribble--coral">not ready to start anything?</p>
          <h2 class="ctabox__title">A 30-minute discovery call</h2>
          <p class="ctabox__body">
            Bring your questions: about your current site, what a build would cost, whether you
            even need one. You’ll leave with a straight answer either way. No deck, no follow-up
            sequence, no obligation.
          </p>
        </div>
        {/* No sparkles: the export has none anywhere, they came from the
            previous design along with the nav dots. */}
        <a
          class="wdbtn wdbtn--ink"
          href={`mailto:${CONTACT.email}?subject=Discovery call — 30 minutes&body=Hi Miguel — I'd like to book a free 30-minute discovery call.%0A%0AMy business: %0AA few times that work for me: `}
          >Book a free call ↗</a
        >
      </div>
    </section>

    {/* ------------------------------------------------------------ pricing -- */}
    <section class="pricing" id="pricing">
      <div class="wd__inner">
        <p class="scribble" data-wd-reveal="up">plain pricing</p>
        <h2 class="wd__h2" data-wd-reveal="up">
          Fixed prices, <em>agreed before anything starts.</em>
        </h2>
        <p class="pricing__sub" data-wd-reveal="up">
          <strong>Founding-client rates for the first five projects,</strong> in exchange for a
          testimonial and permission to feature the work. The three smaller sites show the
          hand-built rate; a platform build you can edit yourself is $100 more. Everything
          included, the scheduled standard rates, care plans and extras live on the
          <a href="/web-design/pricing/">pricing page</a>.
        </p>

        <p class="pricing__label" data-wd-reveal="up">Websites</p>
        <div class="pricing__list" data-wd-stagger="up">
          {
            SUMMARY_TIERS.map((tier) => (
              <div class="pricerow">
                <div>
                  <h4 class="pricerow__name">
                    {tier.name}
                    {'tag' in tier ? <span class="pricerow__tag">{tier.tag}</span> : null}
                  </h4>
                  <span class="pricerow__sub">{tier.sub}</span>
                </div>
                <strong class="pricerow__price">{tier.price}</strong>
              </div>
            ))
          }
        </div>

        <p class="pricing__label" data-wd-reveal="up">Also available</p>
        <div class="pricing__list pricing__list--two" data-wd-stagger="up">
          {
            SUMMARY_EXTRAS.map((extra) => (
              <div class="pricerow">
                <div>
                  <h4 class="pricerow__name">{extra.name}</h4>
                  <span class="pricerow__sub">{extra.sub}</span>
                </div>
                <strong class="pricerow__price">{extra.price}</strong>
              </div>
            ))
          }
        </div>

        <div class="pricing__cta" data-wd-reveal="up">
          <a class="pricing__link" href="/web-design/pricing/">The full pricing breakdown ↗</a>
          <span class="scribble">
            every number public, including how it compares to other Vancouver studios
          </span>
        </div>
      </div>
    </section>

    {/* --------------------------------------------------------------- work -- */}
    <section class="work" id="work">
      <div class="wd__inner">
        <p class="scribble" data-wd-reveal="up">the proof</p>
        <h2 class="work__title" data-wd-reveal="up">The <em>work.</em></h2>
        {/*
          A full-bleed screenshot band over a padded body, tag above the name.
          The taped-photo look and the tilt were the previous design's.
        */}
        <div class="work__grid" data-wd-stagger="up">
          {
            WORKS.map((work) => (
              <article class="workpiece">
                <div class="workpiece__img">
                  <Image
                    src={work.img}
                    alt={`${work.name} website`}
                    widths={[600, 900]}
                    sizes="(max-width: 900px) 92vw, 44vw"
                    loading="lazy"
                  />
                </div>
                <div class="workpiece__body">
                  <p class="workpiece__tag">{work.tag}</p>
                  <h3 class="workpiece__name">{work.name}</h3>
                  <p class="workpiece__blurb">{work.blurb}</p>
