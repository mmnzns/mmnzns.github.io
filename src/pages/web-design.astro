    text-shadow: 1px 1px 0 var(--wd-ink);
    animation-delay: 2.25s;
  }

  .star--coral {
    color: var(--wd-coral);
  }

  @keyframes wd-wiggle {
    0%,
    82%,
    100% {
      transform: rotate(0deg) scale(1);
      box-shadow: 4px 4px 0 var(--wd-ink);
    }

    84% {
      transform: rotate(-2.5deg) scale(1.04);
    }

    87% {
      transform: rotate(2deg) scale(1.05);
      box-shadow: 6px 6px 0 var(--wd-ink);
    }

    90% {
      transform: rotate(-1.5deg) scale(1.04);
    }

    93% {
      transform: rotate(1deg) scale(1.03);
    }

    96% {
      transform: rotate(0deg) scale(1);
      box-shadow: 4px 4px 0 var(--wd-ink);
    }
  }

  @keyframes wd-star {
    0%,
    80%,
    100% {
      opacity: 0;
      transform: scale(0) rotate(0deg);
    }

    86% {
      opacity: 1;
      transform: scale(1.15) rotate(40deg);
    }

    94% {
      opacity: 0;
      transform: scale(0.4) rotate(90deg);
    }
  }

  /* ---------------------------------------------------------------- hero -- */
  .hero {
    position: relative;
    padding: 96px 24px 0;
    overflow: hidden;
  }

  .hero__floatA,
  .hero__floatB {
    position: absolute;
