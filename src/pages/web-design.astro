                <span aria-hidden="true">↗</span>
              </a>
              <a class="startroute startroute--ghost" href={phoneHref}>
                <span>{CONTACT.phone} · call or text</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>

            <p class="start__scribble start__replies">usually replies within a day</p>
          </div>

          <form
            class="startform"
            action={FORM_ENDPOINT}
            method="POST"
            data-wd-reveal="pop"
            data-contact-form
          >
            {/* Routes web-design leads apart from consulting notes in the inbox. */}
            <input type="hidden" name="_subject" value="New website project" />
            <input type="hidden" name="service" value="web-design" />

            <label class="startform__field">
              Your name
              <input type="text" name="name" required placeholder="Jane from Jane's Clinic" autocomplete="name" />
            </label>

            <label class="startform__field">
              What do you need?
              <select name="need">
                {NEEDS.map((need) => <option>{need}</option>)}
              </select>
            </label>

            <label class="startform__field">
              What’s not working right now?
              <textarea
                name="problem"
                rows="4"
                required
                placeholder={'"People find us but nobody books." · "We\'re invisible on Google." · "Embarrassing on a phone."'}
              ></textarea>
            </label>

            <label class="startform__field">
              Once it’s live, do you want to make changes yourself?
              <select name="edit_yourself">
                {EDIT_OPTIONS.map((option) => <option>{option}</option>)}
              </select>
            </label>

            <label class="startform__field">
              Budget range
              <select name="budget">
                {BUDGETS.map((budget) => <option>{budget}</option>)}
              </select>
            </label>

            {/* Formspree discards any submission that fills this in. */}
            <input
              type="text"
              name="_gotcha"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
              class="startform__honeypot"
            />

            <button type="submit" class="wdbtn wdbtn--ink startform__submit">Send it over ↗</button>

            <p class="startform__status" role="status" aria-live="polite" data-form-status></p>
            <p class="startform__note">
              Goes straight to my inbox — I read every one myself and reply within two business
              days.
            </p>
          </form>
        </div>
      </div>
    </section>

    {/* ------------------------------------------------------------- footer -- */}
    <footer class="wdfoot">
      <div class="wdfoot__inner">
        <span>
          <strong class="wdfoot__m">M.</strong> Sites that sell.
          <span class="wdfoot__sub">by Miguel Monzones</span>
        </span>
        <span>{CONTACT.entity}</span>
        <span class="wdfoot__links">
          <a href={CONTACT.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          {/* Not in the export, but the site sets analytics cookies and the
              banner has to stay reachable from every page. */}
          <a href="#cookie-settings" data-cookie-settings>Cookie settings</a>
          <a href="/">mnmonzones.com ↗</a>
        </span>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  /* ---------------------------------------------------------- word rotor -- */
  /* One index drives the headline word, the laptop screenshot, the caption
     link and the active dot, exactly as the export does — they are meant to
     change together, and two timers would drift apart. */
  const word = document.querySelector<HTMLElement>('[data-wd-word]');
  const shots = [...document.querySelectorAll<HTMLElement>('[data-wd-shot]')];
  const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-wd-dot]')];
  const shotLink = document.querySelector<HTMLAnchorElement>('[data-wd-shotlink]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const WORDS = ['found.', 'booked.', 'called.', 'paid.'];
  let index = 0; // the server-rendered state: "found." and the first shot

  const paint = (next: number, animateWord: boolean) => {
    index = ((next % WORDS.length) + WORDS.length) % WORDS.length;

    if (word) {
      word.textContent = WORDS[index];
      if (animateWord) {
        word.style.animation = 'none';
        // Restart the entrance animation by forcing a reflow between writes.
        void word.offsetWidth;
        word.style.animation = `${index % 2 === 0 ? 'wd-in-a' : 'wd-in-b'} .55s cubic-bezier(.2,.8,.2,1) both`;
      }
    }

    shots.forEach((shot, i) => shot.classList.toggle('is-on', i === index));
    dots.forEach((dot, i) => dot.classList.toggle('is-on', i === index));

    const active = dots[index];
    if (shotLink && active) {
      shotLink.href = active.dataset.wdHref ?? shotLink.href;
      shotLink.textContent = `${active.dataset.wdLink ?? ''} ↗`;
    }
  };

  // Clicking a dot picks that shot and stops the carousel advancing itself,
  // so the page doesn't move on while someone is reading what they chose.
  let timer = 0;
  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      window.clearInterval(timer);
      paint(i, !reduced);
    });
  });

  if (!reduced && (word || shots.length)) {
    timer = window.setInterval(() => paint(index + 1, true), 2400);
  }

  /* ----------------------------------------------------------- flip cards -- */
  for (const flip of document.querySelectorAll<HTMLButtonElement>('[data-wd-flip]')) {
    flip.addEventListener('click', () => {
      const pressed = flip.getAttribute('aria-pressed') === 'true';
      flip.setAttribute('aria-pressed', String(!pressed));
    });
  }

  /* -------------------------------------------------------------- reveals -- */
  // Same discipline as Motion.astro: starting states written here, never in
  // CSS, with a failsafe that shows everything if the observer goes quiet.
  const canObserve = typeof IntersectionObserver === 'function';

  if (!reduced && canObserve) {
    const initial: Record<string, string> = {
      up: 'translateY(30px)',
      pop: 'translateY(20px) scale(.94)',
      tilt: 'translateY(26px) rotate(-2.5deg)',
    };

    const pending = new Set<HTMLElement>();

    const prep = (el: HTMLElement, kind: string, delay: number) => {
      el.style.opacity = '0';
      el.style.transform = initial[kind] ?? initial.up;
      el.style.transition = `opacity .7s ease ${delay}ms, transform .8s cubic-bezier(.2,.8,.2,1) ${delay}ms`;
      pending.add(el);
    };

    const showEl = (el: HTMLElement) => {
      if (!pending.delete(el)) return;
      el.style.opacity = '1';
      el.style.transform = 'none';
    };

    const targets: HTMLElement[] = [];

    for (const el of document.querySelectorAll<HTMLElement>('[data-wd-reveal]')) {
      prep(el, el.dataset.wdReveal ?? 'up', 0);
      targets.push(el);
    }

    for (const parent of document.querySelectorAll<HTMLElement>('[data-wd-stagger]')) {
      const kind = parent.dataset.wdStagger ?? 'up';
      [...parent.children].forEach((child, i) => prep(child as HTMLElement, kind, i * 110));
      targets.push(parent);
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          if (el.hasAttribute('data-wd-stagger')) {
            [...el.children].forEach((child) => showEl(child as HTMLElement));
          } else {
            showEl(el);
          }
          io.unobserve(el);
        }
      },
      { threshold: 0.12 },
    );
    targets.forEach((el) => io.observe(el));

    const flush = () => {
      for (const el of [...pending]) {
        el.style.transition = '';
        showEl(el);
      }
    };
    window.setTimeout(flush, 2600);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && pending.size) flush();
    });
  }

  /* ----------------------------------------------------------------- form -- */
  // Same in-place submit as the site's other forms; a failure falls through
  // to Formspree's own page, so nothing is ever swallowed.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener('submit', async (event) => {
    if (!form.checkValidity()) return;
    event.preventDefault();

    const original = submit?.textContent ?? 'Send it over →';
    if (submit) {
      submit.disabled = true;
      submit.textContent = 'Sending…';
    }
    if (status) status.textContent = '';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(String(response.status));
      form.reset();
      if (status) {
        status.textContent = 'Got it — that’s with me. You’ll hear back within two business days.';
        status.dataset.state = 'ok';
      }
    } catch {
      if (status) {
        status.textContent = `That didn’t send. Email me directly at miguel@mnmonzones.com and I’ll pick it up.`;
        status.dataset.state = 'error';
      }
    } finally {
      if (submit) {
        submit.disabled = false;
        submit.textContent = original;
      }
    }
  });
</script>

<style>
  /* The page's own design system. Cream paper, ink, peach/blue/butter pastels,
     rounded everything — nothing shared with global.css on purpose. */
  .wd {
    /* v13 palette. The web design section was re-skinned in v13: Archivo
       replaces Bricolage Grotesque, the paper cools, and the peach/blue pair
       is gone entirely. `--wd-peach` and `--wd-blue*` are kept as aliases
       onto their v13 replacements so nothing referencing them renders an
       invalid colour, but new work should use the named tokens below. */
    --wd-paper: #f4f1ea;
    --wd-card: #fcfbf7;
    --wd-bright: #fcfbf7;
    --wd-ink: #171310;
    --wd-ink-deep: #14100c;
    --wd-ink-soft: #3a3327;
    --wd-muted: #6e675c;
    --wd-faint: #a89f8d;
    --wd-rule: #ddd6c7;
    --wd-rule-strong: #c9c2b2;
    --wd-yellow: #f5d44a;
    --wd-coral: #ee4a11;
    --wd-coral-deep: #d8400c;
    --wd-scribble: #d8400c;
    --wd-butter: #f5d44a;
    --wd-gold: #f5d44a;
    --wd-peach: #f5d44a;
    --wd-blue: #ddd6c7;
    --wd-blueband: #e5dfd0;
    /* The rest of v13's palette, by the role each colour plays in the export.
       Counted across all four Monzones-W files: body #3e3931 (x43), the dark
       card faces on the near-black bands (x25 between the three), light copy
       on those bands (x14), and the FAQ's closed-row rule (x3). */
    --wd-body: #3e3931;
    --wd-body-soft: #4a443b;
    --wd-card-dark: #241d13;
    --wd-card-darker: #201b14;
    --wd-card-warm: #2a2015;
    --wd-on-dark: #c7beac;
    --wd-on-dark-soft: #d5cdbb;
    --wd-rule-soft: #d9d2c2;
    --wd-bluelink: #d8400c;
    --wd-font: 'Archivo', 'Helvetica Neue', sans-serif;
    --wd-hand: 'Caveat', cursive;
    --wd-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

    font-family: var(--wd-font);
    background: var(--wd-paper);
    color: var(--wd-ink);
    min-width: 320px;
    overflow-x: clip;
  }

  /* Archivo is a variable font with a width axis, and v13 sets headings wide.
     This is a large part of why the section reads as its own brand. */
  .wd :global(h1),
  .wd :global(h2),
  .wd :global(h3),
  .wd :global(h4) {
    font-stretch: 125%;
  }

  .wd :global(a) {
    transition: color var(--dur-fast, 220ms) ease;
  }

  .wd__grain {
    position: fixed;
    inset: 0;
    z-index: 99;
    pointer-events: none;
    opacity: 0.06;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2'/></filter><rect width='160' height='160' filter='url(%23n)'/></svg>");
  }

  .wd__inner {
    max-width: 1180px;
    margin-inline: auto;
  }

  /* ------------------------------------- what you get / three steps (v13) -- */
  .keep,
  .steps {
    padding-block: clamp(48px, 6vw, 88px);
  }

  .keep__grid {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .keep__card {
    padding: 26px;
    border: 2px solid var(--wd-ink);
    border-radius: 20px;
    background: var(--wd-bright);
    box-shadow: 6px 6px 0 var(--wd-ink);
  }

  .keep__title {
    font-size: clamp(18px, 1.8vw, 21px);
    font-weight: 800;
    letter-spacing: -0.014em;
    line-height: 1.2;
  }

  .keep__body {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--wd-muted);
    text-wrap: pretty;
  }

  .steps__list {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .steps__row {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr);
    gap: 24px;
    align-items: center;
    padding-block: 26px;
    border-top: 1px solid #c9c2b2;
  }

  .steps__num {
    font-size: clamp(34px, 4vw, 54px);
    font-weight: 800;
    line-height: 1;
    color: var(--wd-peach);
  }

  .steps__more {
    margin-top: 26px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--wd-muted);
  }

  .steps__more a {
    color: var(--wd-bluelink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .steps__more a:hover,
  .steps__more a:focus-visible {
    color: var(--wd-coral-deep);
  }

  @media (max-width: 900px) {
    .keep__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .keep__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    /* The number gutter costs room a phone hasn't got. */
    .steps__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }

  .wd__h2 {
    margin: 0 0 8px;
    font-size: clamp(38px, 5vw, 68px);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 0.98;
    text-transform: uppercase;
  }

  /* Every heading accent in v13 is italic coral — all four W files agree, and
     it is the main reason the section reads as its own brand. The exception is
     the closing CTA, whose heading sits on the coral band and takes ink. */
  .wd__h2 em,
  .work__title em,
  .awkward__title em,
  .faq__title em {
    font-style: italic;
    color: var(--wd-coral);
  }

  .start__title em {
    font-style: italic;
    color: var(--wd-ink);
  }

  .scribble {
    margin: 0 0 12px;
    font-family: var(--wd-hand);
    font-size: 28px;
    font-weight: 600;
    color: var(--wd-ink);
  }

  .scribble--coral {
    color: var(--wd-scribble);
    font-size: 26px;
    transform: rotate(-1deg);
  }

  .deco {
    position: absolute;
    pointer-events: none;
  }

  /* ------------------------------------------------------------ buttons -- */
  .wdbtn {
    position: relative;
    display: inline-block;
    border: 2px solid var(--wd-ink);
    color: var(--wd-ink);
    font-weight: 800;
    font-size: 18px;
    padding: 14px 28px;
    border-radius: 999px;
    white-space: nowrap;
  }

  /* v13 runs one filled button everywhere: black, no border, no offset
     shadow, coral on hover. The yellow and blue variants, the offset shadow
     and the wiggle all belonged to the previous design. */
  .wdbtn--ink {
    background: var(--wd-ink);
    color: var(--wd-card);
    font-size: 17px;
    padding: 16px 30px;
  }

  .wdbtn--ink:hover,
  .wdbtn--ink:focus-visible {
    background: var(--wd-coral-deep);
    color: var(--wd-card);
    transform: translateY(-2px);
  }

  /* ---------------------------------------------------------------- hero -- */
  /* Every number here is the v13 export's. The float blobs, spinning asterisk
     and scattered dots that used to sit in this block were decoration from the
     previous design; v13 replaces them with the laptop and the marquee. */
  .hero {
    position: relative;
    padding: 96px 24px 0;
  }

  .hero__grid {
    position: relative;
    max-width: 1320px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr 1.02fr;
    gap: 48px 56px;
    align-items: center;
  }

  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 26px;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    white-space: nowrap;
    border: 1px solid var(--wd-ink);
    color: var(--wd-ink);
    font-weight: 700;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 8px 14px 7px;
    border-radius: 999px;
  }

  /* Filled in the export with no border of its own; the matching border-colour
     keeps it exactly the same size as the outlined one beside it. */
  .hero__badge--fill {
    background: var(--wd-yellow);
    border-color: var(--wd-yellow);
  }

  .hero__h1 {
    margin: 0;
    font-size: clamp(40px, 5.2vw, 84px);
    line-height: 0.94;
    font-weight: 900;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: var(--wd-ink);
  }

  .hero__line {
    display: block;
  }

  .hero__word-wrap {
    position: relative;
    display: inline-block;
    font-style: italic;
    color: var(--wd-coral);
  }

  .hero__word {
    display: inline-block;
  }

  @keyframes wd-in-a {
    from {
      opacity: 0;
      transform: translateY(0.5em) rotate(1.5deg);
    }

    to {
      opacity: 1;
      transform: translateY(0) rotate(0deg);
    }
  }

  @keyframes wd-in-b {
    from {
      opacity: 0;
      transform: translateY(0.5em) rotate(-1.5deg);
    }

    to {
      opacity: 1;
      transform: translateY(0) rotate(0deg);
    }
  }

  .hero__underline {
    position: absolute;
    left: 0;
    bottom: -0.12em;
    width: 100%;
    height: 0.18em;
    overflow: visible;
  }

  .hero__lede {
    margin: 26px 0 0;
    max-width: 520px;
    font-size: 18.5px;
    line-height: 1.6;
    color: var(--wd-muted);
  }

  .hero__ctas {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    margin-top: 30px;
  }

  .hero__scribble {
    font-family: var(--wd-hand);
    font-size: 24px;
    color: var(--wd-coral-deep);
    transform: rotate(-2deg);
  }

  .hero__buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    border-radius: 999px;
    text-decoration: none;
    font-size: 16.5px;
    transition:
      background 0.2s,
      color 0.2s,
      transform 0.2s;
  }

  .hero__btn--solid {
    background: var(--wd-ink);
    color: var(--wd-paper);
    font-weight: 800;
    padding: 18px 30px 17px;
  }

  .hero__btn--solid:hover,
  .hero__btn--solid:focus-visible {
    background: var(--wd-coral-deep);
    color: var(--wd-paper);
    transform: translateY(-2px);
  }

  .hero__btn--outline {
    border: 1.5px solid var(--wd-ink);
    color: var(--wd-ink);
    font-weight: 700;
    padding: 16.5px 26px 15.5px;
  }

  .hero__btn--outline:hover,
  .hero__btn--outline:focus-visible {
    background: var(--wd-ink);
    color: var(--wd-paper);
  }

  /* ---------------------------------------------------------- hero device -- */
  /* The percentages place the screenshot inside the laptop art, so they are
     tied to hero-laptop-frame.png and should only change with the image. */
  .hero__device {
    position: relative;
    width: 100%;
    aspect-ratio: 2560 / 1600;
  }

  .hero__screen {
    position: absolute;
    left: 14.6%;
    top: 3.9%;
    width: 68.75%;
    height: 63%;
    overflow: hidden;
    background: var(--wd-blueband);
  }

  .hero__shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  .hero__shot.is-on {
    opacity: 1;
  }

  .hero__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    z-index: 2;
  }

  .hero__stamp {
    position: absolute;
    z-index: 3;
    top: 4%;
    right: 0;
    background: var(--wd-yellow);
    border: 1px solid var(--wd-ink);
    box-shadow: 5px 5px 0 var(--wd-ink);
    color: var(--wd-ink);
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 8px 15px;
    border-radius: 999px;
    transform: rotate(3deg);
    white-space: nowrap;
  }

  .hero__shotbar {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 6px;
  }

  /* The spacer opposite the link is what centres the dots under the laptop
     while the caption stays hard against them. */
  .hero__shotlink {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    justify-content: flex-end;
  }

  .hero__shotlink a {
    white-space: nowrap;
    font-family: var(--wd-hand);
    font-size: 25px;
    line-height: 1.2;
    color: var(--wd-coral-deep);
    text-decoration: none;
    transform: rotate(-1deg);
  }

  .hero__shotlink a:hover,
  .hero__shotlink a:focus-visible {
    color: var(--wd-ink);
  }

  .hero__dots {
    flex: none;
    display: flex;
    gap: 2px;
  }

  .hero__dot {
    width: 26px;
    height: 26px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: none;
    background: none;
  }

  .hero__dot > span {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    border: 1px solid var(--wd-ink);
    background: transparent;
    transition: background 0.3s;
  }

  .hero__dot.is-on > span {
    background: var(--wd-coral);
  }

  .hero__shotsp {
    flex: 1 1 0;
  }

  /* -------------------------------------------------------------- marquee -- */
  .hero__marquee {
    margin-top: 80px;
    border-top: 1px solid var(--wd-ink);
    border-bottom: 1px solid var(--wd-ink);
    padding: 16px 0;
    overflow: hidden;
  }

  /* Four copies, translated by half the track, so the loop is seamless. */
  .hero__mq {
    display: flex;
    gap: 0;
    width: max-content;
    animation: wd-marquee 32s linear infinite;
  }

  @keyframes wd-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .hero__mqi {
    display: flex;
    align-items: center;
    gap: 36px;
    padding-right: 36px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--wd-muted);
    white-space: nowrap;
  }

  .hero__ast {
    color: var(--wd-coral);
  }


  /* ----------------------------------------------------------------- who -- */
  /* v13 runs this band near-black. Everything inside it inherits, so the
     card faces below set their own ink back explicitly. */
  .who {
    background: var(--wd-ink-deep);
    color: var(--wd-paper);
    padding: 100px 24px;
  }

  .who .scribble {
    color: var(--wd-yellow);
  }

  .who__title {
    margin: 0 0 48px;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    max-width: 820px;
    text-transform: uppercase;
    text-shadow: 3px 3px 0 var(--wd-card);
    text-wrap: balance;
  }

  .who__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .flip {
    perspective: 1000px;
    cursor: pointer;
    min-height: 320px;
    transform: rotate(var(--tilt, 0deg));
    border: 0;
    background: none;
    padding: 0;
    text-align: left;
    font-family: inherit;
    transition: transform 0.25s ease;
  }

  .flip:hover {
    transform: rotate(0deg) translateY(-5px);
  }

  .flip__inner {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-height: 320px;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.3, 0.7, 0.3, 1);
  }

  .flip[aria-pressed='true'] .flip__inner {
    transform: rotateY(180deg);
  }

  /* A hairline border, a small radius and a coral drop — the heavy ink border
     and ink shadow were the previous design's. Both faces take the card's own
     background, so a flip doesn't change colour underneath you. */
  .flip__front,
  .flip__back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    border: 1px solid var(--wd-ink);
    border-radius: 12px;
    padding: 26px;
    box-shadow: 6px 6px 0 var(--wd-coral);
    display: flex;
    flex-direction: column;
  }

  .flip__back {
    transform: rotateY(180deg);
    padding: 24px;
  }

  .flip__ast {
    font-size: 22px;
    line-height: 1;
    color: var(--wd-coral);
  }

  .flip__title {
    margin: 16px 0 10px;
    font-size: 20px;
    font-weight: 800;
    color: var(--wd-ink);
  }

  .flip__copy {
    font-size: 15px;
    line-height: 1.55;
    color: var(--wd-body-soft);
  }

  .flip__hint {
    margin-top: auto;
    font-family: var(--wd-hand);
    font-size: 20px;
    color: var(--wd-coral-deep);
    transform: rotate(-1deg);
  }

  .flip__backcopy {
    font-size: 14px;
    line-height: 1.55;
    font-weight: 500;
    color: var(--wd-ink);
  }

  .flip__backhint {
    margin-top: auto;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--wd-ink);
  }

  /* ------------------------------------------------------------ ctaboxes -- */
  .disc {
    padding: 90px 24px 0;
  }

  .ctabox {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 24px 48px;
    align-items: center;
    justify-content: space-between;
    border: 2px dashed var(--wd-ink);
    border-radius: 28px;
    background: var(--wd-card);
    padding: 44px 40px;
  }

  .ctabox--solid {
    border-style: solid;
    background: var(--wd-bright);
    box-shadow: 8px 8px 0 var(--wd-ink);
    padding: 56px 40px;
  }

  .ctabox__badge {
    position: absolute;
    top: -16px;
    right: 52px;
    background: var(--wd-butter);
    border: 1.5px solid var(--wd-ink);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 999px;
    transform: rotate(2deg);
  }

  .ctabox__text {
    max-width: 600px;
  }

  .ctabox__title {
    margin: 0 0 10px;
    font-size: clamp(28px, 3.6vw, 44px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .ctabox__body {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--wd-muted);
  }

  .midcta-wrap {
    padding: 0 24px;
  }

  .midcta {
    margin-bottom: 110px;
  }

  .midcta__star1 {
    top: -14px;
    left: 48px;
    font-size: 30px;
    color: var(--wd-coral);
    text-shadow: 1.5px 1.5px 0 var(--wd-ink);
    transform: rotate(-12deg);
  }

  .midcta__star2 {
    bottom: -12px;
    right: 64px;
    font-size: 24px;
    color: #D8400C;
    text-shadow: 1px 1px 0 var(--wd-ink);
    transform: rotate(15deg);
  }

  /* --------------------------------------------------------------- ladder -- */
  .ladder {
    position: relative;
    padding: 110px 24px;
    overflow: hidden;
  }

  .ladder__dot1 {
    top: 70px;
    right: 8%;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--wd-peach);
  }

  .ladder__dot2 {
    bottom: 120px;
    left: 5%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--wd-blue);
  }

  .ladder__sub {
    margin: 0 0 44px;
    font-size: 19px;
    max-width: 560px;
    line-height: 1.5;
  }

  .ladder__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }

  .rung {
    background: var(--wd-bright);
    border: 2.5px solid var(--wd-ink);
    border-radius: 22px;
    padding: 30px;
    box-shadow: 8px 8px 0 var(--rung, var(--wd-peach));
    transition:
      transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .rung:hover {
    transform: translate(-4px, -7px) rotate(-0.6deg);
    box-shadow: 14px 16px 0 var(--rung, var(--wd-peach));
  }

  .rung__num {
    margin: 0;
    font-size: 72px;
    font-weight: 800;
    line-height: 1;
  }

  .rung__title {
    margin: 14px 0 8px;
    font-size: 28px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .rung__body {
    margin: 0 0 14px;
    font-size: 16px;
    line-height: 1.55;
  }

  .rung__price {
    margin: 0;
    font-weight: 700;
    font-size: 17px;
  }

  .rung__scribble {
    margin: 8px 0 0;
    font-family: var(--wd-hand);
    font-size: 22px;
    color: var(--wd-bluelink);
    transform: rotate(-1.5deg);
  }

  .ladder__note {
    margin: 32px 0 0;
    font-size: 16px;
    max-width: 640px;
    line-height: 1.55;
  }

  /* ----------------------------------------------------------------- fork -- */
  .fork {
    background: var(--wd-blueband);
    border-top: 2px solid var(--wd-ink);
    border-bottom: 2px solid var(--wd-ink);
    padding: 110px 24px;
  }

  .fork__title {
    margin: 0 0 48px;
    font-size: clamp(36px, 5.6vw, 72px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    max-width: 900px;
    text-transform: uppercase;
    text-shadow: 3px 3px 0 var(--wd-card);
    text-wrap: balance;
  }

  .fork__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }

  .forkcard {
    background: var(--wd-card);
    border: 2px solid var(--wd-ink);
    border-radius: 24px;
    padding: 34px;
    transform: rotate(var(--tilt, 0deg));
    box-shadow: 6px 6px 0 var(--wd-ink);
    transition:
      transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .forkcard:hover {
    transform: rotate(0deg) translate(-4px, -6px);
    box-shadow: 12px 14px 0 var(--forkshadow, var(--wd-peach));
  }

  .forkcard__chip {
    display: inline-block;
    border: 1.5px solid var(--wd-ink);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 7px 14px;
    border-radius: 999px;
    margin: 0 0 18px;
  }

  .forkcard__title {
    margin: 0 0 12px;
    font-size: 30px;
    font-weight: 800;
    line-height: 1.05;
  }

  .forkcard__body {
    margin: 0 0 14px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--wd-muted);
  }

  .forkcard__price {
    margin: 4px 0 0;
    font-size: 22px;
    font-weight: 800;
  }

  .fork__note {
    margin: 36px auto 0;
    max-width: 760px;
    font-size: 18px;
    line-height: 1.55;
    text-align: center;
    font-weight: 600;
  }

  /* -------------------------------------------------------------- pricing -- */
  .pricing {
    background: var(--wd-ink-deep);
    color: var(--wd-paper);
    padding: 110px 24px;
  }

  .pricing .scribble {
    color: var(--wd-yellow);
  }

  .pricing__sub a {
    color: var(--wd-yellow);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pricing__label {
    color: var(--wd-faint);
  }

  .pricing__sub {
    margin: 0 0 26px;
    font-size: 19px;
    max-width: 620px;
    line-height: 1.5;
  }

  .pricing__label {
    margin: 34px 0 14px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--wd-faint, #A89F8D);
  }

  .pricing__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 56px;
  }

  /* Rows sit directly on the near-black band, divided by a hairline. They
     used to be bright cards, which meant the names and prices inherited the
     band's cream text onto a cream face and were invisible (1.09:1). */
  .pricerow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--wd-ink-soft);
  }

  .pricerow > div {
    min-width: 0;
  }

  .pricerow__name {
    margin: 0;
    font-size: 17px;
    font-weight: 800;
    color: var(--wd-paper);
  }

  .pricerow__tag {
    margin-left: 6px;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--wd-coral-deep);
    color: var(--wd-card);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    vertical-align: 2px;
  }

  .pricerow__sub {
    display: block;
    font-family: var(--wd-mono);
    font-size: 12px;
    line-height: 1.45;
    color: var(--wd-faint);
  }

  .pricerow__price {
    flex: none;
    font-family: var(--wd-mono);
    font-size: 20px;
    font-weight: 700;
    color: var(--wd-paper);
    white-space: nowrap;
  }

  .pricing__cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }

  /* Paper on the near-black band, and it goes coral on hover. */
  .pricing__link {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    min-height: 44px;
    padding: 18px 30px 17px;
    border-radius: 999px;
    background: var(--wd-paper);
    color: var(--wd-ink);
    font-size: 16.5px;
    font-weight: 800;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  .pricing__link:hover,
  .pricing__link:focus-visible {
    transform: translateY(-2px);
    background: var(--wd-coral-deep);
    color: var(--wd-card);
  }

  @media (max-width: 760px) {
    .pricing__list {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Stacked, the price wants its own line rather than a squeezed column. */
    .pricerow {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }

  /* ----------------------------------------------------------------- work -- */
  .work {
    background: var(--wd-paper);
    border-top: 2px solid var(--wd-ink);
    border-bottom: 2px solid var(--wd-ink);
    padding: 110px 24px;
  }

  /* No text-shadow in v13 — that was needed when this band was peach. */
  .work__title {
    margin: 0 0 52px;
    font-size: clamp(38px, 5vw, 68px);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 0.98;
    text-transform: uppercase;
  }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 430px), 1fr));
    gap: 30px;
  }

  .workpiece {
    position: relative;
    background: var(--wd-card);
    border: 2px solid var(--wd-ink);
    border-radius: 22px;
    padding: 18px 18px 26px;
    transform: rotate(var(--tilt, 0deg));
    display: flex;
    flex-direction: column;
    box-shadow: 6px 6px 0 var(--wd-ink);
    transition: transform 0.25s ease;
  }

  .workpiece:hover {
    transform: rotate(0deg) translateY(-4px);
  }

  .workpiece__tape {
    position: absolute;
    top: -13px;
    left: 34px;
    min-width: 92px;
    height: 28px;
    padding: 0 12px;
    border: 1.5px solid var(--wd-ink);
    transform: rotate(-4deg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--wd-hand);
    font-size: 19px;
    font-weight: 700;
    white-space: nowrap;
  }

  .workpiece__img {
    border-radius: 14px;
    overflow: hidden;
    background: #DDD6C7;
    border: 1.5px solid var(--wd-ink);
    height: 290px;
  }

  .workpiece__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .workpiece__name {
    margin: 20px 0 2px;
    font-size: 26px;
    font-weight: 800;
  }

  .workpiece__tag {
    margin: 0 0 10px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--wd-muted);
  }

  .workpiece__blurb {
    margin: 0 0 12px;
    font-size: 16px;
    line-height: 1.55;
  }

  .workpiece__stat {
    margin: 0 0 16px;
    font-family: var(--wd-hand);
    font-size: 23px;
    color: var(--wd-bluelink);
  }

  .workpiece__link {
    margin-top: auto;
    align-self: flex-start;
    font-weight: 700;
    font-size: 16px;
    color: var(--wd-ink);
    border-bottom: 3px solid var(--wd-gold);
  }

  .workpiece__link:hover,
  .workpiece__link:focus-visible {
    color: var(--wd-ink);
    border-bottom-color: var(--wd-bluelink);
  }

  .work__note {
    margin: 40px 0 0;
    font-size: 16px;
    max-width: 640px;
    line-height: 1.6;
    font-weight: 500;
  }

  /* -------------------------------------------------------------- awkward -- */
  .awkward {
    position: relative;
    padding: 110px 24px;
    overflow: hidden;
  }

  .awkward__dot1 {
    top: 90px;
    right: 10%;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--wd-butter);
  }

  .awkward__dot2 {
    bottom: 100px;
    left: 7%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--wd-peach);
  }

  .awkward__inner {
    position: relative;
    max-width: 900px;
    margin-inline: auto;
  }

  .awkward__title {
    margin: 0 0 28px;
    font-family: var(--wd-hand);
    font-size: clamp(44px, 7vw, 84px);
    font-weight: 700;
    line-height: 1;
    color: var(--wd-scribble);
    transform: rotate(-1.2deg);
  }

  .awkward__inner > p {
    margin: 0 0 18px;
    font-size: 20px;
    line-height: 1.6;
    color: #3A3327;
  }

  .awkward__punch {
    display: inline-block;
    background: var(--wd-butter);
    border: 2px solid var(--wd-ink);
    color: var(--wd-ink) !important;
    font-size: clamp(20px, 2.6vw, 28px) !important;
    font-weight: 800;
    line-height: 1.35 !important;
    padding: 16px 24px;
    border-radius: 14px;
    transform: rotate(-0.8deg);
    box-shadow: 5px 5px 0 var(--wd-ink);
    margin-top: 10px !important;
  }

  /* ------------------------------------------------------------ ownership -- */
  .own {
    background: var(--wd-blueband);
    border-top: 2px solid var(--wd-ink);
    border-bottom: 2px solid var(--wd-ink);
    padding: 96px 24px;
  }

  .own__title {
    margin: 0 0 44px;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: uppercase;
    text-shadow: 3px 3px 0 var(--wd-card);
  }

  .own__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }

  .owncard {
    background: var(--wd-card);
    border: 2px solid var(--wd-ink);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 5px 5px 0 var(--wd-ink);
  }

  .owncard h3 {
    margin: 0 0 8px;
    font-size: 22px;
    font-weight: 800;
  }

  .owncard p {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
  }

  /* ------------------------------------------------------------------ faq -- */
  .faq {
    padding: 110px 24px;
  }

  .faq__inner {
    max-width: 820px;
    margin-inline: auto;
  }

  .faq__list {
    border-top: 2px solid var(--wd-ink);
    margin-top: 40px;
  }

  .faq__item {
    border-bottom: 2px solid var(--wd-ink);
  }

  .faq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 20px 4px;
    font-size: 19px;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    flex: none;
    font-size: 26px;
    font-weight: 500;
    color: var(--wd-scribble);
    transition: transform 0.25s ease;
  }

  .faq__item[open] .faq__icon {
    transform: rotate(45deg);
  }

  .faq__a {
    padding: 0 4px 22px;
    font-size: 16.5px;
    line-height: 1.65;
    max-width: 700px;
    white-space: pre-line;
  }

  /* ---------------------------------------------------------------- start -- */
  .start {
    background: var(--wd-coral-deep);
    color: var(--wd-card);
    border-top: 2px solid var(--wd-ink);
    padding: 110px 24px 100px;
  }

  .start__inner {
    max-width: 1080px;
    margin-inline: auto;
  }

  .start__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 48px;
    align-items: start;
  }

