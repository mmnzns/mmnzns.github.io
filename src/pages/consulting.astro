---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import {
  PRACTICES,
  ENGAGEMENTS,
  FIT_YES,
  FIT_NO,
  START_STEPS,
  PROOF,
  CONSULTING_NUMBERS,
  WORTH_KNOWING,
  SYSTEMS,
  DEPTH,
} from '../data/consulting';
---

<BaseLayout
  title="Consulting"
  description="Help with lifecycle, conversion, and the systems behind them — through MNM Alaminos Consulting Ltd., from a focused one-week review to ongoing support."
  breadcrumbs={[{ label: 'Consulting', href: '/consulting/' }]}
  footerFlush
>
  {/* ------------------------------------------------------------- hero -- */}
  <section class="section--first wrap chero" id="top">
    <div class="dotacc" aria-hidden="true"></div>

    <p class="eyebrow">Consulting</p>
    <h1 class="page-title chero__title">
      Help with lifecycle, conversion, and the systems behind them.
    </h1>

    <div class="chero__grid">
      <div class="chero__intro">
        <p>
          Hi! I’m Miguel. I’ve spent eleven years working across lifecycle, web, and marketing
          operations, mostly in fintech, with some SaaS and ecommerce along the way. My consulting
          work runs through MNM Alaminos Consulting Ltd.
        </p>
        <p>
          Teams usually reach out when an important number is moving in the wrong direction, a
          customer journey isn’t working as expected, or a process has become too difficult to hold
          together.
        </p>
        <p>
          My first step is to understand the situation from the people closest to it. I look at the
          customer journey, the data, the tools, and how work moves between teams. Sometimes the
          first theory is right. Other times, the issue sits somewhere less obvious—after the
          click, between two systems, or in a part of the experience nobody fully owns.
        </p>
        <p>
          From there, we agree on what needs to change and which result will tell us whether it
          worked. Depending on what you need, I can build it alongside your team or leave you with
          a practical plan they can carry forward.
        </p>
      </div>

      <div class="card card--raised worth">
        <p class="eyebrow eyebrow--muted">Worth knowing</p>
        <div class="worth__rows">
          {
            WORTH_KNOWING.map((row) => (
              <p class="worth__row">
                <span class="worth__dot" style={`background:${row.accent}`} aria-hidden="true" />
                <span>{row.text}</span>
              </p>
            ))
          }
        </div>
        <a class="btn worth__cta" href="#contact">Tell me what you’re working through</a>
      </div>
    </div>
  </section>

  {/* -------------------------------------------------------- practices -- */}
  <section class="section wrap" id="practices">
    <p class="eyebrow">What I work on</p>
    <h2 class="section-title practices__title">
      Three connected areas, with most problems sitting somewhere between them.
    </h2>
    <p class="lede practices__sub">
      Three areas that often overlap. Start with the one that feels closest to your problem, and we
      can follow the thread from there.
    </p>

    <div class="practices" data-practices>
      {
        PRACTICES.map((practice, i) => (
          <button
            type="button"
            class="card practice"
            data-practice={practice.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            <span class="accent-bar" style={`--bar:${practice.accent}`} aria-hidden="true" />
            <span class="practice__name">{practice.name}</span>
            <span class="practice__blurb">{practice.blurb}</span>
            <span class="practice__cta" data-practice-cta>
              {i === 0 ? 'Showing below ↓' : 'Explore this area'}
            </span>
          </button>
        ))
      }
    </div>

    <div class="card card--raised detail">
      {
        PRACTICES.map((practice, i) => (
          <div class="detail__panel" data-practice-panel={practice.key} hidden={i !== 0}>
            <div>
              <p class="label-row detail__label">
                <span class="accent-bar" style={`--bar:${practice.accent}`} />
                <span class="eyebrow eyebrow--muted">{practice.name}</span>
              </p>
              <p class="detail__text">{practice.detail}</p>
            </div>
            <div>
              <p class="eyebrow eyebrow--muted detail__includes">Typically includes</p>
              <div class="detail__items">
                {practice.items.map((item) => (
                  <p class="detail__item">{item}</p>
                ))}
              </div>
              <p class="detail__tools">{practice.tools}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  {/* ------------------------------------------------------ engagements -- */}
  <section class="band band--sun escope" id="engagements">
    <div class="wrap">
      <p class="eyebrow">How it’s scoped</p>
      <h2 class="section-title escope__title">From a focused review to ongoing support.</h2>
      <p class="escope__sub">
        There are a few ways we can work together, from a focused one-week review to ongoing
        support inside your team.
      </p>

      <div class="engagements">
        {
          ENGAGEMENTS.map((engagement) => (
            <article
              class="engagement"
              data-engagement
              data-for={engagement.fits.join(' ')}
              data-other={engagement.other ? 'true' : undefined}
            >
              <div class="engagement__head">
                <h3 class="engagement__name">{engagement.name}</h3>
                <span class="engagement__length">{engagement.length}</span>
              </div>
              <p class="engagement__body">{engagement.body}</p>
              <div class="engagement__foot">
                <p class="engagement__leave">{engagement.leave}</p>
                {engagement.other ? (
                  <a class="engagement__status engagement__status--link" href="#contact">
                    Tell me what you need →
                  </a>
                ) : (
                  <span class="engagement__status" data-engagement-status>
                    Available
                  </span>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <p class="escope__note">
        Project work is quoted as a fixed fee in the proposal, so the scope and cost are clear
        before anything begins. There is no hourly billing after the introductory call.
      </p>
    </div>
  </section>

  {/* ---------------------------------------------------------- systems -- */}
  <section class="section wrap" id="systems">
    <p class="eyebrow">Systems</p>
    <h2 class="section-title systems__title">
      The stack I work in, and the parts of it I know well enough to build in from day one.
    </h2>
    <p class="lede systems__sub">
      I decide what a system needs to do before choosing what to run it on. That said, most teams
      already have a stack, so here’s what I can pick up without a ramp.
    </p>

    <div class="sysgrid">
      {
        SYSTEMS.map((category) => (
          <div class="card syscard">
            <p class="label-row">
              <span class="accent-bar accent-bar--sm" style={`--bar:${category.accent}`} />
              <span class="syscard__name">{category.name}</span>
            </p>
            <div class="syscard__tools">
              {category.tools.map((tool) => (
                <span class="syscard__tool">{tool}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="depth">
      <p class="eyebrow eyebrow--muted depth__label">Where I go deepest</p>
      <div class="depth__grid">
        {
          DEPTH.map((entry) => (
            <div class="depth__row">
              <p class="depth__head">
                <span class="depth__name">{entry.name}</span>
                <span class="depth__level" style={`color:${entry.accent}`}>
                  {entry.level}
                </span>
              </p>
              <p class="depth__note">{entry.note}</p>
            </div>
          ))
        }
      </div>
      <p class="depth__caveat">
        Proficiency here reflects current fluency rather than everything I’ve touched. Salesforce
        Marketing Cloud is the one exception worth flagging: my last production build was 2021, and
        I’m current on the platform through a live vendor evaluation rather than day-to-day work.
      </p>
    </div>
  </section>

  {/* --------------------------------------------------------- receipts -- */}
  <section class="band creceipts">
    <div class="wrap">
      <p class="eyebrow creceipts__eyebrow">Receipts</p>
      <h2 class="creceipts__headline">
        Different teams, different problems. The same goal: understand what’s happening, build
        what’s needed, and leave the numbers moving in the right direction.
      </h2>

      <div class="creceipts__numbers">
        {
          CONSULTING_NUMBERS.map((number) => (
            <div>
              <p class="stat__value">{number.value}</p>
              <p class="stat__label">{number.label}</p>
            </div>
          ))
        }
      </div>

      <div class="creceipts__proof">
        {
          PROOF.map((item) => (
            <a class="proofcard" href={`/work/${item.slug}/`}>
              <span class="proofcard__client" style={`color:${item.accent}`}>
                {item.client}
              </span>
              <span class="proofcard__title">{item.title}</span>
              <span class="proofcard__line">{item.line}</span>
              <span class="proofcard__read">Read the full case →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* -------------------------------------------------------------- fit -- */}
  <section class="band band--coral fit" id="fit">
    <div class="wrap">
      <p class="eyebrow">Fit</p>
      <h2 class="section-title fit__title">
        The work tends to go well when there’s a meaningful problem to understand, enough signal to
        learn from, and a team willing to look across the full system.
      </h2>

      <div class="fit__grid">
        <div class="card card--raised fit__col">
          <p class="fit__head fit__head--yes">Good fit</p>
          <div>
            {FIT_YES.map((item) => <p class="fit__item">{item}</p>)}
          </div>
        </div>
        <div class="fit__col fit__col--no">
          <p class="fit__head">Probably not the right fit</p>
          <div>
            {FIT_NO.map((item) => <p class="fit__item fit__item--muted">{item}</p>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ start -- */}
  <section class="section wrap" id="start">
    <p class="eyebrow">How it starts</p>
    <h2 class="section-title start__title">
      Three straightforward steps, with a chance to decide whether it makes sense to continue at
      each one.
    </h2>

    <div class="startgrid">
      {
        START_STEPS.map((step) => (
          <div class="start__step">
            <span class="start__num">{step.num}</span>
            <span class="start__name">{step.name}</span>
            <span class="start__body">{step.body}</span>
          </div>
        ))
      }
    </div>
  </section>

  {/* ---------------------------------------------------------- contact -- */}
  <ContactSection
    title="Let’s talk."
    intro="Tell me what you're working through, what you're seeing, and what you think may be getting in the way. I'll take a look and let you know whether it sounds like something I can help with."
  />
</BaseLayout>

<script>
  // The practice cards drive both the detail panel and which engagements read
  // as available. Server renders the first practice's state; this swaps it.
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-practice]');
  const panels = document.querySelectorAll<HTMLElement>('[data-practice-panel]');
  const engagements = document.querySelectorAll<HTMLElement>('[data-engagement]');

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const key = button.dataset.practice;

      for (const b of buttons) {
        const active = b === button;
        b.setAttribute('aria-pressed', String(active));
        const cta = b.querySelector('[data-practice-cta]');
        if (cta) cta.textContent = active ? 'Showing below ↓' : 'Explore this area';
      }

      for (const panel of panels) panel.hidden = panel.dataset.practicePanel !== key;

      for (const engagement of engagements) {
        if (engagement.dataset.other) continue;
        const ok = (engagement.dataset.for ?? '').split(' ').includes(key ?? '');
        engagement.classList.toggle('engagement--dim', !ok);
        const status = engagement.querySelector('[data-engagement-status]');
        if (status) status.textContent = ok ? 'Available' : 'Not offered for this area';
      }
    });
  }
</script>

<style>
  .chero {
    position: relative;
  }

  .chero__title {
    margin-top: 26px;
    max-width: 1000px;
  }

  .chero__grid {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 56px;
    align-items: start;
  }

  .chero__intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: 18px;
    line-height: 1.66;
    color: var(--ink-2);
    max-width: 620px;
  }

  .worth {
    box-shadow: var(--shadow);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .worth__rows {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 16px;
    line-height: 1.6;
  }

  .worth__row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
  }

  .worth__dot {
    width: 7px;
    height: 7px;
    margin-top: 8px;
  }

  .worth__cta {
    margin-top: auto;
    align-self: flex-start;
    white-space: normal;
    text-align: left;
  }

  /* -------------------------------------------------------- practices -- */
  .practices__title {
    margin-top: 20px;
    max-width: 760px;
  }

  .practices__sub {
    margin: 18px 0 44px;
    max-width: 560px;
  }

  .practices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 20px;
  }

  .practice {
    text-align: left;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition:
      transform var(--dur) var(--ease),
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .practice:hover {
    transform: translate(-4px, -4px);
  }

  .practice[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .practice__name {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.012em;
  }

  .practice__blurb {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .practice[aria-pressed='true'] .practice__blurb,
  .practice[aria-pressed='true'] .practice__cta {
    color: var(--on-dark-2);
  }

  .practice__cta {
    margin-top: 6px;
    font-size: 13px;
    color: var(--ink-2);
    letter-spacing: 0.02em;
  }

  .detail {
    margin-top: 24px;
    box-shadow: var(--shadow);
    padding: clamp(30px, 4vw, 44px);
  }

  .detail__panel {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 48px;
    align-items: start;
  }

  .detail__label {
    margin-bottom: 18px;
  }

  .detail__text {
    font-size: 19px;
    line-height: 1.6;
    letter-spacing: -0.005em;
  }

  .detail__includes {
    margin-bottom: 18px;
  }

  .detail__items {
    display: flex;
    flex-direction: column;
  }

  .detail__item {
    padding: 12px 0;
    border-bottom: var(--border);
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .detail__tools {
    margin-top: 20px;
    font-size: 13px;
    color: var(--ink-3);
    line-height: 1.6;
  }

  /* ------------------------------------------------------ engagements -- */
  .escope {
    padding-block: clamp(66px, 8.4vw, 116px);
  }

  .escope__title {
    margin-top: 20px;
    max-width: 640px;
  }

  .escope__sub {
    margin: 18px 0 44px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--sun-ink);
    max-width: 640px;
  }

  .engagements {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 22px;
  }

  .engagement {
    background: var(--dark);
    border: var(--border);
    box-shadow: 10px 10px 0 var(--paper);
    padding: clamp(26px, 3.2vw, 38px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .engagement:hover {
    transform: translate(-4px, -4px);
  }

  .engagement--dim {
    opacity: 0.5;
    box-shadow: none;
  }

  .engagement__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .engagement__name {
    font-size: clamp(24px, 2.2vw, 30px);
    line-height: 1.04;
    letter-spacing: -0.022em;
    color: var(--on-dark);
  }

  .engagement--dim .engagement__name {
    color: var(--on-dark-3);
  }

  .engagement__length {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--sun);
    border: 2px solid var(--sun);
    padding: 4px 8px;
    white-space: nowrap;
  }

  .engagement--dim .engagement__length {
    background: transparent;
    border-color: var(--ink-2);
    color: var(--on-dark-3);
  }

  .engagement__body {
    font-size: 16px;
    line-height: 1.65;
    color: var(--on-dark-2);
  }

  .engagement__foot {
    margin-top: auto;
    padding-top: 18px;
    border-top: 3px solid rgb(251 249 246 / 40%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .engagement__leave {
    font-size: 13px;
    color: var(--on-dark-3);
    line-height: 1.5;
  }

  .engagement__status {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sun);
    white-space: nowrap;
  }

  .engagement--dim .engagement__status {
    color: var(--on-dark-3);
  }

  .engagement__status--link:hover,
  .engagement__status--link:focus-visible {
    color: var(--coral);
  }

  .escope__note {
    margin-top: 26px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--sun-ink);
    max-width: 660px;
  }

  /* ---------------------------------------------------------- systems -- */
  .systems__title {
    margin-top: 20px;
    max-width: 800px;
  }

  .systems__sub {
    margin: 18px 0 44px;
    max-width: 620px;
  }

  .sysgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 18px;
  }

  .syscard {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .syscard__name {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.008em;
  }

  .syscard__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .syscard__tool {
    font-size: 13.5px;
    line-height: 1.3;
    padding: 6px 12px;
    border: var(--border);
    color: var(--ink-2);
  }

  .depth {
    margin-top: 44px;
    padding-top: clamp(36px, 4.4vw, 52px);
    border-top: var(--border);
  }

  .depth__label {
    margin-bottom: 28px;
  }

  .depth__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 0 48px;
  }

  .depth__row {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 0;
    border-top: var(--border);
  }

  .depth__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
  }

  .depth__name {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .depth__level {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .depth__note {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .depth__caveat {
    margin-top: 26px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-3);
    max-width: 660px;
  }

  /* --------------------------------------------------------- receipts -- */
  .creceipts {
    padding-block: clamp(90px, 9vw, 130px);
  }

  .creceipts__eyebrow {
    color: var(--on-dark);
    margin-bottom: 22px;
  }

  .creceipts__headline {
    max-width: 820px;
    font-size: clamp(32px, 4.5vw, 68px);
    line-height: 0.95;
    letter-spacing: -0.034em;
    color: var(--sun);
  }

  .creceipts__numbers {
    margin-top: clamp(48px, 6vw, 72px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 40px;
  }

  .creceipts__proof {
    margin-top: clamp(52px, 6vw, 76px);
    padding-top: clamp(44px, 5vw, 60px);
    border-top: 3px solid var(--on-dark);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
    gap: 28px;
  }

  .proofcard {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px;
    border: 3px solid var(--on-dark);
    color: var(--on-dark);
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .proofcard:hover,
  .proofcard:focus-visible {
    border-color: var(--sun);
    transform: translate(-4px, -4px);
    color: var(--on-dark);
  }

  .proofcard__client {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .proofcard__title {
    font-size: 19px;
    line-height: 1.28;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .proofcard__line {
    font-size: 15px;
    line-height: 1.6;
    color: var(--on-dark-2);
  }

  .proofcard__read {
    margin-top: 8px;
    font-size: 13px;
    color: var(--on-dark-3);
  }

  /* -------------------------------------------------------------- fit -- */
  .fit {
    padding-block: clamp(66px, 8.4vw, 116px);
  }

  .fit__title {
    margin: 20px 0 44px;
  }

  .fit__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 22px;
    align-items: start;
  }

  .fit__col {
    padding: clamp(30px, 3.4vw, 40px);
    box-shadow: var(--shadow);
  }

  .fit__col--no {
    background: var(--wash);
    border: var(--border);
    box-shadow: none;
  }

  .fit__head {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
