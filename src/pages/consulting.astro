---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import {
  PRACTICES,
  ENGAGEMENTS,
  FIT_YES,
  FIT_NO,
  START_STEPS,
  PROOF,
  CONSULTING_NUMBERS,
  WORTH_KNOWING,
} from '../data/consulting';
---

<BaseLayout
  title="Consulting"
  description="Independent lifecycle, conversion and automation engagements. I read what's actually wrong before deciding what to build — audits, teardowns, builds and fractional work."
>
  <section class="section--first wrap" id="top">
    <p class="eyebrow consult-hero__eyebrow">Consulting</p>
    <h1 class="page-title consult-hero__title">
      Help with lifecycle, conversion, and the systems behind them.
    </h1>

    <div class="consult-hero">
      <div class="consult-hero__copy" data-reveal-group>
        <p>
          Hi! I’m Miguel. I’ve spent eleven years working across lifecycle, web, and marketing
          operations, mostly in fintech, with some SaaS and ecommerce along the way. My consulting
          work runs through MNM Alaminos Consulting Ltd.
        </p>
        <p>
          Teams usually reach out when an important number is moving in the wrong direction, a
          customer journey isn’t working as expected, or a process has become too difficult to hold
          together.
        </p>
        <p>
          My first step is to understand the situation from the people closest to it. I look at the
          customer journey, the data, the tools, and how work moves between teams. Sometimes the
          first theory is right. Other times, the issue sits somewhere less obvious—after the click,
          between two systems, or in a part of the experience nobody fully owns.
        </p>
        <p>
          From there, we agree on what needs to change and which result will tell us whether it
          worked. Depending on what you need, I can build it alongside your team or leave you with a
          practical plan they can carry forward.
        </p>
      </div>

      <aside class="card card--raised consult-hero__aside">
        <p class="eyebrow">Worth knowing</p>
        <ul class="consult-hero__list">
          {
            WORTH_KNOWING.map((item) => (
              <li>
                <span class="dot" style={`--dot:${item.accent}`} aria-hidden="true" />
                {item.text}
              </li>
            ))
          }
        </ul>
        <a class="btn consult-hero__cta" href="#contact">Tell me what you’re working through</a>
      </aside>
    </div>
  </section>

  {/* ------------------------------------------------------- practices -- */}
  <section class="section wrap" id="practices">
    <p class="eyebrow practices__eyebrow">What I work on</p>
    <h2 class="section-title--sm practices__title">
      Three connected areas, with most problems sitting somewhere between them.
    </h2>
    <p class="lede practices__sub">
      Three areas that often overlap. Start with the one that feels closest to your problem, and we
      can follow the thread from there.
    </p>

    <div class="practices" role="tablist" aria-label="Practice areas">
      {
        PRACTICES.map((practice, i) => (
          <button
            type="button"
            role="tab"
            id={`practice-tab-${practice.key}`}
            aria-controls={`practice-panel-${practice.key}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="practice"
            data-practice={practice.key}
          >
            <span class="accent-bar" style={`--bar:${practice.accent}`} />
            <span class="practice__name">{practice.name}</span>
            <span class="practice__blurb">{practice.blurb}</span>
            <span class="practice__cta" data-practice-cta>
              {i === 0 ? 'Showing below ↓' : 'See what’s inside'}
            </span>
          </button>
        ))
      }
    </div>

    {
      PRACTICES.map((practice, i) => (
        <div
          role="tabpanel"
          id={`practice-panel-${practice.key}`}
          aria-labelledby={`practice-tab-${practice.key}`}
          class="card card--raised practice-detail"
          data-practice-panel={practice.key}
          hidden={i !== 0}
        >
          <div>
            <p class="label-row practice-detail__label">
              <span class="accent-bar" style={`--bar:${practice.accent}`} />
              <span class="eyebrow">{practice.name}</span>
            </p>
            <p class="practice-detail__body">{practice.detail}</p>
          </div>

          <div>
            <p class="eyebrow practice-detail__eyebrow">Typically includes</p>
            <ul class="practice-detail__items">
              {practice.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <p class="practice-detail__tools">{practice.tools}</p>
          </div>
        </div>
      ))
    }
  </section>

  {/* ----------------------------------------------------- engagements -- */}
  <section class="section wrap" id="engagements">
    <div class="engage__head">
      <div>
        <p class="eyebrow engage__eyebrow">How it’s scoped</p>
        <h2 class="section-title--sm">From a focused review to ongoing support.</h2>
        <p class="lede engage__sub">
          There are a few ways we can work together, from a focused one-week review to ongoing
          support inside your team. Showing what fits
          <strong data-practice-name>{PRACTICES[0].name.toLowerCase()}</strong>.
        </p>
      </div>
      <p class="meta" data-engage-count aria-live="polite">
        {`${ENGAGEMENTS.filter((e) => e.fits.includes(PRACTICES[0].key)).length} of ${ENGAGEMENTS.length} fit this area`}
      </p>
    </div>

    <div class="engage">
      {
        ENGAGEMENTS.map((engagement) => (
          <article
            class:list={['card', 'engage__card', engagement.other && 'engage__card--else']}
            data-engagement
            data-fits={engagement.fits.join(' ')}
            data-available={engagement.fits.includes(PRACTICES[0].key) ? 'true' : 'false'}
          >
            <div class="engage__top">
              <h3 class="engage__name">{engagement.name}</h3>
              <span class="meta">{engagement.length}</span>
            </div>
            <p class="engage__body">{engagement.body}</p>
            <div class="engage__foot">
              <span class="meta">{engagement.leave}</span>
              {
                engagement.other ? (
                  <a class="engage__status engage__status--link" href="#contact">
                    Email me <span aria-hidden="true">→</span>
                  </a>
                ) : (
                  <span class="engage__status" data-engage-status>
                    {engagement.fits.includes(PRACTICES[0].key) ? 'Available' : 'Not for this area'}
                  </span>
                )
              }
            </div>
          </article>
        ))
      }
    </div>

    <p class="engage__pricing">
      Project work is quoted as a fixed fee in the proposal, so the scope and cost are clear before
      anything begins. There is no hourly billing after the introductory call.
    </p>
  </section>

  {/* --------------------------------------------------------- receipts -- */}
  <section class="band consult-numbers">
    <div class="wrap">
      <p class="eyebrow consult-numbers__eyebrow">Receipts</p>
      <h2 class="consult-numbers__title">
        These results come from roles where I worked inside the business, alongside the teams
        responsible for carrying the work forward. I’d rather be clear about that than present them
        as consulting-client results.
      </h2>

      <div class="stat-row consult-numbers__grid">
        {
          CONSULTING_NUMBERS.map((item) => (
            <div>
              <p class="stat__value">{item.value}</p>
              <p class="stat__label">{item.label}</p>
            </div>
          ))
        }
      </div>

      <div class="consult-proof">
        {
          PROOF.map((item) => (
            <a class="consult-proof__card" href={`/work/${item.slug}/`}>
              <span class="eyebrow" style={`color:${item.accent}`}>
                {item.client}
              </span>
              <span class="consult-proof__title">{item.title}</span>
              <span class="consult-proof__line">{item.line}</span>
              <span class="consult-proof__more">Read the full case →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* -------------------------------------------------------------- fit -- */}
  <section class="section wrap" id="fit">
    <p class="eyebrow fit__eyebrow">Fit</p>
    <h2 class="section-title--sm fit__title">
      The work tends to go well when there’s a meaningful problem to understand, enough signal to
      learn from, and a team willing to look across the full system.
    </h2>

    <div class="fit">
      <div class="card card--raised fit__col">
        <p class="eyebrow fit__label fit__label--yes">Good fit</p>
        <ul class="fit__list">{FIT_YES.map((item) => <li>{item}</li>)}</ul>
      </div>

      <div class="fit__col fit__col--muted">
        <p class="eyebrow fit__label">Probably not the right fit</p>
        <ul class="fit__list fit__list--muted">{FIT_NO.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ start -- */}
  <section class="section wrap" id="start">
    <p class="eyebrow start__eyebrow">How it starts</p>
    <h2 class="section-title--sm start__title">
      Three straightforward steps, with a chance to decide whether it makes sense to continue at
      each one.
    </h2>

    <ol class="start">
      {
        START_STEPS.map((step) => (
          <li class="start__step">
            <span class="start__num">{step.num}</span>
            <span class="start__name">{step.name}</span>
            <span class="start__body">{step.body}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <ContactSection
    title="Let’s talk."
    intro="Tell me what you’re working through, what you’re seeing, and what you think may be getting in the way. I’ll take a look and let you know whether it sounds like something I can help with."
  />
</BaseLayout>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-practice]'));
  const panels = document.querySelectorAll<HTMLElement>('[data-practice-panel]');
  const engagements = document.querySelectorAll<HTMLElement>('[data-engagement]');
  const nameOut = document.querySelector<HTMLElement>('[data-practice-name]');
  const countOut = document.querySelector<HTMLElement>('[data-engage-count]');

  function select(key: string, focus = false) {
    let name = '';

    tabs.forEach((tab) => {
      const active = tab.dataset.practice === key;
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
      const cta = tab.querySelector<HTMLElement>('[data-practice-cta]');
      if (cta) cta.textContent = active ? 'Showing below ↓' : 'See what’s inside';
      if (active) {
        name = tab.querySelector('.practice__name')?.textContent ?? '';
        if (focus) tab.focus();
      }
    });

    for (const panel of panels) {
      panel.toggleAttribute('hidden', panel.dataset.practicePanel !== key);
    }

    let available = 0;
    for (const card of engagements) {
      const fits = (card.dataset.fits ?? '').split(' ').includes(key);
      card.dataset.available = String(fits);
      const status = card.querySelector<HTMLElement>('[data-engage-status]');
      if (status) status.textContent = fits ? 'Available' : 'Not for this area';
      if (fits) available += 1;
    }

    if (nameOut) nameOut.textContent = name.toLowerCase();
    if (countOut) countOut.textContent = `${available} of ${engagements.length} fit this area`;
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab.dataset.practice ?? ''));
    tab.addEventListener('keydown', (event) => {
      const delta = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (!delta) return;
      event.preventDefault();
      const target = tabs[(i + delta + tabs.length) % tabs.length];
      select(target.dataset.practice ?? '', true);
    });
  });
</script>

<style>
  .consult-hero__eyebrow {
    margin-bottom: 26px;
  }

  .consult-hero__title {
    max-width: 1000px;
  }

  .consult-hero {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(36px, 5vw, 56px);
    align-items: start;
  }

  .consult-hero__copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: 18px;
    line-height: 1.66;
    color: var(--ink-2);
    max-width: 620px;
  }

  .consult-hero__aside {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .consult-hero__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 16px;
    line-height: 1.6;
  }

  .consult-hero__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: var(--pill);
    background: var(--dot);
    margin-top: 8px;
  }

  .consult-hero__cta {
    margin-top: auto;
    align-self: flex-start;
  }

  /* -------------------------------------------------------- practices -- */
  .practices__eyebrow {
    margin-bottom: 20px;
  }

  .practices__title {
    max-width: 760px;
  }

  .practices__sub {
    margin: 18px 0 44px;
    max-width: 560px;
  }

  .practices {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .practice {
    text-align: left;
    background: var(--card);
    color: var(--ink);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition:
      transform var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .practice:hover {
    transform: translateY(-2px);
    border-color: var(--ink);
  }

  .practice[aria-selected='true'] {
    background: var(--dark);
    border-color: var(--dark);
    color: var(--on-dark);
  }

  .practice__name {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.012em;
  }

  .practice__blurb {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .practice__cta {
    margin-top: 6px;
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--ink-3);
  }

  .practice[aria-selected='true'] .practice__blurb,
  .practice[aria-selected='true'] .practice__cta {
    color: var(--on-dark-2);
  }

  .practice-detail {
    margin-top: 24px;
    padding: clamp(30px, 4vw, 44px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 48px;
    align-items: start;
  }

  .practice-detail__label {
    margin-bottom: 18px;
  }

  .practice-detail__body {
    font-size: 19px;
    line-height: 1.6;
    letter-spacing: -0.005em;
  }

  .practice-detail__eyebrow {
    margin-bottom: 18px;
  }

  .practice-detail__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .practice-detail__items li {
    padding-block: 12px;
    border-bottom: 1px solid var(--rule);
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .practice-detail__tools {
    margin-top: 20px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-3);
  }

  /* ------------------------------------------------------ engagements -- */
  .engage__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
    margin-bottom: 44px;
  }

  .engage__head > div {
    max-width: 640px;
  }

  .engage__eyebrow {
    margin-bottom: 20px;
  }

  .engage__sub {
    margin-top: 18px;
  }

  .engage__sub strong {
    font-weight: 500;
    color: var(--ink);
  }

  .engage {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .engage__card {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition:
      opacity var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  /* Shapes that don't apply to the chosen area stay on the page, dimmed and
     labelled, rather than disappearing — saying "not for this" is the point. */
  .engage__card[data-available='true'] {
    box-shadow: var(--shadow);
  }

  .engage__card[data-available='false'] {
    background: transparent;
    border-color: #e2dbd1;
    box-shadow: none;
    opacity: 0.42;
  }

  .engage__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .engage__name {
    font-size: 21px;
    letter-spacing: -0.01em;
  }

  .engage__body {
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .engage__foot {
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
  }

  .engage__status {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-3);
  }

  .engage__card[data-available='true'] .engage__status {
    color: var(--accent);
  }

  /* The catch-all card. It sits on wash rather than white and ends in a link
     instead of an availability label, because it isn't a shape you pick — it's
     an invitation to describe one. */
  .engage__card--else {
    background: var(--wash);
    box-shadow: none;
  }

  .engage__card--else[data-available] {
    opacity: 1;
  }

  .engage__status--link {
    color: var(--ink);
    display: inline-flex;
    gap: 6px;
    transition: color var(--dur-fast) var(--ease);
  }

  .engage__status--link:hover {
    color: var(--accent);
  }

  .engage__pricing {
    margin-top: 22px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-3);
    max-width: 660px;
  }

  /* --------------------------------------------------------- receipts -- */
  .consult-numbers {
    margin-top: clamp(88px, 13vw, 170px);
  }

  .consult-numbers__eyebrow {
    margin-bottom: 22px;
  }

  .consult-numbers__title {
    max-width: 820px;
    font-size: clamp(26px, 3.2vw, 42px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--sun);
  }

  .consult-numbers__grid {
    margin-top: clamp(48px, 6vw, 72px);
  }

  .consult-proof {
    margin-top: clamp(52px, 6vw, 76px);
    padding-top: clamp(44px, 5vw, 60px);
    border-top: 1px solid var(--on-dark-rule);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 28px;
  }

  .consult-proof__card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px;
    border: 1px solid rgb(251 249 246 / 14%);
    border-radius: var(--radius);
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .consult-proof__card:hover {
    border-color: rgb(251 249 246 / 40%);
    transform: translateY(-2px);
    color: var(--on-dark);
  }

  .consult-proof__title {
    font-size: 19px;
    line-height: 1.28;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--on-dark);
  }

  .consult-proof__line {
    font-size: 15px;
    line-height: 1.6;
    color: var(--on-dark-2);
  }

  .consult-proof__more {
    margin-top: 8px;
    font-size: 13px;
    color: var(--on-dark-3);
  }

  /* -------------------------------------------------------------- fit -- */
  .fit__eyebrow {
    margin-bottom: 20px;
  }

  .fit__title {
    margin-bottom: 44px;
  }

  .fit {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .fit__col {
    padding: clamp(30px, 3.4vw, 40px);
  }

  .fit__col--muted {
    background: var(--wash);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .fit__label {
    margin-bottom: 22px;
  }

  .fit__label--yes {
    color: var(--moss);
  }

  .fit__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .fit__list li {
    padding-block: 16px;
    border-bottom: 1px solid var(--rule);
    font-size: 17px;
    line-height: 1.55;
  }

  .fit__list--muted li {
    border-bottom-color: #e2dbd1;
    color: var(--ink-2);
  }

  /* ------------------------------------------------------------ start -- */
  .start__eyebrow {
    margin-bottom: 20px;
  }

  .start__title {
    margin-bottom: 44px;
  }

  .start {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .start__step {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 22px;
    border-top: 2px solid var(--ink);
  }

  .start__num {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--ink-3);
  }

  .start__name {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .start__body {
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-2);
  }

  @media (min-width: 700px) {
    .engage,
    .fit {
      grid-template-columns: repeat(2, 1fr);
    }

    .start {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 900px) {
    .practices {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
