---
import ConsultingLayout from '../layouts/ConsultingLayout.astro';
import { CONTACT, FORM_ENDPOINT } from '../config';
import {
  CONTACT_SECTION,
  ENGAGEMENTS,
  HERO,
  HERO_STATS,
  PRACTICES,
  PROOF,
  START_STEPS,
  STATS,
} from '../data/consulting';

/**
 * `/consulting/` — the section's front door, ported from the v13 export's
 * `Monzones-C-Home`. Copy lives in src/data/consulting.ts; the sub-brand's
 * palette, nav and footer live in ConsultingLayout.astro.
 */
const phoneHref = `tel:${CONTACT.phone.replace(/[^+\d]/g, '')}`;
---

<ConsultingLayout
  title="Consulting"
  description="Lifecycle, conversion and automation consulting for fintech, SaaS and ecommerce teams. I fix the journeys, funnels and systems behind a stuck metric, then leave you owning the fix."
  current="home"
>
  <section class="chero" id="top">
    <div class="cwrap chero__grid">
      <div>
        <p class="chero__avail">
          <span class="chero__dot" aria-hidden="true"></span>
          {HERO.availability}
        </p>

        <h1 class="disp chero__title">
          {HERO.titleLead} <span class="chero__accent">{HERO.titleAccent}</span><br
          />{HERO.titleRest}
        </h1>

        <p class="chero__body">{HERO.body}</p>

        <div class="ctarow">
          <a class="cbtn cbtn--solid" href="#contact">{HERO.primaryCta}</a>
          <a class="cbtn cbtn--ghost" href="#cases">{HERO.secondaryCta}</a>
        </div>

        <p class="chero__reassure">{HERO.reassurance}</p>
      </div>

      <div class="chero__stats">
        {
          HERO_STATS.map((stat, i) => (
            <div class={`chero__chip chero__chip--${i + 1}`}>
              <span class="disp chero__chip-num">{stat.num}</span>
              <span class="chero__chip-label">{stat.label}</span>
            </div>
          ))
        }
        <p class="chero__note">
          All three are broken down on the <a href="/consulting/results/">results page</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="csection csection--overlap" id="results">
    <div class="cwrap">
      <div class="chead" data-reveal>
        <div>
          <span class="ckicker">Results</span>
          <h2 class="disp ctitle">Proof, not promises.</h2>
        </div>
        <a class="clink" href="/consulting/results/">The full breakdown →</a>
      </div>

      <div class="cstats" data-reveal>
        {
          STATS.map((stat) => (
            <div class="cstat">
              <span class="cstat__rule" aria-hidden="true" />
              <p class="disp cstat__num">{stat.num}</p>
              <p class="cstat__label">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="csection csection--green csection--after-overlap" id="cases">
    <div class="cwrap">
      <div class="chead" data-reveal>
        <div>
          <span class="ckicker ckicker--on-green">Selected work</span>
          <h2 class="disp ctitle">The receipts.</h2>
        </div>
        <a class="clink clink--on-green" href="/consulting/results/">See the full results →</a>
      </div>

      <div class="ccases">
        {
          PROOF.map((proof) => (
            <a class="ccase" href={proof.href} data-reveal>
              <span class="ccase__metric-label">{proof.metricLabel}</span>
              <span class="disp ccase__metric">{proof.metric}</span>
              <span class="ccase__metric-note">{proof.metricNote}</span>
              <span class="ccase__rule" aria-hidden="true" />
              <span class="ccase__client">{proof.client}</span>
              <span class="disp ccase__title">{proof.title}</span>
              <span class="ccase__line">{proof.line}</span>
              <span class="ccase__more">Read the full case →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="csection" id="practices">
    <div class="cwrap">
      <div data-reveal>
        <span class="ckicker">Practice</span>
        <h2 class="disp ctitle">How I help your numbers move.</h2>
      </div>
      <p class="clede" data-reveal>
        Three connected areas, and most problems live somewhere between them. Pick the one closest
        to yours.
      </p>

      {/*
        Every panel is rendered. The script hides the inactive ones and turns
        the headings into a tablist — so with no JavaScript this reads as three
        labelled sections rather than one visible panel and two missing.
      */}
      <div class="cprac" data-prac>
        <div class="cprac__tabs" role="tablist" aria-label="Practice areas" hidden data-prac-tabs>
          {
            PRACTICES.map((practice, i) => (
              <button
                type="button"
                role="tab"
                class="cprac__tab"
                id={`prac-tab-${i}`}
                aria-controls={`prac-panel-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-prac-tab={String(i)}
              >
                {practice.name}
              </button>
            ))
          }
        </div>

        {
          PRACTICES.map((practice, i) => (
            <article
              class="cprac__panel"
              id={`prac-panel-${i}`}
              role="tabpanel"
              aria-labelledby={`prac-tab-${i}`}
              tabindex="0"
              data-prac-panel={String(i)}
            >
              <div>
                <span class="cprac__kicker">{practice.kicker}</span>
                <h3 class="disp cprac__name">{practice.name}</h3>
                <p class="cprac__blurb">{practice.blurb}</p>
              </div>
              <div>
                <p class="cprac__detail">{practice.detail}</p>
                <p class="cprac__tools">
                  <span class="cprac__tools-label">Tools</span>
                  {practice.tools}
                </p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="cfollow" data-reveal>
        <a class="cbtn" href="/consulting/services/">Every practice area in detail →</a>
        <span class="cfollow__note">Deliverables, inclusions, and tools on the services page.</span>
      </div>
    </div>
  </section>

  <section class="csection csection--flush-top" id="services">
    <div class="cwrap">
      <div data-reveal>
        <span class="ckicker">Services</span>
        <h2 class="disp ctitle">Ways to work together.</h2>
      </div>
      <p class="clede" data-reveal>
        From one focused week to a seat inside your team: six shapes, every one a fixed fee quoted
        before anything starts.
      </p>

      <div class="cengs" data-reveal>
        {
          ENGAGEMENTS.map((engagement) => (
            <article class="ceng">
              <h3 class="disp ceng__name">{engagement.name}</h3>
              <p class="ceng__line">{engagement.line}</p>
              <span class="ceng__length">{engagement.length}</span>
            </article>
          ))
        }
      </div>

      <div class="cfollow" data-reveal>
        <a class="cbtn cbtn--ink" href="/consulting/services/">Explore the services →</a>
        <span class="cfollow__note">
          What’s included, what you walk away with, and the full detail.
        </span>
      </div>
    </div>
  </section>

  <section class="csection csection--flush-top csection--deep" id="start">
    <div class="cwrap">
      <div data-reveal>
        <span class="ckicker">How it starts</span>
        <h2 class="disp ctitle">Starting is zero-risk. By design.</h2>
      </div>

      <div class="csteps">
        {
          START_STEPS.map((step) => (
            <div class="cstep" data-reveal>
              <span class="disp cstep__num">{step.num}</span>
              <span class="disp cstep__name">{step.name}</span>
              <span class="cstep__body">{step.body}</span>
            </div>
          ))
        }
      </div>

      <div class="cfollow cfollow--roomy" data-reveal>
        <a class="cbtn" href="/consulting/process/">Here’s the whole process →</a>
        <span class="cfollow__note cfollow__note--strong">
          Three steps, and you can bail at every one of them.
        </span>
      </div>
    </div>
  </section>

  <section class="csection csection--terra" id="contact">
    <div class="cwrap">
      <p class="ccontact__avail" data-reveal>
        <span class="chero__dot" aria-hidden="true"></span>
        {CONTACT_SECTION.availability}
      </p>
      <h2 class="disp ctitle ccontact__title" data-reveal>{CONTACT_SECTION.title}</h2>
      <p class="clede ccontact__lede" data-reveal>{CONTACT_SECTION.body}</p>

      <div class="ccontact" data-reveal>
        <form class="cform" action={FORM_ENDPOINT} method="POST" data-consulting-form>
          {/* Routes consulting enquiries apart from web-design leads. */}
          <input type="hidden" name="_subject" value="New consulting enquiry" />
          <input type="hidden" name="service" value="consulting" />

          <label class="cfield">
            Your name
            <input type="text" name="name" autocomplete="name" required />
          </label>

          <label class="cfield">
            Email
            <input type="email" name="email" autocomplete="email" required />
          </label>

          <label class="cfield">
            What’s on your mind?
            <textarea name="message" rows="4" required></textarea>
          </label>

          {/* Formspree discards any submission that fills this in. */}
          <input
            type="text"
            name="_gotcha"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="choneypot"
          />

          <button type="submit" class="cbtn cbtn--send">Send it</button>

          <p class="cform__status" role="status" aria-live="polite" data-form-status></p>
        </form>

        <div class="ccontact__direct">
          <a href={`mailto:${CONTACT.email}`}>
            <span class="ccontact__label">Email</span>
            <span class="ccontact__value">{CONTACT.email}</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href={phoneHref}>
            <span class="ccontact__label">Phone</span>
            <span class="ccontact__value">{CONTACT.phone}</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href={CONTACT.linkedin} target="_blank" rel="noopener">
            <span class="ccontact__label">LinkedIn</span>
            <span class="ccontact__value">linkedin.com/in/mmonzones</span>
            <span aria-hidden="true">↗</span>
          </a>

          <p class="ccontact__note ccontact__note--lead">{CONTACT_SECTION.local}</p>
          <p class="ccontact__note">
            Funnel’s fine but the website itself needs building? That’s its own service:
            <a class="ccontact__xlink" href="/web-design/">web design →</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</ConsultingLayout>

<script>
  /* ------------------------------------------------------ practice tabs -- */
  const prac = document.querySelector<HTMLElement>('[data-prac]');

  if (prac) {
    const tabs = [...prac.querySelectorAll<HTMLButtonElement>('[data-prac-tab]')];
    const panels = [...prac.querySelectorAll<HTMLElement>('[data-prac-panel]')];
    const tabBar = prac.querySelector<HTMLElement>('[data-prac-tabs]');

    if (tabs.length && tabs.length === panels.length && tabBar) {
      const select = (index: number, focus = false) => {
        tabs.forEach((tab, i) => {
          tab.setAttribute('aria-selected', String(i === index));
          tab.tabIndex = i === index ? 0 : -1;
        });
        panels.forEach((panel, i) => {
          panel.hidden = i !== index;
        });
        if (focus) tabs[index].focus();
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
        tab.addEventListener('keydown', (event) => {
          /* Roving tabindex: a tablist is one stop, arrows move within it. */
          const delta = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
          if (!delta) return;
          event.preventDefault();
          select((i + delta + tabs.length) % tabs.length, true);
        });
      });

      tabBar.hidden = false;
      select(0);
    }
  }

  /* ------------------------------------------------------------- form ---- */
  /* Submits in place, falling through to a normal POST on anything
     unexpected — the same bargain ContactSection makes, repeated here because
     component scripts only ship on pages that render the component. */
  const form = document.querySelector<HTMLFormElement>('[data-consulting-form]');

  if (form) {
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      if (!form.checkValidity()) return;
      event.preventDefault();

      const original = submit?.textContent ?? 'Send it';
      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }
      if (status) {
        status.textContent = '';
        status.dataset.state = '';
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(String(response.status));

        form.reset();
        if (status) {
          status.textContent = 'Thanks — that’s with me. I answer everything within a couple of days.';
          status.dataset.state = 'ok';
        }
      } catch {
        if (status) {
          status.textContent =
            'That didn’t send. Email me directly at miguel@mnmonzones.com and I’ll pick it up.';
          status.dataset.state = 'error';
        }
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = original;
        }
      }
    });
  }
</script>


<style>
  /* Page-unique styles only. The shared consulting vocabulary — buttons,
     section heads, stat card, practice tabs, step cards, hero grid — lives in
     ConsultingLayout.astro, because all four pages use it and scoped styles
     can't reach markup the layout renders around a <slot />. Values are the
     v14 export's (`Monzones-C-Home`). */

  /* The availability line is a raised pill. */
  .chero__avail {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 18px;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    background: var(--c-card);
    font-size: 13px;
    font-weight: 600;
    color: var(--c-ink-3);
    box-shadow: var(--c-raised);
  }

  .chero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-terra);
    animation: cpulse 2.6s ease-out infinite;
  }

  @keyframes cpulse {
    0% {
      box-shadow: 0 0 0 0 rgb(192 96 60 / 50%);
    }
    70% {
      box-shadow: 0 0 0 9px rgb(192 96 60 / 0%);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(192 96 60 / 0%);
    }
  }

  /* The accent isn't a colour change: the words stay ink over a butter
     highlighter stripe drawn through their lower half. */
  .chero__accent {
    background-image: linear-gradient(
      180deg,
      transparent 56%,
      var(--c-butter) 56%,
      var(--c-butter) 93%,
      transparent 93%
    );
  }

  .chero__reassure {
    margin: 22px 0 0;
    font-size: 15px;
    color: var(--c-ink-4);
  }

  /* Three floating figure pills, each tilted and indented differently. */
  .chero__stats {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding-top: 38px;
  }

  .chero__chip {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 16px 26px;
    border: 1px solid rgb(34 30 26 / 8%);
    border-radius: 999px;
    background: var(--c-card);
    box-shadow:
      0 1px 2px rgb(34 30 26 / 7%), 0 24px 48px -20px rgb(34 30 26 / 22%),
      inset 0 1px 0 rgb(255 255 255 / 90%);
    animation: cfloaty 5.5s ease-in-out infinite;
  }

  .chero__chip--1 {
    rotate: -2deg;
  }

  .chero__chip--2 {
    margin-left: 34px;
    rotate: 1.5deg;
    animation-delay: -1.6s;
    animation-duration: 6.2s;
  }

  .chero__chip--3 {
    margin-left: 10px;
    rotate: -1deg;
    animation-delay: -3.4s;
    animation-duration: 5s;
  }

  @keyframes cfloaty {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -9px;
    }
  }

  .chero__chip-num {
    font-size: 22px;
    font-weight: 600;
    color: var(--c-terra);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .chero__chip-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--c-ink-2);
    white-space: nowrap;
  }

  .chero__note {
    margin: 8px 0 0;
    max-width: 280px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--c-ink-4);
  }

  .chero__note a {
    color: var(--c-green);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .chero__note a:hover,
  .chero__note a:focus-visible {
    color: var(--c-terra);
  }

  /* The export caps these two titles so they break onto two lines. */
  #practices .ctitle {
    max-width: 760px;
  }

  #services .ctitle,
  #start .ctitle {
    max-width: 820px;
  }

  /* ------------------------------------------------------------- cases -- */
  .ccases {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    align-items: start;
  }

  .ccase {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 32px 30px 30px;
    border-radius: 30px;
    background: var(--c-card);
    color: var(--c-ink);
    box-shadow: var(--c-raised-green);
    transition:
      transform 0.3s cubic-bezier(0.2, 0.8, 0.25, 1),
      box-shadow 0.3s cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  /* The middle card sits proud in the design. The offset is a margin, not a
     `translate`: the reveal in ConsultingLayout animates `translate` and
     clears it to `none` inline when the card comes into view, which outranks
     any stylesheet rule and flattened the card back into the row. It keeps
     its own resting shadow so the hover below still reads as a lift. */
  .ccase:nth-child(2) {
    margin-top: -18px;
    box-shadow: var(--c-float-green);
  }

  .ccase:hover,
  .ccase:focus-visible {
    transform: translateY(-6px);
    box-shadow: var(--c-float-green);
  }

  .ccase__metric-label {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-green);
  }

  .ccase__metric {
    font-size: clamp(40px, 4vw, 58px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--c-terra);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .ccase__metric-note {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--c-ink-4);
  }

  .ccase__rule {
    display: block;
    height: 1px;
    margin: 14px 0 10px;
    background: var(--c-line);
  }

  .ccase__client {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink-3);
  }

  .ccase__title {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.15;
  }

  .ccase__line {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--c-ink-2);
    text-wrap: pretty;
  }

  .ccase__more {
    margin-top: auto;
    padding-top: 14px;
    font-size: 14px;
    font-weight: 600;
    color: var(--c-green);
  }

  /* ------------------------------------------------------- engagements -- */
  .cengs {
    margin-top: 36px;
    border-top: 1px solid rgb(34 30 26 / 14%);
  }

  .ceng {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.7fr) minmax(0, 1.1fr);
    gap: clamp(16px, 2.5vw, 44px);
    align-items: center;
    padding-block: 24px;
    border-bottom: 1px solid rgb(34 30 26 / 12%);
  }

  .ceng__name {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .ceng__line {
    font-size: 15px;
    line-height: 1.6;
    color: var(--c-ink-2);
    text-wrap: pretty;
  }

  /* The length reads as a green hairline pill. */
  .ceng__length {
    justify-self: start;
    padding: 8px 16px;
    border: 1px solid rgb(47 93 80 / 35%);
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1;
    color: var(--c-green);
    white-space: nowrap;
  }

  /* ----------------------------------------------------------- contact -- */
  /* The availability tag: butter, tilted, above the title. */
  .ccontact__avail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 24px;
    padding: 9px 16px;
    border-radius: 999px;
    background: var(--c-butter);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--c-ink);
    rotate: -1.5deg;
    box-shadow: 0 1px 2px rgb(34 30 26 / 10%), 0 16px 32px -16px rgb(34 30 26 / 30%);
  }

  .ccontact__avail .chero__dot {
    width: 9px;
    height: 9px;
  }

  /* The home band's title and lede run bigger than the sub-pages' CTA. The
     section is in the selector to outrank the layout's `.c .csection--terra
     .ctitle` — this page renders the section, so the scope attribute lands on
     both compounds. */
  .csection--terra .ccontact__title {
    max-width: 1050px;
    font-size: clamp(38px, 5.2vw, 86px);
    line-height: 1;
  }

  .csection--terra .ccontact__lede {
    margin: 24px 0 0;
    max-width: 620px;
    font-size: clamp(16px, 1.7vw, 19px);
  }

  .ccontact {
    margin-top: clamp(36px, 4.5vw, 58px);
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(32px, 4.5vw, 72px);
    align-items: start;
  }

  /* The form is a cream card on the terracotta. */
  .cform {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: clamp(26px, 3vw, 40px);
    border-radius: 30px;
    background: var(--c-card);
    color: var(--c-ink);
    box-shadow:
      0 1px 2px rgb(34 30 26 / 10%), 0 44px 80px -28px rgb(60 20 10 / 45%),
      inset 0 1px 0 rgb(255 255 255 / 90%);
  }

  .cfield {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--c-ink-3);
  }

  .cfield input,
  .cfield textarea {
    width: 100%;
