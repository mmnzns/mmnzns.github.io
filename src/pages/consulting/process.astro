---
import ConsultingLayout from '../../layouts/ConsultingLayout.astro';
import { CONTACT } from '../../config';
import { FIT_NO, FIT_YES, PRINCIPLES, PROCESS_HERO, PROCESS_JUMPS, PROCESS_STEPS } from '../../data/consulting';

/** `/consulting/process/` — ported from the v14 export's `Monzones-C-Process`. */
---

<ConsultingLayout
  title="Process · Consulting"
  description="How a consulting engagement starts and runs: three steps to begin, four principles once we're going, and an honest read on fit before anyone spends a dollar."
  current="process"
>
  <section class="chero" id="top">
    <div class="cwrap chero__grid">
      <div>
        <span class="ckicker ckicker--hero">{PROCESS_HERO.kicker}</span>
        <h1 class="disp chero__title">{PROCESS_HERO.title}</h1>
        <p class="chero__body">{PROCESS_HERO.body}</p>
        <div class="ctarow">
          <a class="cbtn cbtn--solid" href="/consulting/#contact">Send that note</a>
          <a class="cbtn cbtn--ghost" href="#fit">Read the fit test</a>
        </div>
      </div>

      <nav class="cjump cjump--labelled" aria-label="On this page">
        <span class="cminilabel">On this page</span>
        {
          PROCESS_JUMPS.map((jump) => (
            <a href={jump.href}>
              <span>{jump.name}</span>
              <span class="cjump__meta">{jump.meta}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section class="csection csection--overlap" id="start">
    <div class="cwrap">
      <div data-reveal>
        <span class="ckicker">How it starts</span>
        <h2 class="disp ctitle">Three steps. No mystery.</h2>
      </div>

      <div class="csteps csteps--overlap">
        {
          PROCESS_STEPS.map((step) => (
            <div class="cstep" data-reveal>
              <span class="disp cstep__num">{step.num}</span>
              <span class="disp cstep__name">{step.name}</span>
              <span class="cstep__body">{step.body}</span>
              <span class="cstep__bail">{step.bail}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="csection csection--green csection--after-overlap-88" id="running">
    <div class="cwrap">
      <div data-reveal>
        <span class="ckicker">Once we’re going</span>
        <h2 class="disp ctitle">What working together looks like.</h2>
      </div>
      <p class="clede" data-reveal>
        The shape flexes with the <a class="cinline" href="/consulting/services/">engagement you
        pick</a>, but the principles don’t.
      </p>

      <div class="cprinciples">
        {
          PRINCIPLES.map((principle) => (
            <div class="cprinciple" data-reveal>
              <span class="cprinciple__tag">{principle.tag}</span>
              <span class="disp cprinciple__name">{principle.name}</span>
              <span class="cprinciple__body">{principle.body}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="csection csection--deep" id="fit">
    <div class="cwrap">
      <div data-reveal>
        <span class="ckicker">Fit</span>
        <h2 class="disp ctitle">Real talk about fit.</h2>
      </div>
      <p class="clede" data-reveal>
        This works best when there’s a real problem to understand, enough signal to learn from, and
        a team willing to look at the whole system. If it’s not a fit, I’ll tell you early and
        cheerfully. That saves us both a quarter.
      </p>

      <div class="cfit">
        <div class="cfit__col cfit__col--yes" data-reveal>
          <p class="cfit__head cfit__head--yes">We’ll get along if</p>
          {
            FIT_YES.map((line) => (
              <p class="cfit__row cfit__row--yes">
                <span class="cfit__sign" aria-hidden="true">
                  +
                </span>
                {line}
              </p>
            ))
          }
        </div>
        <div class="cfit__col cfit__col--no" data-reveal>
          <p class="cfit__head cfit__head--no">Probably not, if</p>
          {
            FIT_NO.map((line) => (
              <p class="cfit__row cfit__row--no">
                <span class="cfit__sign" aria-hidden="true">
                  −
                </span>
                {line}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="csection csection--terra" id="cta">
    <div class="cwrap">
      <h2 class="disp ctitle" data-reveal>Step one is two paragraphs. That’s it.</h2>
      <p class="clede" data-reveal>
        What’s happening, which number you’re watching, what you’ve tried. I’ll take it from there.
      </p>
      <div class="ctarow" data-reveal>
        <a class="cbtn cbtn--solid" href="/consulting/#contact">Send that note</a>
        <a class="cbtn cbtn--ghost" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      </div>
    </div>
  </section>
</ConsultingLayout>

<style>
  /* Page-unique styles; the shared vocabulary is in ConsultingLayout.astro.
     Values are the v14 export's (`Monzones-C-Process`). */

  .cstep__bail {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--c-line);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--c-green);
  }

  .cinline {
    color: var(--c-butter);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cinline:hover,
  .cinline:focus-visible {
    color: var(--c-card);
  }

  /* Four outlined cards on the green, no fill. */
  .cprinciples {
    margin-top: 36px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(18px, 2.2vw, 32px);
  }

  .cprinciple {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    border: 1px solid rgb(244 239 230 / 20%);
    border-radius: 26px;
    transition:
      transform 0.3s cubic-bezier(0.2, 0.8, 0.25, 1),
      border-color 0.25s ease;
  }

  .cprinciple:hover {
    transform: translateY(-5px);
    border-color: rgb(246 231 178 / 70%);
  }

  .cprinciple__tag {
    align-self: flex-start;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-butter);
  }

  .cprinciple__name {
    font-size: 19.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--c-paper);
  }

  .cprinciple__body {
    font-size: 14.5px;
    line-height: 1.65;
    color: rgb(244 239 230 / 72%);
    text-wrap: pretty;
  }

  #running .ctitle {
    max-width: 860px;
  }

  #fit .clede {
    max-width: 680px;
  }

  /* Two cards; the "yes" column floats, the "no" column sits lower and flatter. */
  .cfit {
    margin-top: 36px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
    align-items: start;
  }

  .cfit__col {
    padding: clamp(26px, 3vw, 40px);
    border: 1px solid rgb(34 30 26 / 8%);
    border-radius: 30px;
    background: var(--c-card);
  }

  .cfit__col--yes {
    box-shadow: var(--c-float);
  }

  .cfit__col--no {
    margin-top: 26px;
    box-shadow: var(--c-raised);
  }

  .cfit__head {
    margin: 0 0 14px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cfit__head--yes {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--c-butter);
    color: var(--c-green);
    rotate: -1.5deg;
    box-shadow: 0 1px 2px rgb(34 30 26 / 7%);
  }

  .cfit__head--no {
    padding: 8px 0;
    color: var(--c-ink-4);
  }

  .cfit__row {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 12px;
    margin: 0;
    padding: 14px 0;
    border-top: 1px solid var(--c-line);
    font-size: 15px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .cfit__row--yes {
    color: var(--c-ink);
  }

  .cfit__row--no {
    color: var(--c-ink-2);
  }

  .cfit__sign {
    font-weight: 700;
  }

  .cfit__row--yes .cfit__sign {
    color: var(--c-terra);
  }

  .cfit__row--no .cfit__sign {
    color: var(--c-ink);
  }

  @media (max-width: 1080px) {
    .cprinciples {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 760px) {
    .cfit {
      grid-template-columns: 1fr;
    }

    .cfit__col--no {
      margin-top: 0;
    }
  }

  @media (max-width: 560px) {
    .cprinciples {
      grid-template-columns: 1fr;
    }
  }
</style>
