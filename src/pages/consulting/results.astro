---
import ConsultingLayout from '../../layouts/ConsultingLayout.astro';
import { CONTACT } from '../../config';
import { RESULTS_HERO, RESULT_STORIES, STATS } from '../../data/consulting';

/** `/consulting/results/` — ported from the v14 export's `Monzones-C-Results`. */
---

<ConsultingLayout
  title="Results · Consulting"
  description="The headline numbers from real consulting engagements and the stories behind them: what was stuck, what changed, and what moved."
  current="results"
>
  <section class="chero" id="top">
    <div class="cwrap chero__grid">
      <div>
        <span class="ckicker ckicker--hero">{RESULTS_HERO.kicker}</span>
        <h1 class="disp chero__title chero__title--results">{RESULTS_HERO.title}</h1>
        <p class="chero__body">{RESULTS_HERO.body}</p>
        <div class="ctarow">
          <a class="cbtn cbtn--solid" href="#stories">Read the stories</a>
          <a class="cbtn cbtn--ghost" href="/consulting/#contact">Book a free 30-min call</a>
        </div>
      </div>

      <nav class="cjump cjump--labelled" aria-label="The stories">
        <span class="cminilabel">Three stories</span>
        {
          RESULT_STORIES.map((story, i) => (
            <a class="cjumpstory" href={`#${story.id}`}>
              <span class="disp cjumpstory__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="cjumpstory__text">
                <span class="cjumpstory__title">{story.title}</span>
                <span class="cjumpstory__meta">{story.client}</span>
              </span>
              <span class="cjumpstory__arrow" aria-hidden="true">↓</span>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section class="csection csection--overlap" id="numbers">
    <div class="cwrap">
      <div class="cnumbers__head" data-reveal>
        <span class="ckicker">The numbers</span>
        <h2 class="disp ctitle">Four figures, all from real work.</h2>
      </div>

      <div class="cstats" data-reveal>
        {
          STATS.map((stat) => (
            <div class="cstat">
              <span class="cstat__rule" aria-hidden="true" />
              <p class="disp cstat__num">{stat.num}</p>
              <p class="cstat__label">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="csection csection--green csection--after-overlap" id="stories">
    <div class="cwrap">
      <div class="cstories__head" data-reveal>
        <span class="ckicker">The stories behind the numbers</span>
        <h2 class="disp ctitle">What was stuck, and what moved.</h2>
      </div>

      <div class="cstories">
        {
          RESULT_STORIES.map((story) => (
            <article class="cstory" id={story.id} data-reveal>
              <div class="cstory__figure">
                <span class="cstory__label">{story.metricLabel}</span>
                <p class="disp cstory__metric">{story.metric}</p>
                <p class="cstory__note">{story.metricNote}</p>
                <p class="cstory__second">{story.second}</p>
              </div>

              <div class="cstory__text">
                <span class="cstory__client">{story.client}</span>
                <h3 class="disp cstory__title">{story.title}</h3>
                <p class="cstory__block cstory__block--stuck">
                  <span class="cstory__blocklabel">What was stuck</span>
                  {story.stuck}
                </p>
                <p class="cstory__block">
                  <span class="cstory__blocklabel">What we did</span>
                  {story.did}
                </p>
                <a class="cstory__link" href={story.href}>Read the full case study →</a>
              </div>
            </article>
          ))
        }
      </div>

      <p class="cstories__note" data-reveal>
        Three engagements, written up with the context intact. Dig into the full case studies, and
        I’m happy to walk through the detail on a call.
      </p>
    </div>
  </section>

  {/*
    The export leaves this band's top corners square on this one page while the
    other three round them; the other three are taken as the intent.
  */}
  <section class="csection csection--terra" id="cta">
    <div class="cwrap">
      <h2 class="disp ctitle" data-reveal>Want numbers like these? Tell me which one’s stuck.</h2>
      <p class="clede" data-reveal>
        Two paragraphs is plenty to start, and the first call is free and useful either way.
      </p>
      <div class="ctarow" data-reveal>
        <a class="cbtn cbtn--solid" href="/consulting/#contact">Book a free 30-min call</a>
        <a class="cbtn cbtn--ghost" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      </div>
    </div>
  </section>
</ConsultingLayout>

<style>
  /* Page-unique styles; the shared vocabulary is in ConsultingLayout.astro.
     Values are the v14 export's (`Monzones-C-Results`). */

  .chero__grid .chero__title--results {
    max-width: 820px;
  }

  /* The hero's story list: number, title and client, arrow. */
  .cjump > .cjumpstory {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    align-items: baseline;
    padding-block: 15px;
  }

  .cjumpstory__num {
    font-size: 14px;
    font-weight: 600;
    color: var(--c-terra);
  }

  .cjumpstory__text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .cjumpstory__title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
  }

  .cjumpstory__meta {
    font-size: 12.5px;
    font-weight: 400;
    line-height: 1.4;
    color: var(--c-ink-4);
  }

  .cjumpstory__arrow {
    font-size: 14px;
  }

  .cnumbers__head {
    margin-bottom: clamp(28px, 3vw, 40px);
  }

  .cstories__head {
    margin-bottom: clamp(36px, 4vw, 56px);
  }

  .cstories__head .ctitle {
    max-width: 860px;
  }

  .cstories {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  /* Three cream cards on the green: the first floats, the second sits
     raised, the third stays close to the band. */
  .cstory {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(24px, 3.5vw, 56px);
    padding: clamp(28px, 3.4vw, 48px);
    border: 1px solid rgb(34 30 26 / 6%);
    border-radius: 30px;
    background: var(--c-card);
    color: var(--c-ink);
    scroll-margin-top: 96px;
    box-shadow:
      0 1px 2px rgb(34 30 26 / 7%), 0 12px 24px -16px rgb(14 30 26 / 30%),
      inset 0 1px 0 rgb(255 255 255 / 90%);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.25, 1);
  }

  .cstory:nth-child(1) {
    box-shadow: var(--c-float-green);
  }

  .cstory:nth-child(2) {
    box-shadow: var(--c-raised-green);
  }

  .cstory:hover {
    transform: translateY(-4px);
  }

  .cstory__label {
    display: block;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink-4);
  }

  .cstory__metric {
    margin: 12px 0 0;
    font-size: clamp(44px, 5vw, 76px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
    color: var(--c-terra);
    font-variant-numeric: tabular-nums;
  }

  .cstory__note {
    margin: 12px 0 0;
    max-width: 240px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--c-ink-4);
  }

  .cstory__second {
    display: inline-block;
    margin: 20px 0 0;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--c-butter);
    color: var(--c-green);
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1;
    rotate: -1.5deg;
    box-shadow: 0 1px 2px rgb(34 30 26 / 10%);
  }

  .cstory__text {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .cstory__client {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink-4);
  }

  .cstory__title {
    margin: 0;
    font-size: clamp(24px, 2.4vw, 36px);
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.08;
  }

  .cstory__block {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--c-ink-2);
    text-wrap: pretty;
  }

  .cstory__block--stuck {
    color: var(--c-ink);
  }

  .cstory__blocklabel {
    display: block;
    margin-bottom: 5px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-terra);
  }

  .cstory__link {
    align-self: flex-start;
    margin-top: 6px;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--c-terra);
    font-size: 14.5px;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .cstory__link:hover,
  .cstory__link:focus-visible {
    color: var(--c-terra);
  }

  .cstories__note {
    margin: 32px 0 0;
    max-width: 680px;
    font-size: 14.5px;
    line-height: 1.65;
    color: rgb(244 239 230 / 68%);
  }

  @media (max-width: 860px) {
    .cstory {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 719px) {
    .cstory__link {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
