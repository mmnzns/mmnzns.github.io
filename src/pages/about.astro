---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import poster from '../assets/about-poster.png';
import {
  INTRO,
  WHAT_I_DO,
  HOW_I_GOT_HERE,
  SCOPE_PROOF,
  TOTALS,
  BELIEF,
  OUTSIDE_WORK,
  TO_WORK_WITH,
  ROLES,
  INTRO_VIDEO,
} from '../data/about';
---

<BaseLayout
  title="About"
  description="Miguel Monzones — eleven years on lifecycle and GTM across fintech, SaaS and ecommerce. Canada, then a farm in the Philippines, then newsrooms, then marketing systems."
>
  <section class="section--first wrap" id="top">
    <p class="eyebrow about-hero__eyebrow">About</p>
    <h1 class="page-title">A bit more about me.</h1>

    <div class="about-hero__intro">
      {INTRO.map((para, i) => <p class={i === 0 ? 'about-hero__hello' : undefined}>{para}</p>)}
    </div>
  </section>

  {/* ------------------------------------------------------ what I do -- */}
  <section class="section--tight wrap">
    <div class="portrait-split">
      <figure class="portrait">
        <Image src={poster} alt="Miguel Monzones" width={880} height={1100} loading="lazy" />
        <a class="portrait__play" href={INTRO_VIDEO.href} target="_blank" rel="noopener">
          <span class="portrait__icon" aria-hidden="true">▶</span>
          {INTRO_VIDEO.label}
        </a>
      </figure>

      <div class="portrait-split__body">
        <p class="eyebrow prose-block__eyebrow">What I do</p>
        <div class="prose-block" data-reveal-group>
          {WHAT_I_DO.map((para) => <p>{para}</p>)}
        </div>
        <p class="portrait-split__sign">Miguel Monzones</p>
      </div>
    </div>
  </section>

  {/* --------------------------------------------------- how I got here -- */}
  <section class="section wrap">
    <div class="split">
      <div>
        <p class="eyebrow split__eyebrow">How I got here</p>
        <h2 class="split__title">Canada, then a farm, then newsrooms.</h2>
      </div>
      <div class="prose-block" data-reveal-group>
        {HOW_I_GOT_HERE.map((para) => <p>{para}</p>)}
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------ scope band -- */}
  <section class="band about-band">
    <div class="wrap">
      <blockquote class="about-band__quote">
        Every role I’ve had turned into something bigger than what I was hired for.
      </blockquote>

      <div class="about-band__proof">
        {SCOPE_PROOF.map((para) => <p>{para}</p>)}
      </div>

      <hr class="band-rule about-band__rule" />

      <div class="stat-row">
        {
          TOTALS.map((total) => (
            <div>
              <p
                class="stat__value"
                data-count={'countTo' in total ? total.countTo : undefined}
                data-suffix={'suffix' in total ? total.suffix : undefined}
              >
                {total.value}
              </p>
              <p class="stat__label">{total.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* --------------------------------------------------- what I believe -- */}
  <section class="section wrap">
    <div class="split">
      <div>
        <p class="eyebrow split__eyebrow">What I believe</p>
        <h2 class="split__title">At the core of all of it is one idea:</h2>
      </div>
      <div class="prose-block" data-reveal-group>
        <p class="belief">{BELIEF.headline}</p>
        {BELIEF.paras.map((para) => <p>{para}</p>)}
        <p>
          {BELIEF.tattoo.before}<em>{BELIEF.tattoo.phrase}</em>{BELIEF.tattoo.after}
        </p>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------- outside work -- */}
  <section class="section wrap">
    <div class="split">
      <div>
        <p class="eyebrow split__eyebrow">Outside work</p>
        <h2 class="split__title">Food, fiction, and a fat cat.</h2>
      </div>
      <div class="prose-block" data-reveal-group>
        {OUTSIDE_WORK.map((para) => <p>{para}</p>)}
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------- roles -- */}
  <section class="section wrap">
    <div class="split">
      <div>
        <p class="eyebrow split__eyebrow">Where</p>
        <h2 class="split__title">Where I’ve worked.</h2>
      </div>

      <div class="roles">
        {
          ROLES.map((role) => (
            <div class="roles__row">
              <div>
                <p class="roles__org">{role.org}</p>
                <p class="roles__title">{role.title}</p>
                <p class="roles__what">{role.what}</p>
              </div>
              <p class="roles__years">{role.years}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* -------------------------------------------------- to work with -- */}
  <section class="section wrap">
    <div class="split">
      <div>
        <p class="eyebrow split__eyebrow">What I’m like to work with</p>
      </div>
      <div class="prose-block" data-reveal-group>
        {TO_WORK_WITH.map((para) => <p>{para}</p>)}
      </div>
    </div>
  </section>

  <ContactSection
    title="Get in touch."
    intro="Want to work together, chat about something you’re stuck on, or just say hey? Reach out here."
    aside="And if you’re ever in Vancouver, coffee’s on me. I’d rather hear the problem out loud anyway."
  />
</BaseLayout>

{/* The `data-count` totals are animated by Motion.astro, along with every other
    scroll-driven effect on the site. There is no page-local script here on
    purpose: two observers watching the same elements would count twice. */}

<style>
  .about-hero__eyebrow {
    margin-bottom: 26px;
  }

  .about-hero__intro {
    margin-top: 44px;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .about-hero__hello {
    color: var(--ink);
  }

  /* ------------------------------------------------------------ split -- */
  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(32px, 5vw, 56px);
    align-items: start;
  }

  .split__eyebrow {
    margin-bottom: 20px;
  }

  .split__title {
    font-size: clamp(28px, 3.2vw, 42px);
    line-height: 1.08;
  }

  .prose-block {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    font-size: 18px;
    line-height: 1.66;
  }

  .prose-block__eyebrow {
    margin-bottom: 22px;
  }

  .belief {
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.014em;
    text-wrap: balance;
  }

  /* -------------------------------------------------------- portrait -- */
  .portrait-split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(40px, 6vw, 72px);
    align-items: start;
  }

  .portrait {
    position: relative;
    margin: 0;
  }

  .portrait :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    display: block;
    box-shadow: var(--shadow);
  }

  .portrait__play {
    position: absolute;
    bottom: 18px;
    left: 18px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 16px 9px 12px;
    background: rgb(251 249 246 / 94%);
    border-radius: var(--pill);
    font-size: 13px;
    font-weight: 500;
    transition:
      background var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .portrait__play:hover {
    background: var(--card);
    transform: translateY(-1px);
    color: var(--ink);
  }

  .portrait__icon {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: var(--pill);
    background: var(--accent);
    color: #fff;
    font-size: 9px;
  }

  .portrait-split__body {
    padding-top: 6px;
  }

  .portrait-split__sign {
    margin-top: 34px;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  /* ------------------------------------------------------------- band -- */
  .about-band {
    margin-top: clamp(96px, 14vw, 170px);
  }

  .about-band__quote {
    margin: 0;
    max-width: 880px;
    font-size: clamp(28px, 4vw, 52px);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.12;
    color: var(--sun);
    text-wrap: balance;
  }

  .about-band__proof {
    margin-top: clamp(44px, 5vw, 64px);
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: start;
  }

  .about-band__proof p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--on-dark-2);
  }

  .about-band__rule {
    margin-block: clamp(52px, 6vw, 76px) clamp(44px, 5vw, 60px);
  }

  /* ------------------------------------------------------------ roles -- */
  .roles {
    display: flex;
    flex-direction: column;
  }

  .roles__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: baseline;
    padding-block: 22px;
    border-bottom: 1px solid var(--rule);
  }

  .roles__org {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.005em;
  }

  .roles__title {
    margin-top: 3px;
    font-size: 16px;
    line-height: 1.4;
    color: var(--ink-3);
  }

  .roles__what {
    margin-top: 5px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .roles__years {
    font-size: 13px;
    color: var(--ink-3);
    white-space: nowrap;
  }

  @media (min-width: 860px) {
    .about-band__proof {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }
</style>
