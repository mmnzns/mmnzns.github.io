    width: clamp(120px, 15vw, 220px);
    pointer-events: none;
  }
  .coffee__cup img {
    display: block;
    width: 100%;
    height: auto;
    transform-origin: 50% 90%;
    animation: cup 4.8s ease-in-out infinite;
    filter: drop-shadow(0 12px 16px rgba(15, 20, 40, 0.35));
  }
  .coffee__cup.is-in {
    animation: slap 0.7s cubic-bezier(0.3, 1.4, 0.5, 1) both;
  }
  @keyframes cup {
    0%,
    100% {
      transform: translateY(0) rotate(8deg);
    }
    50% {
      transform: translateY(-10px) rotate(4deg);
    }
  }
  @keyframes slap {
    0% {
      opacity: 0;
      transform: scale(1.8) rotate(-20deg);
    }
    60% {
      opacity: 1;
      transform: scale(0.94) rotate(12deg);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;
  const narrow = window.matchMedia('(max-width: 899px)');
  const EASE = 'cubic-bezier(.16,1,.3,1)';
  const FAILSAFE_MS = 2600;

  /* ------------------------------------------------ skills: an ARIA tablist */
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-skill]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  const select = (i: number, focus = false) => {
    tabs.forEach((t, k) => {
      t.setAttribute('aria-selected', String(k === i));
      t.tabIndex = k === i ? 0 : -1;
    });
    panels.forEach((p, k) => p.classList.toggle('is-off', k !== i));
    if (focus) tabs[i].focus();
    if (reduced) return;
    panels[i].querySelectorAll<HTMLElement>('[data-tag]').forEach((t, k) => {
      t.style.transition = 'none';
      t.style.opacity = '0';
      t.style.translate = '0 10px';
      t.style.rotate = `${k % 2 ? 3 : -3}deg`;
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          t.style.transition = `opacity .5s ${EASE} ${k * 35}ms, translate .6s ${EASE} ${k * 35}ms, rotate .6s ${EASE} ${k * 35}ms`;
          t.style.opacity = '';
          t.style.translate = '';
          t.style.rotate = '';
        }),
      );
    });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('mouseenter', () => {
      if (fine && t.getAttribute('aria-selected') !== 'true') select(i);
    });
    t.addEventListener('keydown', (e) => {
      const keys: Record<string, number> = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 };
      if (e.key in keys) {
        e.preventDefault();
        select((i + keys[e.key] + tabs.length) % tabs.length, true);
      } else if (e.key === 'Home' || e.key === 'End') {
        e.preventDefault();
        select(e.key === 'Home' ? 0 : tabs.length - 1, true);
      }
    });
  });

  /* ------------------------------------------ certificates: filter + collapse */
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-issuer]'));
  const certs = Array.from(document.querySelectorAll<HTMLElement>('[data-cert]'));
  const more = document.querySelector<HTMLButtonElement>('[data-certs-toggle]')!;
  const moreIcon = document.querySelector<HTMLElement>('[data-certs-icon]')!;
  const moreLabel = document.querySelector<HTMLElement>('[data-certs-label]')!;
  let issuer = 'All';
  let open = false;
  const applyCerts = (animate: boolean) => {
    const matches = certs.filter((c) => issuer === 'All' || c.dataset.group === issuer);
    // Phones see three and a button, not a wall of twenty-one.
    const cap = narrow.matches && !open && matches.length > 3;
    certs.forEach((c) => (c.hidden = true));
    (cap ? matches.slice(0, 3) : matches).forEach((c) => (c.hidden = false));
    chips.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.issuer === issuer)));
    more.hidden = !(narrow.matches && matches.length > 3);
    moreIcon.textContent = open ? '−' : '+';
    moreLabel.textContent = open ? 'Show fewer' : `Show all ${matches.length}${issuer === 'All' ? '' : ` ${issuer}`} certificates`;
    if (!animate || reduced) return;
    certs
      .filter((c) => !c.hidden)
      .forEach((c, i) => {
        c.style.transition = 'none';
        c.style.opacity = '0';
        c.style.translate = '0 18px';
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            const d = Math.min(i, 12) * 35;
            c.style.transition = `opacity .6s ${EASE} ${d}ms, translate .8s ${EASE} ${d}ms, transform .45s ${EASE}, box-shadow .45s`;
            c.style.opacity = '';
            c.style.translate = '';
          }),
        );
      });
  };
  chips.forEach((b) =>
    b.addEventListener('click', () => {
      if (issuer === b.dataset.issuer) return;
      issuer = b.dataset.issuer ?? 'All';
      applyCerts(true);
    }),
  );
  more.addEventListener('click', () => {
    open = !open;
    applyCerts(false);
  });
  narrow.addEventListener('change', () => applyCerts(false));
  applyCerts(false);

  /* ------------------------------------- beliefs: typed on when they arrive */
  const typers = Array.from(document.querySelectorAll<HTMLElement>('[data-type]'));
  if (!reduced && typeof IntersectionObserver === 'function') {
    const pendingType = new Set<HTMLElement>();
    const typeOn = (el: HTMLElement, instant = false) => {
      if (!pendingType.delete(el)) return;
      const full = el.getAttribute('aria-label') ?? '';
      if (instant) {
        el.textContent = full;
        return;
      }
      const text = document.createTextNode('');
      const caret = document.createElement('span');
      caret.className = 'caret';
      caret.setAttribute('aria-hidden', 'true');
      el.append(text, caret);
      let i = 0;
      const step = () => {
        i += 1 + (Math.random() < 0.2 ? 1 : 0);
        text.nodeValue = full.slice(0, i);
        if (i < full.length) window.setTimeout(step, 26 + Math.random() * 40);
        else window.setTimeout(() => caret.remove(), 1400);
      };
      window.setTimeout(step, 150);
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting && e.boundingClientRect.bottom >= 0) continue;
          io.unobserve(e.target);
          typeOn(e.target as HTMLElement, !e.isIntersecting);
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );
    typers.forEach((el) => {
      // The heading keeps its words as its accessible name while it types.
      el.setAttribute('aria-label', el.textContent ?? '');
      el.textContent = '';
      pendingType.add(el);
      io.observe(el);
    });
    const flush = () => {
      for (const el of [...pendingType]) if (el.getBoundingClientRect().top < window.innerHeight) typeOn(el, true);
    };
    window.setTimeout(flush, FAILSAFE_MS);
    document.addEventListener('visibilitychange', () => document.visibilityState === 'visible' && flush());
  }

  /* --------------------------------------------- the scroll-pinned career */
  const pin = document.querySelector<HTMLElement>('[data-pin]');
  const strip = document.querySelector<HTMLElement>('[data-strip]');
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const roles = strip ? strip.children.length : 0;
  const pinFrame = () => {
    if (!pin || !strip || !pin.classList.contains('is-pinned')) return;
    const r = pin.getBoundingClientRect();
    const range = r.height - window.innerHeight;
    if (range <= 0 || r.bottom < 0 || r.top > window.innerHeight) return;
    const p = Math.min(1, Math.max(0, -r.top / range));
    const dist = Math.max(0, strip.scrollWidth - window.innerWidth);
    strip.style.transform = `translate3d(${(-p * dist).toFixed(1)}px,0,0)`;
    if (rail) rail.style.transform = `scaleX(${p.toFixed(4)})`;
  };
  const setPinned = () => {
    if (!pin || !strip) return;
    const on = !reduced && !narrow.matches;
    pin.classList.toggle('is-pinned', on);
    pin.style.height = on ? `${roles * 55 + 60}vh` : '';
    if (!on) {
      strip.style.transform = '';
      if (rail) rail.style.transform = '';
    }
    pinFrame();
  };
  setPinned();
  narrow.addEventListener('change', setPinned);

  /* ---------------------------------------- the smaller scroll flourishes */
  const photo = document.querySelector<HTMLElement>('[data-tilt]');
  const parallax = document.querySelector<HTMLElement>('[data-parallax]');
  const cup = document.querySelector<HTMLElement>('[data-cup]');
  const stamp = document.querySelector<HTMLElement>('[data-stamp]');
  const sym = document.querySelector<HTMLElement>('[data-sym]');
  let px = -999;
  let py = -999;
  let tilt = 0;
  let symT0 = 0;
  let symN = 0;

  if (!reduced) {
    if (cup) cup.style.opacity = '0';
    if (stamp) stamp.style.opacity = '0';
    if (sym) sym.style.opacity = '0';
    // If rAF never runs, none of the three may stay invisible.
    window.setTimeout(() => {
      for (const el of [cup, stamp, sym]) if (el && el.style.opacity === '0' && el.getBoundingClientRect().top < window.innerHeight) el.style.opacity = '';
    }, FAILSAFE_MS);
  }
  window.addEventListener(
    'pointermove',
    (e) => {
      px = e.clientX;
      py = e.clientY;
    },
    { passive: true },
  );

  const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
  const tick = (now: number) => {
    requestAnimationFrame(tick);
    pinFrame();
    if (reduced) return;
    const vh = window.innerHeight;

    if (photo && fine) {
      const r = photo.getBoundingClientRect();
      if (r.bottom > 0 && r.top < vh) {
        const tx = px > -900 ? clamp((px - (r.left + r.width / 2)) / window.innerWidth, -0.5, 0.5) : 0;
        tilt += (tx - tilt) * 0.06;
        photo.style.transform = `rotate(${(-2 + tilt * 4).toFixed(2)}deg)`;
      }
    }
    if (parallax) {
      const r = parallax.parentElement!.getBoundingClientRect();
      if (r.bottom > 0 && r.top < vh) {
        parallax.style.transform = `translate3d(0,${(((r.top + r.height / 2 - vh / 2) / vh) * -50).toFixed(1)}px,0) scale(1.14)`;
      }
    }
    if (cup && !cup.classList.contains('is-in') && cup.getBoundingClientRect().top < vh * 0.82) {
      cup.style.opacity = '';
      cup.classList.add('is-in');
    }
    if (stamp && !stamp.classList.contains('is-stamped') && stamp.getBoundingClientRect().top < vh * 0.8) {
      stamp.style.opacity = '';
      stamp.classList.add('is-stamped');
    }
    if (sym) {
      if (!symT0) {
        const r = sym.getBoundingClientRect();
        if (r.top < vh * 0.85 && r.bottom > 0) symT0 = now;
      } else {
        // Springs in, then idles; leans a little toward a nearby pointer.
        const k = Math.min(1, (now - symT0) / 1000);
        const c = 2.2;
        const e = 1 + (c + 1) * Math.pow(k - 1, 3) + c * Math.pow(k - 1, 2);
        const r = sym.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        const near = fine && px > -900 ? clamp(1 - Math.hypot(px - cx, py - cy) / 260, 0, 1) : 0;
        symN += (near - symN) * 0.1;
        const lean = fine && px > -900 ? clamp((px - cx) / 300, -1, 1) * symN * 10 : 0;
        const idle = k < 1 ? 0 : 1;
        const t = now / 1000;
        const rot = 30 - 22 * e + idle * Math.sin(t * 0.9) * 3 + lean;
        const y = idle * Math.sin(t * 0.7) * 6 - symN * 10;
        const sc = 1.7 - 0.7 * e + symN * 0.08;
        sym.style.opacity = String(Math.min(1, (now - symT0) / 220));
        sym.style.transform = `translate3d(0,${y.toFixed(2)}px,0) rotate(${rot.toFixed(2)}deg) scale(${sc.toFixed(3)})`;
      }
    }
  };
  requestAnimationFrame(tick);
</script>
