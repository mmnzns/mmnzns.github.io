---
/**
 * About — v19 `Monzones-D-About-V4`.
 *
 * Departures, each so nothing is hidden when a script doesn't run:
 *
 *  - The career strip is pinned and scroll-driven only once the script adds
 *    `is-pinned`. Without it (no JS, or reduced motion) it is an ordinary
 *    swipeable row — in the export, reduced motion left four of the five
 *    cards stuck off-screen.
 *  - "Outside work" is native <details name>, so every item opens without
 *    JavaScript and only one stays open at a time.
 *  - All eight skill panels are in the markup; the tabs toggle `hidden`.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT } from '../config';
import { FACTS, ROLES, BELIEFS, LIFE, CERTS, CERT_ISSUERS, SKILLS, INTRO_VIDEO } from '../data/about';
import desk from '../assets/brand/miguel-desk.webp';
import poster from '../assets/brand/about-poster.webp';
import tapeBlue from '../assets/brand/tape-blue.webp';
import tapeYellow from '../assets/brand/tape-yellow.webp';
import ctaResume from '../assets/brand/cta-resume.png';
import ctaLinkedin from '../assets/brand/cta-linkedin.png';
import neaOnnim from '../assets/art/nea-onnim-newspaper-cutout.webp';
import cup from '../assets/art/coffee-cup-cutout.webp';

/** Lets a narrow pill break the address after the @ instead of mid-word. */
const [emailUser, emailDomain] = CONTACT.email.split('@');

/*
 * The résumé button only renders once the PDF is actually in public/, so the
 * live site never offers a download that 404s. Drop the file in and rebuild.
 */
const RESUME_PATH = '/Miguel-Monzones-Resume.pdf';
// Resolved from the project root: Astro builds from there, and import.meta.url
// points into the compiled output rather than src/.
const hasResume = existsSync(join(process.cwd(), 'public', RESUME_PATH));

const pad = (n: number) => String(n).padStart(2, '0');
const INK = ['var(--blue)', 'var(--red)', 'var(--green)', 'var(--amber)'];
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const main = CERT_ISSUERS.map((i) => i.name as string);
const dotFor = (issuer: string) => CERT_ISSUERS.find((i) => i.name === issuer)?.dot ?? (issuer === 'University of Michigan' ? 'var(--ink)' : 'var(--grey)');
const groupOf = (issuer: string) => (main.includes(issuer) ? issuer : 'Other');
const issuerChips = ['All', ...main, 'Other'].map((name) => ({
  name,
  n: name === 'All' ? CERTS.length : CERTS.filter((c) => groupOf(c.issuer) === name).length,
}));
const years = CERTS.map((c) => Number(c.month.slice(0, 4)));
const certSpan = `${CERTS.length} certificates, ${Math.min(...years)} – ${Math.max(...years)}`;
const phoneHref = `tel:${CONTACT.phone.replace(/[^+\d]/g, '')}`;
---

<BaseLayout
  title="About"
  description="Curious by default, builder by upbringing, strategist by habit. Where I've worked, what I believe, and what I'm like to work with."
  current="About"
  breadcrumbs={[{ label: 'About', href: '/about/' }]}
>
  <section class="ahero">
    <div class="mz-max">
      <p class="mz-kicker ahero__kicker" data-hero><span>The profile · About Miguel</span><span class="mz-muted">Vancouver, BC</span></p>
      <div class="ahero__grid">
        <div class="ahero__copy">
          <h1 class="ahero__h1">
            <span data-hero>Curious by default.</span>
            <span data-hero><em>Builder</em> by upbringing.</span>
            <span data-hero data-word class="ahero__word"><span class="ahero__swatch">Strategist by habit.</span></span>
          </h1>
          <p class="ahero__lede" data-hero>
            Hi, I'm Miguel. I build the lifecycle, GTM and automation systems that turn a first click into a long-term customer.
          </p>
          <p class="ahero__sub" data-hero>
            I dig into how things work, listen to the people closest to the problem, and leave behind systems that run without me.
          </p>
        </div>
        <div class="ahero__photo" data-hero>
          <div class="ahero__stage">
          <div class="ahero__frame" data-tilt>
            <div class="ahero__paper">
              <div class="ahero__img">
                <Image src={desk} alt="Miguel Monzones at his desk" widths={[480, 720, 960]} sizes="(max-width: 900px) 92vw, 470px" loading="eager" fetchpriority="high" />
              </div>
              <p class="ahero__caption"><span>Fig. 1 — At the desk</span><span>Vancouver</span></p>
            </div>
            <Image src={tapeBlue} alt="" aria-hidden="true" width={140} densities={[1, 2]} class="mz-tape ahero__tape" />
          </div>
          <a class="vid" href={INTRO_VIDEO.href} target="_blank" rel="noopener" data-magnetic>
            <span class="vid__play" aria-hidden="true">▶</span>{INTRO_VIDEO.label}
          </a>
          </div>
          <div class:list={['ahero__ctas', { 'ahero__ctas--one': !hasResume }]}>
            {
              hasResume && (
                <a class="ahero__cta ahero__cta--resume" href={RESUME_PATH} download="Miguel-Monzones-Resume.pdf">
                  <Image src={ctaResume} alt="Download my résumé (PDF)" widths={[300, 600]} sizes="(max-width: 599px) 300px, 240px" />
                </a>
              )
            }
            <a class="ahero__cta ahero__cta--linkedin" href={CONTACT.linkedin} target="_blank" rel="noopener">
              <Image src={ctaLinkedin} alt="Find me on LinkedIn (opens in a new tab)" widths={[300, 600]} sizes="(max-width: 599px) 300px, 240px" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="facts" aria-label="The short version">
    <div class="mz-max">
      <p class="facts__head mz-double" data-rv>The short version</p>
      <div class="facts__grid">
        {
          FACTS.map((f, i) => (
            <div class="facts__cell" data-rv data-delay={i * 90}>
              <span class="facts__v" data-count>{f.value}</span>
              <span class="facts__l">{f.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="what">
    <div class="what__grid">
      <div class="what__copy">
        <p class="mz-kicker" data-rv>01 / What I do</p>
        <h2 class="mz-h2 what__h2" data-split>Most of my work begins with a <em>question.</em></h2>
        <div class="what__body" data-rv>
          <p><span class="what__drop" aria-hidden="true">A</span><span class="visually-hidden">A</span> journey stalls, a key number slips, or a team is working too hard just to hold a process together. I look across the experience, data, tools and handoffs to find what's really in the way.</p>
          <p>Then I help decide what to change, and build it: a rebuilt lifecycle journey, a better post-click experience, connected tools, or automation that retires manual work.</p>
          <p>Most of it I've done in-house, next to the people who know the customers best. I'm open to the right senior role in lifecycle, conversion and automation.</p>
        </div>
      </div>
      <figure class="quote" data-rv data-delay="120">
        <span class="quote__mark" aria-hidden="true">“</span>
        <blockquote>I follow the problem wherever it goes.</blockquote>
        <figcaption>Useful work crosses teams, tools and disciplines, so my job descriptions rarely stay fixed for long.</figcaption>
      </figure>
    </div>
  </section>

  <section class="career" data-career>
    <div class="career__pin" data-pin>
      <div class="career__stage">
        <div class="mz-wrap career__head">
          <p class="mz-kicker mz-kicker--dark"><span>02 / Where I've worked</span><span class="career__hint">keep scrolling →</span></p>
          <h2 class="career__h2">The scope kept <em>widening.</em></h2>
        </div>
        <div class="career__track">
          <div class="career__rail" aria-hidden="true"><div class="career__rail-fill" data-rail></div></div>
          <div class="career__strip" data-strip>
            {
              ROLES.map((r, i) => (
                <article class="role" style={`--tilt:${i % 2 ? 1.2 : -1.2}deg`}>
                  <span class="role__years"><span class="role__pin" aria-hidden="true" />{r.years}</span>
                  <div class="role__card">
                    <h3 class="role__org">{r.org}</h3>
                    <p class="role__title">{r.title}</p>
                    <p class="role__story">{r.story}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="beliefs">
    <div class="mz-max">
      <p class="mz-kicker" data-rv>03 / What I believe</p>
      <h2 class="mz-h2 beliefs__h2" data-split>A few principles I've picked up and held onto.</h2>
      <div class="beliefs__list">
        {
          BELIEFS.map((b, i) => (
            <div class="belief">
              <span class="belief__n" style={`color:${INK[i % 4]}`}>{pad(i + 1)}</span>
              <h3 class="belief__t" data-type>{b.title}</h3>
              <p class="belief__b" data-rv data-delay="300">{b.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="wrist">
    <div class="wrist__inner">
      <p class="wrist__kicker" data-rv>And one I keep on my wrist</p>
      <p class="wrist__name" data-rv data-delay="80">Nea Onnim No Sua A, Ohu</p>
      <div class="wrist__quote" data-clip>
        <p class="wrist__text">“He who does not know can know <em>from learning.</em>”</p>
        <Image src={tapeBlue} alt="" aria-hidden="true" width={140} densities={[1, 2]} class="mz-tape wrist__tape" />
        <span class="wrist__stamp" aria-hidden="true" data-stamp>
          <span class="wrist__stamp-in"><span class="wrist__stars">★ ★ ★</span><span>Still<br />learning<br />since '14</span></span>
        </span>
        <div class="wrist__sym">
          <Image src={neaOnnim} alt="The Nea Onnim No Sua A, Ohu Adinkra symbol, cut from newspaper" width={170} densities={[1, 2]} data-sym />
        </div>
      </div>
      <p class="wrist__note" data-rv data-delay="200">
        An Adinkra symbol and Akan proverb, tattooed on my right wrist. I don't believe in “I can't do this.” Only “I haven't learned it yet.”
      </p>
    </div>
  </section>

  <section class="certs">
    <div class="mz-max">
      <p class="mz-kicker" data-rv><span>04 / Licenses &amp; certifications</span><span class="mz-muted">{certSpan}</span></p>
      <div class="certs__top">
        <h2 class="mz-h2 certs__h2" data-split>Proof I meant the <em>learning</em> part.</h2>
        <div class="certs__chips" data-rv>
          {
            issuerChips.map((c) => (
              <button type="button" class="cchip" aria-pressed={c.name === 'All' ? 'true' : 'false'} data-issuer={c.name}>
                {c.name} <span class="cchip__n">{c.n}</span>
              </button>
            ))
          }
        </div>
      </div>
      <div class="certs__grid" data-certs>
        {
          CERTS.map((c) => (
            <article class="cert" data-cert data-group={groupOf(c.issuer)}>
              <span class="cert__hole" aria-hidden="true" />
              <span class="cert__top">
                <span class="cert__issuer"><span class="cert__dot" style={`background:${dotFor(c.issuer)}`} />{c.issuer}</span>
                <span class="cert__date">{MON[Number(c.month.slice(5)) - 1]} {c.month.slice(0, 4)}</span>
              </span>
              <span class="cert__title">{c.title}</span>
              <span class="cert__meta">{c.meta || 'Certificate of completion'}</span>
            </article>
          ))
        }
      </div>
      <button type="button" class="certs__more" data-certs-toggle hidden>
        <span aria-hidden="true" data-certs-icon>+</span><span data-certs-label>Show all</span>
      </button>
    </div>
  </section>

  <section class="life">
    <div class="life__grid">
      <div class="life__photo">
        <div class="life__clip" data-clip>
          <div class="life__paper">
            <div class="life__img">
              <Image src={poster} alt="Miguel laughing at a café table" widths={[420, 640, 900]} sizes="(max-width: 900px) 92vw, 520px" data-parallax />
            </div>
            <p class="life__caption">Fig. 2 — Off the clock</p>
          </div>
        </div>
        <Image src={tapeBlue} alt="" aria-hidden="true" width={118} densities={[1, 2]} class="mz-tape life__tape" />
      </div>
      <div class="life__copy">
        <p class="mz-kicker" data-rv>05 / Outside work</p>
        <h2 class="mz-h2 life__h2" data-split>Food, stories, music, and one very opinionated cat.</h2>
        <div class="life__list">
          {
            LIFE.map((l, i) => (
              <details class="lifeitem" name="outside-work" open={i === 0}>
                <summary>
                  <span class="lifeitem__head">
                    <span class="lifeitem__n">{pad(i + 1)}</span>
                    <span class="lifeitem__t">{l.title}</span>
                  </span>
                  <span class="lifeitem__plus" aria-hidden="true">+</span>
                </summary>
                <p class="lifeitem__body">{l.body}</p>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="with">
    <div class="with__grid">
      <div>
        <p class="with__kicker" data-rv>06 / What I'm like to work with</p>
        <h2 class="with__h2" data-split>I care more about the right answer than <em>having</em> it.</h2>
      </div>
      <div class="with__body" data-rv>
        <p>I'm curious, collaborative and open about my thinking. I ask a lot of questions and invite the people closest to the work to challenge my read.</p>
        <p>I get invested. Every problem is a puzzle, and solving it makes life easier for a customer or a team.</p>
      </div>
    </div>
  </section>

  <section class="skills">
    <div class="mz-max">
      <p class="mz-kicker" data-rv>07 / Skills and systems</p>
      <div class="skills__top">
        <h2 class="mz-h2 skills__h2" data-split>What I do, and what I do it in.</h2>
        <p class="skills__intro" data-rv>I decide what a system needs to do before picking the tool. Here's what I can use without a ramp-up.</p>
      </div>
      <div class="skills__box" data-rv>
        <div class="skills__tabs" role="tablist" aria-label="Skill areas">
          {
            SKILLS.map((g, i) => (
              <button
                type="button"
                role="tab"
                id={`skill-tab-${i}`}
                aria-controls={`skill-panel-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                class="stab"
                data-skill={i}
              >
                <span class="stab__label"><span class="stab__n">{pad(i + 1)}</span>{g.name}</span>
                <span class="stab__arrow" aria-hidden="true">→</span>
              </button>
            ))
          }
        </div>
        <div class="skills__panels">
        {
          SKILLS.map((g, i) => (
            <div class:list={['spanel', { 'is-off': i !== 0 }]} role="tabpanel" id={`skill-panel-${i}`} aria-labelledby={`skill-tab-${i}`} data-panel={i}>
              <p class="spanel__n">{pad(i + 1)} / {pad(SKILLS.length)}</p>
              <h3 class="spanel__h">{g.name}</h3>
              <p class="spanel__body">{g.skills}</p>
              <div class="spanel__tags">
                {g.tools.map((t) => (
                  <span class="spanel__tag" data-tag>{t}</span>
                ))}
              </div>
              <p class="spanel__note">
                Ordered by current fluency. Expert in Braze, Salesforce Marketing Cloud, HubSpot and Webflow. Last hands-on SFMC build: 2021, kept current through a live vendor evaluation.
              </p>
            </div>
          ))
        }
        </div>
      </div>
    </div>
  </section>

  <section class="coffee">
    <div class="coffee__inner">
      <div class="coffee__note">
        <div class="coffee__paper">
          <p class="coffee__meta"><span>08 / Get in touch</span><span>A note from Miguel</span></p>
          <h2 class="coffee__h2" data-split>Coffee's on <em>me.</em></h2>
          <div class="coffee__grid">
            <p class="coffee__p" data-rv>
              Want to work together, talk through something you're building, or just say hi? If you're in Vancouver, let's do it in person.
            </p>
            <div class="coffee__links" data-rv data-delay="120">
              <a href="/#contact" class="coffee__btn coffee__btn--solid" data-magnetic>Start a conversation <span aria-hidden="true">→</span></a>
              <a href={`mailto:${CONTACT.email}`} class="coffee__btn"><span class="coffee__wrap">{emailUser}@<wbr />{emailDomain}</span> <span aria-hidden="true">→</span></a>
              <a href={phoneHref} class="coffee__btn">{CONTACT.phone} <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <p class="coffee__sign">— Miguel</p>
        </div>
        <Image src={tapeYellow} alt="" aria-hidden="true" width={150} densities={[1, 2]} class="mz-tape coffee__tape" />
      </div>
      <div class="coffee__cup" aria-hidden="true" data-cup>
        <Image src={cup} alt="" width={220} densities={[1, 2]} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ahero {
    padding: clamp(40px, 6vw, 88px) var(--gutter) clamp(56px, 6vw, 96px);
  }
  .ahero__kicker {
    gap: 10px 20px;
    padding-bottom: 14px;
  }
  .ahero__grid {
    margin-top: clamp(36px, 5vw, 72px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: clamp(40px, 6vw, 100px);
    align-items: center;
  }
  .ahero__copy {
    min-width: 0;
  }
  .ahero__h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(3.25rem, 7vw, 7.5rem);
    line-height: 0.96;
    letter-spacing: -0.02em;
  }
  .ahero__h1 > span {
    display: block;
  }
  .ahero__h1 > .ahero__word {
    display: inline-block;
    margin-top: 0.08em;
  }
  .ahero__swatch {
    display: inline-block;
    padding: 0.02em 0.18em 0.06em;
    background: var(--amber);
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 700;
    font-size: 0.78em;
    letter-spacing: -0.045em;
    transform: rotate(-1.5deg);
    clip-path: polygon(0 5%, 4% 0, 40% 3%, 70% 0, 100% 4%, 99% 55%, 100% 100%, 62% 97%, 28% 100%, 0 96%, 1% 50%);
  }
  .ahero__lede {
    margin-top: clamp(28px, 3vw, 40px);
    max-width: 40ch;
    font-size: clamp(1.125rem, 1.5vw, 1.375rem);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .ahero__sub {
    margin-top: 22px;
    max-width: 42ch;
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
    line-height: 1.55;
    color: var(--body);
    text-wrap: pretty;
  }
  @media (max-width: 699px) {
    .ahero__h1,
    .mz-h2 {
      letter-spacing: 0.005em;
      line-height: 1.04;
    }
    .ahero__swatch {
      letter-spacing: -0.01em;
    }
  }
  .ahero__photo {
    justify-self: center;
    width: 100%;
    max-width: 29.375rem;
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 2vw, 22px);
  }
  .ahero__stage {
    position: relative;
    padding: 20px 14px 20px 6px;
  }
  /* v20: the two newspaper-clipping buttons under the photo. */
  .ahero__ctas {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: clamp(10px, 2vw, 20px);
    padding: 0 4px;
  }
  .ahero__ctas--one {
    justify-content: center;
  }
  .ahero__cta {
    display: block;
    flex: 1 1 0;
    min-width: 0;
    max-width: 15rem;
    filter: drop-shadow(0 6px 10px rgba(31, 29, 43, 0.16));
    transition: transform 0.35s var(--ease);
  }
  .ahero__cta--resume {
    transform: rotate(-1.5deg);
  }
  .ahero__cta--linkedin {
    transform: rotate(1.5deg);
  }
  .ahero__cta:hover,
  .ahero__cta:focus-visible {
    transform: rotate(0deg) translateY(-3px) scale(1.04);
  }
  .ahero__cta :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 599px) {
    .ahero__ctas {
      flex-direction: column;
      align-items: center;
      gap: 14px;
    }
    .ahero__cta {
      flex: none;
      width: min(100%, 300px);
      max-width: 300px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ahero__cta:hover,
    .ahero__cta:focus-visible {
      transform: none;
    }
  }
  .ahero__frame {
    position: relative;
    transform: rotate(-2deg);
    filter: drop-shadow(0 16px 24px rgba(31, 29, 43, 0.22));
    will-change: transform;
  }
  .ahero__paper {
    position: relative;
    padding: 12px 12px 44px;
    background: var(--card);
    clip-path: var(--torn-portrait);
  }
  .ahero__img {
    position: relative;
    aspect-ratio: 4183 / 3824;
    overflow: hidden;
    background: #e6dfd1;
    clip-path: var(--torn-portrait-img);
  }
  .ahero__img img,
  .life__img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }
  .ahero__caption {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 12px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .ahero__tape {
    top: -16px;
    left: 50%;
    width: 140px;
    margin-left: -70px;
    rotate: 4deg;
  }
  .vid {
    position: absolute;
    right: -4px;
    bottom: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px 12px 12px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.875rem;
    font-weight: 600;
    transform: rotate(3deg);
    transition:
      translate 0.5s var(--ease),
      background 0.3s;
  }
  .vid:hover {
    background: var(--blue);
    color: var(--paper);
  }
  .vid__play {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--amber);
    color: var(--ink);
    font-size: 0.625rem;
  }
  @media (max-width: 699px) {
    .vid {
      position: relative;
      right: auto;
      bottom: auto;
      margin: 18px auto 0;
      display: flex;
      width: fit-content;
      transform: rotate(-1deg);
    }
  }

  .facts {
    padding: 0 var(--gutter);
  }
  .facts__head {
    padding: 16px 0 10px;
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .facts__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
    border-right: 1px solid var(--ink);
    margin-left: 1px;
  }
  @media (max-width: 999px) {
    .facts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 559px) {
    .facts__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .facts__cell {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-left: -1px;
    padding: clamp(20px, 2vw, 28px) clamp(16px, 1.8vw, 24px);
    border-left: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .facts__v {
    font-family: var(--serif);
    font-size: clamp(3.25rem, 5vw, 5rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .facts__l {
    max-width: 24ch;
    font-size: 1rem;
    line-height: 1.4;
  }

  .what {
    padding: clamp(72px, 8vw, 120px) var(--gutter);
  }
  .what__grid {
    max-width: var(--max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(72px, 6vw, 100px);
    align-items: start;
  }
  .what__copy {
    min-width: 0;
  }
  .what__h2 {
    margin-top: 32px;
    max-width: 23ch;
    font-size: clamp(2.5rem, 5vw, 4.75rem);
  }
  .what__body {
    margin-top: clamp(36px, 3vw, 44px);
    display: flex;
    flex-direction: column;
    gap: 26px;
    max-width: 58ch;
    font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
    line-height: 1.62;
    text-wrap: pretty;
  }
  .what__drop {
    float: left;
    margin: 0.06em 0.12em 0 -0.02em;
    font-family: var(--serif);
    font-size: 5.2em;
    line-height: 0.78;
    color: var(--blue);
  }
  .quote {
    position: relative;
    align-self: center;
    padding: clamp(56px, 4vw, 64px) 0 clamp(12px, 1vw, 16px) clamp(20px, 2.5vw, 40px);
    border-left: 1px solid var(--ink);
  }
  .quote__mark {
    position: absolute;
    left: clamp(12px, 2vw, 32px);
    top: -0.25em;
    font-family: var(--serif);
    font-size: clamp(7.5rem, 12vw, 12.5rem);
    line-height: 1;
    color: var(--amber);
  }
  .quote blockquote {
    position: relative;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2.125rem, 3.8vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .quote figcaption {
    margin-top: 28px;
    max-width: 44ch;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--body);
    text-wrap: pretty;
  }

  /* --------------------------------------------------------------- career */
  .career {
    background: var(--ink);
    color: var(--paper);
  }
  .career__stage {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 0;
  }
  /* A column flexbox shrink-wraps an item with auto side margins, so the
     wrap has to be told to fill the row. */
  .career__head {
    width: 100%;
  }
  .career__hint {
    color: var(--lav);
  }
  .career__h2 {
    margin-top: 24px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(3rem, 4.6vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }
  .career__h2 em {
    color: var(--amber);
  }
  .career__track {
    position: relative;
    margin-top: clamp(28px, 4vh, 48px);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .career__track::-webkit-scrollbar {
    display: none;
  }
  .career__rail {
    position: absolute;
    left: 0;
    right: 0;
    top: 34px;
    height: 1px;
    background: rgba(248, 244, 236, 0.25);
  }
  .career__rail-fill {
    position: absolute;
    inset: 0;
    background: var(--amber);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  .career__strip {
    display: flex;
    gap: 28px;
    width: max-content;
    padding: 0 max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    will-change: transform;
  }
  .role {
    flex: none;
    width: clamp(300px, 30vw, 420px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .role__years {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 68px;
    font-family: var(--mono);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
  }
  .role__pin {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 0 6px var(--ink);
  }
  .role__card {
    padding: 22px 24px 26px;
    background-color: var(--card);
    color: var(--ink);
    transform: rotate(var(--tilt));
    clip-path: var(--torn-note);
    background-image:
      linear-gradient(transparent 58px, rgba(223, 90, 60, 0.55) 58px, rgba(223, 90, 60, 0.55) 59px, transparent 59px),
      repeating-linear-gradient(transparent 0, transparent 31px, rgba(59, 120, 190, 0.16) 31px, rgba(59, 120, 190, 0.16) 32px);
    background-position:
      0 0,
      0 60px;
  }
  .role__org {
    min-height: 44px;
    font-weight: 700;
    font-size: clamp(1.25rem, 1.6vw, 1.5rem);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .role__title {
    margin-top: 14px;
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.5;
    color: var(--muted);
  }
  .role__story {
    margin-top: 12px;
    font-size: 1rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
  /* Pinned mode — only once the script has taken over the scroll. */
  .career__pin.is-pinned {
    position: relative;
  }
  .career__pin.is-pinned .career__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    padding: 96px 0 48px;
  }
  .career__pin.is-pinned .career__track {
    overflow: visible;
  }
  /* Phones: a plain stack of cards, oldest first. */
  @media (max-width: 899px) {
    .career__stage {
      padding: 80px 0;
    }
    .career__head {
      padding-inline: 20px;
    }
    .career__hint,
    .career__rail {
      display: none;
    }
    .career__h2 {
      margin-top: 22px;
      font-size: clamp(2.375rem, 8vw, 3rem);
    }
    .career__track {
      margin-top: 36px;
      overflow: visible;
    }
    .career__strip {
      width: auto;
      flex-direction: column;
      padding: 0 20px;
    }
    .role {
      width: auto;
      gap: 0;
      padding: 20px 20px 22px;
      background: var(--card);
      color: var(--ink);
    }
    .role__years {
      height: auto;
      font-size: 0.75rem;
      letter-spacing: 0.06em;
      color: var(--muted);
    }
    .role__pin {
      display: none;
    }
    .role__card {
      padding: 0;
      transform: none;
      clip-path: none;
      background: none;
    }
    .role__org {
      margin-top: 8px;
      min-height: 0;
      font-size: 1.3125rem;
    }
    .role__title {
      margin-top: 8px;
    }
    .role__story {
      margin-top: 10px;
    }
  }

  /* -------------------------------------------------------------- beliefs */
  .beliefs {
    padding: clamp(72px, 8vw, 120px) var(--gutter);
  }
  .beliefs__h2 {
    margin-top: 32px;
    max-width: 26ch;
    font-size: clamp(2.5rem, 5vw, 4.75rem);
  }
  .beliefs__list {
    margin-top: clamp(36px, 4vw, 60px);
    display: flex;
    flex-direction: column;
  }
  .belief {
    display: grid;
    grid-template-columns: minmax(64px, 0.16fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 16px clamp(20px, 3vw, 48px);
    align-items: start;
    padding: clamp(32px, 2.6vw, 36px) 0;
    border-top: 1px solid var(--ink);
  }
  @media (max-width: 899px) {
    .belief {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
  }
  .belief__n {
    font-family: var(--serif);
    font-size: clamp(3rem, 4.4vw, 4.5rem);
    line-height: 0.85;
  }
  .belief__t {
    min-height: 1.3em;
    font-family: var(--mono);
    font-weight: 700;
    font-size: clamp(1.25rem, 1.7vw, 1.625rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .belief__t :global(.caret) {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 2px;
    vertical-align: -0.14em;
    background: var(--blue);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
  .belief__b {
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.6;
    color: var(--body);
    text-wrap: pretty;
  }

  /* ---------------------------------------------------------------- wrist */
  .wrist {
    padding: clamp(72px, 8vw, 120px) var(--gutter);
    overflow: hidden;
    background: var(--amber);
    color: var(--ink);
  }
  .wrist__inner {
    position: relative;
    max-width: 75rem;
    margin: 0 auto;
    text-align: center;
  }
  .wrist__kicker {
    font-family: var(--mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .wrist__name {
    margin-top: 16px;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.5rem, 2.4vw, 2.125rem);
    line-height: 1.1;
  }
  .wrist__quote {
    position: relative;
    display: inline-block;
    margin-top: clamp(24px, 3vw, 40px);
    transform: rotate(-1.5deg);
    filter: drop-shadow(0 18px 28px rgba(31, 29, 43, 0.28));
  }
  .wrist__text {
    padding: clamp(22px, 3vw, 40px) clamp(24px, 4vw, 64px);
    background: var(--card);
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2.5rem, 6.4vw, 6.5rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    text-wrap: balance;
    clip-path: polygon(0 3%, 18% 0, 42% 2.5%, 66% 0, 86% 2%, 100% 0, 99% 40%, 100% 100%, 78% 97.5%, 54% 100%, 30% 97.5%, 0 100%, 1% 55%);
  }
  .wrist__text em {
    color: var(--blue);
  }
  .wrist__tape {
    top: -19px;
    left: 12%;
    width: 140px;
    rotate: -5deg;
  }
  .wrist__stamp {
    position: absolute;
    z-index: 3;
    left: calc(-1 * min(clamp(40px, 4.5vw, 64px), max(10px, var(--gutter) - 6px + (100vw - 1240px) / 2)));
    top: calc(-1 * clamp(44px, 5vw, 70px));
    width: clamp(108px, 10vw, 140px);
    height: clamp(108px, 10vw, 140px);
    display: inline-grid;
    place-items: center;
    border: 3px solid var(--stamp);
    border-radius: 50%;
    outline: 1.5px solid var(--stamp);
    outline-offset: -9px;
    background: var(--paper);
    box-shadow: 0 6px 14px rgba(31, 29, 43, 0.22);
    color: var(--stamp);
    font-family: var(--mono);
    font-weight: 700;
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-align: center;
    transform: rotate(-8deg);
  }
  .wrist__stamp.is-stamped {
    animation: stamp 0.5s cubic-bezier(0.5, 1.6, 0.4, 1) both;
  }
  @keyframes stamp {
    from {
      opacity: 0;
      transform: rotate(-14deg) scale(1.6);
    }
    to {
      opacity: 1;
      transform: rotate(-8deg) scale(1);
    }
  }
  .wrist__stamp-in {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: 72%;
    height: 72%;
    border: 1.5px dashed var(--stamp);
    border-radius: 50%;
  }
  .wrist__stars {
    font-size: 0.4375rem;
    letter-spacing: 0.25em;
  }
  .wrist__sym {
    position: absolute;
    z-index: 2;
    right: calc(-1 * min(56px, max(-20px, (100vw - 1240px) / 2)));
    bottom: calc(-1 * clamp(48px, 5vw, 80px));
    width: clamp(96px, 11vw, 170px);
  }
  .wrist__sym img {
    display: block;
    width: 100%;
    height: auto;
    transform: rotate(8deg);
    filter: drop-shadow(0 12px 18px rgba(31, 29, 43, 0.3));
  }
  .wrist__note {
    margin: clamp(28px, 3vw, 40px) auto 0;
    max-width: 52ch;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.55;
    text-wrap: pretty;
  }
  @media (max-width: 899px) {
    .wrist__text {
      padding: 36px 22px 44px;
    }
    .wrist__tape {
      left: auto;
      right: 10%;
      width: 104px;
    }
    .wrist__stamp {
      left: -10px;
      top: -46px;
      width: 96px;
      height: 96px;
      font-size: 0.5625rem;
    }
    .wrist__sym {
      right: -10px;
      bottom: -44px;
      width: 84px;
    }
    .wrist__note {
      margin-top: 60px;
    }
  }

  /* ---------------------------------------------------------------- certs */
  .certs {
    padding: clamp(72px, 8vw, 120px) var(--gutter) clamp(24px, 3vw, 40px);
  }
  .certs__top {
    margin-top: 32px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 36px 48px;
  }
  .certs__h2 {
    max-width: 19ch;
    font-size: clamp(2.5rem, 5vw, 4.75rem);
  }
  .certs__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cchip {
    min-height: 40px;
    padding: 8px 14px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition:
      background 0.3s,
      color 0.3s;
  }
  .cchip[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }
  .cchip__n {
    opacity: 0.6;
  }
  .certs__grid {
    margin-top: clamp(40px, 3.4vw, 52px);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 14px;
  }
  .cert {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 20px 18px 28px;
    background: var(--card);
    border: 1px solid rgba(31, 29, 43, 0.18);
    border-left: 2px dashed rgba(31, 29, 43, 0.35);
    border-radius: 4px;
    transition:
      transform 0.45s var(--ease),
      box-shadow 0.45s;
  }
  .cert:hover {
    transform: translateY(-3px) rotate(-0.4deg);
    box-shadow: 0 14px 24px -14px rgba(31, 29, 43, 0.35);
  }
  .cert__hole {
    position: absolute;
    left: -7px;
    top: 50%;
    width: 12px;
    height: 12px;
    margin-top: -6px;
    border-radius: 50%;
    background: var(--paper);
    border: 1px solid rgba(31, 29, 43, 0.18);
  }
  .cert__top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .cert__issuer {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cert__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .cert__date {
    color: var(--muted);
    white-space: nowrap;
  }
  .cert__title {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
    text-wrap: balance;
  }
  .cert__meta {
    margin-top: auto;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .certs__more {
    margin-top: 14px;
    width: 100%;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 18px;
    border: 1px dashed rgba(31, 29, 43, 0.45);
    border-radius: 4px;
    background: transparent;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .certs__more [aria-hidden] {
    font-size: 1rem;
    line-height: 1;
  }

  /* ----------------------------------------------------------------- life */
  .life {
    padding: clamp(72px, 8vw, 120px) var(--gutter) clamp(40px, 5vw, 72px);
  }
  .life__grid {
    max-width: var(--max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(40px, 6vw, 100px);
    align-items: center;
  }
  .life__photo {
    position: relative;
    max-width: 32.5rem;
    padding: 18px 12px 24px 8px;
  }
  .life__clip {
    position: relative;
    transform: rotate(2deg);
    filter: drop-shadow(0 14px 22px rgba(31, 29, 43, 0.2));
  }
  .life__paper {
    position: relative;
    padding: 12px 12px 40px;
    background: var(--card);
    clip-path: var(--torn-frame);
  }
  .life__img {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #e6dfd1;
    clip-path: var(--torn-frame-img);
  }
  .life__img img {
    transform: scale(1.14);
  }
  .life__caption {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 12px;
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .life__tape {
    top: 0;
    right: 18px;
    width: 118px;
    rotate: 8deg;
  }
  .life__copy {
    min-width: 0;
  }
  .life__h2 {
    margin-top: 32px;
    max-width: 29ch;
    font-size: clamp(2.375rem, 4.4vw, 4.25rem);
  }
  .life__list {
    margin-top: clamp(24px, 3vw, 36px);
    display: flex;
    flex-direction: column;
  }
  .lifeitem {
    border-top: 1px solid var(--ink);
  }
  .lifeitem summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    cursor: pointer;
    list-style: none;
  }
  .lifeitem summary::-webkit-details-marker {
    display: none;
  }
  .lifeitem__head {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .lifeitem__n {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .lifeitem__t {
    font-weight: 700;
    font-size: clamp(1.125rem, 1.4vw, 1.3125rem);
    letter-spacing: -0.015em;
  }
  .lifeitem__plus {
    font-size: 1.375rem;
    line-height: 1;
    transition: transform 0.4s var(--ease);
  }
  .lifeitem[open] .lifeitem__plus {
    transform: rotate(45deg);
  }
  .lifeitem__body {
    padding: 0 0 18px 34px;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--body);
    text-wrap: pretty;
  }
  /* Where the browser can animate a <details> open, it does; elsewhere it just opens. */
  @supports selector(::details-content) {
    .lifeitem::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 0.5s var(--ease),
        content-visibility 0.5s allow-discrete;
    }
    .lifeitem[open]::details-content {
      block-size: auto;
    }
  }

  .with {
    padding: clamp(40px, 5vw, 72px) var(--gutter);
  }
  .with__grid {
    max-width: var(--max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: clamp(36px, 5vw, 80px);
