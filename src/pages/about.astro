  /* The note's ruled margin leaves a phone about 250px, which splits the
     email address mid-word at 16px. */
  @media (max-width: 479px) {
    .coffee__paper {
      padding-left: 58px;
      padding-right: 20px;
    }
    .coffee__btn {
      gap: 10px;
      padding: 14px 18px;
    }
    .coffee__btn:not(.coffee__btn--solid) {
      font-size: 0.875rem;
    }
  }
  .coffee__sign {
    margin-top: clamp(24px, 3vw, 36px);
    font-family: var(--serif);
