  .coffee__paper {
    --margin-x: clamp(46px, 6vw, 78px);
    position: relative;
    padding: clamp(36px, 4.4vw, 64px) clamp(24px, 5vw, 80px) clamp(36px, 4.4vw, 56px) clamp(64px, 8.5vw, 120px);
    background-color: var(--card);
    background-image:
      linear-gradient(90deg, transparent var(--margin-x), rgba(223, 90, 60, 0.5) var(--margin-x), rgba(223, 90, 60, 0.5) calc(var(--margin-x) + 1.5px), transparent calc(var(--margin-x) + 1.5px)),
      repeating-linear-gradient(transparent 0, transparent 35px, rgba(59, 120, 190, 0.16) 35px, rgba(59, 120, 190, 0.16) 36px);
    background-position:
      0 0,
      0 22px;
    clip-path: polygon(0 1.5%, 18% 0, 40% 1.2%, 62% 0, 84% 1%, 100% 0, 99.3% 30%, 100% 62%, 99% 100%, 76% 98.8%, 52% 100%, 28% 99%, 0 100%, 0.7% 64%, 0 32%);
  }
  .coffee__meta {
    display: flex;
