---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import CaseDiagram from '../components/CaseDiagram.astro';
import ContactSection from '../components/ContactSection.astro';
import portrait from '../assets/miguel.png';
import { SYMPTOMS, FEATURED_CASES, METHOD, RECEIPTS } from '../data/home';
import { CATEGORY_ACCENT } from '../data/site';
import { TAGS, tagAccent } from '../data/writing';
import { formatDate, readingTime } from '../utils/format';

const posts = (await getCollection('thinking', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout>
  {/* ------------------------------------------------------------- hero -- */}
  <section class="section--first wrap" id="top">
    <div class="hero">
      <div>
        <p class="eyebrow hero__place">Vancouver, BC</p>
        <h1 class="display">Hi, I’m Miguel.</h1>
        <p class="hero__tagline">
          I work across lifecycle, GTM, and automation—usually where the real problem is a little
          upstream from the obvious one.
        </p>

        <div class="hero__id">
          {/*
            The source is 1024x1536. Asking for a square here would make Astro
            resize it to a square first, squashing the photo — and the CSS crop
            below would then frame the wrong part of a distorted image, which
            is why the face sat too low. Keep the 2:3 ratio and let
            `object-fit: cover` with `object-position` do the cropping, exactly
            as the design does.
          */}
          <Image
            src={portrait}
            alt="Miguel Monzones"
            width={264}
            height={396}
            loading="eager"
            fetchpriority="high"
          />
          <p class="hero__where">Consulting and open to the right senior role</p>
        </div>
      </div>

      <div class="hero__intro" data-reveal-group>
        <p>
          I’ve spent the last eleven years helping teams understand why customers stall, drop off,
          or walk away—and building the systems that help them move forward.
        </p>
        <p>
          Most of my work starts before anything gets built. A number is heading the wrong way, a
          customer journey feels off, or a team is spending too much time holding a process
          together. I talk to the people closest to it, follow the experience from end to end, and
          work out what’s actually getting in the way.
        </p>
        <p>
          Sometimes the answer is in the message. Often it’s in what happens after the click, the
          data behind the journey, or the way the systems connect.
        </p>
        <p>
          Lately, much of that work has involved automation: building lifecycle systems that respond
          to what people actually do, stay reliable under real conditions, and are straightforward
          for teams to own.
        </p>
      </div>
    </div>

    {/* ------------------------------------------------ the symptom card -- */}
    <div class="symptom">
      <p class="symptom__rail eyebrow">What that looks like in practice</p>

      <div class="card card--raised symptom__card" data-symptom>
        <div class="symptom__body">
          <p class="eyebrow" data-symptom-label>What we were seeing</p>
          <p class="symptom__text" data-symptom-text>{SYMPTOMS[0].ask}</p>
        </div>

        <div class="symptom__controls">
          <button type="button" class="btn" data-symptom-flip aria-pressed="false">
            Look underneath
          </button>
          <button type="button" class="btn btn--ghost" data-symptom-next>Show me another</button>
          <p class="symptom__count" data-symptom-count>1 of {SYMPTOMS.length}</p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ SYMPTOMS }}>
    // Inlined so the copy is available without a second request. The card
    // renders its first state server-side, so this only ever changes it.
    (() => {
      const root = document.querySelector('[data-symptom]');
      if (!root) return;

      const label = root.querySelector('[data-symptom-label]');
      const text = root.querySelector('[data-symptom-text]');
      const flip = root.querySelector('[data-symptom-flip]');
      const next = root.querySelector('[data-symptom-next]');
      const count = root.querySelector('[data-symptom-count]');

      let index = 0;
      let flipped = false;

      function render() {
        const item = SYMPTOMS[index];
        label.textContent = flipped ? 'What was happening underneath' : 'What we were seeing';
        text.textContent = flipped ? item.found : item.ask;
        flip.textContent = flipped ? '← Back to the starting point' : 'Look underneath';
        flip.setAttribute('aria-pressed', String(flipped));
        count.textContent = `${index + 1} of ${SYMPTOMS.length}`;
      }

      flip.addEventListener('click', () => {
        flipped = !flipped;
        render();
      });

      next.addEventListener('click', () => {
        index = (index + 1) % SYMPTOMS.length;
        flipped = false;
        render();
      });
    })();
  </script>

  <LogoMarquee />

  {/* ------------------------------------------------------------- work -- */}
  <section class="section" id="work">
    <div class="wrap work__head">
      <div>
        <p class="eyebrow">Work</p>
        <h2 class="section-title">A few things I’ve helped build.</h2>
        <p class="lede work__sub">
          Each one started with a real business problem. The useful part was understanding what sat
          underneath it—and working with the people closest to the problem to build something
          better.
        </p>
      </div>

      <div class="segmented segmented--bare" role="group" aria-label="Layout">
        <button type="button" class="segmented__btn" data-view="shelf" aria-pressed="true">
          ☰ Shelf
        </button>
        <button type="button" class="segmented__btn" data-view="grid" aria-pressed="false">
          ⊞ Grid
        </button>
      </div>
    </div>

    {/* Shelf: one case open, the rest collapsed to spines beside it. */}
    <div class="wrap wrap--wide shelf" data-view-panel="shelf">
      {
        FEATURED_CASES.map((item, i) => (
          <article class="card card--raised shelf__case" data-case-panel={i} hidden={i !== 0}>
            <div class="shelf__visual">
              <CaseDiagram slug={item.slug} />
            </div>

            <div class="shelf__text">
              <p class="label-row">
                <span class="accent-bar" style={`--bar:${CATEGORY_ACCENT[item.category]}`} />
                <span class="eyebrow">{item.client}</span>
              </p>

              <h3 class="shelf__title">
                <a href={`/work/${item.slug}/`}>{item.title}</a>
              </h3>

              <div class="segmented" role="group" aria-label="Which part of the story">
                <button type="button" class="segmented__btn" data-mode="ask" aria-pressed="true">
                  The starting point
                </button>
                <button type="button" class="segmented__btn" data-mode="found" aria-pressed="false">
                  What we learned
                </button>
              </div>

              <div class="shelf__copy" data-copy="ask">
                {item.brief.map((para) => <p>{para}</p>)}
              </div>
              <div class="shelf__copy" data-copy="found" hidden>
                {item.read.map((para) => <p>{para}</p>)}
              </div>

              <p class="shelf__metric">
                <span class="shelf__metric-value">{item.metric}</span>
                <span class="meta">{item.note}</span>
              </p>
            </div>
          </article>
        ))
      }

      <div class="shelf__spines">
        {
          FEATURED_CASES.map((item, i) => (
            <button
              type="button"
              class="shelf__spine"
              data-spine={i}
              hidden={i === 0}
              style={`--bar:${CATEGORY_ACCENT[item.category]}`}
              title={item.client}
            >
              <span>{item.client} · {item.title}</span>
            </button>
          ))
        }
      </div>
    </div>

    {/* Grid: all four at once, for anyone who'd rather scan than click. */}
    <div class="wrap grid-view" data-view-panel="grid" hidden>
      {
        FEATURED_CASES.map((item) => (
          <article class="card card--raised grid-view__card">
            <p class="label-row">
              <span class="accent-bar" style={`--bar:${CATEGORY_ACCENT[item.category]}`} />
              <span class="eyebrow">{item.client}</span>
            </p>

            <h3 class="grid-view__title">
              <a href={`/work/${item.slug}/`}>{item.title}</a>
            </h3>

            <div class="segmented" role="group" aria-label="Which part of the story">
              <button type="button" class="segmented__btn" data-mode="ask" aria-pressed="true">
                The starting point
              </button>
              <button type="button" class="segmented__btn" data-mode="found" aria-pressed="false">
                What we learned
              </button>
            </div>

            <div class="grid-view__copy" data-copy="ask">
              {item.brief.map((para) => <p>{para}</p>)}
            </div>
            <div class="grid-view__copy" data-copy="found" hidden>
              {item.read.map((para) => <p>{para}</p>)}
            </div>

            <p class="shelf__metric">
              <span class="grid-view__metric-value">{item.metric}</span>
              <span class="meta">{item.note}</span>
            </p>
          </article>
        ))
      }
    </div>
  </section>

  {/* ----------------------------------------------------------- method -- */}
  <section class="section wrap" id="method">
    <div class="method">
      <div class="method__intro">
        <p class="eyebrow">How I work</p>
        <h2 class="section-title">Understand first. Then build.</h2>
        <p class="method__sub">
          The problems change, but the rhythm is usually the same: listen to the people closest to
          the work, trace what’s happening, agree on what success looks like, build, and learn from
          the result.
        </p>
      </div>

      <div class="method__panel" data-method>
        <div class="method__tabs" role="tablist" aria-label="Method steps">
          {
            METHOD.map((step, i) => (
              <button
                type="button"
                role="tab"
                class="method__tab"
                id={`method-tab-${i}`}
                aria-controls={`method-panel-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-step={i}
              >
                <span class="method__num">0{i + 1}</span>
                {step.name}
              </button>
            ))
          }
          <span
            class="method__indicator"
            aria-hidden="true"
            style={`width:${100 / METHOD.length}%`}
            data-method-indicator></span>
        </div>

        <div class="card card--raised method__body">
          {
            METHOD.map((step, i) => (
              <div
                role="tabpanel"
                id={`method-panel-${i}`}
                aria-labelledby={`method-tab-${i}`}
                data-step-panel={i}
                hidden={i !== 0}
              >
                <p class="eyebrow">{step.source}</p>
                <p class="method__example">{step.example}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------- receipts -- */}
  <section class="band" id="numbers">
    <div class="wrap">
      <div class="receipts__head">
        <div>
          <p class="eyebrow">Numbers</p>
          <h2 class="section-title">A few numbers—and the work behind them.</h2>
          <p class="lede receipts__sub">
            The result matters. So does the context that explains why it moved.
          </p>
        </div>

        <div class="receipts__tabs" role="tablist" aria-label="Numbers">
          {
            RECEIPTS.map((r, i) => (
              <button
                type="button"
                role="tab"
                class="receipts__tab"
                id={`receipt-tab-${i}`}
                aria-controls={`receipt-panel-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-receipt={i}
              >
                {r.name}
              </button>
            ))
          }
        </div>
      </div>

      <div class="receipts__body">
        {
          RECEIPTS.map((r, i) => (
            <div
              role="tabpanel"
              id={`receipt-panel-${i}`}
              aria-labelledby={`receipt-tab-${i}`}
              class="receipts__panel"
              data-receipt-panel={i}
              hidden={i !== 0}
            >
              <div>
                {r.bars ? (
                  <div class="bars">
                    <div class="bars__row">
                      <p class="bars__legend">
                        <span>Before</span>
                        <span>{r.bars.beforeLabel}</span>
                      </p>
                      <div class="bars__track">
                        <div class="bars__fill" data-bar style={`--w:${r.bars.before}%`} />
                      </div>
                    </div>
                    <div class="bars__row">
                      <p class="bars__legend">
                        <span>After</span>
                        <span>{r.bars.afterLabel}</span>
                      </p>
                      <div class="bars__track">
                        <div
                          class="bars__fill bars__fill--accent"
                          data-bar
                          style={`--w:${r.bars.after}%`}
                        />
                      </div>
                    </div>
                  </div>
                ) : (
                  <div>
                    <p class="receipts__single">{r.headline}</p>
                    <p class="receipts__single-sub">{r.single}</p>
                  </div>
                )}
                <p class="receipts__window">{r.window}</p>
              </div>

              <div>
                <p class="receipts__headline">{r.bars ? r.headline : r.name}</p>
                <p class="receipts__read">{r.read}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------- writing -- */}
  <section class="section wrap" id="writing">
    <div class="writing">
      <div class="writing__rail">
        <p class="eyebrow">Writing</p>
        <h2 class="section-title--sm writing__title">Things I’ve written.</h2>
        <p class="writing__sub">
          Mostly lifecycle, AI, and how search is changing. I write to work out what I actually
          think—and to share what I’ve learned while doing the work.
        </p>

        <div class="writing__chips" role="group" aria-label="Filter writing by topic">
          <button type="button" class="chip" data-tag="All" aria-pressed="true">All</button>
          {
            TAGS.map((tag) => (
              <button type="button" class="chip" data-tag={tag} aria-pressed="false">
                {tag}
              </button>
            ))
          }
        </div>

        <p class="meta writing__count" data-writing-count aria-live="polite">
          {posts.length} pieces
        </p>

        <a class="writing__all" href="/thinking/">All writing <span aria-hidden="true">→</span></a>
      </div>

      <div class="writing__col">
        <div class="writing__grid" data-writing-grid>
          {
            posts.map((post) => (
              <a
                class="card card--interactive post-card"
                href={`/thinking/${post.id}/`}
                data-post-tag={post.data.tag}
              >
                <span class="eyebrow" style={`color:${tagAccent(post.data.tag)}`}>
                  {post.data.tag}
                </span>
                <span class="post-card__title">{post.data.title}</span>
                <span class="meta">
                  {formatDate(post.data.date)} · {readingTime(post.body ?? '')} min read
                </span>
              </a>
            ))
          }
          <p class="writing__empty" data-writing-empty hidden>Nothing here for that yet.</p>
        </div>

        {/*
          Hidden until the script takes over. Paging is a JavaScript affordance,
          so without it the honest fallback is every piece on one page rather
          than a pager whose buttons do nothing.
        */}
        <nav class="pager" aria-label="Writing pages" data-pager hidden>
          <button type="button" class="pager__step" data-page-prev>
            <span aria-hidden="true">←</span> Newer
          </button>
          <div class="pager__numbers" data-page-numbers></div>
          <button type="button" class="pager__step" data-page-next>
            Older <span aria-hidden="true">→</span>
          </button>
        </nav>
      </div>
    </div>
  </section>

  <ContactSection
    title="Let’s talk."
    intro="If you’re working through a difficult customer journey, building something new, or hiring for a role you think might fit, I’d love to hear about it."
  />
</BaseLayout>

<script>
  /* ---------------------------------------------------- shelf / grid -- */
  const viewButtons = document.querySelectorAll<HTMLButtonElement>('[data-view]');
  const viewPanels = document.querySelectorAll<HTMLElement>('[data-view-panel]');

  for (const button of viewButtons) {
    button.addEventListener('click', () => {
      const view = button.dataset.view;
      for (const other of viewButtons) {
        other.setAttribute('aria-pressed', String(other === button));
      }
      for (const panel of viewPanels) {
        panel.toggleAttribute('hidden', panel.dataset.viewPanel !== view);
      }
    });
  }

  /* --------------------------------------------------- case selection -- */
  const casePanels = document.querySelectorAll<HTMLElement>('[data-case-panel]');
  const spines = document.querySelectorAll<HTMLButtonElement>('[data-spine]');

  for (const spine of spines) {
    spine.addEventListener('click', () => {
      const index = spine.dataset.spine;
      for (const panel of casePanels) {
        panel.toggleAttribute('hidden', panel.dataset.casePanel !== index);
      }
      for (const other of spines) {
        other.toggleAttribute('hidden', other.dataset.spine === index);
      }
    });
  }

  /* --------------------------------------------- ask / found toggles -- */
  // Scoped to the card the buttons live in, so the shelf and each grid card
  // keep their own state.
  for (const group of document.querySelectorAll<HTMLElement>('[data-mode]')) {
    group.addEventListener('click', () => {
      const card = group.closest('article');
      if (!card) return;
      const mode = group.dataset.mode;

      for (const button of card.querySelectorAll<HTMLElement>('[data-mode]')) {
        button.setAttribute('aria-pressed', String(button.dataset.mode === mode));
      }
      for (const copy of card.querySelectorAll<HTMLElement>('[data-copy]')) {
        copy.toggleAttribute('hidden', copy.dataset.copy !== mode);
      }
    });
  }

  /* --------------------------------------------------------- method -- */
  const method = document.querySelector<HTMLElement>('[data-method]');

  if (method) {
    const tabs = Array.from(method.querySelectorAll<HTMLButtonElement>('[data-step]'));
    const panels = Array.from(method.querySelectorAll<HTMLElement>('[data-step-panel]'));
    const indicator = method.querySelector<HTMLElement>('[data-method-indicator]');
    let timer: number | undefined;

    function show(index: number, focus = false) {
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((panel, i) => panel.toggleAttribute('hidden', i !== index));
      if (indicator) indicator.style.transform = `translateX(${index * 100}%)`;
      if (focus) tabs[index]?.focus();
    }

    function stop() {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => {
        stop();
        show(i);
      });

      // Arrow-key navigation, which is what makes a tablist a tablist.
      tab.addEventListener('keydown', (event) => {
        const delta = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!delta) return;
        event.preventDefault();
        stop();
        show((i + delta + tabs.length) % tabs.length, true);
      });
    });

    // Advances on its own until someone takes over, and never when the visitor
    // has asked for reduced motion.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let current = 0;
      timer = window.setInterval(() => {
        current = (current + 1) % tabs.length;
        show(current);
      }, 5000);
      method.addEventListener('pointerdown', stop, { once: true });
      method.addEventListener('focusin', stop, { once: true });
    }
  }

  /* ------------------------------------------------------- receipts -- */
  const receiptTabs = document.querySelectorAll<HTMLButtonElement>('[data-receipt]');
  const receiptPanels = document.querySelectorAll<HTMLElement>('[data-receipt-panel]');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Draw the bars up from zero as you land on a tab. Done here rather than in
     CSS because the resting state has to stay the true width — see the note on
     `.bars__fill`. Nothing here is load-bearing: skip it and the bars are
     simply already the right length. */
  function growBars(panel: HTMLElement) {
    if (reduceMotion) return;
    const bars = panel.querySelectorAll<HTMLElement>('[data-bar]');
    for (const bar of bars) bar.style.width = '0%';
    // Flush layout so the zero width is committed as the transition's starting
    // point, then hand the bars straight back to the stylesheet. Doing both in
    // one synchronous pass — rather than clearing inside requestAnimationFrame
    // — means there is no moment where an unfired callback could leave a bar
    // reading 0%.
    void panel.offsetWidth;
    for (const bar of bars) bar.style.width = '';
  }

  function showReceipt(index: string, focus = false) {
    for (const tab of receiptTabs) {
      const selected = tab.dataset.receipt === index;
      tab.setAttribute('aria-selected', String(selected));
      tab.tabIndex = selected ? 0 : -1;
      if (selected && focus) tab.focus();
    }
    for (const panel of receiptPanels) {
      const active = panel.dataset.receiptPanel === index;
      panel.toggleAttribute('hidden', !active);
      if (active) growBars(panel);
    }
  }

  receiptTabs.forEach((tab, i) => {
    tab.addEventListener('click', () => showReceipt(tab.dataset.receipt ?? '0'));
    tab.addEventListener('keydown', (event) => {
      const delta = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (!delta) return;
      event.preventDefault();
      showReceipt(String((i + delta + receiptTabs.length) % receiptTabs.length), true);
    });
  });

  /* ------------------------------------------ writing filter + paging -- */
  const writingChips = [...document.querySelectorAll<HTMLButtonElement>('[data-tag]')];
  const writingCards = [...document.querySelectorAll<HTMLElement>('[data-post-tag]')];
  const writingCount = document.querySelector<HTMLElement>('[data-writing-count]');
  const writingEmpty = document.querySelector<HTMLElement>('[data-writing-empty]');
  const pager = document.querySelector<HTMLElement>('[data-pager]');
  const pageNumbers = document.querySelector<HTMLElement>('[data-page-numbers]');
  const prevPage = document.querySelector<HTMLButtonElement>('[data-page-prev]');
  const nextPage = document.querySelector<HTMLButtonElement>('[data-page-next]');

  const PER_PAGE = 6;
  let activeTag = 'All';
  let page = 0;

  function renderWriting() {
    const matching = writingCards.filter(
      (card) => activeTag === 'All' || card.dataset.postTag === activeTag,
    );
    const pageCount = Math.max(1, Math.ceil(matching.length / PER_PAGE));
    page = Math.min(page, pageCount - 1);
    const from = page * PER_PAGE;
    const visible = new Set(matching.slice(from, from + PER_PAGE));

    for (const card of writingCards) card.toggleAttribute('hidden', !visible.has(card));
    writingEmpty?.toggleAttribute('hidden', matching.length > 0);

    if (writingCount) {
      writingCount.textContent = matching.length
        ? `Showing ${from + 1}–${from + visible.size} of ${matching.length}`
        : 'Nothing under that tag';
    }

    if (!pager || !pageNumbers) return;
    pager.hidden = pageCount < 2;
    if (prevPage) prevPage.disabled = page === 0;
    if (nextPage) nextPage.disabled = page === pageCount - 1;

    // Rebuilt rather than toggled: filtering changes how many pages exist, so
    // the number of buttons is part of the state.
    pageNumbers.replaceChildren(
      ...Array.from({ length: pageCount }, (_, i) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'pager__number';
        button.textContent = String(i + 1);
        if (i === page) button.setAttribute('aria-current', 'true');
        button.setAttribute('aria-label', `Page ${i + 1} of ${pageCount}`);
        button.addEventListener('click', () => {
          page = i;
          renderWriting();
        });
        return button;
      }),
    );
  }

  for (const chip of writingChips) {
    chip.addEventListener('click', () => {
      activeTag = chip.dataset.tag ?? 'All';
      page = 0;
      for (const other of writingChips) {
        other.setAttribute('aria-pressed', String(other === chip));
      }
      renderWriting();
    });
  }

  prevPage?.addEventListener('click', () => {
    page = Math.max(0, page - 1);
    renderWriting();
  });

  nextPage?.addEventListener('click', () => {
    page += 1;
    renderWriting();
  });

  if (writingCards.length) renderWriting();
</script>

