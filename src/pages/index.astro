---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import CaseDiagram from '../components/CaseDiagram.astro';
import ContactSection from '../components/ContactSection.astro';
import portrait from '../assets/miguel.png';
import { SYMPTOMS, FEATURED_CASES, METHOD, RECEIPTS } from '../data/home';
import { CATEGORY_ACCENT } from '../data/site';
import { tagAccent } from '../data/writing';
import { formatDate, readingTime } from '../utils/format';

const posts = (await getCollection('thinking', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

/* The card grid runs six to a page; the chips filter it. Both are enhancements
   on top of a server-rendered first page. */
const PER_PAGE = 6;
const CHIPS = ['All', 'Lifecycle', 'AI & automation', 'Search', 'Positioning'] as const;

const cardData = posts.map((post) => ({
  slug: post.id,
  tag: post.data.tag,
  title: post.data.shortTitle ?? post.data.title,
  meta: `${formatDate(post.data.date)} · ${readingTime(post.body ?? '')} min read`,
}));

/* The hero's four service slabs — the same four accents the categories use,
   but named as disciplines rather than archive groups. */
const SLABS = [
  { name: 'Lifecycle', accent: 'var(--coral)' },
  { name: 'GTM', accent: 'var(--sun)' },
  { name: 'Automation', accent: 'var(--sky)' },
  { name: 'Operations', accent: 'var(--moss)' },
] as const;

/* Career-wide figures. Each one exists elsewhere on the site — the years in
   the site description, the markets and users in the About page's totals, the
   activation lift in the Mogo case — so nothing here is claimed only once. */
const HERO_STATS = [
  { value: '11', label: 'Years building growth systems', accent: 'var(--coral)' },
  { value: '14', label: 'Markets shipped into worldwide', accent: 'var(--sun)' },
  { value: '24 → 38%', label: 'Activation lift in two months', accent: 'var(--sky)' },
  { value: '1.5M+', label: 'Users managed across lifecycles', accent: 'var(--moss)' },
] as const;

/* The design opens the numbers band on Retention rather than the first tab. */
const DEFAULT_RECEIPT = 1;
---

<BaseLayout footerFlush>
  {/* ------------------------------------------------------------- hero -- */}
  <section class="section--first wrap--home" id="top">
    <div class="kicker">
      <span class="eyebrow">Vancouver, BC</span>
      <span class="kicker__rule" aria-hidden="true"></span>
      <span class="kicker__avail eyebrow"
        ><span class="kicker__dot" aria-hidden="true"></span>Available</span
      >
    </div>

    <h1 class="display hero__line">Hi, I’m Miguel.</h1>

    <div class="hero__rule" aria-hidden="true"></div>

    <div class="slabs">
      {
        SLABS.map((slab) => (
          <span class="slabs__item">
            <span class="slabs__mark" style={`background:${slab.accent}`} aria-hidden="true" />
            {slab.name}
          </span>
        ))
      }
    </div>

    <div class="statgrid">
      {
        HERO_STATS.map((stat) => (
          <div class="card statcard">
            <span class="statcard__mark" style={`background:${stat.accent}`} aria-hidden="true" />
            <span class="statcard__value">{stat.value}</span>
            <span class="statcard__label">{stat.label}</span>
          </div>
        ))
      }
    </div>

    <div class="split">
      <div>
        <p class="split__tagline">
          I work across lifecycle, GTM, and automation—usually where the real problem is a little
          upstream from the obvious one.
        </p>

        <div class="split__id">
          <div class="split__photo">
            {/*
              The source is 1024x1536. Keep the ratio and let `object-fit:
              cover` with `object-position` do the cropping, exactly as the
              design does — resizing to a square first would squash the face.
            */}
            <Image
              src={portrait}
              alt="Miguel Monzones"
              width={336}
              height={504}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="split__status">
            <span class="eyebrow eyebrow--muted">Status</span>
            <p>Consulting, and open to the right senior role.</p>
          </div>
        </div>
      </div>

      <div class="split__intro" data-reveal-group>
        <p>
          I’ve spent the last eleven years helping teams understand why customers stall, drop off,
          or walk away—and building the systems that help them move forward.
        </p>
        <p>
          Most of my work starts before anything gets built. A number is heading the wrong way, a
          customer journey feels off, or a team is spending too much time holding a process
          together. I talk to the people closest to it, follow the experience from end to end, and
          work out what’s actually getting in the way.
        </p>
        <p>
          Sometimes the answer is in the message. Often it’s in what happens after the click, the
          data behind the journey, or the way the systems connect.
        </p>
        <p>
          Lately, much of that work has involved automation: building lifecycle systems that
          respond to what people actually do, stay reliable under real conditions, and are
          straightforward for teams to own.
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------- 01 · the symptom card -- */}
  <section class="band band--terracotta symptom-band">
    <div class="wrap--home">
      <div class="numbered">
        <span class="numbered__n" aria-hidden="true">01</span>
        <h2 class="symptom-band__title">What that looks like in practice</h2>
      </div>

      <div class="card card--raised symptom" data-symptom>
        <div class="symptom__body">
          <p class="eyebrow eyebrow--muted symptom__label" data-symptom-label>
            What we were seeing
          </p>
          <p class="symptom__text" data-symptom-text>{SYMPTOMS[0].ask}</p>
        </div>

        <div class="symptom__controls">
          <button type="button" class="btn" data-symptom-flip aria-pressed="false">
            Look underneath
          </button>
          <button type="button" class="btn btn--ghost" data-symptom-next>Show me another</button>
          <p class="symptom__count" data-symptom-count>1 / {SYMPTOMS.length}</p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ SYMPTOMS }}>
    // Inlined so the copy is available without a second request. The card
    // renders its first state server-side, so this only ever changes it.
    (() => {
      const root = document.querySelector('[data-symptom]');
      if (!root) return;

      const label = root.querySelector('[data-symptom-label]');
      const text = root.querySelector('[data-symptom-text]');
      const flip = root.querySelector('[data-symptom-flip]');
      const next = root.querySelector('[data-symptom-next]');
      const count = root.querySelector('[data-symptom-count]');

      let index = 0;
      let flipped = false;

      function render() {
        const item = SYMPTOMS[index];
        label.textContent = flipped ? 'What was happening underneath' : 'What we were seeing';
        text.textContent = flipped ? item.found : item.ask;
        // The flipped answer is prose, not a headline, so it renders at body
        // size rather than the front's larger, tighter-set question.
        root.dataset.flipped = String(flipped);
        flip.textContent = flipped ? '← Back to the start' : 'Look underneath';
        flip.setAttribute('aria-pressed', String(flipped));
        count.textContent = `${index + 1} / ${SYMPTOMS.length}`;
      }

      flip.addEventListener('click', () => {
        flipped = !flipped;
        render();
      });

      next.addEventListener('click', () => {
        index = (index + 1) % SYMPTOMS.length;
        flipped = false;
        render();
      });
    })();
  </script>

  <LogoMarquee />

  {/* -------------------------------------------------------- 02 · work -- */}
  <section class="section" id="work">
    <div class="wrap--home">
      <div class="numbered">
        <span class="numbered__n" aria-hidden="true">02</span>
        <h2 class="work__title">A few things I’ve helped build.</h2>
      </div>

      <div class="work__head">
        <p class="lede work__sub">
          Each one started with a real business problem. The useful part was understanding what sat
          underneath it—and working with the people closest to the problem to build something
          better.
        </p>

        <div class="segmented" role="group" aria-label="Layout">
          <button type="button" class="segmented__btn" data-view="shelf" aria-pressed="true">
            Shelf
          </button>
          <button type="button" class="segmented__btn" data-view="grid" aria-pressed="false">
            Grid
          </button>
        </div>
      </div>
    </div>

    {/* Shelf: one case open, the rest collapsed to spines beside it. */}
    <div class="shelf" data-view-panel="shelf">
      {
        FEATURED_CASES.map((item, i) => (
          <article class="card card--raised shelf__case" data-case-panel={i} hidden={i !== 0}>
            <div class="shelf__visual">
              <CaseDiagram slug={item.slug} />
            </div>

            <div class="shelf__text">
              <p class="label-row">
                <span class="accent-bar" style={`--bar:${CATEGORY_ACCENT[item.category]}`} />
                <span class="eyebrow">{item.client}</span>
              </p>

              <h3 class="shelf__title">
                <a href={`/work/${item.slug}/`}>{item.title}</a>
              </h3>

              <div class="segmented" role="group" aria-label="Which part of the story">
                <button type="button" class="segmented__btn" data-mode="ask" aria-pressed="true">
                  Starting point
                </button>
                <button type="button" class="segmented__btn" data-mode="found" aria-pressed="false">
                  What we learned
                </button>
              </div>

              <div class="shelf__copy" data-copy="ask">
                {item.brief.map((para) => (
                  <p>{para}</p>
                ))}
              </div>
              <div class="shelf__copy" data-copy="found" hidden>
                {item.read.map((para) => (
                  <p>{para}</p>
                ))}
              </div>

              <p class="shelf__metric">
                <span class="shelf__metric-value">{item.metric}</span>
                <span class="shelf__metric-note">{item.note}</span>
              </p>
            </div>
          </article>
        ))
      }

      <div class="shelf__spines">
        {
          FEATURED_CASES.map((item, i) => (
            <button
              type="button"
              class="shelf__spine"
              data-spine={i}
              hidden={i === 0}
              style={`--bar:${CATEGORY_ACCENT[item.category]}`}
              title={item.client}
            >
              <span>{item.title}</span>
            </button>
          ))
        }
      </div>
    </div>

    {/* Grid: all four at once, for anyone who'd rather scan than click. */}
    <div class="wrap--home grid-view" data-view-panel="grid" hidden>
      {
        FEATURED_CASES.map((item) => (
          <article class="card grid-view__card">
            <p class="label-row">
              <span class="accent-bar" style={`--bar:${CATEGORY_ACCENT[item.category]}`} />
              <span class="eyebrow">{item.client}</span>
            </p>

            <h3 class="grid-view__title">
              <a href={`/work/${item.slug}/`}>{item.title}</a>
            </h3>

            <div class="segmented" role="group" aria-label="Which part of the story">
              <button type="button" class="segmented__btn" data-mode="ask" aria-pressed="true">
                Starting point
              </button>
              <button type="button" class="segmented__btn" data-mode="found" aria-pressed="false">
                What we learned
              </button>
            </div>

            <div class="grid-view__copy" data-copy="ask">
              {item.brief.map((para) => (
                <p>{para}</p>
              ))}
            </div>
            <div class="grid-view__copy" data-copy="found" hidden>
              {item.read.map((para) => (
                <p>{para}</p>
              ))}
            </div>

            <p class="shelf__metric">
              <span class="grid-view__metric-value">{item.metric}</span>
              <span class="shelf__metric-note">{item.note}</span>
            </p>
          </article>
        ))
      }
    </div>
  </section>

  {/* ------------------------------------------------------ 03 · method -- */}
  <section class="band band--sun method-band" id="method">
    <div class="wrap--home">
      <div class="method">
        <div class="method__intro">
          <div class="numbered">
            <span class="numbered__n" aria-hidden="true">03</span>
            <span class="eyebrow">How I work</span>
          </div>
          <h2 class="method__title">Understand first. Then build.</h2>
          <p class="method__sub">
            The problems change, but the rhythm is usually the same: listen to the people closest
            to the work, trace what’s happening, agree on what success looks like, build, and learn
            from the result.
          </p>
        </div>

        <div class="method__panel" data-method>
          <div class="method__tabs" role="tablist" aria-label="Method steps">
            {
              METHOD.map((step, i) => (
                <button
                  type="button"
                  role="tab"
                  class="method__tab"
                  id={`method-tab-${i}`}
                  aria-controls={`method-panel-${i}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  data-step={i}
                >
                  <span class="method__num">0{i + 1}</span>
                  {step.name}
                </button>
              ))
            }
            <span
              class="method__indicator"
              aria-hidden="true"
              style={`width:${100 / METHOD.length}%`}
              data-method-indicator></span>
          </div>

          <div class="card card--raised method__body">
            {
              METHOD.map((step, i) => (
                <div
                  role="tabpanel"
                  id={`method-panel-${i}`}
                  aria-labelledby={`method-tab-${i}`}
                  data-step-panel={i}
                  hidden={i !== 0}
                >
                  <p class="eyebrow eyebrow--muted method__source">{step.source}</p>
                  <p class="method__example">{step.example}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* -------------------------------------------------- 04 · receipts -- */}
  <section class="band receipts" id="numbers">
    <div class="wrap--home">
      <div class="numbered">
        <span class="numbered__n numbered__n--on-dark" aria-hidden="true">04</span>
        <h2 class="receipts__title">A few numbers—and the work behind them.</h2>
      </div>

      <div class="receipts__head">
        <p class="receipts__sub">The result matters. So does the context that explains why it moved.</p>

        <div class="receipts__tabs" role="tablist" aria-label="Numbers">
          {
            RECEIPTS.map((r, i) => (
              <button
                type="button"
                role="tab"
                class="chip"
                id={`receipt-tab-${i}`}
                aria-controls={`receipt-panel-${i}`}
                aria-selected={i === DEFAULT_RECEIPT ? 'true' : 'false'}
                aria-pressed={i === DEFAULT_RECEIPT ? 'true' : 'false'}
                tabindex={i === DEFAULT_RECEIPT ? 0 : -1}
                data-receipt={i}
              >
                {r.name}
              </button>
            ))
          }
        </div>
      </div>

      <div class="receipts__body">
        {
          RECEIPTS.map((r, i) => (
            <div
              role="tabpanel"
              id={`receipt-panel-${i}`}
              aria-labelledby={`receipt-tab-${i}`}
              class="receipts__panel"
              data-receipt-panel={i}
              hidden={i !== DEFAULT_RECEIPT}
            >
              <div>
                {r.bars ? (
                  <div class="bars">
                    <div class="bars__row">
                      <p class="bars__legend">
                        <span>Before</span>
                        <span>{r.bars.beforeLabel}</span>
                      </p>
                      <div class="bars__track">
                        <div class="bars__fill" style={`width:${r.bars.before}%`} />
                      </div>
                    </div>
                    <div class="bars__row">
                      <p class="bars__legend">
                        <span>After</span>
                        <span>{r.bars.afterLabel}</span>
                      </p>
                      <div class="bars__track">
                        <div class="bars__fill bars__fill--accent" style={`width:${r.bars.after}%`} />
                      </div>
                    </div>
                  </div>
                ) : (
                  <div>
                    <p class="receipts__single">{r.headline}</p>
                    <p class="receipts__single-sub">{r.single}</p>
                  </div>
                )}
                <p class="receipts__window">{r.window}</p>
              </div>

              <div>
                <p class="receipts__headline">{r.bars ? r.headline : r.name}</p>
                <p class="receipts__read">{r.read}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* --------------------------------------------------- 05 · writing -- */}
  <section class="section wrap--home" id="writing">
    <div class="numbered">
      <span class="numbered__n" aria-hidden="true">05</span>
      <h2 class="work__title">Things I’ve written.</h2>
    </div>

    <div class="writing__head">
      <p class="lede writing__sub">
        Mostly lifecycle, AI, and how search is changing. I write to work out what I actually
        think—and to share what I’ve learned while doing the work.
      </p>

      <div class="writing__chips" data-writing-chips>
        {
          CHIPS.map((chip) => (
            <button type="button" class="chip" data-chip={chip} aria-pressed={chip === 'All' ? 'true' : 'false'}>
              {chip}
            </button>
          ))
        }
      </div>
    </div>

    <div class="postgrid" data-postgrid>
      {
        cardData.map((post, i) => (
          <a
            class="card card--interactive postcard"
            href={`/thinking/${post.slug}/`}
            data-post-tag={post.tag}
            hidden={i >= PER_PAGE}
          >
            <span class="postcard__tag" style={`background:${tagAccent(post.tag)}`}>
              {post.tag}
            </span>
            <span class="postcard__title">{post.title}</span>
            <span class="postcard__meta">{post.meta}</span>
          </a>
        ))
      }
    </div>

    <div class="writing__foot">
      <p class="writing__showing" data-writing-showing aria-live="polite">
        Showing 1–{Math.min(PER_PAGE, cardData.length)} of {cardData.length}
      </p>
      <div class="writing__pager" data-writing-pager></div>
    </div>
  </section>

  <script is:inline define:vars={{ PER_PAGE }}>
    // Filter chips and pagination for the card grid. The first page renders
    // server-side; this only re-slices what's visible.
    (() => {
      const grid = document.querySelector('[data-postgrid]');
      const chipsWrap = document.querySelector('[data-writing-chips]');
      const showing = document.querySelector('[data-writing-showing]');
      const pagerWrap = document.querySelector('[data-writing-pager]');
      if (!grid || !chipsWrap || !showing || !pagerWrap) return;

      const cards = Array.from(grid.querySelectorAll('[data-post-tag]'));
      const chips = Array.from(chipsWrap.querySelectorAll('[data-chip]'));
      let chip = 'All';
      let page = 0;

      function render() {
        const filtered = cards.filter(
          (card) => chip === 'All' || card.dataset.postTag === chip,
        );
        const totalPages = Math.max(1, Math.ceil(filtered.length / PER_PAGE));
        page = Math.min(page, totalPages - 1);
        const from = page * PER_PAGE;
        const shown = filtered.slice(from, from + PER_PAGE);

        for (const card of cards) card.hidden = !shown.includes(card);

        showing.textContent = filtered.length
          ? `Showing ${from + 1}–${from + shown.length} of ${filtered.length}`
          : 'Nothing here for that yet.';

        for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.chip === chip));

        pagerWrap.replaceChildren();
        if (totalPages <= 1) return;

        const btn = (label, cls, disabled, go) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = label;
          b.className = cls;
          b.disabled = disabled;
          b.addEventListener('click', () => {
            page = go;
            render();
          });
          return b;
        };

        pagerWrap.append(btn('← Newer', 'chip', page === 0, Math.max(0, page - 1)));
        for (let i = 0; i < totalPages; i++) {
          const b = btn(String(i + 1), 'chip writing__page', false, i);
          b.setAttribute('aria-current', String(i === page));
          if (i === page) b.setAttribute('aria-pressed', 'true');
          pagerWrap.append(b);
        }
        pagerWrap.append(
          btn('Older →', 'chip', page === totalPages - 1, Math.min(totalPages - 1, page + 1)),
        );
      }

      for (const c of chips) {
        c.addEventListener('click', () => {
          chip = c.dataset.chip;
          page = 0;
          render();
        });
      }

      render();
    })();
  </script>

  {/* --------------------------------------------------- 06 · contact -- */}
  <ContactSection
    number="06"
    title="Let’s talk."
    intro="If you’re working through a difficult customer journey, building something new, or hiring for a role you think might fit, I’d love to hear about it."
    submitLabel="Send it"
    vancouverBox="sun"
  />
</BaseLayout>

<script>
  /* ------------------------------------------------- shelf / grid view -- */
  const viewButtons = document.querySelectorAll<HTMLButtonElement>('[data-view]');
  const viewPanels = document.querySelectorAll<HTMLElement>('[data-view-panel]');

  for (const button of viewButtons) {
    button.addEventListener('click', () => {
      const view = button.dataset.view;
      for (const b of viewButtons) b.setAttribute('aria-pressed', String(b === button));
      for (const panel of viewPanels) panel.hidden = panel.dataset.viewPanel !== view;
    });
  }

  /* ----------------------------------------------------------- spines -- */
  const spines = document.querySelectorAll<HTMLButtonElement>('[data-spine]');
  const casePanels = document.querySelectorAll<HTMLElement>('[data-case-panel]');

  for (const spine of spines) {
    spine.addEventListener('click', () => {
      const index = spine.dataset.spine;
      for (const panel of casePanels) panel.hidden = panel.dataset.casePanel !== index;
      for (const s of spines) s.hidden = s === spine;
    });
  }

  /* -------------------------------------------- ask / found switchers -- */
  // Scoped per card: the shelf panels and the grid cards each carry their own
  // pair of buttons and copy blocks.
  for (const scope of document.querySelectorAll<HTMLElement>(
    '[data-case-panel], .grid-view__card',
  )) {
    const buttons = scope.querySelectorAll<HTMLButtonElement>('[data-mode]');
    const copies = scope.querySelectorAll<HTMLElement>('[data-copy]');
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const mode = button.dataset.mode;
        for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
        for (const copy of copies) copy.hidden = copy.dataset.copy !== mode;
      });
    }
  }

  /* ------------------------------------------------------ method tabs -- */
  const methodRoot = document.querySelector<HTMLElement>('[data-method]');

  if (methodRoot) {
    const tabs = [...methodRoot.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const panels = methodRoot.querySelectorAll<HTMLElement>('[data-step-panel]');
    const indicator = methodRoot.querySelector<HTMLElement>('[data-method-indicator]');
    let current = 0;
    let touched = false;

    function select(index: number) {
      current = index;
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      for (const panel of panels) panel.hidden = panel.dataset.stepPanel !== String(index);
      if (indicator) indicator.style.transform = `translateX(${index * 100}%)`;
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        touched = true;
        select(index);
      });
      // Standard tablist keyboard behaviour: arrows move, Home/End jump.
      tab.addEventListener('keydown', (event) => {
        const moves: Record<string, number> = {
          ArrowRight: index + 1,
          ArrowLeft: index - 1,
          Home: 0,
          End: tabs.length - 1,
        };
        const to = moves[event.key];
        if (to === undefined) return;
        event.preventDefault();
        touched = true;
        const next = ((to % tabs.length) + tabs.length) % tabs.length;
        select(next);
        tabs[next].focus();
      });
    });

    /* The steps advance on their own until the reader takes over. Reduced
       motion means no autoplay at all — an interface changing by itself is
       exactly what that setting asks to stop. */
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const timer = window.setInterval(() => {
        if (touched) {
          window.clearInterval(timer);
          return;
        }
        select((current + 1) % tabs.length);
      }, 5000);
    }
  }

  /* ----------------------------------------------------- receipt tabs -- */
  const receiptTabs = [...document.querySelectorAll<HTMLButtonElement>('[data-receipt]')];
  const receiptPanels = document.querySelectorAll<HTMLElement>('[data-receipt-panel]');

  receiptTabs.forEach((tab, index) => {
    const select = (i: number) => {
      receiptTabs.forEach((t, n) => {
        t.setAttribute('aria-selected', String(n === i));
        t.setAttribute('aria-pressed', String(n === i));
        t.tabIndex = n === i ? 0 : -1;
      });
      for (const panel of receiptPanels) panel.hidden = panel.dataset.receiptPanel !== String(i);
    };

    tab.addEventListener('click', () => select(index));
    tab.addEventListener('keydown', (event) => {
      const moves: Record<string, number> = {
        ArrowRight: index + 1,
        ArrowLeft: index - 1,
        Home: 0,
        End: receiptTabs.length - 1,
      };
      const to = moves[event.key];
      if (to === undefined) return;
      event.preventDefault();
      const next = ((to % receiptTabs.length) + receiptTabs.length) % receiptTabs.length;
      select(next);
      receiptTabs[next].focus();
    });
  });
</script>

