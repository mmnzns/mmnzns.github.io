---
/**
 * An article — v19 `Monzones-D-Article-V4`, "Field note No. NN".
 *
 * The export fetches and parses each post's Markdown in the browser; here
 * Astro renders it at build time, so the page arrives complete and the
 * contents rail is built from the real headings.
 */
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tagAccent } from '../../data/writing';
import { formatDate, wordCount } from '../../utils/format';
import { getPosts, postHref, noteNumber, minutes } from '../../utils/posts';
import miguel from '../../assets/brand/miguel.webp';
import tapeYellow from '../../assets/brand/tape-yellow.webp';
import tapeGreen from '../../assets/brand/tape-green.webp';

export const getStaticPaths = (async () => {
  const sorted = await getPosts();
  return sorted.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      no: noteNumber(post, sorted),
      /* Same topic first, newest first, never the piece you're reading. */
      related: sorted
        .filter((other) => other.id !== post.id)
        .sort((a, b) => Number(a.data.tag !== post.data.tag) - Number(b.data.tag !== post.data.tag))
        .slice(0, 3)
        .map((p) => ({ post: p, no: noteNumber(p, sorted) })),
    },
  }));
}) satisfies GetStaticPaths;

const { post, no, related } = Astro.props;
const { Content, headings } = await render(post);

/* Only h2s make the rail — h3s would turn it into an outline of an outline. */
const toc = headings.filter((h) => h.depth === 2);
const trim = (text: string) => (text.length > 52 ? `${text.slice(0, 50).replace(/[\s,:;—-]+\S*$/, '')}…` : text);
const accent = tagAccent(post.data.tag);
/* The blockquote's tape is a CSS background, so it needs a URL rather than an <img>. */
const quoteTape = await getImage({ src: tapeYellow, width: 224, format: 'webp' });
const TILT = ['-1.4deg', '1.1deg', '-.7deg'];
---

<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
  current="Writing"
  progress="amber"
  ogType="article"
  article={{ published: post.data.date, tag: post.data.tag, wordCount: wordCount(post.body ?? '') }}
  breadcrumbs={[
    { label: 'Writing', href: '/thinking/' },
    { label: post.data.title, href: postHref(post) },
  ]}
>
  <article>
    <header class="ahead">
      <div class="mz-max">
        <div class="mz-head3" data-hero>
          <a href="/thinking/"><span aria-hidden="true">←</span> All field notes</a>
          <span>Field note No. {no}</span>
          <span>{formatDate(post.data.date)} · {minutes(post)} min read</span>
        </div>
        <div class="ahead__tag" data-hero>
          <span><span class="ahead__dot" style={`background:${accent}`}></span>{post.data.tag}</span>
        </div>
        <h1 class="ahead__h1" data-hero>{post.data.title}</h1>
        <div class="ahead__band mz-double" data-hero>
          <p>{post.data.excerpt}</p>
        </div>
        <div class="ahead__by" data-hero>
          <span class="ahead__author">
            <Image src={miguel} alt="" width={36} height={36} densities={[1, 2]} class="ahead__avatar" />
            Words by <strong>Miguel Monzones</strong>
          </span>
          <button type="button" class="ahead__copy" data-copy-link>Copy link</button>
        </div>
      </div>
    </header>

    {
      post.data.image && (
        <figure class="ahero" data-rv>
          <span class="ahero__frame">
            <span class="ahero__paper">
              <span class="ahero__img">
                <Image
                  src={post.data.image}
                  alt={post.data.imageAlt ?? ''}
                  widths={[640, 960, 1280, 1920]}
                  sizes="(max-width: 1080px) 92vw, 1000px"
                  loading="eager"
                />
              </span>
            </span>
            <Image src={tapeYellow} alt="" aria-hidden="true" width={150} densities={[1, 2]} class="mz-tape ahero__tape" />
          </span>
        </figure>
      )
    }

    <section class="abody">
      <div class="abody__grid">
        <nav class="toc" aria-label="On this page">
          {
            toc.length > 1 && (
              <div class="toc__inner">
                <p class="toc__head">Contents</p>
                {toc.map((h, i) => (
                  <a href={`#${h.slug}`} class="toc__link" data-toc={h.slug}>
                    <span class="toc__n">{String(i + 1).padStart(2, '0')}</span>
                    <span>{trim(h.text)}</span>
                  </a>
                ))}
                <p class="toc__pct" data-read-pct>0% read</p>
              </div>
            )
          }
        </nav>

        <div class="abody__main">
          <div class="post-body" style={`--tape:url(${quoteTape.src})`} data-post-body>
            <Content />
          </div>

          <p class="mz-endmark abody__end" style={`--sq:${accent}`} data-rv><span></span>End of note</p>

          <div class="thanks" data-rv>
            <span class="thanks__snap">
              <span class="thanks__paper">
                <Image src={miguel} alt="Miguel Monzones" width={132} height={132} densities={[1, 2]} class="thanks__img" />
              </span>
              <Image src={tapeGreen} alt="" aria-hidden="true" width={75} densities={[1, 2]} class="thanks__tape" />
            </span>
            <div>
              <p class="thanks__h">Thanks for reading!</p>
              <p class="thanks__p">
                I'm Miguel. I do lifecycle and GTM for fintech, SaaS and ecommerce teams. Working through
                something similar? I'd love to hear about it.
              </p>
              <a href="/#contact" class="thanks__btn" data-magnetic>Say hello <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>

  <section class="rel">
    <div class="mz-max">
      <div class="rel__top">
        <h2 class="rel__h2" data-split>More field <em>notes.</em></h2>
        <a class="rel__all" href="/thinking/">The whole journal <span aria-hidden="true">→</span></a>
      </div>
      <div class="rel__grid">
        {
          related.map(({ post: r, no: n }, i) => (
            <a class="rcard" href={postHref(r)} data-rv data-delay={i * 110} data-cursor="Read">
              <span class="rcard__frame" style={`--tilt:${TILT[i]}`}>
                <span class="rcard__paper">
                  <span class="rcard__img" style={`background:${tagAccent(r.data.tag)}`}>
                    <span class="rcard__no">No. {n}</span>
                    {r.data.image && <Image src={r.data.image} alt="" widths={[400, 600, 800]} sizes="(max-width: 900px) 92vw, 420px" loading="lazy" />}
                  </span>
                </span>
              </span>
              <span class="rcard__meta">
                <span class="rcard__dot" style={`background:${tagAccent(r.data.tag)}`} />
                {r.data.tag} · {minutes(r)} min
              </span>
              <span class="rcard__title">{r.data.title}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="cta__row">
      <h2 class="cta__h2" data-split>Something here sound like your <em>problem?</em></h2>
      <a href="/#contact" class="mz-btn mz-btn--cream" data-rv data-magnetic>Let's talk it through <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .ahead {
    padding: clamp(28px, 4vw, 56px) var(--gutter) 0;
  }
  .ahead__tag {
    margin-top: clamp(28px, 4vw, 56px);
    display: flex;
    justify-content: center;
  }
  .ahead__tag > span {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .ahead__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .ahead__h1 {
    margin: clamp(29px, 3.8vw, 45px) auto 0;
    max-width: 17ch;
    text-align: center;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(46px, 6.6vw, 112px);
    line-height: 0.94;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .ahead__band {
    margin-top: clamp(42px, 4.8vw, 64px);
    padding: 26px 0 46px;
    border-bottom: 1px solid var(--ink);
    display: flex;
    justify-content: center;
    text-align: center;
  }
  .ahead__band p {
    margin-top: 6px;
    max-width: 60ch;
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.5;
    text-wrap: balance;
  }
  .ahead__by {
    margin-top: 18px;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 18px;
  }
  .ahead__author {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
  }
  .ahead__author strong {
    font-weight: 700;
  }
  .ahead__avatar {
    width: 36px;
    height: 36px;
    display: block;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 18%;
    border: 1.5px solid var(--ink);
  }
  .ahead__copy {
    min-height: 40px;
    padding: 8px 16px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    transition:
      background 0.3s,
      color 0.3s;
  }
  .ahead__copy:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .ahero {
    max-width: 1080px;
    margin: clamp(44px, 5vw, 72px) auto 0;
    padding: 0 var(--gutter);
  }
  .ahero__frame {
    position: relative;
    display: block;
    transform: rotate(-0.8deg);
    filter: drop-shadow(0 18px 26px rgba(31, 29, 43, 0.18));
  }
  .ahero__paper {
    display: block;
    padding: 12px 12px 14px;
    background: var(--card);
    clip-path: var(--torn-frame);
  }
  .ahero__img {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--panel);
  }
  .ahero__img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ahero__tape {
    top: -24px;
    left: 50%;
    width: 150px;
    margin-left: -75px;
    rotate: -3deg;
  }

  .abody {
    padding: clamp(48px, 6vw, 88px) var(--gutter) 0;
  }
  .abody__grid {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 40px clamp(40px, 5vw, 80px);
  }
  .toc {
    flex: 1 1 220px;
    max-width: 280px;
  }
  .toc__inner {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
  }
  .toc__head {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--ink);
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .toc__link {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 8px;
    align-items: baseline;
    padding: 10px 0;
    border-bottom: 1px solid rgba(31, 29, 43, 0.18);
    font-size: 14px;
    line-height: 1.4;
    color: var(--muted);
    transition:
      color 0.2s,
      padding 0.4s var(--ease);
  }
  .toc__link:hover {
    color: var(--ink);
    padding-left: 6px;
  }
  .toc__link.is-on {
    color: var(--ink);
  }
  .toc__n {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  .toc__link.is-on .toc__n {
    color: var(--blue);
  }
  .toc__pct {
    margin-top: 14px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  .abody__main {
    flex: 1 1 560px;
    max-width: 700px;
    min-width: 0;
  }
  @media (min-width: 700px) and (max-width: 1099px) {
    .abody__grid {
      flex-wrap: nowrap;
      column-gap: 36px;
    }
    .toc {
      flex: 0 0 200px;
      max-width: 200px;
    }
    .abody__main {
      flex: 1 1 0;
    }
    .toc__inner {
      max-height: calc(100vh - 120px);
      overflow-y: auto;
      scrollbar-width: thin;
      overscroll-behavior: contain;
    }
    .toc__link {
      font-size: 13px;
      padding: 8px 0;
    }
  }
  @media (max-width: 699px) {
    .abody__grid {
      justify-content: flex-start;
    }
    .toc,
    .abody__main {
      flex: 1 1 100%;
      max-width: none;
    }
  }

  /* The body is rendered Markdown, so its elements can only be reached globally. */
  .post-body {
    font-size: 19px;
    line-height: 1.72;
    color: var(--body-deep);
    counter-reset: sec;
  }
  .post-body :global(p) {
    margin: 0 0 26px;
    text-wrap: pretty;
  }
  .post-body > :global(p:first-of-type) {
    font-size: clamp(20px, 1.6vw, 23px);
    line-height: 1.6;
    color: var(--ink);
  }
  .post-body > :global(p:first-of-type::first-letter) {
    float: left;
    font-family: var(--serif);
    font-size: 5.1em;
    line-height: 0.82;
    padding: 0.06em 0.12em 0 0;
    color: var(--blue);
  }
  .post-body :global(h2) {
    margin: 72px 0 20px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(34px, 3.2vw, 46px);
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--ink);
    scroll-margin-top: 110px;
    text-wrap: balance;
  }
  .post-body :global(h2::before) {
    counter-increment: sec;
    content: '§ ' counter(sec, decimal-leading-zero);
    display: block;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--ink);
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .post-body :global(h3) {
    margin: 44px 0 14px;
    font-size: 22px;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
    scroll-margin-top: 110px;
  }
  .post-body :global(h4) {
    margin: 32px 0 12px;
    font-family: var(--mono);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink);
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 28px;
    padding-left: 26px;
  }
  .post-body :global(li) {
    margin-bottom: 10px;
    padding-left: 4px;
  }
  .post-body :global(li::marker) {
    color: var(--blue);
    font-family: var(--mono);
  }
  .post-body :global(li > p) {
    margin: 0;
  }
  .post-body :global(blockquote) {
    position: relative;
    margin: 56px 0;
    padding: 34px clamp(22px, 4vw, 44px) 30px;
    background: var(--card);
    transform: rotate(-0.6deg);
    filter: drop-shadow(0 12px 18px rgba(31, 29, 43, 0.14));
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(26px, 2.4vw, 34px);
    line-height: 1.22;
    color: var(--ink);
  }
  .post-body :global(blockquote::before) {
    content: '';
    position: absolute;
    top: -21px;
    left: 28px;
    width: 112px;
    height: 45px;
    background-image: var(--tape);
    background-size: 100% 100%;
    transform: rotate(-4deg);
  }
  .post-body :global(blockquote p) {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
  }
  .post-body :global(hr) {
    margin: 56px 0;
    border: 0;
    text-align: center;
    overflow: visible;
  }
  .post-body :global(hr::after) {
    content: '✳  ✳  ✳';
    white-space: pre;
    font-size: 18px;
    color: var(--blue);
  }
  .post-body :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--amber);
    text-decoration-thickness: 3px;
    text-underline-offset: 3px;
  }
  .post-body :global(a:hover) {
    color: var(--blue);
  }
  .post-body :global(strong) {
    font-weight: 700;
    color: var(--ink);
  }
  .post-body :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
    padding: 1px 6px;
    border: 1px solid rgba(31, 29, 43, 0.2);
    border-radius: 4px;
    background: var(--card);
  }
  .post-body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 36px 0;
  }
  .post-body :global(table) {
    width: 100%;
    margin: 0 0 28px;
    border-collapse: collapse;
    font-size: 16px;
    display: block;
    overflow-x: auto;
  }
  .post-body :global(th),
  .post-body :global(td) {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid rgba(31, 29, 43, 0.25);
  }
  .post-body :global(th) {
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 1px solid var(--ink);
  }

  .abody__end {
    margin-top: 64px;
  }
  .thanks {
    margin-top: 48px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 24px clamp(20px, 3vw, 36px);
    align-items: center;
  }
  .thanks__snap {
    position: relative;
    display: block;
    width: clamp(96px, 11vw, 132px);
    transform: rotate(3deg);
    filter: drop-shadow(0 10px 16px rgba(31, 29, 43, 0.18));
  }
  .thanks__paper {
    display: block;
    padding: 7px 7px 20px;
    background: var(--card);
  }
  .thanks__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: 50% 18%;
  }
  .thanks__tape {
    position: absolute;
    top: -14px;
    left: 50%;
    width: 75px;
    height: auto;
    margin-left: -37px;
    rotate: -6deg;
    pointer-events: none;
  }
  .thanks__h {
    font-family: var(--serif);
    font-size: clamp(30px, 2.6vw, 40px);
    line-height: 1;
  }
  .thanks__p {
    margin-top: 12px;
    max-width: 48ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--body);
    text-wrap: pretty;
  }
  .thanks__btn {
    margin-top: 18px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 15px;
    font-weight: 600;
    transition:
      translate 0.5s var(--ease),
      background 0.3s;
  }
  .thanks__btn:hover {
    background: var(--blue);
    color: var(--paper);
  }

  .rel {
    padding: clamp(88px, 10vw, 150px) var(--gutter) clamp(72px, 8vw, 120px);
  }
  .rel__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 16px 32px;
    padding-bottom: 16px;
    border-bottom: 3px solid var(--ink);
  }
  .rel__h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(40px, 5vw, 76px);
    line-height: 0.96;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .rel__all {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-family: var(--mono);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .rel__grid {
    margin-top: clamp(36px, 4vw, 56px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: clamp(36px, 4vw, 56px) clamp(24px, 3vw, 40px);
  }
  .rcard {
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: var(--ink);
  }
  .rcard:hover {
    color: var(--ink);
  }
  .rcard__frame {
    display: block;
    transform: rotate(var(--tilt));
    filter: drop-shadow(0 10px 16px rgba(31, 29, 43, 0.16));
    transition: transform 0.6s var(--ease);
  }
  .rcard:hover .rcard__frame {
    transform: rotate(0deg) translateY(-4px);
  }
  .rcard__paper {
    display: block;
    padding: 8px 8px 10px;
    background: var(--card);
    clip-path: var(--torn-snap);
  }
  .rcard__img {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }
  .rcard__no {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--serif);
    font-size: clamp(56px, 6vw, 88px);
    color: var(--ink);
  }
  .rcard__img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rcard__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .rcard__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .rcard__title {
    font-family: var(--serif);
    font-size: clamp(26px, 2.1vw, 32px);
    line-height: 1.05;
    text-wrap: balance;
  }

  .cta {
    padding: clamp(56px, 6vw, 96px) var(--gutter);
    background: var(--green);
    color: var(--paper);
  }
  .cta__row {
    max-width: var(--max);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 28px 48px;
  }
  .cta__h2 {
    max-width: 23ch;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(40px, 5.4vw, 84px);
    line-height: 0.96;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .cta__h2 em {
    color: var(--amber);
  }
</style>

<script>
  /* Copy link: the clipboard where allowed, and a confirmation either way. */
  const copy = document.querySelector<HTMLButtonElement>('[data-copy-link]');
  copy?.addEventListener('click', () => {
    navigator.clipboard?.writeText(window.location.href).catch(() => {});
    copy.textContent = 'Link copied ✓';
    window.setTimeout(() => (copy.textContent = 'Copy link'), 2000);
  });

  /* The rail marks the section being read, and counts how far in you are. */
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
  const pct = document.querySelector<HTMLElement>('[data-read-pct]');
  const heads = links
    .map((a) => document.getElementById(a.dataset.toc ?? ''))
    .filter((h): h is HTMLElement => !!h);
  let queued = false;
  const update = () => {
    queued = false;
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    if (pct) pct.textContent = `${Math.round(max > 0 ? Math.min(100, (doc.scrollTop / max) * 100) : 0)}% read`;
    let current = heads[0]?.id ?? '';
    for (const h of heads) if (h.getBoundingClientRect().top < 160) current = h.id;
    links.forEach((a) => a.classList.toggle('is-on', a.dataset.toc === current));
  };
  if (links.length) {
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>
