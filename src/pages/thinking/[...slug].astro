---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, readingTime } from '../../utils/format';

export async function getStaticPaths() {
  const posts = (await getCollection('thinking')).filter((p) => !p.data.draft);
  const sorted = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return sorted.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: sorted[i + 1], next: sorted[i - 1] },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <article>
    <header class="wrap article__head">
      <p class="marker enter" style="--i:0">
        {formatDate(post.data.date)} &nbsp;·&nbsp; {readingTime(post.body ?? '')} min read
      </p>
      <h1 class="article__title enter" style="--i:1">{post.data.title}</h1>
      <p class="article__excerpt enter" style="--i:2">{post.data.excerpt}</p>
    </header>

    <div class="wrap">
      <div class="article__body">
        <Content />
      </div>
    </div>
  </article>

  <nav class="wrap article__nav" aria-label="More articles">
    {
      prev && (
        <a class="adjacent" href={`/thinking/${prev.id}/`}>
          <span class="adjacent__label">← Previous</span>
          <span class="adjacent__title">{prev.data.title}</span>
        </a>
      )
    }
    {
      next && (
        <a class="adjacent adjacent--next" href={`/thinking/${next.id}/`}>
          <span class="adjacent__label">Next →</span>
          <span class="adjacent__title">{next.data.title}</span>
        </a>
      )
    }
  </nav>
</BaseLayout>

<style>
  .article__head {
    padding-block: clamp(3rem, 2rem + 6vw, 6rem) clamp(2rem, 1rem + 3vw, 3rem);
    max-width: 54rem;
  }

  .article__title {
    font-size: var(--step-5);
    margin-block: 1.25rem 0;
    max-width: 22ch;
  }

  .article__excerpt {
    margin-top: 1.75rem;
    max-width: 58ch;
    font-size: var(--step-1);
    color: var(--ink-2);
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  .article__body {
    max-width: 40rem;
    padding-bottom: var(--section-gap);
    font-size: var(--step-0);
    line-height: 1.8;
  }

  /* Long-form typography. Scoped with :global because the Markdown renders
     into this container rather than through Astro components. */
  .article__body :global(h2) {
    font-size: var(--step-3);
    margin-block: 3rem 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .article__body :global(h3) {
    font-size: var(--step-2);
    margin-block: 2.25rem 0.75rem;
  }

  .article__body :global(h4) {
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 600;
    margin-block: 1.75rem 0.5rem;
  }

  .article__body :global(p) {
    margin-block: 1.25rem;
    color: var(--ink-2);
  }

  .article__body :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .article__body :global(ul),
  .article__body :global(ol) {
    margin-block: 1.25rem;
    padding-left: 1.25rem;
    color: var(--ink-2);
  }

  .article__body :global(li) {
    margin-block: 0.6rem;
    padding-left: 0.35rem;
  }

  .article__body :global(li::marker) {
    color: var(--accent);
  }

  .article__body :global(a) {
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .article__body :global(a:hover) {
    opacity: 0.7;
  }

  .article__body :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.5rem;
    border-left: 2px solid var(--accent);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.4;
    color: var(--ink);
  }

  .article__body :global(hr) {
    margin-block: 3rem;
    border: 0;
    border-top: 1px solid var(--rule);
  }

  /* ---- prev / next ---- */
  .article__nav {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    padding-bottom: var(--section-gap);
  }

  .adjacent {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--rule);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }

  .adjacent--next {
    text-align: right;
    align-items: flex-end;
  }

  .adjacent:hover {
    border-top-color: var(--accent);
  }

  .adjacent__label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent);
  }

  .adjacent__title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.2;
    max-width: 26ch;
  }
</style>
