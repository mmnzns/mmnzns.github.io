---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tagAccent } from '../../data/writing';
import { formatDate, readingTime } from '../../utils/format';

const all = (await getCollection('thinking', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

/* The v8 design's featured slot is literally "Latest" — the newest piece, not
   a curated flag. The `featured` frontmatter field still exists but this page
   no longer reads it. */
const featured = all[0];
const rest = all.slice(1);

/* Recent work gets cards; everything older collapses into a compact list, so
   the page stays scannable as the archive grows. Filtering or searching
   flattens the split and searches everything. */
const CARD_COUNT = 6;
const cards = rest.slice(0, CARD_COUNT);
const archive = rest.slice(CARD_COUNT);

const meta = (post: (typeof all)[number]) =>
  `${formatDate(post.data.date)} · ${readingTime(post.body ?? '')} min read`;

/* A hero image published with the article doubles as the featured panel's
   visual. Resolved at build time; a post without one gets the plain panel. */
const heroImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/thinking/*-hero.jpg',
  { eager: true },
);
const featuredHero = featured
  ? heroImages[`../../assets/thinking/${featured.id}-hero.jpg`]?.default
  : undefined;

/* Everything the client-side filter needs, mirrored from the server render. */
const searchIndex = all.map((post) => ({
  slug: post.id,
  tag: post.data.tag,
  text: `${post.data.title} ${post.data.excerpt} ${post.data.tag}`.toLowerCase(),
}));

const CHIPS = ['All', 'Lifecycle', 'Search', 'AI & automation', 'Positioning'] as const;
---

<BaseLayout
  title="Writing"
  description="Lifecycle, AI, search, automation, and the occasional detour into doing the work better. Mostly me thinking through something until it makes sense."
  breadcrumbs={[{ label: 'Writing', href: '/thinking/' }]}
>
  <section class="section--first wrap whero">
    <p class="eyebrow">Writing</p>
    <div class="whero__grid">
      <h1 class="page-title">Things I’ve written.</h1>
      <div class="whero__intro">
        <p>
          Lifecycle, AI, search, automation, and the occasional detour into doing the work better.
          Mostly me thinking through something until it makes sense.
        </p>
        <p>
          I write when I can’t yet explain something in a meeting. If a piece is here, it means I
          got to the end of the thought.
        </p>
      </div>
    </div>
  </section>

  {
    featured && (
      <section class="band band--sun latest" data-latest>
        <div class="wrap">
          <p class="rule-heading latest__label">
            <span class="eyebrow">Latest</span>
          </p>
          <a class="card featured" href={`/thinking/${featured.id}/`}>
            <div class="featured__visual">
              <span class="featured__tag" style={`color:${tagAccent(featured.data.tag)}`}>
                {featured.data.tag}
              </span>
              {featuredHero ? (
                <div class="featured__photo">
                  <Image
                    src={featuredHero}
                    alt=""
                    width={720}
                    height={480}
                    loading="eager"
                    densities={[1, 2]}
                  />
                </div>
              ) : (
                <svg viewBox="0 0 260 150" aria-hidden="true" class="featured__chart">
                  <path
                    d="M12 128 C60 126, 92 120, 128 104 C168 86, 200 52, 248 30"
                    stroke="#F2603F"
                    stroke-opacity=".9"
                    stroke-width="2"
                    fill="none"
                    stroke-linecap="round"
                  />
                  <path d="M12 128 L248 128" stroke="#1F1C19" stroke-opacity=".22" stroke-width="1.5" />
                  <path d="M12 128 L12 18" stroke="#1F1C19" stroke-opacity=".22" stroke-width="1.5" />
                  <circle cx="128" cy="104" r="3.6" fill="#F2603F" />
                  <circle cx="248" cy="30" r="3.6" fill="#F2603F" />
                  <text x="22" y="34" font-size="11" fill="#6B6560">revenue events</text>
                  <text x="140" y="146" font-size="11" fill="#6B6560">the journey, mapped</text>
                </svg>
              )}
              <span class="featured__recency">Most recent</span>
            </div>
            <div class="featured__text">
              <h2 class="featured__title">{featured.data.title}</h2>
              <p class="featured__dek">{featured.data.excerpt}</p>
              <p class="featured__meta">
                <span>{meta(featured)}</span>
                <span class="featured__read">Read →</span>
              </p>
            </div>
          </a>
        </div>
      </section>
    )
  }

  <section class="section--tight wrap">
    <div class="filters">
      <div class="filters__chips" data-writing-chips>
        {
          CHIPS.map((chip) => (
            <button
              type="button"
              class="chip"
              data-chip={chip}
              aria-pressed={chip === 'All' ? 'true' : 'false'}
            >
              {chip}
            </button>
          ))
        }
      </div>

      <div class="filters__side">
        <input
          type="search"
          class="filters__search"
          placeholder="Search writing"
          aria-label="Search writing"
          data-writing-search
        />
        <span class="filters__count" data-writing-count aria-live="polite">
          {all.length} pieces
        </span>
      </div>
    </div>

    <div class="wgrid" data-writing-grid>
      {
        rest.map((post, i) => (
          <a
            class="card card--interactive wcard"
            href={`/thinking/${post.id}/`}
            data-post-slug={post.id}
            hidden={i >= CARD_COUNT}
          >
            <p class="label-row">
              <span class="accent-bar accent-bar--sm" style={`--bar:${tagAccent(post.data.tag)}`} />
              <span class="eyebrow eyebrow--muted">{post.data.tag}</span>
            </p>
            <span class="wcard__title">{post.data.title}</span>
            <span class="wcard__dek">{post.data.excerpt}</span>
            <span class="wcard__meta">{meta(post)}</span>
          </a>
        ))
      }
      {/* The featured piece re-enters the grid when a filter or search runs. */}
      {
        featured && (
          <a
            class="card card--interactive wcard"
            href={`/thinking/${featured.id}/`}
            data-post-slug={featured.id}
            data-post-featured
            hidden
          >
            <p class="label-row">
              <span
                class="accent-bar accent-bar--sm"
                style={`--bar:${tagAccent(featured.data.tag)}`}
              />
              <span class="eyebrow eyebrow--muted">{featured.data.tag}</span>
            </p>
            <span class="wcard__title">{featured.data.title}</span>
            <span class="wcard__dek">{featured.data.excerpt}</span>
            <span class="wcard__meta">{meta(featured)}</span>
          </a>
        )
      }
    </div>

    <div class="noresults" data-writing-empty hidden>
      Nothing here for that yet.
      <button type="button" class="noresults__clear" data-writing-clear>Clear filters</button>
    </div>
  </section>

  {
    archive.length > 0 && (
      <section class="band earlier" data-archive>
        <div class="wrap">
          <p class="rule-heading earlier__label">
            <span class="eyebrow earlier__eyebrow">Earlier writing</span>
          </p>
          <div class="earlier__list">
            {archive.map((post) => (
              <a class="earlier__row" href={`/thinking/${post.id}/`}>
                <span class="earlier__title">{post.data.title}</span>
                <span class="earlier__tag">{post.data.tag}</span>
                <span class="earlier__year">{post.data.date.getUTCFullYear()}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<script is:inline define:vars={{ searchIndex, CARD_COUNT }}>
  // Filtering and search re-slice what the server rendered. With no filter
  // active, the page keeps its shape: featured on top, six cards, the rest
  // collapsed into the archive band. Any filter flattens that split.
  (() => {
    const grid = document.querySelector('[data-writing-grid]');
    const chipsWrap = document.querySelector('[data-writing-chips]');
    const search = document.querySelector('[data-writing-search]');
    const count = document.querySelector('[data-writing-count]');
    const empty = document.querySelector('[data-writing-empty]');
    const clear = document.querySelector('[data-writing-clear]');
    const latest = document.querySelector('[data-latest]');
    const archiveBand = document.querySelector('[data-archive]');
    if (!grid || !chipsWrap || !count) return;

    const cards = new Map(
      Array.from(grid.querySelectorAll('[data-post-slug]')).map((el) => [el.dataset.postSlug, el]),
    );
    const chips = Array.from(chipsWrap.querySelectorAll('[data-chip]'));
    const total = searchIndex.length;
    let chip = 'All';
    let query = '';

    function render() {
      const active = chip !== 'All' || query.length > 0;

      for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.chip === chip));
      if (latest) latest.hidden = active;
      if (archiveBand) archiveBand.hidden = active;

      let shown = 0;
      searchIndex.forEach((post, i) => {
        const card = cards.get(post.slug);
        if (!card) return;
        let visible;
        if (!active) {
          // The resting shape: no featured card, first six of the rest.
          visible = i > 0 && i <= CARD_COUNT;
        } else {
          visible = (chip === 'All' || post.tag === chip) && (!query || post.text.includes(query));
        }
        card.hidden = !visible;
        if (visible) shown += 1;
      });

      count.textContent = active ? `${shown} of ${total} pieces` : `${total} pieces`;
      if (empty) empty.hidden = !(active && shown === 0);
    }

    for (const c of chips) {
      c.addEventListener('click', () => {
        chip = c.dataset.chip;
        render();
      });
    }

    search?.addEventListener('input', () => {
      query = search.value.trim().toLowerCase();
      render();
    });

    clear?.addEventListener('click', () => {
      chip = 'All';
      query = '';
      if (search) search.value = '';
      render();
    });
  })();
</script>

<style>
  .whero__grid {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 40px 64px;
    align-items: end;
  }

  .whero__intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-2);
    padding-bottom: 10px;
  }

  .latest {
    margin-top: clamp(72px, 9vw, 120px);
    padding-block: clamp(56px, 7vw, 96px);
  }

  .latest__label {
    margin-bottom: 26px;
  }

  .featured {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform var(--dur) var(--ease);
  }

  .featured:hover {
    transform: translate(-4px, -4px);
    color: var(--ink);
  }

  .featured__visual {
    min-height: 300px;
    background: var(--wash);
    padding: clamp(17px, 4.5vw, 34px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
  }

  .featured__tag {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .featured__photo {
    overflow: hidden;
    border: var(--border);
  }

  .featured__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured__chart {
    width: 100%;
    height: auto;
    font-family: var(--font-sans);
  }

  .featured__recency {
    font-size: 12px;
    color: var(--ink-3);
    letter-spacing: 0.02em;
  }

  .featured__text {
    padding: clamp(21px, 5.6vw, 42px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .featured__title {
    font-size: clamp(32px, 4vw, 58px);
    line-height: 0.95;
    letter-spacing: -0.034em;
  }

  .featured__dek {
    font-size: 17px;
    line-height: 1.68;
    color: var(--ink-2);
  }

  .featured__meta {
    margin-top: auto;
    padding-top: 24px;
    border-top: var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 13px;
    color: var(--ink-3);
  }

  .featured__read {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
  }

  .filters {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  .filters__chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .filters__side {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .filters__search {
    width: 210px;
    padding: 10px 14px;
    border: var(--border);
    background: var(--paper);
    font-size: 14px;
    color: var(--ink);
  }

  .filters__count {
    font-size: 13px;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .wgrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr));
    gap: 20px;
  }

  .wcard {
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .wcard:hover {
    box-shadow: var(--shadow);
  }

  .wcard__title {
    font-size: 20px;
    line-height: 1.24;
    font-weight: 700;
    letter-spacing: -0.012em;
    text-wrap: pretty;
  }

  .wcard__dek {
    font-size: 15px;
    line-height: 1.62;
    color: var(--ink-2);
  }

  .wcard__meta {
    margin-top: auto;
    padding-top: 20px;
    border-top: var(--border);
    font-size: 13px;
    color: var(--ink-3);
  }

  .noresults {
    padding: 56px 0;
    text-align: center;
    color: var(--ink-3);
    font-size: 16px;
  }

  .noresults__clear {
    border: 0;
    background: transparent;
    color: var(--coral);
    font-size: 16px;
    padding: 0;
    text-decoration: underline;
  }

  .earlier {
    margin-top: clamp(88px, 11vw, 150px);
    padding-block: clamp(88px, 8vw, 110px);
  }

  .earlier__label {
    margin-bottom: 26px;
  }

  .earlier__eyebrow {
    color: var(--on-dark);
  }

  .earlier__list {
    border: 3px solid var(--on-dark);
  }

  .earlier__row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 24px;
    align-items: baseline;
    padding: 20px 28px;
    color: var(--on-dark);
    transition:
      background var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .earlier__row + .earlier__row {
    border-top: 3px solid var(--on-dark-rule-2);
  }

  .earlier__row:hover,
  .earlier__row:focus-visible {
    background: var(--sun);
    color: var(--ink);
  }

  .earlier__title {
    font-size: 18px;
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: -0.014em;
  }

  .earlier__tag {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-dark-3);
  }

  .earlier__row:hover .earlier__tag,
  .earlier__row:hover .earlier__year {
    color: var(--ink);
  }

  .earlier__year {
    font-size: 13px;
    font-weight: 700;
    color: var(--on-dark-3);
    min-width: 38px;
    text-align: right;
  }

  @media (max-width: 640px) {
    .earlier__row {
      grid-template-columns: 1fr auto;
    }

    .earlier__tag {
      display: none;
    }
  }
</style>
