---
/**
 * The writing index — v19 `Monzones-D-Writing-V4`, "Field notes".
 *
 * Driven by the collection, never by the export's hardcoded list: the newest
 * post takes the big "Latest" slot, the next three sit beside it, and the
 * archive below holds the rest, by year. Filtering or searching widens the
 * archive to every post, exactly as the export does. All rows are rendered on
 * the server; the script only toggles `hidden`.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TAGS, tagAccent } from '../../data/writing';
import { formatDate } from '../../utils/format';
import { getPosts, postHref, minutes, dekOf } from '../../utils/posts';
import tapeYellow from '../../assets/brand/tape-yellow.webp';

const posts = await getPosts();
const [feat, ...afterFeat] = posts;
const side = afterFeat.slice(0, 3);
const frontIds = new Set([feat, ...side].map((p) => p.id));
const restCount = posts.length - frontIds.size;

const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))].sort((a, b) => b - a);
const span = `${years[years.length - 1]} – ${years[0]}`;
---

<BaseLayout
  title="Writing"
  description="Field notes on lifecycle, search, AI and positioning — each one written to think something through to the end."
  current="Writing"
  breadcrumbs={[{ label: 'Writing', href: '/thinking/' }]}
>
  <section class="mast">
    <div class="mz-max">
      <div class="mz-head3" data-hero>
        <span>The journal</span>
        <span>{posts.length} essays, {span}</span>
        <span>Lifecycle · Search · AI · Positioning</span>
      </div>
      <h1 class="mast__h1" data-hero>Field <em>notes.</em></h1>
      <div class="mast__band mz-double" data-hero>
        <p>Notes I write to think things through. Each one made it to the end of the thought.</p>
      </div>
    </div>
  </section>

  <section class="front">
    <div class="front__grid">
      <a class="feat" href={postHref(feat)} data-rv data-cursor="Read">
        <span class="feat__frame">
          <span class="feat__paper">
            <span class="feat__img">
              {
                feat.data.image ? (
                  <Image src={feat.data.image} alt={feat.data.imageAlt ?? ''} widths={[560, 840, 1200]} sizes="(max-width: 1000px) 92vw, 680px" loading="eager" />
                ) : (
                  <span class="ph" style={`background:${tagAccent(feat.data.tag)}`}>No. {String(posts.length).padStart(2, '0')}</span>
                )
              }
            </span>
          </span>
          <Image src={tapeYellow} alt="" aria-hidden="true" width={128} densities={[1, 2]} class="mz-tape feat__tape" />
        </span>
        <span class="feat__meta">
          <span class="feat__latest">Latest</span>
          <span class="mz-muted">{feat.data.tag} · {formatDate(feat.data.date)} · {minutes(feat)} min</span>
        </span>
        <span class="feat__title">{feat.data.title}</span>
        <span class="feat__dek">{dekOf(feat)}</span>
        <span class="mz-cta feat__cta">Read the essay <span aria-hidden="true">→</span></span>
      </a>

      <div class="side">
        <p class="side__head" data-rv>Also on the front page</p>
        {
          side.map((p, i) => (
            <a class="side__item" href={postHref(p)} data-rv data-delay={i * 100} data-cursor="Read">
              <span class="side__text">
                <span class="side__meta">{p.data.tag} · {minutes(p)} min</span>
                <span class="side__title">{p.data.title}</span>
                <span class="side__dek">{dekOf(p)}</span>
              </span>
              <span class="side__thumb" style={`rotate:${i % 2 ? 3 : -3}deg`}>
                {p.data.image ? (
                  <Image src={p.data.image} alt="" width={300} height={300} class="side__img" loading="lazy" />
                ) : (
                  <span class="side__img ph ph--sm" style={`background:${tagAccent(p.data.tag)}`} />
                )}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="arch">
    <div class="mz-max">
      <div class="abar">
        <div class="abar__chips" role="group" aria-label="Filter by topic">
          {
            ['All', ...TAGS].map((t) => (
              <button type="button" class="achip" aria-pressed={t === 'All' ? 'true' : 'false'} data-tag={t}>
                <span class="achip__dot" style={t === 'All' ? '' : `background:${tagAccent(t as (typeof TAGS)[number])}`} />
                {t}
              </button>
            ))
          }
        </div>
        <label class="asearch">
          <span aria-hidden="true">&gt;</span>
          <input type="search" placeholder="search the journal" aria-label="Search the journal" data-search />
        </label>
      </div>
      <p class="showing" aria-live="polite" data-showing>The archive · {restCount} more essays</p>

      <div class="years" data-years>
        {
          years.map((y) => {
            const inYear = posts.filter((p) => p.data.date.getUTCFullYear() === y);
            const allFront = inYear.every((p) => frontIds.has(p.id));
            return (
              <div class="year" data-year hidden={allFront}>
                <div class="year__label"><span>{y}</span></div>
                <div>
                  {inYear.map((p) => (
                    <a
                      class="arow"
                      href={postHref(p)}
                      data-row
                      data-tag={p.data.tag}
                      data-front={frontIds.has(p.id) ? '1' : undefined}
                      data-text={`${p.data.title} ${dekOf(p)} ${p.data.tag}`.toLowerCase()}
                      hidden={frontIds.has(p.id)}
                    >
                      <span class="arow__main">
                        {p.data.image && (
                          <Image src={p.data.image} alt="" widths={[360, 520]} sizes="92vw" class="arow__thumb" loading="lazy" />
                        )}
                        <span class="arow__meta">
                          <span class="arow__dot" style={`background:${tagAccent(p.data.tag)}`} />
                          {p.data.tag} · {formatDate(p.data.date)}
                        </span>
                        <span class="arow__title">{p.data.title}</span>
                        <span class="arow__dek">{dekOf(p)}</span>
                      </span>
                      <span class="arow__read">{minutes(p)} min →</span>
                    </a>
                  ))}
                </div>
              </div>
            );
          })
        }
      </div>
      <div class="empty" data-empty hidden>
        <p>Nothing on that yet.</p>
        <button type="button" data-clear>Clear filters</button>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="cta__row">
      <h2 class="cta__h2" data-split>Something here sound like your <em>problem?</em></h2>
      <a href="/#contact" class="mz-btn mz-btn--cream" data-rv data-magnetic>Let's talk it through <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .mast {
    padding: clamp(32px, 5vw, 72px) var(--gutter) 0;
  }
  .mast__h1 {
    margin-top: clamp(32px, 4.8vw, 58px);
    text-align: center;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(64px, 12vw, 210px);
    line-height: 0.86;
    letter-spacing: -0.03em;
  }
  .mast__band {
    margin-top: clamp(29px, 3.8vw, 48px);
    padding: 24px 0 44px;
    border-bottom: 1px solid var(--ink);
    display: flex;
    justify-content: center;
    text-align: center;
  }
  .mast__band p {
    margin-top: 6px;
    max-width: 62ch;
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.5;
    text-wrap: balance;
  }

  .front {
    padding: clamp(36px, 4vw, 64px) var(--gutter) clamp(56px, 6vw, 96px);
  }
  .front__grid {
    max-width: var(--max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: clamp(32px, 4vw, 64px);
  }
  .feat {
    display: flex;
    flex-direction: column;
    gap: 20px;
    color: var(--ink);
  }
  .feat:hover {
    color: var(--ink);
  }
  .feat__frame {
    position: relative;
    display: block;
    transform: rotate(-1.2deg);
    filter: drop-shadow(0 14px 22px rgba(31, 29, 43, 0.18));
    transition: transform 0.6s var(--ease);
  }
  .feat:hover .feat__frame {
    transform: rotate(0deg) scale(1.01);
  }
  .feat__paper {
    display: block;
    padding: 10px 10px 12px;
    background: var(--card);
    clip-path: var(--torn-frame);
  }
  .feat__img {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    clip-path: var(--torn-frame-img);
  }
  .feat__img img,
  .feat__img .ph {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ph {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--serif);
    font-size: clamp(56px, 6vw, 88px);
    color: var(--ink);
  }
  .feat__tape {
    top: -18px;
    left: 14%;
    width: 128px;
    rotate: -5deg;
  }
  .feat__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .feat__latest {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
  }
  .feat__title {
    font-family: var(--serif);
    font-size: clamp(36px, 3.8vw, 62px);
    line-height: 1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .feat__dek {
    font-size: clamp(17px, 1.3vw, 19px);
    line-height: 1.55;
    color: var(--body);
    max-width: 56ch;
    text-wrap: pretty;
  }
  .feat__cta {
    font-size: 16px;
  }

  .side {
    display: flex;
    flex-direction: column;
    padding-left: clamp(20px, 2.6vw, 40px);
    border-left: 1px solid var(--ink);
  }
  @media (max-width: 899px) {
    .side {
      padding-left: 0;
      padding-top: 16px;
      border-left: 0;
    }
  }
  .side__head {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--ink);
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .side__item {
    flex: 1 1 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(96px, 10vw, 150px);
    gap: 18px;
    align-items: center;
    align-content: center;
    padding: clamp(18px, 2vw, 26px) 0;
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
    transition: padding 0.5s var(--ease);
  }
  @media (max-width: 899px) {
    .side__item {
      flex: 0 0 auto;
      padding: 32px 0;
    }
  }
  .side__item:hover {
    padding-left: 12px;
    color: var(--ink);
  }
  .side__text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .side__meta,
  .arow__meta {
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .side__title {
    font-family: var(--serif);
    font-size: clamp(24px, 2vw, 32px);
    line-height: 1.05;
    text-wrap: balance;
  }
  .side__dek {
    font-size: 15px;
    line-height: 1.5;
    color: var(--body);
    text-wrap: pretty;
  }
  .side__thumb {
    display: block;
    padding: 5px 5px 7px;
    background: var(--card);
    clip-path: var(--torn-thumb);
    filter: drop-shadow(0 6px 10px rgba(31, 29, 43, 0.18));
  }
  .side__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .arch {
    padding: 0 var(--gutter) clamp(72px, 8vw, 120px);
  }
  .abar {
    position: sticky;
    top: 0;
    z-index: 20;
    margin: 0 calc(-1 * var(--gutter));
    padding: 12px var(--gutter);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 20px;
    background: rgba(248, 244, 236, 0.92);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-top: 3px double var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .abar__chips {
    flex: 1 1 auto;
    min-width: min(100%, 560px);
    max-width: 100%;
    display: flex;
    flex-wrap: nowrap;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    margin: -2px 0;
    padding: 2px 0;
  }
  .abar__chips::-webkit-scrollbar {
    display: none;
  }
  .achip {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 14px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
    transition:
      background 0.3s,
      color 0.3s;
  }
  .achip[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }
  .achip__dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  .asearch {
    flex: 1 1 280px;
    min-width: min(100%, 280px);
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: var(--card);
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
  .asearch input {
    flex: 1;
    min-width: 0;
    padding: 8px 0;
    border: 0;
    background: transparent;
    font-family: var(--mono);
    font-size: 14px;
    color: var(--ink);
    outline: none;
  }
  .asearch:focus-within {
    outline: 3px solid var(--blue);
    outline-offset: 3px;
  }
  .showing {
    padding: 16px 0 0;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }

  .years {
    margin-top: 12px;
  }
  .year {
    display: grid;
    grid-template-columns: minmax(90px, 0.18fr) minmax(0, 1fr);
    gap: 0 clamp(16px, 3vw, 48px);
    border-top: 1px solid var(--ink);
  }
  .year__label {
    padding-top: clamp(18px, 2vw, 26px);
  }
  .year__label span {
    position: sticky;
    top: 84px;
    display: block;
    font-family: var(--serif);
    font-size: clamp(44px, 5vw, 84px);
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--blue);
  }
  .arow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px clamp(16px, 2.4vw, 36px);
    align-items: baseline;
    padding: clamp(18px, 2vw, 26px) 10px;
    border-bottom: 1px solid rgba(31, 29, 43, 0.25);
    border-radius: 4px;
    color: var(--ink);
    transition:
      background 0.3s,
      padding 0.5s var(--ease);
  }
  .arow:hover {
    background: var(--card);
    padding-left: 22px;
    color: var(--ink);
  }
  .arow__main {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .arow__thumb {
    display: none;
    width: 100%;
    max-width: 520px;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    margin-bottom: 4px;
    border: 1px solid rgba(31, 29, 43, 0.15);
  }
  @media (hover: none), (pointer: coarse), (max-width: 999px) {
    .arow__thumb {
      display: block;
    }
  }
  .arow__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    letter-spacing: 0.06em;
  }
  .arow__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .arow__title {
    font-family: var(--serif);
    font-size: clamp(24px, 2.3vw, 36px);
    line-height: 1.06;
    text-wrap: balance;
  }
  .arow__dek {
    font-size: 15px;
    line-height: 1.5;
    color: var(--body);
    max-width: 70ch;
    text-wrap: pretty;
  }
  .arow__read {
    font-family: var(--mono);
    font-size: 13px;
    white-space: nowrap;
  }
  @media (max-width: 899px) {
    .year {
      grid-template-columns: minmax(0, 1fr);
    }
    .year__label {
      padding: 36px 0 20px;
    }
    .arow {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      padding: 32px 4px;
    }
    .arow__main {
      gap: 12px;
    }
  }
  .empty {
    padding: 48px 0;
    text-align: center;
    border-top: 1px solid var(--ink);
  }
  .empty p {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(28px, 3vw, 40px);
  }
  .empty button {
    margin-top: 18px;
    padding: 12px 20px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
  }

  .cta {
    padding: clamp(56px, 6vw, 96px) var(--gutter);
    background: var(--green);
    color: var(--paper);
  }
  .cta__row {
    max-width: var(--max);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 28px 48px;
  }
  .cta__h2 {
    max-width: 23ch;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(40px, 5.4vw, 84px);
    line-height: 0.96;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .cta__h2 em {
    color: var(--amber);
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const EASE = 'cubic-bezier(.16,1,.3,1)';
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tag]')).filter((b) => b.tagName === 'BUTTON');
  const search = document.querySelector<HTMLInputElement>('[data-search]')!;
  const showing = document.querySelector<HTMLElement>('[data-showing]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const yearsBox = document.querySelector<HTMLElement>('[data-years]')!;
  const years = Array.from(document.querySelectorAll<HTMLElement>('[data-year]'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-row]'));
  const initial = showing.textContent;
  let tag = 'All';
  let timer = 0;

  const deal = () => {
    if (reduced) return;
    rows
      .filter((r) => !r.hidden)
      .forEach((r, i) => {
        r.style.transition = 'none';
        r.style.opacity = '0';
        r.style.translate = '0 24px';
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            const d = Math.min(i, 10) * 50;
            r.style.transition = `opacity .7s ${EASE} ${d}ms, translate .9s ${EASE} ${d}ms, background .3s, padding .5s ${EASE}`;
            r.style.opacity = '';
            r.style.translate = '';
          }),
        );
      });
  };

  const apply = (animate: boolean) => {
    const q = search.value.trim().toLowerCase();
    const browsing = tag === 'All' && !q;
    let n = 0;
    for (const r of rows) {
      const match = (tag === 'All' || r.dataset.tag === tag) && (!q || (r.dataset.text ?? '').includes(q));
      // Browsing hides what's already on the front page; a filter or search covers everything.
      const show = match && !(browsing && r.dataset.front);
      r.hidden = !show;
      if (show) n++;
    }
    years.forEach((y) => (y.hidden = !y.querySelector('[data-row]:not([hidden])')));
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.tag === tag)));
    empty.hidden = n > 0;
    yearsBox.hidden = n === 0;
    showing.textContent = browsing
      ? initial
      : `Showing ${n} of ${rows.length}${tag === 'All' ? '' : ` · ${tag}`}${q ? ` · “${search.value.trim()}”` : ''}`;
    if (animate) deal();
  };

  chips.forEach((c) =>
    c.addEventListener('click', () => {
      if (tag === c.dataset.tag) return;
      tag = c.dataset.tag ?? 'All';
      apply(true);
    }),
  );
  search.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(() => apply(false), 120);
  });
  document.querySelector('[data-clear]')?.addEventListener('click', () => {
    tag = 'All';
    search.value = '';
    apply(true);
  });
</script>
