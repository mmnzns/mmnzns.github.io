---
import { Image } from 'astro:assets';
import WebDesignLayout from '../../layouts/WebDesignLayout.astro';
import {
  BACKGROUND_LOGOS,
  BUILDS,
  JUDGE_TESTS,
  TESTIMONIAL_SLOTS,
  WORK_HERO,
  WORK_JUMPS,
} from '../../data/web-design';
import shotII from '../../assets/webdesign/intelligent-investing.jpg';
import shotDTC from '../../assets/webdesign/dtc-newsletter.jpg';
import shotKatty from '../../assets/webdesign/kattyco.jpg';
import shotSLP from '../../assets/webdesign/east-van-slp.jpg';

/**
 * `/web-design/work/` — ported from the v14 export's `Monzones-W-Work`.
 *
 * The screenshots are the ones already committed for the main web design
 * page, keyed by the build's slug so the data file doesn't have to import
 * images itself.
 */
const SHOTS = {
  'intelligent-investing': shotII,
  'dtc-newsletter': shotDTC,
  kattyco: shotKatty,
  'east-van-slp': shotSLP,
} as const;
---

<WebDesignLayout
  title="Work · Web Design"
  description="Four live websites, written up with what was going on, what I built and what happened next — plus how to judge any portfolio, including this one."
  current="work"
>
  <header class="wdwrap wdhero" id="top">
    <p class="wdhero__tags">
      {
        WORK_HERO.tags.map((tag, i) => (
          <span class:list={['wdtag', i === 1 && 'wdtag--butter']}>{tag}</span>
        ))
      }
    </p>
    <h1 class="wdhero__title">
      {WORK_HERO.titleLead} <em>{WORK_HERO.titleAccent}</em>
    </h1>
    <p class="wdhero__body">
      {WORK_HERO.body} <strong>{WORK_HERO.bodyStrong}</strong>
    </p>

    <nav class="wdjumps" aria-label="On this page">
      {WORK_JUMPS.map((jump) => <a href={jump.href}>{jump.label}</a>)}
    </nav>
  </header>

  {/*
    Each build is its own full-bleed band, alternating near-black and paper,
    with the picture swapping sides to match.
  */}
  {
    BUILDS.map((build, i) => {
      const dark = i % 2 === 0;
      return (
        <section
          class:list={['wdband', dark ? 'wdband--dark' : 'wdband--paper']}
          id={i === 0 ? 'cases' : undefined}
        >
          <div class="wdband__inner">
            {i === 0 ? (
              <p class="wdkick wdcase__kick" data-reveal>
                one of four
              </p>
            ) : null}

            <article class:list={['wdcase', !dark && 'wdcase--flip']}>
              <div class="wdcase__text" data-reveal>
                <p class="wdmono wdcase__meta">{build.meta}</p>
                <h2 class="wdh2 wdcase__title">
                  {build.titleLead} <em>{build.titleAccent}</em>
                </h2>

                <div class="wdcase__blocks">
                  <div>
                    <span class="wdlabel">The situation</span>
                    <p class="wdbody">{build.situation}</p>
                  </div>
                  <div>
                    <span class="wdlabel">What I built</span>
                    <p class="wdbody">{build.built}</p>
                  </div>
                  <div>
                    <span class="wdlabel">What happened</span>
                    <p class="wdbody">{build.happened}</p>
                  </div>
                </div>

                <a class="wdlink" href={build.href} target="_blank" rel="noopener">
                  {build.linkLabel}
                </a>
              </div>

              <div class="wdcase__shot" data-reveal="pop">
                <a href={build.href} target="_blank" rel="noopener" aria-label={build.alt}>
                  <Image
                    src={SHOTS[build.slug]}
                    alt={build.alt}
                    widths={[560, 900]}
                    sizes="(max-width: 980px) 92vw, 46vw"
                    loading="lazy"
                  />
                </a>
              </div>
            </article>
          </div>
        </section>
      );
    })
  }

  <section class="wdband wdband--paper wdband--rule" id="judge">
    <div class="wdband__inner wdband__inner--1000 wdjudge__inner">
      <p class="wdkick" data-reveal>please be picky</p>
      <h2 class="wdh2 wdh2--work" data-reveal>How to judge these <em>yourself.</em></h2>
      <p class="wdlede wdlede--17 wdjudge__lede" data-reveal>
        A portfolio you can’t verify is just a nice grid of pictures. Here’s the four-minute version
        of what I’d check on any website, mine included. Open one of them on your phone and run
        through it.
      </p>

      <div class="wdgrid wdjudge__grid">
        {
          JUDGE_TESTS.map((test) => (
            <div class="wdcard wdjudge__card" data-reveal>
              <p class="wdjudge__q">{test.q}</p>
              <p class="wdbody wdbody--sm">{test.a}</p>
            </div>
          ))
        }
      </div>

      <p class="wdnote wdjudge__note" data-reveal>
        if any of mine fail your test, tell me. I’d like to know
      </p>
    </div>
  </section>

  <section class="wdband wdband--dark" id="background">
    <div class="wdband__inner">
      <p class="wdkick" data-reveal>the longer story</p>
      <h2 class="wdh2 wdh2--md wdbg__title" data-reveal>Where the instincts <em>came from.</em></h2>
      <p class="wdlede wdlede--17 wdbg__lede" data-reveal>
        Building websites is the newer chapter. Before it, a decade-plus of lifecycle and
        go-to-market work across 14 markets: figuring out why people sign up, why they leave, and
        which single sentence changes their mind. That’s the part that shows up in the builds.
      </p>

      <p class="wdlogos" data-reveal>
        {BACKGROUND_LOGOS.map((logo) => <span class="wdchip">{logo}</span>)}
      </p>

      <div class="wdgrid wdbg__grid">
        <div class="wdcard wdcard--14" data-reveal>
          <span class="wdlabel wdbg__label">To be clear</span>
          <p class="wdbody wdbg__body">
            That work was lifecycle, retention and go-to-market, not website builds. I’m listing it
            because it’s the reason I design pages around what makes a real person act, rather than
            around what looks good in a mockup.
          </p>
        </div>
        <div class="wdcard wdcard--14 wdbg__card" data-reveal>
          <span class="wdlabel wdbg__label">The full history</span>
          <p class="wdbody wdbg__body">
            The detailed case studies live at HQ: the programs, the markets, the numbers and the
            parts that didn’t work. And if the site is fine but the funnel behind it isn’t, that’s
            the consulting practice.
          </p>
          <p class="wdbg__links">
            <a class="wdlink wdbg__link" href="/work/">All 13 case studies ↗</a>
            <a class="wdlink wdbg__link" href="/consulting/">The consulting practice ↗</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="wdband wdband--paper" id="testimonials">
    <div class="wdband__inner wdband__inner--1000">
      <p class="wdkick" data-reveal>the honest bit</p>
      <h2 class="wdh2 wdh2--md" data-reveal>
        The testimonial wall is <em>empty on purpose.</em>
      </h2>
      <p class="wdlede wdlede--18 wdwall__lede" data-reveal>
        I could have five glowing quotes on this page by dinner. Anyone could. So instead: this
        practice is new, the founding-client rate is running, and the first five clients are the
        ones whose words will go here.
      </p>
      <p class="wdlede wdlede--18 wdwall__lede wdwall__lede--last" data-reveal>
        That’s the trade behind the <a class="wdinline" href="/web-design/pricing/">founding rate</a
        >: a genuinely lower price, in exchange for an honest testimonial and permission to feature
        the work. Honest is the operative word. If the experience was a six out of ten, I want the
        six out of ten, because that’s the feedback that makes the next build better.
      </p>

      <div class="wdgrid wdgrid--3 wdwall__grid">
        {
          TESTIMONIAL_SLOTS.map((slot) => (
            <div class="wdslot" data-reveal>
              <span class="wdslot__num">{slot.num}</span>
              <p class="wdslot__line">{slot.line}</p>
              <p class="wdslot__note">{slot.note}</p>
            </div>
          ))
        }
      </div>

      <div class="wdmeantime" data-reveal="pop">
        <p class="wdmeantime__line">In the meantime, the live sites are the reference.</p>
        <p class="wdmeantime__body">
          Four of them, up there, all clickable. Judge the work rather than the adjectives, and if
          you’d like to talk to me about any of it, the call is free and I love these conversations.
        </p>
      </div>
    </div>
  </section>

  <section class="wdcta" id="start">
    <span class="wdcta__m" aria-hidden="true">M.</span>
    <div class="wdcta__inner">
      <h2 class="wdh2" data-reveal>Fancy being <em>number five?</em></h2>
      <p class="wdlede" data-reveal>
        Five questions, two minutes, and I can usually come back with a price rather than a pitch
        within two business days.
      </p>
      <p class="wdnote" data-reveal>one build at a time, so you get a real start date</p>
      <div class="wdctarow" data-reveal>
        <a class="wdbtn wdbtn--solid" href="/web-design/#start">Start a project ↗</a>
        <a class="wdbtn wdbtn--ghost" href="/web-design/process/">How the process works</a>
        <a class="wdbtn wdbtn--ghost" href="/web-design/pricing/">See the prices</a>
      </div>
    </div>
  </section>
</WebDesignLayout>

<style>
  /* Page-unique styles; the shared vocabulary is in WebDesignLayout.astro.
     Values are the v14 export's (`Monzones-W-Work`). */

  /* -------------------------------------------------------------- cases -- */
  .wdcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.04fr);
    gap: 44px 52px;
    align-items: center;
  }

  /* Alternating sides. The image is second in the markup either way, so the
     reading order stays text-then-picture for a screen reader. */
  .wdcase--flip {
    grid-template-columns: minmax(0, 1.04fr) minmax(0, 1fr);
  }

  .wdcase--flip .wdcase__text {
    order: 2;
  }

  .wdcase__kick {
    margin-bottom: 44px;
  }

  .wdcase__meta {
    margin-bottom: 10px;
  }

  .wdcase__title {
    margin-bottom: 22px;
    font-size: clamp(34px, 4.4vw, 58px);
    line-height: 1;
  }

  .wdcase__blocks {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 26px;
  }

  .wdcase__shot a {
    display: block;
    border: 1px solid var(--wd-ink);
    border-radius: 14px;
    overflow: hidden;
    background: var(--wd-blueband);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .wdcase__shot a:hover,
  .wdcase__shot a:focus-visible {
    transform: translateY(-5px);
    box-shadow: 8px 8px 0 var(--wd-coral);
  }

  /* Darker frame and mat on the dark band, so the screenshot doesn't sit in a
     bright box. */
  .wdband--dark .wdcase__shot a {
    border-color: var(--wd-ink-soft);
    background: var(--wd-card-dark);
  }

  .wdcase__shot img {
    display: block;
    width: 100%;
    height: 420px;
    object-fit: cover;
    object-position: top center;
  }

  /* -------------------------------------------------------------- judge -- */
  .wdjudge__inner {
    padding-top: 88px;
  }

  .wdh2--work {
    font-size: clamp(34px, 4.4vw, 58px);
    line-height: 1;
  }

  .wdjudge__lede {
    max-width: 640px;
    margin-bottom: 40px;
  }

  .wdjudge__grid {
    grid-auto-rows: 1fr;
    gap: 16px;
  }

  .wdjudge__card {
    padding: 26px 24px;
  }

  .wdjudge__q {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 800;
  }

  .wdjudge__note {
    margin-top: 26px;
  }

  /* --------------------------------------------------------- background -- */
  .wdbg__title {
    max-width: 900px;
  }

  .wdbg__lede {
    max-width: 720px;
    margin-bottom: 32px;
  }

  .wdlogos {
    margin: 0 0 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .wdbg__grid {
    gap: 20px;
    align-items: stretch;
  }

  .wdbg__label {
    margin-bottom: 10px;
  }

  .wdbg__body {
    font-size: 16px;
  }

  .wdbg__card {
    display: flex;
    flex-direction: column;
  }

  .wdbg__links {
    margin: auto 0 0;
    padding-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
  }

  .wdbg__link {
    font-size: 15.5px;
  }

  /* ------------------------------------------------------- testimonials -- */
  .wdwall__lede {
    margin-bottom: 20px;
  }

  .wdwall__lede--last {
    margin-bottom: 40px;
  }

  .wdwall__grid {
    grid-auto-rows: 1fr;
    gap: 16px;
    margin-bottom: 34px;
  }

  /* Three dashed placeholders, half-transparent card faces. */
  .wdslot {
    display: flex;
    flex-direction: column;
    padding: 30px 26px;
    border: 2px dashed var(--wd-rule-strong);
    border-radius: 14px;
    background: rgb(252 251 247 / 50%);
  }

  .wdslot__num {
    font-size: 44px;
    font-weight: 900;
    line-height: 1;
    color: var(--wd-rule-soft);
  }

  .wdslot__line {
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.6;
    font-style: italic;
    color: var(--wd-muted);
  }

  .wdslot__note {
    margin: auto 0 0;
    padding-top: 18px;
    font-family: var(--wd-hand);
    font-size: 21px;
    color: var(--wd-rule-strong);
  }

  .wdmeantime {
    padding: 26px 30px;
    border: 1px solid var(--wd-ink);
    border-radius: 12px;
    background: var(--wd-yellow);
    box-shadow: 6px 6px 0 var(--wd-ink);
    color: var(--wd-ink);
  }

  .wdmeantime__line {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 900;
    line-height: 1.4;
  }

  .wdmeantime__body {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
  }

  @media (max-width: 980px) {
    .wdcase {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Stacked, the picture leads on every build. */
    .wdcase--flip .wdcase__text {
      order: 0;
    }

    .wdcase__shot {
      order: -1;
    }
  }
</style>
