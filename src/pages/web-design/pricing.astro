---
import WebDesignLayout from '../../layouts/WebDesignLayout.astro';
import { CONTACT } from '../../config';
import {
  ADDONS,
  BUILD_TABLE,
  CARE_PLANS,
  CARE_TERMS,
  COMPARISON,
  DOMAIN_ITEMS,
  DOMAIN_WAYS,
  FINE_PRINT,
  LARGE_TIERS,
  NOT_HAND_BUILT,
  PAY_METHODS,
  PRICING_COMPARE_JUMP,
  PRICING_HERO,
  PRICING_JUMPS,
  SITE_CHECK,
  SMALL_TIERS,
} from '../../data/web-design';

/**
 * `/web-design/pricing/` — ported from the v15 export's `Monzones-W-Pricing`
 * (v15 changed only this page: the hero's claim, the jump list, the picker's
 * aside and the phone layout of the build toggle).
 *
 * Every number on this page comes from src/data/web-design.ts, transcribed
 * from the design. Don't compute, round or infer one here.
 */
const phoneHref = `tel:${CONTACT.phone.replace(/[^+0-9]/g, '')}`;
const callHref = `mailto:${CONTACT.email}?subject=${encodeURIComponent('Discovery call (30 minutes)')}`;

/* The export sets the two rate names in the small print in ink; the data keeps
   the paragraph as one string. */
const STRONG_A = 'founding client rate';
const STRONG_B = 'scheduled standard rate';
const heroParts = PRICING_HERO.fine.split(new RegExp(`(${STRONG_A}|${STRONG_B})`));

/* The picker's answers, one per combination. Rendered in full so that with no
   JavaScript the section reads as a plain table of "if you need this, it's
   that"; the script narrows it to one row. */
const PICKS = [
  {
    key: '1|No|No',
    when: '1 page, not selling, I’ll handle changes',
    name: 'Get Found',
    price: '$465 hand-built',
    note: 'One page plus the plumbing: domain, Google Business Profile verified, indexed, analytics. Already have those? The One-Page Site is $305.',
    care: 'Not editing it yourself: after the first 30 days, changes come through me at $30/hr (one-hour minimum), or the $50/mo Care plan keeps them flowing.',
  },
  {
    key: '1|No|Yes',
    when: '1 page, not selling, I’ll edit it myself',
    name: 'Get Found',
    price: '$565 platform',
    note: 'One page plus the plumbing: domain, Google Business Profile verified, indexed, analytics. Already have those? The One-Page Site is $405.',
  },
  {
    key: '2–3|No|No',
    when: '2–3 pages, not selling, I’ll handle changes',
    name: 'Portfolio Site',
    price: '$670 hand-built',
    note: 'Hand-built and hosted free, forever. Changes after launch come through me.',
    care: 'Not editing it yourself: after the first 30 days, changes come through me at $30/hr (one-hour minimum), or the $50/mo Care plan keeps them flowing.',
  },
  {
    key: '2–3|No|Yes',
    when: '2–3 pages, not selling, I’ll edit it myself',
    name: 'Portfolio Site',
    price: '$770 platform',
    note: 'Platform build with an editor you drive; the platform subscription is paid directly by you.',
  },
  {
    key: '4–7|No|No',
    when: '4–7 pages, not selling, I’ll handle changes',
    name: 'Small Business Site',
    price: '$2,470',
    note: 'Built on a platform either way; you can leave the editing to me with a Care plan.',
    care: 'Not editing it yourself: a Care plan (from $50/mo) keeps the changes flowing, with me monitoring the site.',
  },
  {
    key: '4–7|No|Yes',
    when: '4–7 pages, not selling, I’ll edit it myself',
    name: 'Small Business Site',
    price: '$2,470',
    note: 'Built on a platform with an editor, so it’s yours to drive after launch.',
  },
  {
    key: 'More|No|No',
    when: 'More pages, not selling, I’ll handle changes',
    name: 'Company Site',
    price: 'from $8,240',
    note: 'Quoted to your scope. CMS, conversion tracking, and a documented handover.',
    care: 'Not editing it yourself: a Care plan (from $50/mo) keeps the changes flowing, with me monitoring the site.',
  },
  {
    key: 'More|No|Yes',
    when: 'More pages, not selling, I’ll edit it myself',
    name: 'Company Site',
    price: 'from $8,240',
    note: 'Quoted to your scope. CMS, conversion tracking, and a documented handover.',
  },
  {
    key: 'sell',
    when: 'Selling online, any number of pages',
    name: 'Shop',
    price: '$4,015',
    note: 'Founding rate; standard $6,695. Store setup, checkout, and up to 25 products on Shopify, Webflow or WooCommerce.',
  },
] as const;

/* The build-price column reads as a three-step scale. */
const buildClass = (build: string) =>
  build === 'Lowest' ? 'wdbuild--low' : build === 'Premium' ? 'wdbuild--high' : undefined;
---

<WebDesignLayout
  title="Pricing · Web Design"
  description="Every web design price in the open: six website packages from $305, Site Check, Care plans, managed domain and SSL, and how the numbers compare to three Vancouver providers."
  current="pricing"
>
  <header class="wdwrap wdhero wdhero--pricing" id="top">
    <p class="wdhero__tags">
      <span class="wdtag">{PRICING_HERO.place}</span>
      <span class="wdtag wdtag--butter">{PRICING_HERO.badge}</span>
    </p>
    <h1 class="wdhero__title">
      {PRICING_HERO.titleLead} <em>{PRICING_HERO.titleAccent}</em>
    </h1>
    <p class="wdhero__claim">
      {PRICING_HERO.claimLead} <s class="wdhero__struck">{PRICING_HERO.claimStruck}</s>{' '}
      {PRICING_HERO.claimTail}
    </p>
    <p class="wdhero__sub">{PRICING_HERO.sub}</p>
    <p class="wdhero__fine">
      {
        heroParts.map((part) =>
          part === STRONG_A || part === STRONG_B ? <strong>{part}</strong> : part,
        )
      }
    </p>
  </header>

  {/* ------------------------------------------------------------ picker -- */}
  <section class="wdpickband" id="picker">
    <div class="wdpick" data-pick>
      <p class="wdkick wdpick__kick">in a hurry? three questions</p>

      <div class="wdpick__qs" hidden data-pick-qs>
        <div class="wdpick__q">
          <span class="wdmono">How many pages?</span>
          <div class="wdpick__opts" role="group" aria-label="How many pages?">
            {
              ['1', '2–3', '4–7', 'More'].map((opt, i) => (
                <button
                  type="button"
                  class="wdopt"
                  data-pick-pages={opt}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  {opt}
                </button>
              ))
            }
          </div>
        </div>

        <div class="wdpick__q">
          <span class="wdmono">Selling anything online?</span>
          <div class="wdpick__opts" role="group" aria-label="Selling anything online?">
            {
              ['No', 'Yes'].map((opt, i) => (
                <button
                  type="button"
                  class="wdopt"
                  data-pick-sell={opt}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  {opt}
                </button>
              ))
            }
          </div>
        </div>

        <div class="wdpick__q">
          <span class="wdmono">Editing it yourself?</span>
          <div class="wdpick__opts" role="group" aria-label="Editing it yourself?">
            {
              ['No', 'Yes'].map((opt, i) => (
                <button
                  type="button"
                  class="wdopt"
                  data-pick-edit={opt}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  {opt}
                </button>
              ))
            }
          </div>
        </div>

        {/* The handwritten aside changes with the editing answer. */}
        <p class="wdpick__aside">
          <span data-pick-aside="No">
            no login to learn: edits come through me, a small fee or a care plan
          </span>
          <span data-pick-aside="Yes" hidden>
            yes = a real editor, and the keys are yours
          </span>
        </p>
      </div>

      <div class="wdpick__out" role="status" aria-live="polite">
        <span class="wdmono wdpick__outlabel">My recommendation</span>
        <table class="wdpick__table" data-pick-table>
          <tbody>
            {
              PICKS.map((pick) => (
                <tr data-pick-row={pick.key}>
                  <th scope="row">{pick.when}</th>
                  <td>
                    <strong class="wdpick__name">{pick.name}</strong>
                    <strong class="wdpick__price">{pick.price}</strong>
                    <a class="wdpick__more" href="#websites">See what’s included ↓</a>
                    <span class="wdpick__note">{pick.note}</span>
                    {/*
                      Picking "No" to editing means changes come through me, so
                      the answer says how that is charged rather than leaving it
                      to the tier cards further down.
                    */}
                    {'care' in pick ? (
                      <span class="wdpick__care">
                        {pick.care} <a href="#care">See Website Care ↓</a>
                      </span>
                    ) : null}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------- jump to -- */}
  <section class="wdjump" id="jump">
    <div class="wdjump__inner">
      <a class="wdjump__compare" href={PRICING_COMPARE_JUMP.href}>
        {PRICING_COMPARE_JUMP.label} <span aria-hidden="true">↓</span>
      </a>
      <nav class="wdjump__list" aria-label="On this page">
        <p class="wdjump__label">
          <span>Jump to</span><span class="wdjump__rule" aria-hidden="true"></span>
        </p>
        <div class="wdjump__grid">
          {
            PRICING_JUMPS.map((jump, i) => (
              <a href={jump.href}>
                <span class="wdjump__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="wdjump__text">{jump.label}</span>
              </a>
            ))
          }
        </div>
      </nav>
    </div>
  </section>

  {/* --------------------------------------------------------------- how -- */}
  <section class="wdband wdband--paper wdband--92" id="how">
    <div class="wdband__inner">
      <p class="wdkick" data-reveal>how the number is decided</p>
      <h2 class="wdh2 wdhow__title" data-reveal>Two questions <em>set the price.</em></h2>

      <div class="wdgrid wdhow__grid">
        <div class="wdcard wdhow__card" data-reveal>
          <span class="wdhow__num">1</span>
          <h3 class="wdhow__h3">How much site?</h3>
          <p class="wdbody wdbody--sm">
            Page count, whether it sells anything, and whether the content changes regularly. A
            therapist needs one credible page; a store needs checkout, shipping and product pages.
            Different jobs, different prices, and I’ll happily help you find where you land.
          </p>
        </div>
        <div class="wdcard wdhow__card wdhow__card--two" data-reveal>
          <span class="wdhow__num wdhow__num--two">2</span>
          <h3 class="wdhow__h3">Do you want to edit it yourself?</h3>
          <p class="wdbody wdbody--sm">
            This decides <em>how</em> I build it, not what you get. If yes, we build on a platform
            with a real editor, and that’s $100 more on the three smaller sites, plus the platform’s
            own subscription. If you’d rather never think about it, I hand-build it and host it
            free, forever. Either answer is a good one.
          </p>
        </div>
      </div>

      <p class="wddash wdhow__short" data-reveal>
        Short version: the hand-built price is lower because there’s no platform licence behind it,
        and the platform price buys you an editor you drive yourself. Same design care and launch
        checklist either way.
      </p>

      <div class="wdtable" data-reveal>
        <table>
          <tbody>
            <tr>
              <th>Built on</th>
              <th>Can you edit it?</th>
              <th>What you pay monthly</th>
              <th>Build price</th>
            </tr>
            {
              BUILD_TABLE.map((row) => (
                <tr>
                  <td>{row.on}</td>
                  <td>{row.edit}</td>
                  <td>{row.monthly}</td>
                  <td class:list={[buildClass(row.build)]}>{row.build}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="wdhow__methods" data-reveal>
        These are delivery methods, not separate product lines: same design care, same launch
        checklist, whichever way we build. Hand-built costs less because there’s no platform
        licence; platform builds cost a little more because you get an editor and can run the site
        without me.
      </p>

      <div class="wddashbox wdfit" data-reveal>
        <h3 class="wdfit__title">Where hand-built isn’t the right fit</h3>
        <p class="wdbody wdbody--sm wdfit__intro">
          The hand-built option shines for brochure sites: a few pages, content that rarely changes,
          nothing sold, nobody logging in. It’s a platform build when:
        </p>
        <ul class="wdfit__list">
          {NOT_HAND_BUILT.map((item) => <li set:html={item} />)}
        </ul>
        <p class="wdnote wdfit__note">
          when it’s not a fit, I’ll point you to the build that is, cheerfully
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------ smaller three -- */}
  <section class="wdband wdband--paper wdband--112 wdband--rule" id="websites">
    <div class="wdband__inner">
      <div class="wdhead" data-reveal>
        <h2 class="wdh2 wdh2--sm">The smaller three</h2>
        <span class="wdhead__sub">hand-built or platform: your pick, $100 apart</span>
      </div>

      <p class="wdintro wdintro--24" data-reveal>
        Each of these comes two ways: <strong>hand-built</strong> (I write it by hand and host it
        free, forever) or <strong>platform</strong> ($100 more, with a real editor you drive
        yourself; the platform subscription is paid directly by you). Pick one and the cards show
        that price.
      </p>

      {/*
        Both prices are in the markup on every card, and both notes are here.
        The script narrows each card to the chosen one — so with no JavaScript
        the section still answers the question, it just answers it twice.
      */}
      <div class="wdbuild" data-build>
        <div class="wdtray" role="group" aria-label="How it's built" hidden data-build-opts>
          <button type="button" class="wdtray__opt" data-build-opt="hand" aria-pressed="true">
            Hand-built · $0/mo hosting
          </button>
          <button type="button" class="wdtray__opt" data-build-opt="platform" aria-pressed="false">
            Platform · you edit it
          </button>
        </div>

        <p class="wdbuild__note" data-build-note="hand">
          Hand-built: no platform fee, ever, and you own the files. Changes after launch come
          through me at $30/hr or the $50/mo Care plan.
        </p>
        <p class="wdbuild__note" data-build-note="platform">
          Platform: $100 more per site, plus the platform’s own subscription, and you get an editor
          to drive yourself.
        </p>
      </div>

      <div class="wdgrid wdgrid--3 wdtiers">
        {
          SMALL_TIERS.map((tier) => (
            <article
              class:list={['wdcard', 'wdtier', tier.name === 'Get Found' && 'wdtier--pick']}
              data-reveal
            >
              <h3 class="wdtier__name">{tier.name}</h3>
              <p class="wdmono wdtier__meta">{tier.meta}</p>
              <p class="wdtier__blurb">{tier.blurb}</p>
              <ul class="wdtier__list">
                {tier.includes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <p class="wdtier__ex">{tier.excludes}</p>

              <div class="wdtier__prices">
                <p class="wdmono wdtier__rate">Founding client rate</p>
                <p class="wdtier__pair" data-build-price="hand">
                  <strong class="wdtier__price">{tier.hand}</strong>
                  <span class="wdtier__how">hand-built</span>
                </p>
                <p class="wdtier__pair" data-build-price="platform">
                  <strong class="wdtier__price">{tier.platform}</strong>
                  <span class="wdtier__how">platform</span>
                </p>
                <p class="wdtier__std" data-build-std="hand">
                  Scheduled standard rate: {tier.handStd}
                </p>
                <p class="wdtier__std" data-build-std="platform">
                  Scheduled standard rate: {tier.platformStd}
                </p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="wdbutter wdtiers__note" data-reveal>
        <p>
          <strong>Worth knowing before you choose:</strong> a hand-built site doesn’t come with a
          login. After the first 30 days, changes come through me at $30/hr (one-hour minimum) or
          through the $50/mo Care plan. If you’d rather edit yourself, the platform option is
          completely yours to drive. I’ll walk you through both on our call.
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------- bigger three -- */}
  <section class="wdband wdband--paper wdband--112 wdband--rule" id="platform">
    <div class="wdband__inner">
      <div class="wdhead" data-reveal>
        <h2 class="wdh2 wdh2--sm">The bigger three</h2>
        <span class="wdhead__sub">platform-built · you edit it yourself</span>
      </div>

      <p class="wdintro wdintro--40" data-reveal>
        These need a proper platform: a CMS, ecommerce, or more complex functionality than a static
        site should carry. Built on Squarespace, Wix, Webflow, WordPress or Shopify; I recommend
        based on who’s maintaining it after launch, and you make the call. The platform subscription
        is paid directly by you.
      </p>

      <div class="wdgrid wdgrid--3 wdtiers">
        {
          LARGE_TIERS.map((tier) => (
            <article
              class:list={['wdcard', 'wdtier', tier.name === 'Company Site' && 'wdtier--dark']}
              data-reveal
            >
              <h3 class="wdtier__name">{tier.name}</h3>
              <p class="wdmono wdtier__meta">{tier.meta}</p>
              <p class="wdtier__blurb">{tier.blurb}</p>
              <ul class="wdtier__list">
                {tier.includes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <p class="wdtier__ex">{tier.excludes}</p>

              <div class="wdtier__prices">
                <p class="wdmono wdtier__rate wdtier__rate--tight">Founding client rate</p>
                <p class="wdtier__big">{tier.price}</p>
                {tier.standardNote ? (
                  <p class="wdtier__std wdtier__std--plain">
                    Scheduled standard rate: <strong>{tier.standard}</strong>, {tier.standardNote}
                  </p>
                ) : (
                  <p class="wdtier__std">Scheduled standard rate: {tier.standard}</p>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <p class="wdclose" data-reveal>
        <strong>All three include one full-site revision</strong> after you review the completed
        build. And if anything I deliver doesn’t match what we agreed, I fix it free, without
        touching your revision. Fair’s fair.
      </p>
    </div>
  </section>

  {/* --------------------------------------------------------- site check -- */}
  <section class="wdband wdband--paper wdband--112 wdband--rule" id="sitecheck">
    <div class="wdband__inner">
      <div class="wdgrid wdcheck">
        <div data-reveal>
          <p class="wdkick">already have a site?</p>
          <h2 class="wdh2 wdh2--sm">Site Check: <em>a friendly second opinion.</em></h2>
          <p class="wdbody wdcheck__p">
            “We get traffic but nobody calls.” “We’re not showing up on Google.” “It looks fine on
            my laptop but people say it’s broken on their phone.”
          </p>
          <p class="wdbody wdcheck__p wdcheck__p--last">
            Often these aren’t design problems at all; they’re structure, speed, or a page that
            never quite asks for anything. The Site Check finds out which, so you can fix the right
            thing before spending real money on a rebuild you might not even need.
          </p>
          <div class="wdcheck__prices">
            <p class="wdmono wdtier__rate wdtier__rate--tight">Founding client rate</p>
            <p class="wdcheck__price">{SITE_CHECK.price}</p>
            <p class="wdcheck__std">
              Scheduled standard rate: {SITE_CHECK.standard} · {SITE_CHECK.turnaround}
            </p>
            <p class="wdcheck__credit">{SITE_CHECK.credit}</p>
          </div>
        </div>

        <div class="wdcard wdcard--30" data-reveal="pop">
          <h3 class="wdcaps wdcaps--16">What you get</h3>
          <ul class="wdlist15">
            {SITE_CHECK.gets.map((item) => <li>{item}</li>)}
          </ul>
          <p class="wdtier__ex wdtier__ex--flush">{SITE_CHECK.excludes}</p>
        </div>
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------------- care -- */}
  <section class="wdband wdband--dark wdband--92" id="care">
    <div class="wdband__inner">
      <p class="wdkick" data-reveal>after launch</p>
      <h2 class="wdh2 wdmax900" data-reveal>
        Website Care: <em>so it stays fast, safe and found.</em>
      </h2>
      <p class="wdlede wdlede--680 wdlede--44" data-reveal>
        Every Care client gets a <strong>live dashboard</strong>: uptime, traffic, performance and
        SEO signals you can check yourself, any time. Care covers your website’s health and
        performance; the $50/year managed domain &amp; SSL service, hosting and platform licences are
        their own line items, so you always know exactly what you’re paying for.
      </p>

      <div class="wdgrid wdgrid--3 wdtiers">
        {
          CARE_PLANS.map((plan) => (
            <article
              class:list={['wdplan', plan.name === 'Managed' && 'wdplan--pick']}
              data-reveal
            >
              <h3 class="wdplan__name">{plan.name}</h3>
              <p class="wdplan__price">
                {plan.price} {plan.per}
              </p>
              <ul class="wdplan__list">
                {plan.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <p class="wdplan__note">{plan.note}</p>
            </article>
          ))
        }
      </div>

      <ul class="wdterms" data-reveal>
        {
          CARE_TERMS.map((term) => (
            <li>
              <span class="wdterms__tick" aria-hidden="true">
                ✓
              </span>{' '}
              {term}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ------------------------------------------------------------- domain -- */}
  <section class="wdband wdband--paper wdband--92" id="domain">
    <div class="wdband__inner">
      <p class="wdkick" data-reveal>the unglamorous essentials, handled</p>
      <h2 class="wdh2 wdmax940" data-reveal>Managed domain &amp; SSL: <em>one small fee.</em></h2>

      <div class="wdgrid wddomain">
        <div class="wdcard wdcard--30" data-reveal>
          <p class="wddomain__price">$50 /year, standard domain</p>
          <p class="wddomain__body">
            Managed domain, DNS, and SSL are $50 a year for a standard domain, billed separately
            from Website Care. <strong
              >Your domain is registered in your name, so you remain the legal owner.</strong
            > If you ever want to take it over yourself, it’s transferred to you at no charge.
          </p>
          <ul class="wdlist14">
            {DOMAIN_ITEMS.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="wdcard wdcard--30 wdcard--col" data-reveal>
          <h3 class="wdcaps wdcaps--14">Three ways in (you pick)</h3>
          <ul class="wdlist14 wdlist14--roomy">
            {DOMAIN_WAYS.map((way) => <li set:html={way} />)}
          </ul>
          <p class="wdtier__ex wdtier__ex--auto">
            Specialty domains like .ai and .io, and any paid custom certificate, are quoted before
            purchase, happily and in writing.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------- extras -- */}
  <section class="wdband wdband--paper wdband--112 wdband--rule" id="addons">
    <div class="wdband__inner">
      <div class="wdhead wdhead--12" data-reveal>
        <h2 class="wdh2 wdh2--sm">Extras</h2>
        <span class="wdhead__sub">a short list, on purpose</span>
      </div>
      <p class="wdintro wdintro--36 wdmax680" data-reveal>
        Most of what you need is already inside the package; these are the few genuine extras.
        Anything else your project needs, we scope together with a simple written change order,
        priced for your project.
      </p>

      <div class="wdtable wdaddons" data-reveal>
        <table>
          <tbody>
            {
