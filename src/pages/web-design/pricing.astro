<script>
  /* The picker. The table it drives is fully rendered above, so this only ever
     narrows what is already readable — if it never runs, the visitor gets the
     whole matrix instead of nothing. */
  const pick = document.querySelector<HTMLElement>('[data-pick]');

  if (pick) {
    const rows = [...pick.querySelectorAll<HTMLTableRowElement>('[data-pick-row]')];
    const qs = pick.querySelector<HTMLElement>('[data-pick-qs]');

    if (rows.length && qs) {
      const state = { pages: '1', sell: 'No', edit: 'No' };

      const apply = () => {
        /* Selling online wins outright: the design's own picker returns Shop
           regardless of page count or who edits it. */
        const key = state.sell === 'Yes' ? 'sell' : `${state.pages}|${state.sell}|${state.edit}`;
        rows.forEach((row) => {
          row.hidden = row.dataset.pickRow !== key;
        });
      };

      const wire = (attr: 'pages' | 'sell' | 'edit') => {
        const buttons = [...pick.querySelectorAll<HTMLButtonElement>(`[data-pick-${attr}]`)];
        buttons.forEach((button) =>
          button.addEventListener('click', () => {
            state[attr] = button.dataset[`pick${attr[0].toUpperCase()}${attr.slice(1)}`] ?? '';
            buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
            apply();
          }),
        );
      };

      wire('pages');
      wire('sell');
      wire('edit');

      /* Only now do the questions appear and the table collapse to one row. */
      qs.hidden = false;
      pick.setAttribute('data-pick-on', '');
      apply();
    }
  }

  /* ------------------------------------------------- hand vs platform -- */
  const build = document.querySelector<HTMLElement>('[data-build]');
  const buildOpts = build?.querySelector<HTMLElement>('[data-build-opts]');

  if (build && buildOpts) {
    const buttons = [...build.querySelectorAll<HTMLButtonElement>('[data-build-opt]')];
    /* The prices live in the cards below, not inside [data-build]. */
    const swappable = [
      ...document.querySelectorAll<HTMLElement>('[data-build-note], [data-build-price], [data-build-std]'),
    ];

    if (buttons.length && swappable.length) {
      const select = (mode: string) => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.buildOpt === mode)));
        swappable.forEach((el) => {
          const owner = el.dataset.buildNote ?? el.dataset.buildPrice ?? el.dataset.buildStd;
          el.hidden = owner !== mode;
        });
      };

      buttons.forEach((button) =>
        button.addEventListener('click', () => select(button.dataset.buildOpt ?? 'hand')),
      );

      buildOpts.hidden = false;
      select('hand');
    }
  }
</script>

