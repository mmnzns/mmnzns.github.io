---
import WebDesignLayout from '../../layouts/WebDesignLayout.astro';
import { CONTACT } from '../../config';
import {
  ADDONS,
  BUILD_TABLE,
  CARE_PLANS,
  CARE_TERMS,
  COMPARISON,
  DOMAIN_ITEMS,
  DOMAIN_WAYS,
  FINE_PRINT,
  LARGE_TIERS,
  NOT_HAND_BUILT,
  PAY_METHODS,
  PRICING_HERO,
  PRICING_JUMPS,
  SITE_CHECK,
  SMALL_TIERS,
} from '../../data/web-design';

/**
 * `/web-design/pricing/` — ported from the v13 export's `Monzones-W-Pricing`.
 *
 * Every number on this page comes from src/data/web-design.ts, transcribed
 * from the design. Don't compute, round or infer one here.
 */
const phoneHref = `tel:${CONTACT.phone.replace(/[^+\d]/g, '')}`;
const callHref = `mailto:${CONTACT.email}?subject=${encodeURIComponent('Discovery call (30 minutes)')}`;
---

<WebDesignLayout
  title="Pricing · Web Design"
  description="Every web design price in the open: six website packages from $305, Site Check, Care plans, managed domain and SSL, and how the numbers compare to three Vancouver providers."
  current="pricing"
>
  <header class="wdwrap wdhero" id="top">
    <p class="wdhero__tags">
      <span class="wdtag">{PRICING_HERO.place}</span>
      <span class="wdtag wdtag--butter">{PRICING_HERO.badge}</span>
    </p>
    <h1 class="wdhero__title">
      {PRICING_HERO.titleLead} <em>{PRICING_HERO.titleAccent}</em>
    </h1>
    <p class="wdlede wdhero__body">{PRICING_HERO.body}</p>

    <nav class="wdjumps" aria-label="On this page">
      {PRICING_JUMPS.map((jump) => <a href={jump.href}>{jump.label}</a>)}
    </nav>
  </header>

  {/*
    The picker. Every combination's answer is rendered as its own row and the
    script reveals the matching one — so with no JavaScript this reads as a
    plain table of "if you need this, it's that", which is the same
    information the widget gives one row at a time.
  */}
  <section class="wdband wdband--paper" id="picker">
    <div class="wdband__inner">
    <div class="wdcard wdpick" data-pick>
      <p class="wdkick">in a hurry? three questions</p>

      <div class="wdpick__qs" hidden data-pick-qs>
        <div class="wdpick__q">
          <span class="wdpick__label">How many pages?</span>
          <div class="wdpick__opts" role="group" aria-label="How many pages?">
            {
              ['1', '2–3', '4–7', 'More'].map((opt, i) => (
                <button
                  type="button"
                  class="wdpick__opt"
                  data-pick-pages={opt}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  {opt}
                </button>
              ))
            }
          </div>
        </div>

        <div class="wdpick__q">
          <span class="wdpick__label">Selling anything online?</span>
          <div class="wdpick__opts" role="group" aria-label="Selling anything online?">
            {
              ['No', 'Yes'].map((opt, i) => (
                <button
                  type="button"
                  class="wdpick__opt"
                  data-pick-sell={opt}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  {opt}
                </button>
              ))
            }
          </div>
        </div>

        <div class="wdpick__q">
          <span class="wdpick__label">Editing it yourself?</span>
          <div class="wdpick__opts" role="group" aria-label="Editing it yourself?">
            {
              ['No', 'Yes'].map((opt, i) => (
                <button
                  type="button"
                  class="wdpick__opt"
                  data-pick-edit={opt}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  {opt}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <div class="wdpick__out" role="status" aria-live="polite">
        <p class="wdpick__outlabel">My recommendation</p>
        <table class="wdpick__table" data-pick-table>
          <tbody>
            <tr data-pick-row="1|No|No">
              <th scope="row">1 page, not selling, I’ll handle changes</th>
              <td>
                <strong>Get Found</strong> — $465 hand-built.
                <span
                  >One page plus the plumbing: domain, Google Business Profile verified, indexed,
                  analytics. Already have those? The One-Page Site is $305.</span
                >
              </td>
            </tr>
            <tr data-pick-row="1|No|Yes">
              <th scope="row">1 page, not selling, I’ll edit it myself</th>
              <td>
                <strong>Get Found</strong> — $565 platform.
                <span
                  >One page plus the plumbing: domain, Google Business Profile verified, indexed,
                  analytics. Already have those? The One-Page Site is $405.</span
                >
              </td>
            </tr>
            <tr data-pick-row="2–3|No|No">
              <th scope="row">2–3 pages, not selling, I’ll handle changes</th>
              <td>
                <strong>Portfolio Site</strong> — $670 hand-built.
                <span>Hand-built and hosted free, forever. Changes after launch come through me.</span
                >
              </td>
            </tr>
            <tr data-pick-row="2–3|No|Yes">
              <th scope="row">2–3 pages, not selling, I’ll edit it myself</th>
              <td>
                <strong>Portfolio Site</strong> — $770 platform.
                <span
                  >Platform build with an editor you drive; the platform subscription is paid
                  directly by you.</span
                >
              </td>
            </tr>
            <tr data-pick-row="4–7|No|No">
              <th scope="row">4–7 pages, not selling, I’ll handle changes</th>
              <td>
                <strong>Small Business Site</strong> — $2,470.
                <span
                  >Built on a platform either way; you can leave the editing to me with a Care
                  plan.</span
                >
              </td>
            </tr>
            <tr data-pick-row="4–7|No|Yes">
              <th scope="row">4–7 pages, not selling, I’ll edit it myself</th>
              <td>
                <strong>Small Business Site</strong> — $2,470.
                <span>Built on a platform with an editor, so it’s yours to drive after launch.</span>
              </td>
            </tr>
            <tr data-pick-row="More|No|No">
              <th scope="row">More pages, not selling, I’ll handle changes</th>
              <td>
                <strong>Company Site</strong> — from $8,240.
                <span>Quoted to your scope. CMS, conversion tracking, and a documented handover.</span
                >
              </td>
            </tr>
            <tr data-pick-row="More|No|Yes">
              <th scope="row">More pages, not selling, I’ll edit it myself</th>
              <td>
                <strong>Company Site</strong> — from $8,240.
                <span>Quoted to your scope. CMS, conversion tracking, and a documented handover.</span
                >
              </td>
            </tr>
            <tr data-pick-row="sell">
              <th scope="row">Selling online, any number of pages</th>
              <td>
                <strong>Shop</strong> — $4,015.
                <span
                  >Founding rate; standard $6,695. Store setup, checkout, and up to 25 products on
                  Shopify, Webflow or WooCommerce.</span
                >
              </td>
            </tr>
          </tbody>
        </table>
        <a class="wdpick__more" href="#websites">See what’s included ↓</a>
      </div>
    </div>
    </div>
  </section>

  <section class="wdband wdband--paper" id="how">
    <div class="wdband__inner">
    <p class="wdkick" data-reveal>how the number is decided</p>
    <h2 class="wdh2" data-reveal>Two questions <em>set the price.</em></h2>

    <div class="wdtwo">
      <div class="wdcard" data-reveal>
        <span class="wdnum">1</span>
        <h3 class="wdh3">How much site?</h3>
        <p class="wdbody">
          Page count, whether it sells anything, and whether the content changes regularly. A
          therapist needs one credible page; a store needs checkout, shipping and product pages.
          Different jobs, different prices, and I’ll happily help you find where you land.
        </p>
      </div>
      <div class="wdcard" data-reveal>
        <span class="wdnum">2</span>
        <h3 class="wdh3">Do you want to edit it yourself?</h3>
        <p class="wdbody">
          This decides <em>how</em> I build it, not what you get. If yes, we build on a platform with
          a real editor, and that’s $100 more on the three smaller sites, plus the platform’s own
          subscription. If you’d rather never think about it, I hand-build it and host it free,
          forever. Either answer is a good one.
        </p>
      </div>
    </div>

    <p class="wdlede" data-reveal>
      Short version: the hand-built price is lower because there’s no platform licence behind it, and
      the platform price buys you an editor you drive yourself. Same design care and launch checklist
      either way.
    </p>

    <div class="wdtable" data-reveal>
      <table>
        <tbody>
          <tr>
            <th>Built on</th>
            <th>Can you edit it?</th>
            <th>What you pay monthly</th>
            <th>Build price</th>
          </tr>
          {
            BUILD_TABLE.map((row) => (
              <tr>
                <td>{row.on}</td>
                <td>{row.edit}</td>
                <td>{row.monthly}</td>
                <td>{row.build}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="wdlede" data-reveal>
      These are delivery methods, not separate product lines: same design care, same launch
      checklist, whichever way we build. Hand-built costs less because there’s no platform licence;
      platform builds cost a little more because you get an editor and can run the site without me.
    </p>

    <div class="wdcard wdcard--butter" data-reveal>
      <h3 class="wdh3">Where hand-built isn’t the right fit</h3>
      <p class="wdbody">
        The hand-built option shines for brochure sites: a few pages, content that rarely changes,
        nothing sold, nobody logging in. It’s a platform build when:
      </p>
      <ul class="wdlist">
        {NOT_HAND_BUILT.map((item) => <li set:html={item} />)}
      </ul>
      <p class="wdnote">when it’s not a fit, I’ll point you to the build that is, cheerfully</p>
    </div>
    </div>
  </section>

  <section class="wdband wdband--paper wdband--tight" id="websites">
    <div class="wdband__inner">
    <div class="wdhead" data-reveal>
      <h2 class="wdh2">The smaller three</h2>
      <span class="wdnote">hand-built or platform: your pick, $100 apart</span>
    </div>

    <p class="wdlede" data-reveal>
      Each of these comes two ways: <strong>hand-built</strong> (I write it by hand and host it free,
      forever) or <strong>platform</strong> ($100 more, with a real editor you drive yourself; the
      platform subscription is paid directly by you). Pick one and the cards show that price.
    </p>

    {/*
      Both prices are in the markup on every card, and both notes are here.
      The script narrows each card to the chosen one — so with no JavaScript
      the section still answers the question, it just answers it twice.
    */}
    <div class="wdbuild" data-build>
      <div class="wdbuild__opts" role="group" aria-label="How it's built" hidden data-build-opts>
        <button type="button" class="wdpick__opt" data-build-opt="hand" aria-pressed="true">
          Hand-built · $0/mo hosting
        </button>
        <button type="button" class="wdpick__opt" data-build-opt="platform" aria-pressed="false">
          Platform · you edit it
        </button>
      </div>

      <p class="wdbody wdbuild__note" data-build-note="hand">
        Hand-built: no platform fee, ever, and you own the files. Changes after launch come through
        me at $30/hr or the $50/mo Care plan.
      </p>
      <p class="wdbody wdbuild__note" data-build-note="platform">
        Platform: $100 more per site, plus the platform’s own subscription, and you get an editor to
        drive yourself.
      </p>
    </div>

    <div class="wdthree">
      {
        SMALL_TIERS.map((tier) => (
          <article class="wdcard wdtier" data-reveal>
            <h3 class="wdh3">{tier.name}</h3>
            <p class="wdtier__meta">{tier.meta}</p>
            <p class="wdbody">{tier.blurb}</p>
            <ul class="wdlist">
              {tier.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <p class="wdtier__ex">{tier.excludes}</p>

            <div class="wdtier__prices">
              <p class="wdtier__rate">Founding client rate</p>
              <p class="wdtier__pair" data-build-price="hand">
                <span class="wdtier__price">{tier.hand}</span>
                <span class="wdtier__how">hand-built</span>
              </p>
              <p class="wdtier__pair" data-build-price="platform">
                <span class="wdtier__price">{tier.platform}</span>
                <span class="wdtier__how">platform</span>
              </p>
              <p class="wdtier__std" data-build-std="hand">
                Scheduled standard rate: {tier.handStd}
              </p>
              <p class="wdtier__std" data-build-std="platform">
                Scheduled standard rate: {tier.platformStd}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="wdcard wdcard--blue" data-reveal>
      <p class="wdbody">
        <strong>Worth knowing before you choose:</strong> a hand-built site doesn’t come with a login.
        After the first 30 days, changes come through me at $30/hr (one-hour minimum) or through the
        $50/mo Care plan. If you’d rather edit yourself, the platform option is completely yours to
        drive. I’ll walk you through both on our call.
      </p>
    </div>
    </div>
  </section>

  <section class="wdband wdband--paper wdband--tight" id="platform">
    <div class="wdband__inner">
    <div class="wdhead" data-reveal>
      <h2 class="wdh2">The bigger three</h2>
      <span class="wdnote">platform-built · you edit it yourself</span>
    </div>

    <p class="wdlede" data-reveal>
      These need a proper platform: a CMS, ecommerce, or more complex functionality than a static
      site should carry. Built on Squarespace, Wix, Webflow, WordPress or Shopify; I recommend based
      on who’s maintaining it after launch, and you make the call. The platform subscription is paid
      directly by you.
    </p>

    <div class="wdthree">
      {
        LARGE_TIERS.map((tier) => (
          <article class="wdcard wdtier" data-reveal>
            <h3 class="wdh3">{tier.name}</h3>
            <p class="wdtier__meta">{tier.meta}</p>
            <p class="wdbody">{tier.blurb}</p>
            <ul class="wdlist">
              {tier.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <p class="wdtier__ex">{tier.excludes}</p>

            <div class="wdtier__prices">
              <p class="wdtier__rate">Founding client rate</p>
              <p class="wdtier__pair">
                <span class="wdtier__price">{tier.price}</span>
              </p>
              <p class="wdtier__std">
                Scheduled standard rate: {tier.standard}
                {tier.standardNote ? `, ${tier.standardNote}` : ''}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <p class="wdlede" data-reveal>
      All three include <strong>one full-site revision</strong> after you review the completed build.
      And if anything I deliver doesn’t match what we agreed, I fix it free, without touching your
      revision. Fair’s fair.
    </p>
    </div>
  </section>

  <section class="wdband wdband--paper wdband--tight" id="sitecheck">
    <div class="wdband__inner">
    <div class="wdtwo">
      <div data-reveal>
        <p class="wdkick">already have a site?</p>
        <h2 class="wdh2">Site Check: <em>a friendly second opinion.</em></h2>
        <p class="wdlede">
          “We get traffic but nobody calls.” “We’re not showing up on Google.” “It looks fine on my
          laptop but people say it’s broken on their phone.”
        </p>
        <p class="wdlede">
          Often these aren’t design problems at all; they’re structure, speed, or a page that never
          quite asks for anything. The Site Check finds out which, so you can fix the right thing
          before spending real money on a rebuild you might not even need.
        </p>
        <div class="wdcard wdcard--butter wdcheck">
          <p class="wdtier__rate">Founding client rate</p>
          <p class="wdcheck__price">{SITE_CHECK.price}</p>
          <p class="wdtier__std">
            Scheduled standard rate: <strong>{SITE_CHECK.standard}</strong> · {SITE_CHECK.turnaround}
          </p>
          <p class="wdcheck__credit">{SITE_CHECK.credit}</p>
        </div>
      </div>

      <div class="wdcard" data-reveal="pop">
        <h3 class="wdh3">What you get</h3>
        <ul class="wdlist">
          {SITE_CHECK.gets.map((item) => <li>{item}</li>)}
        </ul>
        <p class="wdtier__ex">{SITE_CHECK.excludes}</p>
      </div>
    </div>
    </div>
  </section>

  <section class="wdband wdband--dark" id="care">
    <div class="wdband__inner">
    <p class="wdkick" data-reveal>after launch</p>
    <h2 class="wdh2" data-reveal>Website Care: <em>so it stays fast, safe and found.</em></h2>
    <p class="wdlede" data-reveal>
      Every Care client gets a <strong>live dashboard</strong>: uptime, traffic, performance and SEO
      signals you can check yourself, any time. Care covers your website’s health and performance;
      the $50/year managed domain &amp; SSL service, hosting and platform licences are their own line
      items, so you always know exactly what you’re paying for.
    </p>

    <div class="wdthree">
      {
        CARE_PLANS.map((plan) => (
          <article class="wdcard wdtier" data-reveal>
            <h3 class="wdh3">{plan.name}</h3>
            <p class="wdcheck__price">
              {plan.price}
              <span class="wdper">{plan.per}</span>
            </p>
            <ul class="wdlist">
              {plan.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <p class="wdtier__ex">{plan.note}</p>
          </article>
        ))
      }
    </div>

    <ul class="wdterms" data-reveal>
      {CARE_TERMS.map((term) => <li>{term}</li>)}
    </ul>
    </div>
  </section>

  <section class="wdband wdband--paper" id="domain">
    <div class="wdband__inner">
    <p class="wdkick" data-reveal>the unglamorous essentials, handled</p>
    <h2 class="wdh2" data-reveal>Managed domain &amp; SSL: <em>one small fee.</em></h2>

    <div class="wdtwo">
      <div class="wdcard" data-reveal>
        <p class="wdcheck__price">$50<span class="wdper"> /year, standard domain</span></p>
        <p class="wdbody">
          Managed domain, DNS, and SSL are $50 a year for a standard domain, billed separately from
          Website Care. <strong>Your domain is registered in your name, so you remain the legal
          owner.</strong> If you ever want to take it over yourself, it’s transferred to you at no
          charge.
        </p>
        <ul class="wdlist">
          {DOMAIN_ITEMS.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="wdcard" data-reveal>
        <h3 class="wdh3">Three ways in (you pick)</h3>
        <ul class="wdlist">
          {DOMAIN_WAYS.map((way) => <li set:html={way} />)}
        </ul>
        <p class="wdtier__ex">
          Specialty domains like .ai and .io, and any paid custom certificate, are quoted before
          purchase, happily and in writing.
        </p>
      </div>
    </div>
    </div>
  </section>

  <section class="wdband wdband--paper wdband--tight" id="addons">
    <div class="wdband__inner">
    <div class="wdhead" data-reveal>
      <h2 class="wdh2">Extras</h2>
      <span class="wdnote">a short list, on purpose</span>
    </div>
    <p class="wdlede" data-reveal>
      Most of what you need is already inside the package; these are the few genuine extras. Anything
      else your project needs, we scope together with a simple written change order, priced for your
      project.
    </p>

    <div class="wdtable" data-reveal>
      <table>
        <tbody>
          {
            ADDONS.map((addon) => (
              <tr>
                <td>{addon.what}</td>
                <td>{addon.price}</td>
                <td>{addon.note}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="wdcard wdcard--butter" data-reveal>
      <h3 class="wdh3">A happy note about SEO</h3>
      <p class="wdbody">
        Foundational SEO and AEO come built into every website I make: structure, metadata, schema,
        sitemap, indexing. It’s never an upsell. If you’d like hands-on SEO implementation, content
        optimization, or dedicated reporting for an existing site, that’s a separate packaged service
        we scope together, usually after a Site Check, so the plan is based on findings rather than
        guesses.
      </p>
    </div>
    </div>
  </section>

  <section class="wdband wdband--paper wdband--tight" id="rules">
    <div class="wdband__inner">
    <p class="wdkick" data-reveal>the fine print, in large print</p>
    <h2 class="wdh2" data-reveal>How we keep <em>a fixed price fixed.</em></h2>

    <div class="wdthree">
      {
        FINE_PRINT.map((rule) => (
          <article class="wdcard" data-reveal>
            <h3 class="wdh3">{rule.title}</h3>
            <p class="wdbody">{rule.body}</p>
          </article>
        ))
      }
    </div>

    <div class="wdcard wdcard--blue" data-reveal>
      <h3 class="wdh3">How you can pay</h3>
      <p class="wdpays">
        {PAY_METHODS.map((method) => <span class="wdtag">{method}</span>)}
      </p>
      <p class="wdbody">
        Every invoice is itemized, so you always see exactly what you’re paying for.
      </p>
      <p class="wdbody">
        <strong
          >Save 3% when you pay by cash, bank deposit, bank transfer, or e-transfer.</strong
        > The discount shows as its own line on your invoice.
      </p>
    </div>

    <p class="wdlede" data-reveal>
      <strong>You own your website, on every tier.</strong> Ownership transfers at final payment, in
      writing. Hand-built clients receive the actual files; platform clients receive the account
      access, design assets and project materials.
    </p>
    </div>
  </section>

  <section class="wdband wdband--dark" id="compare">
    <div class="wdband__inner">
    <p class="wdkick" data-reveal>please do shop around</p>
    <h2 class="wdh2" data-reveal>How the numbers <em>compare.</em></h2>
    <p class="wdlede" data-reveal>
      You’ve seen my numbers; here’s how they sit next to three well-regarded Vancouver providers
      with public pricing, package for package. <strong>“Not published”</strong> simply means no
      comparable package is listed on their site, and most will happily quote one privately.
    </p>

    <div class="wdtable" data-reveal>
      <table>
        <tbody>
          <tr>
            <th>What you need</th>
            <th>Miguel (MNM)</th>
            <th>Taylor Web Design</th>
            <th>Angarum Media</th>
            <th>Brixwork</th>
          </tr>
          {
            COMPARISON.map((row) => (
              <tr>
                <td>
                  {row.need}
                  <small>{row.detail}</small>
                </td>
                <td>
                  {row.mine}
                  {row.mineNote ? <small>{row.mineNote}</small> : null}
                </td>
                <td>{row.taylor}</td>
                <td>{row.angarum}</td>
                <td>{row.brixwork}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="wdtier__ex" data-reveal>
      Checked August 2026 against each provider’s public pricing page: <a
        class="wdlink"
        href="https://taylornguyen.ca/website-design-service-businesses"
        target="_blank"
        rel="noopener">Taylor Web Design</a
      >, <a
        class="wdlink"
        href="https://angarummedia.com/packages-pricing/"
        target="_blank"
        rel="noopener">Angarum Media</a
      >, <a
        class="wdlink"
        href="https://www.brixwork.com/realtors/real-estate-website-monthly-pricing/"
        target="_blank"
        rel="noopener">Brixwork</a
