---
import { CONTACT } from '../config';
---

<section class="section wrap" id="contact">
  <div class="band-panel">
    <div>
      <h2 class="band-panel__title">Tell me what you’re working on.</h2>
      <p class="band-panel__body">
        If you’re working through a customer journey, system, or operational problem and think my
        experience might help, I’d like to hear about it.
      </p>
    </div>

    <div class="band-panel__actions">
      {/*
        This band states availability as a sentence rather than reusing
        SITE.availability, which is the short status-line form used beside the
        green dot on the contact panels.
      */}
      <p class="band-panel__avail">
        Consulting on lifecycle, conversion, and automation—and open to the right senior role.
      </p>
      <div class="band-panel__buttons">
        <a class="btn btn--on-dark" href={CONTACT.linkedin} target="_blank" rel="noopener">
          LinkedIn
        </a>
        <a class="btn btn--outline-dark" href={`mailto:${CONTACT.email}`}>Email</a>
      </div>
    </div>
  </div>
</section>

<style>
  .band-panel {
    background: var(--dark);
    color: var(--on-dark);
    border-radius: var(--radius-lg);
    padding: clamp(40px, 6vw, 78px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 44px;
    align-items: end;
  }

  .band-panel__title {
    font-size: clamp(30px, 4vw, 50px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .band-panel__body {
    margin-top: 20px;
    max-width: 440px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--on-dark-2);
  }

  .band-panel__actions {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .band-panel__avail {
    font-size: 14px;
    color: var(--on-dark-3);
  }

  .band-panel__buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
