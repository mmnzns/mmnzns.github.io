---
/**
 * Click-to-load YouTube facade.
 *
 * A normal YouTube iframe pulls roughly a megabyte of third-party JavaScript on
 * page load, whether or not anyone watches. This renders a self-hosted poster
 * instead and only swaps in the real player on click — so the page stays fast,
 * and no third party sees the visitor unless they choose to watch.
 *
 * Uses youtube-nocookie.com so playback doesn't set tracking cookies either.
 */

interface Props {
  videoId: string;
  /** Accessible title, also shown as the caption. */
  title: string;
  poster: string;
  /** Optional start offset in seconds. */
  start?: number;
}

const { videoId, title, poster, start } = Astro.props;
const params = new URLSearchParams({ autoplay: '1', rel: '0' });
if (start) params.set('start', String(start));
const src = `https://www.youtube-nocookie.com/embed/${videoId}?${params}`;
---

<figure class="video">
  <button class="video__trigger" data-src={src} aria-label={`Play video: ${title}`}>
    <img class="video__poster" src={poster} alt="" width="1280" height="720" loading="lazy" />
    <span class="video__play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
        <path d="M8 5v14l11-7z"></path>
      </svg>
    </span>
    <span class="video__label">Watch the intro</span>
  </button>
  <figcaption class="video__caption">{title}</figcaption>
</figure>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('.video__trigger')) {
    btn.addEventListener(
      'click',
      () => {
        const src = btn.dataset.src;
        if (!src) return;

        const iframe = document.createElement('iframe');
        iframe.src = src;
        iframe.title = btn.getAttribute('aria-label') ?? 'Video';
        iframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.className = 'video__frame';

        btn.replaceWith(iframe);
      },
      { once: true }
    );
  }
</script>

<style>
  .video {
    margin: 0;
  }

  .video__trigger,
  .video :global(.video__frame) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--paper-2);
  }

  .video__trigger {
    position: relative;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    color: inherit;
    font: inherit;
  }

  .video__poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.9) contrast(1.02);
    transition:
      transform var(--dur-slow) var(--ease),
      filter var(--dur) var(--ease);
  }

  /* A wash that lifts on hover, so the poster reads as interactive rather
     than as a flat screenshot. */
  .video__trigger::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 45%), rgb(0 0 0 / 5%) 55%);
    transition: opacity var(--dur) var(--ease);
  }

  .video__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 4.25rem;
    height: 4.25rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    z-index: 1;
    transform: scale(0.94);
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease);
    box-shadow: 0 0 0 0 var(--accent-wash);
  }

  .video__play svg {
    margin-left: 3px;
  }

  .video__label {
    position: absolute;
    left: 1.25rem;
    bottom: 1.15rem;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.05em;
    color: #fff;
  }

  .video__trigger:hover .video__poster {
    transform: scale(1.03);
    filter: saturate(1) contrast(1.02);
  }

  .video__trigger:hover .video__play,
  .video__trigger:focus-visible .video__play {
    transform: scale(1);
    box-shadow: 0 0 0 0.85rem rgb(255 255 255 / 12%);
  }

  .video__caption {
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-3);
  }
</style>
