---
/**
 * The sketch that sits beside each featured case on the home page.
 *
 * Each one draws the same idea the case text describes — the before state next
 * to the after state — so the diagram is doing explanatory work rather than
 * decorating the card. They're inline SVG (and, for the winback, plain boxes)
 * so they inherit the palette and cost no extra request. The drawings are the
 * v8 export's, ported verbatim.
 *
 * Decorative by design: every drawing is aria-hidden and carries a written
 * caption underneath, which is what a screen reader gets instead.
 */

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const CAPTIONS: Record<string, string> = {
  'mogo-lifecycle': 'From calendar time to what people actually did.',
  winback: 'Two audiences, two products, four different pitches.',
  'sportserve-payments-division': 'Eight departments, before and after.',
  'lead-enrichment': 'Signup to sales-ready lead, with validation in the middle.',
};
---

<div class="diagram">
  {
    slug === 'mogo-lifecycle' && (
      <div class="diagram__pair" aria-hidden="true">
        <svg viewBox="0 0 250 130">
          <path
            d="M14 66 C70 62, 130 70, 236 64"
            stroke="#1F1C19"
            stroke-opacity=".45"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"
          />
          <path d="M52 52 L53 80" stroke="#1F1C19" stroke-opacity=".45" stroke-width="2" fill="none" stroke-linecap="round" />
          <path d="M124 55 L122 83" stroke="#1F1C19" stroke-opacity=".45" stroke-width="2" fill="none" stroke-linecap="round" />
          <path d="M198 53 L200 81" stroke="#1F1C19" stroke-opacity=".45" stroke-width="2" fill="none" stroke-linecap="round" />
          <text x="52" y="44" text-anchor="middle" font-size="11" fill="#6B6560">Day 1</text>
          <text x="123" y="47" text-anchor="middle" font-size="11" fill="#6B6560">Day 3</text>
          <text x="199" y="45" text-anchor="middle" font-size="11" fill="#6B6560">Day 7</text>
          <text x="14" y="112" font-size="11" fill="#6B6560">calendar time</text>
        </svg>
        <svg viewBox="0 0 250 130">
          <path d="M14 66 C68 71, 132 60, 236 67" stroke="#F2603F" stroke-width="3" fill="none" stroke-linecap="round" />
          <path d="M46 52 L47 80" stroke="#1F1C19" stroke-opacity=".45" stroke-width="2" fill="none" stroke-linecap="round" />
          <path d="M126 56 L124 84" stroke="#1F1C19" stroke-opacity=".45" stroke-width="2" fill="none" stroke-linecap="round" />
          <path d="M204 53 L206 81" stroke="#1F1C19" stroke-opacity=".45" stroke-width="2" fill="none" stroke-linecap="round" />
          <circle cx="46" cy="68" r="4.2" fill="#F2603F" />
          <circle cx="125" cy="66" r="4.2" fill="#F2603F" />
          <circle cx="205" cy="67" r="4.2" fill="#F2603F" />
          <text x="46" y="44" text-anchor="middle" font-size="11" fill="#6B6560">bank connected</text>
          <text x="125" y="48" text-anchor="middle" font-size="11" fill="#6B6560">first deposit</text>
          <text x="205" y="45" text-anchor="middle" font-size="11" fill="#6B6560">first trade</text>
          <text x="14" y="112" font-size="11" fill="#6B6560">what people did</text>
        </svg>
      </div>
    )
  }

  {
    slug === 'winback' && (
      <div class="diagram__winback" aria-hidden="true">
        <div class="diagram__wb-rail">
          <div class="diagram__wb-spacer" />
          <div class="diagram__wb-audience">
            dormant
            <br />
            investors
          </div>
          <div class="diagram__wb-audience diagram__wb-audience--new">
            lending
            <br />
            customers
            <span>never invested</span>
          </div>
        </div>
        <div class="diagram__wb-col">
          <div class="diagram__wb-head">
            <span class="diagram__wb-product">Manage</span>
            <span class="diagram__wb-sub">auto weekly investing</span>
          </div>
          <div class="diagram__wb-cell">
            <span>resume the habit</span>
            <span class="diagram__wb-sub">→ calculator</span>
          </div>
          <div class="diagram__wb-cell diagram__wb-cell--new">
            <span>start the habit</span>
            <span class="diagram__wb-sub">→ calculator</span>
          </div>
        </div>
        <div class="diagram__wb-col">
          <div class="diagram__wb-head">
            <span class="diagram__wb-product">Self-directed</span>
            <span class="diagram__wb-sub">manual trading</span>
          </div>
          <div class="diagram__wb-cell">
            <span>back to research</span>
            <span class="diagram__wb-sub">→ Fiscal.ai</span>
          </div>
          <div class="diagram__wb-cell diagram__wb-cell--new">
            <span>start researching</span>
            <span class="diagram__wb-sub">→ Fiscal.ai</span>
          </div>
        </div>
      </div>
    )
  }

  {
    slug === 'sportserve-payments-division' && (
      <div class="diagram__pair" aria-hidden="true">
        <svg viewBox="0 0 250 190">
          <g stroke="#1F1C19" stroke-opacity=".2" stroke-width="2" fill="none" stroke-linecap="round">
            <path d="M62 44 C96 66, 74 96, 120 108" />
            <path d="M158 52 C130 88, 176 104, 150 140" />
            <path d="M40 118 C82 130, 96 150, 132 158" />
          </g>
          <g stroke="#1F1C19" stroke-width="2" fill="none" stroke-linecap="round">
            <rect x="14" y="24" width="70" height="24" transform="rotate(-2.2 49 36)" />
            <rect x="120" y="18" width="80" height="24" transform="rotate(1.8 160 30)" />
            <rect x="24" y="66" width="72" height="24" transform="rotate(1.4 60 78)" />
            <rect x="132" y="62" width="78" height="24" transform="rotate(-1.6 171 74)" />
            <rect x="12" y="108" width="66" height="24" transform="rotate(-1.2 45 120)" />
            <rect x="112" y="104" width="66" height="24" transform="rotate(2.4 145 116)" />
            <rect x="30" y="150" width="76" height="24" transform="rotate(1.1 68 162)" />
            <rect x="140" y="148" width="88" height="24" transform="rotate(-2 184 160)" />
          </g>
          <g font-size="11" fill="#1F1C19">
            <text x="24" y="40">Product</text>
            <text x="130" y="34">Engineering</text>
            <text x="34" y="82">Payments</text>
            <text x="142" y="78">Compliance</text>
            <text x="22" y="124">Support</text>
            <text x="122" y="120">Creative</text>
            <text x="40" y="166">Marketing</text>
            <text x="150" y="164">Regional Ops</text>
          </g>
        </svg>
        <svg viewBox="0 0 250 190">
          <g stroke="#1F1C19" stroke-width="2" fill="none" stroke-linecap="round">
            <rect x="8" y="20" width="62" height="20" />
            <rect x="8" y="50" width="62" height="20" />
            <rect x="8" y="80" width="62" height="20" />
            <rect x="8" y="110" width="62" height="20" />
            <rect x="78" y="20" width="62" height="20" />
            <rect x="78" y="50" width="62" height="20" />
            <rect x="78" y="80" width="62" height="20" />
            <rect x="78" y="110" width="62" height="20" />
            <path d="M142 30 L176 68 M142 60 L176 74 M142 90 L176 84 M142 120 L176 92" stroke-opacity=".3" />
          </g>
          <g font-size="9" fill="#1F1C19">
            <text x="13" y="34">Product</text>
            <text x="13" y="64">Payments</text>
            <text x="13" y="94">Support</text>
            <text x="13" y="124">Marketing</text>
            <text x="83" y="34">Engineering</text>
            <text x="83" y="64">Compliance</text>
            <text x="83" y="94">Creative</text>
            <text x="83" y="124">Regional Ops</text>
          </g>
          <path d="M180 18 C183 70, 182 108, 179 148" stroke="#3E8FD8" stroke-width="4" fill="none" stroke-linecap="round" />
          <path d="M182 152 C196 158, 204 160, 224 160" stroke="#1F1C19" stroke-width="2" fill="none" stroke-linecap="round" />
          <text x="196" y="84" text-anchor="middle" transform="rotate(-90 196 84)" font-size="11" fill="#2A6FB0" font-weight="700">
            Payments Ops
          </text>
          <text x="200" y="178" font-size="11" fill="#1F1C19">Launch</text>
        </svg>
      </div>
    )
  }

  {
    slug === 'lead-enrichment' && (
      <svg class="diagram__flow" viewBox="0 0 340 200" aria-hidden="true">
        <g stroke="#1F1C19" stroke-width="2" fill="none" stroke-linecap="round">
          <rect x="4" y="14" width="100" height="70" />
          <rect x="120" y="14" width="100" height="70" />
          <rect x="236" y="14" width="100" height="70" />
          <rect x="120" y="120" width="100" height="70" />
          <path d="M106 49 L117 49 M113 45.5 L117.5 49 L113 52.5" />
          <path d="M222 49 L233 49 M229 45.5 L233.5 49 L229 52.5" />
          <path d="M286 86 C286 98, 286 104, 286 116 M282 111.5 L286 116.5 L290 111.5" />
          <path d="M234 155 L223 155 M227 151.5 L222.5 155 L227 158.5" />
        </g>
        <g stroke="#3FA981" stroke-width="3.5" fill="none" stroke-linecap="round">
          <rect x="236" y="120" width="100" height="70" />
          <rect x="4" y="120" width="100" height="70" />
          <path d="M118 155 L107 155 M111 151.5 L106.5 155 L111 158.5" />
        </g>
        <g font-size="9" font-weight="700" fill="#1F1C19" letter-spacing=".06em">
          <text x="14" y="41">SIGNUP</text>
          <text x="130" y="41">FILTER</text>
          <text x="246" y="41">ENRICH</text>
          <text x="246" y="138" fill="#2E8567">CLASSIFY +</text>
          <text x="246" y="149" fill="#2E8567">VALIDATE</text>
          <text x="130" y="147">CRM</text>
          <text x="14" y="147" fill="#2E8567">ROUTE</text>
        </g>
        <g font-size="8" fill="#6B6560">
          <text x="14" y="57" fill="#1F1C19">DTC Newsletter</text>
          <text x="14" y="70">~300/day</text>
          <text x="130" y="57" fill="#1F1C19">Remove generic</text>
          <text x="130" y="70">email addresses</text>
          <text x="246" y="57" fill="#1F1C19">StoreLeads · Clay</text>
          <text x="246" y="70">LinkedIn · LindyAI</text>
          <text x="246" y="162" fill="#1F1C19">ChatGPT API</text>
          <text x="246" y="175">Fit · persona · QA</text>
          <text x="130" y="163" fill="#1F1C19">HubSpot</text>
          <text x="130" y="176">~70% pre-filled</text>
          <text x="14" y="163" fill="#1F1C19">Slack → Sales</text>
          <text x="14" y="176">high value, real time</text>
        </g>
      </svg>
    )
  }

  {CAPTIONS[slug] && <p class="diagram__caption">{CAPTIONS[slug]}</p>}
</div>

<style>
  .diagram {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
    height: 100%;
  }

  .diagram svg {
    font-family: var(--font-sans);
  }

  .diagram__pair {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
  }

  .diagram__pair svg {
    flex: 1 1 240px;
    min-width: 0;
    height: auto;
  }

  .diagram__flow {
    width: 100%;
    height: auto;
  }

  .diagram__caption {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  /* -------------------------------------------------- winback boxes -- */

  .diagram__winback {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .diagram__wb-rail {
    flex: 0 0 104px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .diagram__wb-spacer {
    height: 34px;
  }

  .diagram__wb-audience {
    height: 86px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    font-size: 12px;
    color: var(--ink-2);
    line-height: 1.35;
  }

  .diagram__wb-audience--new {
    color: #8a6410;
  }

  .diagram__wb-audience span {
    font-size: 9px;
  }

  .diagram__wb-col {
    flex: 1 1 190px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .diagram__wb-head {
    height: 34px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    border-bottom: var(--border);
    padding-bottom: 6px;
  }

  .diagram__wb-product {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .diagram__wb-sub {
    font-size: 9px;
    color: var(--ink-3);
  }

  .diagram__wb-cell {
    height: 86px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    padding: 0 16px;
    border: var(--border);
    font-size: 12px;
  }

  .diagram__wb-cell--new {
    border-color: var(--sun);
    background: rgb(245 184 65 / 16%);
  }
</style>
