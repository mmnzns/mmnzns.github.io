---
import { Image } from 'astro:assets';
import logoM from '../assets/logo-m-transparent.png';

/**
 * The web design section's nav, shared by `web-design.astro` and the three
 * sub-pages that render through `WebDesignLayout`.
 *
 * Every value here comes from the v13 export, where all four `Monzones-W-*`
 * files carry a byte-identical nav: 14px/28px padding, a 38px mark, 14px/700
 * links at .02em, and a **black** pill CTA that goes coral on hover. It
 * shipped yellow-on-outline before, which is the single most visible thing
 * that kept the live section reading as the old design.
 *
 * The export has no current-page state at all — on each page the current item
 * simply points at `#top`. Miguel asked for one, so `aria-current` colours the
 * item coral: the accent the design already uses for nav hover, rather than a
 * decoration invented for the purpose.
 *
 * FAQ never takes `aria-current`: it is an anchor on the main page, not a page.
 */
interface Props {
  current: 'home' | 'work' | 'process' | 'pricing';
}

const { current } = Astro.props;

const LINKS = [
  { label: 'Home', href: '/web-design/', key: 'home' },
  { label: 'Work', href: '/web-design/work/', key: 'work' },
  { label: 'Process', href: '/web-design/process/', key: 'process' },
  { label: 'Pricing', href: '/web-design/pricing/', key: 'pricing' },
] as const;
---

<nav class="wdnav" aria-label="Web design">
  <a class="wdnav__brand" href="/web-design/">
    <Image src={logoM} alt="" width={76} height={76} loading="eager" />
    <span class="wdnav__brandtext">
      <span class="wdnav__brandname">Sites that sell.</span>
      <span class="wdnav__brandsub">by Miguel Monzones</span>
    </span>
  </a>

  <div class="wdnav__list">
    <a class="wdnav__hq" href="/" title="Back to mnmonzones.com">← back to HQ</a>
    <span class="wdnav__div" aria-hidden="true"></span>

    {
      LINKS.map((link) => (
        <a
          class="wdnav__sec"
          href={link.href}
          aria-current={current === link.key ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }

    <a class="wdnav__sec" href="/web-design/#faq">FAQ</a>
    <a class="wdnav__cta" href="/web-design/#start">Start a project ↗</a>

    <button
      type="button"
      class="wdnav__burger"
      aria-expanded="false"
      aria-controls="wd-mobile-nav"
      data-wd-nav-toggle
    >
      <span class="visually-hidden">Menu</span>
      <span class="wdnav__burgerlines" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>
  </div>

  <div class="wdnav__panel" id="wd-mobile-nav" hidden data-wd-nav-panel>
    {
      LINKS.map((link) => (
        <a href={link.href} aria-current={current === link.key ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
    <a href="/web-design/#faq">FAQ</a>
    <a class="wdnav__panelhq" href="/">← back to HQ</a>
    <a class="wdnav__panelcta" href="/web-design/#start">Start a project ↗</a>
  </div>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-wd-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-wd-nav-panel]');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    panel?.toggleAttribute('hidden', open);
  });

  panel?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) {
      toggle?.setAttribute('aria-expanded', 'false');
      panel.setAttribute('hidden', '');
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (toggle?.getAttribute('aria-expanded') !== 'true') return;
    toggle.setAttribute('aria-expanded', 'false');
    panel?.setAttribute('hidden', '');
    toggle.focus();
  });
</script>

<style>
  .wdnav {
    position: sticky;
    top: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 28px;
    background: rgb(244 241 234 / 92%);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--wd-ink);
    color: var(--wd-ink);
  }

  .wdnav__brand {
    display: flex;
    align-items: center;
    gap: 11px;
    color: var(--wd-ink);
    text-decoration: none;
  }

  .wdnav__brand :global(img) {
    width: 38px;
    height: 38px;
    display: block;
  }

  .wdnav__brandtext {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .wdnav__brandname {
    font-weight: 900;
    font-size: 16px;
    letter-spacing: 0.01em;
  }

  .wdnav__brandsub {
    font-family: var(--wd-hand);
    font-size: 15px;
    color: var(--wd-coral-deep);
    transform: rotate(-1deg);
  }

  .wdnav__list {
    display: flex;
    align-items: center;
    gap: 24px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .wdnav__hq {
    display: inline-block;
    font-family: var(--wd-hand);
    font-size: 18px;
    font-weight: 700;
    color: var(--wd-muted);
    transform: rotate(-2deg);
    white-space: nowrap;
    text-decoration: none;
    transition: color 0.2s;
  }

  .wdnav__hq:hover,
  .wdnav__hq:focus-visible {
    color: var(--wd-coral-deep);
  }

  .wdnav__div {
    width: 1px;
    height: 16px;
    background: rgb(33 33 33 / 30%);
    flex: none;
  }

  .wdnav__sec {
    color: var(--wd-ink);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .wdnav__sec:hover,
  .wdnav__sec:focus-visible {
    color: var(--wd-coral);
  }

  /* The export has no current-page state; this is the one addition Miguel
     asked for. Coral text alone measures 3.31:1 on the nav's paper, under AA
     for 14px, so the mark is the coral rule and the label stays full-contrast
     ink. */
  .wdnav__sec[aria-current='page'] {
    color: var(--wd-ink);
    border-bottom: 2.5px solid var(--wd-coral);
    padding-bottom: 3px;
  }

  .wdnav__cta {
    background: var(--wd-ink);
    color: var(--wd-paper);
    font-weight: 700;
    font-size: 14px;
    padding: 11px 22px;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .wdnav__cta:hover,
  .wdnav__cta:focus-visible {
    background: var(--wd-coral-deep);
    color: var(--wd-paper);
  }

  .wdnav__burger {
    display: none;
    flex: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1.5px solid var(--wd-ink);
    border-radius: 10px;
    padding: 0;
    cursor: pointer;
  }

  .wdnav__burgerlines {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 18px;
  }

  .wdnav__burgerlines span {
    display: block;
    height: 2px;
    background: var(--wd-ink);
  }

  .wdnav__panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background: var(--wd-paper);
    border-bottom: 1px solid var(--wd-ink);
    padding: 6px 20px 18px;
  }

  .wdnav__panel a {
    display: block;
    padding: 13px 0;
    font-size: 16px;
    font-weight: 700;
    color: var(--wd-ink);
    text-align: center;
    text-decoration: none;
    border-bottom: 1px solid var(--wd-rule);
  }

  .wdnav__panel a[aria-current='page'] {
    color: var(--wd-ink);
    text-decoration: underline;
    text-decoration-color: var(--wd-coral);
    text-decoration-thickness: 2.5px;
    text-underline-offset: 5px;
  }

  .wdnav__panelhq {
    color: var(--wd-muted) !important;
  }

  .wdnav__panel .wdnav__panelcta {
    margin-top: 14px;
    background: var(--wd-ink);
    color: var(--wd-paper);
    font-weight: 800;
    font-size: 16px;
    padding: 14px 20px;
    border-radius: 999px;
    border-bottom: 0;
  }

  /* The export switches to the burger at 860px, not 760px. */
  @media (max-width: 860px) {
    .wdnav {
      gap: 14px;
      padding: 12px 16px;
    }

    .wdnav__hq,
    .wdnav__div,
    .wdnav__sec,
    .wdnav__brandsub,
    .wdnav__cta {
      display: none;
    }

    .wdnav__burger {
      display: flex;
    }
  }
</style>
