---
/**
 * The v19 footer, identical on every page.
 *
 * The line names the public brand, Craft Concepts Digital — Miguel's call on
 * 2026-09-26. The legal name (CONTACT.entity) is not the public brand and
 * only appears where the law wants it, on the privacy page.
 */
import { CONTACT, STUDIO } from '../config';

const onPrivacy = Astro.url.pathname.startsWith('/privacy');
---

<footer class="ft">
  <div class="ft__row">
    <p class="ft__line">{STUDIO.name} — lifecycle and GTM, Vancouver.</p>
    <div class="ft__links">
      <a href="/privacy/" class="ft__muted" aria-current={onPrivacy ? 'page' : undefined}>Privacy</a>
      {/* Reopens the consent banner — ConsentBanner.astro binds every [data-cookie-settings]. */}
      <a href="#cookie-settings" class="ft__muted" data-cookie-settings>Cookie settings</a>
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      <a
        class="ft__social"
        href={CONTACT.linkedin}
        target="_blank"
        rel="noopener"
        aria-label="Miguel Monzones on LinkedIn"
      >
        <img src="/linkedin.svg" alt="" width="20" height="20" />
      </a>
    </div>
  </div>
</footer>

<style>
  .ft {
    background: var(--paper);
    padding: clamp(40px, 5vw, 64px) var(--gutter) clamp(80px, 7vw, 96px);
  }
  .ft__row {
    max-width: var(--max);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
    flex-wrap: wrap;
    padding-top: 22px;
    border-top: 1px solid var(--ink);
  }
  .ft__line {
    font-size: 0.9375rem;
  }
  .ft__links {
    display: flex;
    align-items: center;
    gap: 8px 24px;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 0.8125rem;
  }
  .ft__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
  }
  .ft__links a.ft__muted {
    color: var(--muted);
  }
  .ft__links a[aria-current='page'] {
    color: var(--ink);
  }
  .ft__links a:hover {
    color: var(--blue);
  }
  .ft__links a.ft__social {
    justify-content: center;
    width: 44px;
    height: 44px;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  .ft__social:hover {
    opacity: 1;
  }
  .ft__social img {
    display: block;
    width: 20px;
    height: 20px;
  }
</style>
