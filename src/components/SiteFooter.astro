---
import { CONTACT } from '../config';

interface Props {
  /**
   * Set when the page ends on a full-bleed colour band: the band's own bottom
   * edge replaces the footer's usual air, exactly as the design does it.
   */
  flush?: boolean;
}

const { flush = false } = Astro.props;
---

<footer class:list={['footer', { 'footer--flush': flush }]}>
  <div class="footer__card">
    <p class="footer__tag">{CONTACT.entity} — Vancouver.</p>

    <div class="footer__links footer__meta">
      {/* Reopens the consent banner — see ConsentBanner.astro, which binds
          every [data-cookie-settings] link on the page. */}
      <a class="footer__cookies" href="#cookie-settings" data-cookie-settings>Cookie settings</a>
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      <a
        class="footer__social"
        href={CONTACT.linkedin}
        target="_blank"
        rel="noopener"
        aria-label="Miguel Monzones on LinkedIn"
      >
        <svg viewBox="0 0 50 50" aria-hidden="true" focusable="false">
          <path
            d="M41,4H9C6.24,4,4,6.24,4,9v32c0,2.76,2.24,5,5,5h32c2.76,0,5-2.24,5-5V9C46,6.24,43.76,4,41,4z M17,20v19h-6V20H17z M11,14.47c0-1.4,1.2-2.47,3-2.47s2.93,1.07,3,2.47c0,1.4-1.12,2.53-3,2.53C12.2,17,11,15.87,11,14.47z M39,39h-6c0,0,0-9.26,0-10 c0-2-1-4-3.5-4.04h-0.08C27,24.96,26,27.02,26,29c0,0.91,0,10,0,10h-6V20h6v2.56c0,0,1.93-2.56,5.81-2.56 c3.97,0,7.19,2.73,7.19,8.26V39z"
          ></path>
        </svg>
      </a>
    </div>
  </div>

  <div class="footer__wordmark" aria-hidden="true" data-wordmark>MONZONES</div>
</footer>

<style>
  .footer {
    margin-top: clamp(75px, 13.4vw, 150px);
    position: relative;
    overflow: hidden;
    background: var(--paper);
    padding: clamp(62px, 8vw, 108px) var(--gutter) 0;
  }

  /* A page that ends on a full-bleed band shouldn't stack the footer's usual
     air on top of the band's own bottom padding. */
  .footer--flush {
    margin-top: 0;
  }

  .footer__card {
    max-width: var(--wrap-home);
    margin-inline: auto;
    background: var(--dark);
    padding: clamp(22px, 3vw, 32px) clamp(24px, 3.4vw, 38px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
    position: relative;
    z-index: 2;
  }

  .footer__tag {
    font-size: 15px;
    font-weight: 600;
    color: var(--on-dark);
  }

  .footer__links {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .footer__links a {
    color: var(--on-dark);
  }

  /* Quieter than the email address beside it — it's a utility, not a contact
     detail. Setting a colour here outranks the global `a:hover`, so the hover
     and focus colours have to be restated or the link stops responding. */
  .footer__cookies {
    color: rgb(251 249 246 / 60%) !important;
  }

  .footer__cookies:hover,
  .footer__cookies:focus-visible,
  .footer__links a:hover,
  .footer__links a:focus-visible {
    color: var(--sun) !important;
  }

  .footer__social {
    display: block;
    width: 20px;
    height: 20px;
    opacity: 0.6;
    transition: opacity var(--dur-fast) var(--ease);
  }

  .footer__social:hover {
    opacity: 1;
  }

  .footer__social svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: var(--on-dark);
  }

  /* Solid ink wordmark, cropped by the footer's overflow so it reads as the
     page's floor rather than as a heading. Motion.astro drifts it as the
     footer arrives; the authored offset here is inside the range it animates
     over, so it sits correctly either way. */
  .footer__wordmark {
    margin-top: 44px;
    font-size: clamp(52px, 14.6vw, 224px);
    line-height: 0.78;
    font-weight: 700;
    letter-spacing: -0.055em;
    text-align: center;
    color: var(--ink);
    transform: translateY(16%);
    user-select: none;
  }

  @media (max-width: 640px) {
    .footer__card {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* Touch targets. The text links are only as tall as their line box, and the
     social icon is 20px square — both well under the 44px a finger needs, so
     they get padded out on small screens without changing how they look. */
  @media (max-width: 719px) {
    .footer__links {
      gap: 10px 18px;
    }

    .footer__links a:not(.footer__social) {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }

    .footer__social {
      width: 44px;
      height: 44px;
      padding: 12px;
    }

    .footer__wordmark {
      font-size: 13.2vw;
    }
  }
</style>
