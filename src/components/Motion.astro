---
/**
 * The v19 motion vocabulary, shared by every page. Pages opt in with data
 * attributes rather than scripts of their own:
 *
 *   data-hero      rises in on load, in document order (data-word adds a tilt)
 *   data-rv        fades up when scrolled into view (data-delay in ms)
 *   data-split     heading whose words slide up out of a mask
 *   data-clip      a taped photo that drops in and settles to its own tilt
 *   data-count     counts its last number up from zero
 *   data-magnetic  drifts toward the pointer (fine pointers only)
 *
 * The rules that keep motion from hiding the site (see CLAUDE.md):
 *
 *  - Starting states are written here, in JavaScript, never in CSS. No
 *    script, no hidden content.
 *  - Reveals animate the individual `translate` / `rotate` properties, not
 *    `transform`, so a card's own tilt (set in CSS) is never overwritten.
 *  - A failsafe shows anything still pending at or above the fold after
 *    2600ms, and again whenever the tab becomes visible — the conditions under
 *    which observers and rAF quietly never fire. Content further down stays
 *    armed for its scroll reveal.
 */
---

<script>
  const EASE = 'cubic-bezier(.16,1,.3,1)';
  const FAILSAFE_MS = 2600;

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;
  const canObserve = typeof IntersectionObserver === 'function';

  type Armed = HTMLElement & { _words?: HTMLElement[]; _count?: CountState };
  interface CountState {
    node: Text;
    text: string;
    pre: string;
    post: string;
    value: number;
    decimals: number;
  }

  const pending = new Set<Armed>();

  /* Words are wrapped in a clipping span so each can rise out of its own line.
     Elements inside the heading (an <em>) are walked, not flattened. */
  function splitWords(el: Armed) {
    if (el._words) return el._words;
    const out: HTMLElement[] = [];
    const walk = (node: Node) => {
      for (const child of Array.from(node.childNodes)) {
        if (child.nodeType === Node.TEXT_NODE) {
          const text = (child.nodeValue ?? '').replace(/\s+/g, ' ');
          if (!text.trim()) continue;
          const frag = document.createDocumentFragment();
          text.split(' ').forEach((word, i, all) => {
            if (word) {
              const mask = document.createElement('span');
              mask.className = 'mz-word';
              const inner = document.createElement('span');
              inner.textContent = word;
              mask.appendChild(inner);
              frag.appendChild(mask);
              out.push(inner);
            }
            if (i < all.length - 1) frag.appendChild(document.createTextNode(' '));
          });
          child.replaceWith(frag);
        } else if (child.nodeType === Node.ELEMENT_NODE) {
          walk(child);
        }
      }
    };
    walk(el);
    return (el._words = out);
  }

  function armCount(el: Armed) {
    const node = Array.from(el.childNodes).find(
      (n): n is Text => n.nodeType === Node.TEXT_NODE && /\d/.test(n.nodeValue ?? ''),
    );
    if (!node) return;
    const text = node.nodeValue ?? '';
    const matches = Array.from(text.matchAll(/\d+(?:\.\d+)?/g));
    const last = matches[matches.length - 1];
    if (!last || last.index === undefined) return;
    el._count = {
      node,
      text,
      pre: text.slice(0, last.index),
      post: text.slice(last.index + last[0].length),
      value: parseFloat(last[0]),
      decimals: (last[0].split('.')[1] ?? '').length,
    };
    node.nodeValue = el._count.pre + (0).toFixed(el._count.decimals) + el._count.post;
  }

  function playCount(el: Armed, delay: number) {
    const k = el._count;
    if (!k) return;
    const start = performance.now() + delay;
    const step = (now: number) => {
      const p = Math.min(1, Math.max(0, (now - start) / 1700));
      const eased = 1 - Math.pow(1 - p, 4);
      k.node.nodeValue = k.pre + (k.value * eased).toFixed(k.decimals) + k.post;
      if (p < 1) requestAnimationFrame(step);
      else k.node.nodeValue = k.text;
    };
    requestAnimationFrame(step);
  }

  function arm(el: Armed) {
    if (el.hasAttribute('data-rv')) {
      el.style.opacity = '0';
      el.style.translate = '0 40px';
    }
    if (el.hasAttribute('data-split')) {
      for (const w of splitWords(el)) w.style.translate = '0 110%';
    }
    if (el.hasAttribute('data-clip')) {
      el.style.opacity = '0';
      el.style.translate = '0 50px';
      el.style.rotate = '-6deg';
    }
    if (el.hasAttribute('data-count')) armCount(el);
    pending.add(el);
  }

  /** Reveal. `instant` skips the animation — the failsafe and skipped-past path. */
  function play(el: Armed, instant = false) {
    if (!pending.delete(el)) return;
    const d = instant ? 0 : Number(el.dataset.delay ?? 0);
    const t = (ms: number) => (instant ? 'none' : `${ms}ms ${EASE} ${d}ms`);

    if (el.hasAttribute('data-rv')) {
      el.style.transition = instant ? '' : `opacity ${t(1000)}, translate ${t(1100)}`;
      el.style.opacity = '';
      el.style.translate = '';
    }
    if (el.hasAttribute('data-split')) {
      (el._words ?? []).forEach((w, i) => {
        w.style.transition = instant ? '' : `translate 1100ms ${EASE} ${d + i * 60}ms`;
        w.style.translate = '';
      });
    }
    if (el.hasAttribute('data-clip')) {
      el.style.transition = instant ? '' : `opacity ${t(1000)}, translate ${t(1400)}, rotate ${t(1400)}`;
      el.style.opacity = '';
      el.style.translate = '';
      el.style.rotate = '';
    }
    if (el.hasAttribute('data-count')) {
      if (instant && el._count) el._count.node.nodeValue = el._count.text;
      else playCount(el, d + 150);
    }
    if (!instant) {
      // Hand the element back to its stylesheet once it has arrived.
      window.setTimeout(() => {
        el.style.transition = '';
      }, d + 1500);
    }
  }

  function hero() {
    const parts = Array.from(document.querySelectorAll<HTMLElement>('[data-hero]'));
    parts.forEach((p) => {
      p.style.opacity = '0';
      p.style.translate = p.hasAttribute('data-word') ? '0 40px' : '0 28px';
      if (p.hasAttribute('data-word')) p.style.rotate = '-5deg';
    });
    requestAnimationFrame(() =>
      requestAnimationFrame(() => {
        parts.forEach((p, i) => {
          const d = 160 + i * 110;
          p.style.transition = `opacity 1s ${EASE} ${d}ms, translate 1.2s ${EASE} ${d}ms, rotate 1.2s ${EASE} ${d}ms`;
          p.style.opacity = '';
          p.style.translate = '';
          p.style.rotate = '';
          window.setTimeout(() => (p.style.transition = ''), d + 1300);
        });
      }),
    );
    // Same guarantee as the scroll reveals: a stalled rAF can't leave the hero blank.
    window.setTimeout(() => {
      parts.forEach((p) => {
        if (p.style.opacity === '0') {
          p.style.transition = '';
          p.style.opacity = '';
          p.style.translate = '';
          p.style.rotate = '';
        }
      });
    }, FAILSAFE_MS);
  }

  /** Show whatever is pending at or above the bottom of the viewport. */
  function flushVisible() {
    const limit = window.innerHeight;
    for (const el of [...pending]) {
      if (el.getBoundingClientRect().top < limit) play(el, true);
    }
  }

  if (!reduced && canObserve) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target as Armed;
          // Jumped clean past (an anchor link, a flick): already behind the reader.
          const passed = !entry.isIntersecting && entry.boundingClientRect.bottom < 0;
          if (!entry.isIntersecting && !passed) continue;
          io.unobserve(el);
          play(el, passed);
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
    );

    const scan = (root: ParentNode = document) => {
      root
        .querySelectorAll<Armed>('[data-rv],[data-split],[data-clip],[data-count]')
        .forEach((el) => {
          if (pending.has(el) || el.dataset.mzArmed) return;
          el.dataset.mzArmed = '1';
          arm(el);
          io.observe(el);
        });
    };

    hero();
    scan();
    // Pages that render new cards (filters, "show more") ask for another pass.
    document.addEventListener('mz:scan', () => scan());

    window.setTimeout(flushVisible, FAILSAFE_MS);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') flushVisible();
    });
  }

  /* ------------------------------------------------------------ magnetics */
  if (!reduced && fine) {
    let magnets = Array.from(document.querySelectorAll<HTMLElement & { _mx?: number; _my?: number }>('[data-magnetic]'));
    document.addEventListener('mz:scan', () => {
      magnets = Array.from(document.querySelectorAll('[data-magnetic]'));
    });
    let px = -999;
    let py = -999;
    let queued = false;
    const frame = () => {
      queued = false;
      for (const m of magnets) {
        const r = m.getBoundingClientRect();
        const ox = m._mx ?? 0;
        const oy = m._my ?? 0;
        const dx = px - (r.left - ox + r.width / 2);
        const dy = py - (r.top - oy + r.height / 2);
        if (Math.abs(dx) < r.width / 2 + 40 && Math.abs(dy) < r.height / 2 + 40) {
          m._mx = dx * 0.2;
          m._my = dy * 0.3;
          m.style.translate = `${m._mx.toFixed(1)}px ${m._my.toFixed(1)}px`;
        } else if (m._mx || m._my) {
          m._mx = 0;
          m._my = 0;
          m.style.translate = '';
        }
      }
    };
    window.addEventListener(
      'pointermove',
      (e) => {
        px = e.clientX;
        py = e.clientY;
        if (!queued) {
          queued = true;
          requestAnimationFrame(frame);
        }
      },
      { passive: true },
    );
  }
</script>

<style is:global>
  /* The mask each split word rises out of. Padding keeps descenders and the
     italic overhang inside it. */
  .mz-word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
    padding-right: 0.12em;
    margin-right: -0.12em;
  }
  .mz-word > span {
    display: inline-block;
  }
</style>
