---
import { Image } from 'astro:assets';
import { SITE, NAV_LINKS, NAV_SERVICES, NAV_CTA } from '../config';
import logoMark from '../assets/logo-mark.png';

/**
 * The desktop header (`.deskhead` in the export): a dark bar with the plain
 * site links, then the two offerings boxed together behind a small "Services"
 * tab, then the coral CTA.
 *
 * Below 900px the export swaps it for its `Monzones-D-Nav-Bold` component,
 * which v14 is the first round to ship: a 61px bar with a 3px-bordered toggle,
 * and a full-screen dark panel of 26px links in 68px rows — each with a colour
 * dot on the right, the two services tagged "Service", the CTA as the last
 * row. That component is what the mobile markup below ports; the earlier
 * inferred panel is gone.
 */

interface Props {
  /** Renders the article reading-progress bar along the bottom edge. */
  progress?: boolean;
}

const { progress = false } = Astro.props;
const path = Astro.url.pathname;

/** The dot beside each mobile link, as the export's LINKS array assigns them. */
const DOTS: Record<string, string> = {
  '/': 'var(--coral)',
  '/work/': 'var(--sky)',
  '/thinking/': 'var(--moss)',
  '/about/': 'var(--coral)',
  '/consulting/': 'var(--sun)',
  '/web-design/': 'var(--moss)',
  [NAV_CTA.href]: 'var(--sun)',
};

const mobileLinks = [
  ...NAV_LINKS.map((l) => ({ ...l, service: false, cta: false })),
  ...NAV_SERVICES.map((l) => ({ ...l, service: true, cta: false })),
  { ...NAV_CTA, service: false, cta: true },
];

/**
 * `/work/mogo-lifecycle/` should still light up the "Work" tab. Home is matched
 * exactly — every path starts with "/", so a prefix test would mark it current
 * on every page of the site.
 */
function isCurrent(href: string) {
  return href === '/' ? path === '/' : path.startsWith(href);
}
---

<header class="header">
  <nav class="header__bar" aria-label="Primary">
    <a class="brand" href="/">
      <Image src={logoMark} alt="" width={34} height={26} loading="eager" />
      <span>{SITE.title.replace('N. ', '')}</span>
    </a>

    <ul class="navlinks">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              class="navlinks__link"
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="services" aria-label="Services">
      <span class="services__label">Services</span>
      {
        NAV_SERVICES.map((link) => (
          <a
            class="services__link"
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <a class="header__cta" href={NAV_CTA.href}>{NAV_CTA.label}</a>

    <button
      type="button"
      class="header__toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-nav-toggle
    >
      <span class="header__bars" aria-hidden="true"></span>
    </button>
  </nav>

  <nav class="mobilenav" id="mobile-nav" aria-label="Menu" hidden data-nav-panel>
    {
      mobileLinks.map((link) => (
        <a
          class:list={['mobilenav__link', { 'mobilenav__link--cta': link.cta }]}
          href={link.href}
          aria-current={!link.cta && isCurrent(link.href) ? 'page' : undefined}
          style={`--dot:${DOTS[link.href] ?? 'var(--coral)'}`}
        >
          <span class="mobilenav__label">
            <span>{link.label}</span>
            {link.service && <span class="mobilenav__tag">Service</span>}
          </span>
          <span class="mobilenav__dot" aria-hidden="true"></span>
        </a>
      ))
    }
  </nav>

  {progress && <div class="header__progress" aria-hidden="true" data-reading-progress></div>}
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');

  // The panel covers the viewport, so the page behind it stops scrolling while
  // it is open — the export locks body overflow the same way.
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    panel?.toggleAttribute('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
  };
  const isOpen = () => toggle?.getAttribute('aria-expanded') === 'true';

  toggle?.addEventListener('click', () => setOpen(!isOpen()));

  // Escape closes it, and returns focus to the control that opened it.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !isOpen()) return;
    setOpen(false);
    toggle?.focus();
  });

  // Growing past the breakpoint swaps in the desktop bar; an open panel left
  // behind would keep the body locked.
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 900 && isOpen()) setOpen(false);
  });

  // A same-page link (the CTA to #contact) doesn't navigate, so close by hand.
  panel?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });
</script>

<style>
  .header {
    /* `sticky` is also what makes this the containing block the reading
       progress bar positions against. */
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--dark);
    border-bottom: var(--border);
  }

  .header__bar {
    max-width: var(--wrap-home);
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 34px;
    padding: 14px 28px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--on-dark);
    margin-right: auto;
    white-space: nowrap;
  }

  /* The mark is ink on transparent; inverted it reads on the dark bar. */
  .brand :global(img) {
    height: 24px;
    width: auto;
    flex: none;
    display: block;
    filter: invert(1);
  }

  .brand:hover,
  .brand:focus-visible {
    color: var(--on-dark);
  }

  .navlinks {
    display: none;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .navlinks__link {
    color: rgb(251 249 246 / 62%);
    white-space: nowrap;
    padding-block: 4px;
  }

  /* Restated here on purpose. Astro scopes component styles with an attribute
     selector, so `.navlinks__link` outweighs the global `a:hover` and the link
     would otherwise never change colour. Any component that sets its own link
     colour has to set its own hover colour too. */
  .navlinks__link:hover,
  .navlinks__link:focus-visible {
    color: var(--sun);
  }

  .navlinks__link[aria-current='page'] {
    color: var(--on-dark);
  }

  /* The boxed services pair: a sun outline with a solid sun label tab. */
  .services {
    display: none;
    align-items: stretch;
    border: 2px solid var(--sun);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .services__label {
    display: flex;
    align-items: center;
    padding: 6px 10px;
    background: var(--sun);
    color: var(--ink);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .services__link {
    display: flex;
    align-items: center;
    padding: 6px 14px;
    color: rgb(251 249 246 / 62%);
    white-space: nowrap;
  }

  .services__link + .services__link {
    border-left: 2px solid rgb(245 184 65 / 40%);
  }

  .services__link:hover,
  .services__link:focus-visible {
    color: var(--sun);
  }

  .services__link[aria-current='page'] {
    color: var(--on-dark);
  }

  .header__cta {
    display: none;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 12px 20px;
    background: var(--coral);
    color: var(--ink);
    white-space: nowrap;
    box-shadow: 4px 4px 0 var(--paper);
    transition: background var(--dur-fast) var(--ease);
  }

  .header__cta:hover,
  .header__cta:focus-visible {
    background: var(--sun);
    color: var(--ink);
  }

  /* The export's 44px square: a 3px cream frame that fills coral when open. */
  .header__toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 3px solid var(--on-dark);
    background: transparent;
    transition: background var(--dur-fast) var(--ease);
  }

  .header__toggle[aria-expanded='true'] {
    background: var(--coral);
  }

  /* Three 18×3 lines drawn from one element: the bar itself plus two shadows,
     4.5px apart, as the export spaces them. */
  .header__bars,
  .header__bars::before,
  .header__bars::after {
    display: block;
    width: 18px;
    height: 3px;
    background: var(--on-dark);
    transition: transform var(--dur) var(--ease);
  }

  .header__bars::before,
  .header__bars::after {
    content: '';
    position: absolute;
  }

  .header__bars::before {
    transform: translateY(-4.5px);
  }

  .header__bars::after {
    transform: translateY(4.5px);
  }

  [aria-expanded='true'] .header__bars {
    background: transparent;
  }

  [aria-expanded='true'] .header__bars::before,
  [aria-expanded='true'] .header__bars::after {
    background: var(--ink);
  }

  [aria-expanded='true'] .header__bars::before {
    transform: rotate(45deg);
  }

  [aria-expanded='true'] .header__bars::after {
    transform: rotate(-45deg);
  }

  /* The export's panel is fixed below its 61px bar and covers the viewport;
     the page behind is locked by the script while it's open. */
  .mobilenav {
    position: fixed;
    top: 61px;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 55;
    background: var(--dark);
    padding: 8px 0 40px;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .mobilenav__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
    margin: 0 14px;
    padding: 0 4px;
    border-bottom: 3px solid rgb(251 249 246 / 22%);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: rgb(251 249 246 / 68%);
    transition: color var(--dur-fast) var(--ease);
  }

  .mobilenav__link:last-child {
    border-bottom-color: transparent;
  }

  .mobilenav__link:hover,
  .mobilenav__link:focus-visible {
    color: var(--sun);
  }

  .mobilenav__link--cta {
    color: var(--on-dark);
  }

  .mobilenav__link[aria-current='page'] {
    color: var(--sun);
    --dot: var(--sun);
  }

  .mobilenav__label {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mobilenav__tag {
    display: inline-flex;
    align-items: center;
    padding: 3px 8px;
    background: var(--sun);
    color: var(--ink);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .mobilenav__dot {
    flex: none;
    width: 16px;
    height: 16px;
    background: var(--dot);
  }

  /* Taken out of flow on purpose. In flow it added its 2px to the header, so
     the header was 76px everywhere and 78px on an article — and every
     navigation between the two nudged the whole page down or up by two
     pixels. Absolute keeps one header height across the site. */
  .header__progress {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    background: var(--accent);
    width: 0;
    transition: width 120ms linear;
  }

  /* The desktop bar needs more room than before — six links, the boxed pair
     and the CTA — so the breakpoint sits higher than the old 860px. Between
     900 and 1080px the design tightens tracking and hides the Services tab
     label rather than dropping to the burger. */
  /* Below the breakpoint the bar is the export's mobile one: 61px tall, 14px
     gutters, a 22px mark and a 14px brand. */
  @media (max-width: 899px) {
    .header__bar {
      min-height: 61px;
      padding: 0 14px;
      gap: 12px;
    }

    .brand {
      gap: 9px;
      font-size: 14px;
      letter-spacing: 0.04em;
      padding-block: 8px;
    }

    .brand :global(img) {
      height: 22px;
    }
  }

  @media (min-width: 900px) {
    .navlinks,
    .services {
      display: flex;
    }

    .header__cta {
      display: inline-flex;
    }

    .header__toggle {
      display: none;
    }
  }

  @media (min-width: 900px) and (max-width: 1080px) {
    .header__bar {
      gap: 14px;
      padding-inline: 16px;
    }

    .navlinks {
      gap: 12px;
      font-size: 12px;
      letter-spacing: 0.05em;
    }

    .services__label {
      display: none;
    }

    .services__link {
      padding: 6px 8px;
    }

    .header__cta {
      padding: 10px 13px;
      font-size: 12px;
      letter-spacing: 0.05em;
    }
  }
</style>
