---
import { Image } from 'astro:assets';
import { SITE, NAV_LINKS, NAV_SERVICES, NAV_CTA } from '../config';
import logoMark from '../assets/logo-mark.png';

/**
 * The v8 header: a dark bar with the plain site links, then the two offerings
 * boxed together behind a small "Services" tab, then the coral CTA.
 *
 * The design export's own mobile nav (`Monzones-D-Nav-Bold`) never shipped —
 * at 899px and below the export simply has no navigation. The panel below is
 * therefore inferred, not ported: the same accessible toggle-and-panel this
 * site has always had, restyled in the Bold language (dark panel, 3px rules,
 * the services pair labelled as such).
 */

interface Props {
  /** Renders the article reading-progress bar along the bottom edge. */
  progress?: boolean;
}

const { progress = false } = Astro.props;
const path = Astro.url.pathname;

/**
 * `/work/mogo-lifecycle/` should still light up the "Work" tab. Home is matched
 * exactly — every path starts with "/", so a prefix test would mark it current
 * on every page of the site.
 */
function isCurrent(href: string) {
  return href === '/' ? path === '/' : path.startsWith(href);
}
---

<header class="header">
  <nav class="header__bar" aria-label="Primary">
    <a class="brand" href="/">
      <Image src={logoMark} alt="" width={34} height={26} loading="eager" />
      <span>{SITE.title.replace('N. ', '')}</span>
    </a>

    <ul class="navlinks">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              class="navlinks__link"
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="services" aria-label="Services">
      <span class="services__label">Services</span>
      {
        NAV_SERVICES.map((link) => (
          <a
            class="services__link"
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <a class="header__cta" href={NAV_CTA.href}>{NAV_CTA.label}</a>

    <button
      type="button"
      class="header__toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-nav-toggle
    >
      <span class="visually-hidden">Menu</span>
      <span class="header__bars" aria-hidden="true"></span>
    </button>
  </nav>

  <div class="mobilenav" id="mobile-nav" hidden data-nav-panel>
    <ul class="mobilenav__list">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="mobilenav__services-label" aria-hidden="true">Services</li>
      {
        NAV_SERVICES.map((link) => (
          <li>
            <a
              class="mobilenav__service"
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li><a class="mobilenav__cta" href={NAV_CTA.href}>{NAV_CTA.label}</a></li>
    </ul>
  </div>

  {progress && <div class="header__progress" aria-hidden="true" data-reading-progress></div>}
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    panel?.toggleAttribute('hidden', open);
  });

  // Escape closes it, and returns focus to the control that opened it.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (toggle?.getAttribute('aria-expanded') !== 'true') return;
    toggle.setAttribute('aria-expanded', 'false');
    panel?.setAttribute('hidden', '');
    toggle.focus();
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--dark);
    border-bottom: var(--border);
  }

  .header__bar {
    max-width: var(--wrap-home);
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 34px;
    padding: 14px 28px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--on-dark);
    margin-right: auto;
    white-space: nowrap;
  }

  /* The mark is ink on transparent; inverted it reads on the dark bar. */
  .brand :global(img) {
    height: 24px;
    width: auto;
    flex: none;
    display: block;
    filter: invert(1);
  }

  .brand:hover,
  .brand:focus-visible {
    color: var(--on-dark);
  }

  .navlinks {
    display: none;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .navlinks__link {
    color: rgb(251 249 246 / 62%);
    white-space: nowrap;
    padding-block: 4px;
  }

  /* Restated here on purpose. Astro scopes component styles with an attribute
     selector, so `.navlinks__link` outweighs the global `a:hover` and the link
     would otherwise never change colour. Any component that sets its own link
     colour has to set its own hover colour too. */
  .navlinks__link:hover,
  .navlinks__link:focus-visible {
    color: var(--sun);
  }

  .navlinks__link[aria-current='page'] {
    color: var(--on-dark);
  }

  /* The boxed services pair: a sun outline with a solid sun label tab. */
  .services {
    display: none;
    align-items: stretch;
    border: 2px solid var(--sun);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .services__label {
    display: flex;
    align-items: center;
    padding: 6px 10px;
    background: var(--sun);
    color: var(--ink);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .services__link {
    display: flex;
    align-items: center;
    padding: 6px 14px;
    color: rgb(251 249 246 / 62%);
    white-space: nowrap;
  }

  .services__link + .services__link {
    border-left: 2px solid rgb(245 184 65 / 40%);
  }

  .services__link:hover,
  .services__link:focus-visible {
    color: var(--sun);
  }

  .services__link[aria-current='page'] {
    color: var(--on-dark);
  }

  .header__cta {
    display: none;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 12px 20px;
    background: var(--coral);
    color: var(--ink);
    white-space: nowrap;
    box-shadow: 4px 4px 0 var(--paper);
    transition: background var(--dur-fast) var(--ease);
  }

  .header__cta:hover,
  .header__cta:focus-visible {
    background: var(--sun);
    color: var(--ink);
  }

  .header__toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -8px;
    border: 2px solid var(--on-dark);
    background: transparent;
    transition: border-color var(--dur-fast) var(--ease);
  }

  .header__toggle:hover {
    border-color: var(--sun);
  }

  /* Three lines drawn from one element: the bar itself plus two shadows. */
  .header__bars,
  .header__bars::before,
  .header__bars::after {
    display: block;
    width: 18px;
    height: 2.5px;
    background: var(--on-dark);
    transition: transform var(--dur) var(--ease);
  }

  .header__bars::before,
  .header__bars::after {
    content: '';
    position: absolute;
  }

  .header__bars::before {
    transform: translateY(-6px);
  }

  .header__bars::after {
    transform: translateY(6px);
  }

  [aria-expanded='true'] .header__bars {
    background: transparent;
  }

  [aria-expanded='true'] .header__bars::before {
    transform: rotate(45deg);
  }

  [aria-expanded='true'] .header__bars::after {
    transform: rotate(-45deg);
  }

  .mobilenav {
    border-top: 1px solid rgb(251 249 246 / 25%);
    background: var(--dark);
  }

  .mobilenav__list {
    list-style: none;
    margin: 0;
    padding: 8px 28px 20px;
    display: flex;
    flex-direction: column;
  }

  .mobilenav__list a {
    display: block;
    padding: 13px 0;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgb(251 249 246 / 62%);
    border-bottom: 1px solid rgb(251 249 246 / 18%);
  }

  .mobilenav__list a:hover,
  .mobilenav__list a:focus-visible {
    color: var(--sun);
  }

  .mobilenav__list a[aria-current='page'] {
    color: var(--on-dark);
  }

  .mobilenav__services-label {
    padding: 16px 0 4px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sun);
  }

  .mobilenav__service {
    border-color: rgb(245 184 65 / 30%) !important;
  }

  .mobilenav__list .mobilenav__cta {
    margin-top: 18px;
    border: 0;
    background: var(--coral);
    color: var(--ink);
    text-align: center;
    font-weight: 700;
    padding: 15px 20px;
  }

  .mobilenav__list .mobilenav__cta:hover,
  .mobilenav__list .mobilenav__cta:focus-visible {
    background: var(--sun);
    color: var(--ink);
  }

  .header__progress {
    height: 2px;
    background: var(--accent);
    width: 0;
    transition: width 120ms linear;
  }

  /* The desktop bar needs more room than before — six links, the boxed pair
     and the CTA — so the breakpoint sits higher than the old 860px. Between
     900 and 1080px the design tightens tracking and hides the Services tab
     label rather than dropping to the burger. */
  @media (min-width: 900px) {
    .navlinks,
    .services {
      display: flex;
    }

    .header__cta {
      display: inline-flex;
    }

    .header__toggle {
      display: none;
    }
  }

  @media (min-width: 900px) and (max-width: 1080px) {
    .header__bar {
      gap: 14px;
      padding-inline: 16px;
    }

    .navlinks {
      gap: 12px;
      font-size: 12px;
      letter-spacing: 0.05em;
    }

    .services__label {
      display: none;
    }

    .services__link {
      padding: 6px 8px;
    }

    .header__cta {
      padding: 10px 13px;
      font-size: 12px;
      letter-spacing: 0.05em;
    }
  }
</style>
