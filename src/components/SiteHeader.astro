---
/**
 * The shared chrome from the v19 export's `Monzones-D-Nav-V4`: fixed header,
 * reading-progress bar, paper grain, the full-screen mobile menu and the
 * ambient-sound toggle. Rendered once by BaseLayout.
 *
 * Every state is in the markup: the menu is present and `hidden`, the sound
 * button reads "Sound off". The script below only toggles attributes, so with
 * JavaScript off the desktop links still work and the menu button does
 * nothing rather than something broken.
 */
import { Image } from 'astro:assets';
import { NAV_LINKS, NAV_CTA, STUDIO } from '../config';
import logoPrimary from '../assets/brand/logo-primary.png';
import ccdInk from '../assets/brand/ccd-logo-ink.png';

interface Props {
  current?: string;
  overlay?: boolean;
  progress?: 'blue' | 'amber';
}

const { current, overlay = false, progress = 'blue' } = Astro.props;
---

{!overlay && <div class="hd-spacer" aria-hidden="true"></div>}
<div class="hd-grain" aria-hidden="true"></div>
<div class:list={['hd-bar', progress === 'amber' && 'hd-bar--amber']} aria-hidden="true" data-hd-bar></div>

<header class:list={['hd', overlay && 'hd--overlay']} data-hd>
  <nav class="hd__nav" aria-label="Main">
    <a class="hd__logo" href="/" aria-label="Miguel Monzones, home">
      <Image src={logoPrimary} alt="Monzones" height={40} densities={[1, 2]} loading="eager" />
    </a>
    <div class="hd__fill"></div>
    <div class="hd__links">
      {
        NAV_LINKS.map((link) => (
          <a href={link.href} class="hd__link" aria-current={current === link.label ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      <a
        class="hd__studio"
        href={STUDIO.url}
        target="_blank"
        rel="noopener"
        aria-label={`${STUDIO.short}, my studio (opens in a new tab)`}
      >
        <Image src={ccdInk} alt={STUDIO.short} height={36} densities={[1, 2]} loading="eager" />
      </a>
      <a class="hd__cta" href={NAV_CTA.href} data-magnetic>{NAV_CTA.label}</a>
    </div>
    <button
      type="button"
      class="hd__menu-btn"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label="Menu"
      data-hd-toggle
    >
      <span data-hd-toggle-label>Menu</span>
    </button>
  </nav>
</header>

<div class="hd-menu" id="site-menu" hidden data-hd-menu>
  <div class="hd-menu__links">
    {
      NAV_LINKS.map((link) => (
        <a href={link.href} aria-current={current === link.label ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
    <a href={NAV_CTA.href} class="hd-menu__talk">Let's talk</a>
  </div>
  <a
    class="hd-menu__studio"
    href={STUDIO.url}
    target="_blank"
    rel="noopener"
    aria-label={`${STUDIO.short}, my studio (opens in a new tab)`}
  >
    <span class="hd-menu__chip">
      <Image src={ccdInk} alt={STUDIO.short} height={30} densities={[1, 2]} />
    </span>
    <span class="hd-menu__studio-label">my studio ↗</span>
  </a>
</div>

<button type="button" class="hd-sound" aria-pressed="false" data-sound-toggle>
  <span class="hd-sound__eq" aria-hidden="true"><span></span><span></span><span></span></span>
  <span data-sound-label>Sound off</span>
</button>

<style>
  .hd-spacer {
    height: 76px;
  }

  .hd-grain {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.07;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }

  .hd-bar {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 60;
    width: 100%;
    height: 3px;
    background: var(--blue);
    transform-origin: 0 50%;
    transform: scaleX(0);
    pointer-events: none;
  }
  .hd-bar--amber {
    z-index: 200;
    height: 4px;
    background: var(--amber);
  }

  .hd {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: rgba(248, 244, 236, 0.88);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid rgba(31, 29, 43, 0.14);
    transition: transform 0.55s var(--ease);
  }
  /* Home only: clear over the hero until the page moves. */
  .hd--overlay {
    background: rgba(248, 244, 236, 0);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    border-bottom-color: transparent;
    transition:
      transform 0.55s var(--ease),
      background 0.35s,
      border-color 0.35s;
  }
  .hd--overlay.is-solid {
    background: rgba(248, 244, 236, 0.88);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    border-bottom-color: rgba(31, 29, 43, 0.14);
  }
  .hd.is-hidden {
    transform: translate3d(0, -105%, 0);
  }

  .hd__nav {
    box-sizing: content-box;
    max-width: var(--max);
    margin: 0 auto;
    padding: 16px var(--gutter);
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .hd__logo {
    display: flex;
    align-items: center;
    white-space: nowrap;
  }
  .hd__logo img {
    display: block;
    height: 40px;
    width: auto;
    margin: -4px 0 -4px -6px;
  }
  .hd__fill {
    flex: 1;
  }
  .hd__links {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .hd__link {
    color: var(--ink);
    padding-bottom: 3px;
    border-bottom: 1.5px solid transparent;
  }
  .hd__link[aria-current='page'] {
    border-bottom-color: var(--ink);
  }
  .hd__link:hover {
    color: var(--blue);
  }

  /* The studio badge: a torn cream chip, tilted, that straightens on hover. */
  .hd__studio {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 5px 10px;
    background: var(--card);
    transform: rotate(-2deg);
    clip-path: var(--torn-chip);
    filter: drop-shadow(0 4px 6px rgba(31, 29, 43, 0.18));
    transition: transform 0.45s var(--ease);
  }
  .hd__studio:hover {
    transform: rotate(1deg) translateY(-2px) scale(1.04);
  }
  .hd__studio img {
    display: block;
    height: 36px;
    width: auto;
  }

  .hd__cta {
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    white-space: nowrap;
    transition:
      translate 0.5s var(--ease),
      background 0.3s;
  }
  .hd__cta:hover {
    background: var(--blue);
    color: var(--paper);
  }

  .hd__menu-btn {
    display: none;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 8px 16px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  @media (max-width: 899px) {
    .hd__links {
      display: none;
    }
    .hd__menu-btn {
      display: inline-flex;
    }
  }

  .hd-menu {
    position: fixed;
    inset: 0;
    z-index: 49;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    padding: 96px clamp(20px, 6vw, 56px) 40px;
    overflow-y: auto;
    background: var(--ink);
    color: var(--paper);
  }
  .hd-menu__links {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .hd-menu__links a {
    padding: 6px 0;
    border-bottom: 1px solid rgba(248, 244, 236, 0.25);
    font-family: var(--serif);
    font-size: clamp(2.75rem, 12vw, 4.5rem);
    line-height: 1.05;
    color: var(--paper);
  }
  .hd-menu__links a:hover,
  .hd-menu__links a[aria-current='page'] {
    color: var(--amber);
  }
  .hd-menu__links .hd-menu__talk {
    border-bottom: 0;
    font-style: italic;
    color: var(--amber);
  }
  .hd-menu__studio {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--paper);
  }
  .hd-menu__studio:hover {
    color: var(--amber);
  }
  .hd-menu__chip {
    display: inline-flex;
    padding: 8px 12px;
    background: var(--card);
    transform: rotate(-2deg);
    clip-path: var(--torn-chip);
  }
  .hd-menu__chip img {
    display: block;
    height: 30px;
    width: auto;
  }
  .hd-menu__studio-label {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.8;
  }

  .hd-sound {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 48;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 9px 14px 9px 12px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    filter: drop-shadow(0 6px 10px rgba(31, 29, 43, 0.18));
    transition:
      background 0.3s,
      color 0.3s;
  }
  .hd-sound:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .hd-sound__eq {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
  }
  .hd-sound__eq span {
    width: 3px;
    height: 100%;
    background: currentColor;
    transform-origin: 50% 100%;
    transform: scaleY(0.3);
  }
  .hd-sound[aria-pressed='true'] .hd-sound__eq span {
    transform: scaleY(1);
    animation: hd-eq 1s ease-in-out infinite;
  }
  .hd-sound[aria-pressed='true'] .hd-sound__eq span:nth-child(2) {
    animation-delay: 0.18s;
  }
  .hd-sound[aria-pressed='true'] .hd-sound__eq span:nth-child(3) {
    animation-delay: 0.36s;
  }
  @keyframes hd-eq {
    0%,
    100% {
      transform: scaleY(0.3);
    }
    50% {
      transform: scaleY(1);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-hd]');
  const bar = document.querySelector<HTMLElement>('[data-hd-bar]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hd-toggle]');
  const toggleLabel = document.querySelector<HTMLElement>('[data-hd-toggle-label]');
  const menu = document.querySelector<HTMLElement>('[data-hd-menu]');

  /* ------------------------------------------------ progress + hide on scroll */
  let lastY = window.scrollY;
  let hidden = false;
  let solid: boolean | null = null;
  let ticking = false;

  const frame = () => {
    ticking = false;
    const y = window.scrollY;
    const dy = y - lastY;
    lastY = y;

    const max = document.documentElement.scrollHeight - window.innerHeight;
    if (bar) bar.style.transform = `scaleX(${(max > 0 ? Math.min(1, Math.max(0, y / max)) : 0).toFixed(4)})`;

    if (!header) return;
    if (header.classList.contains('hd--overlay')) {
      const next = y > 30;
      if (next !== solid) {
        solid = next;
        header.classList.toggle('is-solid', next);
      }
    }

    let hide = hidden;
    if (menu && !menu.hidden) hide = false;
    else if (y > 220 && dy > 3) hide = true;
    else if (dy < -3 || y <= 220) hide = false;
    if (hide !== hidden) {
      hidden = hide;
      header.classList.toggle('is-hidden', hide);
    }
  };

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(frame);
      }
    },
    { passive: true },
  );
  window.addEventListener('resize', frame, { passive: true });
  frame();

  /* ------------------------------------------------------------- mobile menu */
  const setMenu = (open: boolean, restoreFocus = true) => {
    if (!menu || !toggle) return;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    if (toggleLabel) toggleLabel.textContent = open ? 'Close ×' : 'Menu';
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) {
      header?.classList.remove('is-hidden');
      hidden = false;
      menu.querySelector<HTMLElement>('a')?.focus();
    } else if (restoreFocus) {
      toggle.focus();
    }
  };

  toggle?.addEventListener('click', () => setMenu(menu?.hidden ?? true));
  // A tap on any menu link navigates (or jumps to #contact) — close first.
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false, false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) setMenu(false);
  });
  // Widening past the breakpoint with the menu open would leave the page locked.
  window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
    if (e.matches && menu && !menu.hidden) setMenu(false, false);
  });

  /* ------------------------------------------------------------ ambient sound */
  /* Starts on the visitor's first tap anywhere, unless they turned it off last
     time. The audio element is created lazily so nobody downloads the loop
     until it is actually going to play. */
  const soundBtn = document.querySelector<HTMLButtonElement>('[data-sound-toggle]');
  const soundLabel = document.querySelector<HTMLElement>('[data-sound-label]');
  const SOUND_KEY = 'mnm-sound';
  let audio: HTMLAudioElement | null = null;
  let playing = false;

  const readOff = () => {
    try {
      return localStorage.getItem(SOUND_KEY) === 'off';
    } catch {
      return false;
    }
  };
  const save = (value: 'on' | 'off') => {
    try {
      localStorage.setItem(SOUND_KEY, value);
    } catch {
      /* private mode: the choice just won't persist */
    }
  };
  const render = () => {
    soundBtn?.setAttribute('aria-pressed', String(playing));
    if (soundLabel) soundLabel.textContent = playing ? 'Sound on' : 'Sound off';
  };
  const play = () => {
    if (!audio) {
      audio = new Audio('/websound.mp3');
      audio.loop = true;
      audio.volume = 0.3;
    }
    audio
      .play()
      .then(() => {
        playing = true;
        render();
      })
      .catch(() => {
        /* Autoplay refused: stay "off" and let the button try again. */
      });
  };

  const onFirstTap = (e: PointerEvent) => {
    if ((e.target as Element | null)?.closest?.('[data-sound-toggle]')) return;
    document.removeEventListener('pointerdown', onFirstTap, true);
    if (!readOff()) play();
  };
  document.addEventListener('pointerdown', onFirstTap, true);

  soundBtn?.addEventListener('click', () => {
    document.removeEventListener('pointerdown', onFirstTap, true);
    if (playing) {
      audio?.pause();
      playing = false;
      save('off');
      render();
    } else {
      save('on');
      play();
    }
  });
</script>
