---
import { Image } from 'astro:assets';
import { LOGOS } from '../data/home';

/**
 * The brand marquee: a dark full-bleed strip of photo tiles drifting left,
 * greyscaled until hovered. Pauses on hover, and stands still entirely for
 * reduced motion.
 */

/**
 * Resolved eagerly at build time. A name in LOGOS with no matching file throws
 * during the build rather than rendering a broken image on the live site.
 */
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/logos/*.jpg', {
  eager: true,
});

const logos = LOGOS.map((name) => {
  const file = `../assets/logos/${name.toLowerCase().replace(/&/g, '').replace(/\s+/g, '-')}.jpg`;
  const mod = files[file];
  if (!mod) throw new Error(`LogoMarquee: no image found at ${file} for "${name}"`);
  return { name, src: mod.default };
});

/* The track is rendered twice so the loop is seamless: the animation slides it
   exactly one copy's width, at which point the second copy is where the first
   one started. The duplicate is hidden from assistive tech. */
const track = [...logos, ...logos];
---

<section class="marquee" aria-label="Companies I've worked with">
  <div class="marquee__track">
    {
      track.map((logo, i) => (
        <span class="marquee__item" aria-hidden={i >= logos.length ? 'true' : undefined}>
          <Image
            src={logo.src}
            alt={i >= logos.length ? '' : logo.name}
            width={328}
            height={192}
            loading="lazy"
            densities={[1, 2]}
          />
        </span>
      ))
    }
  </div>
</section>

<style>
  .marquee {
    background: var(--dark);
    padding-block: 26px;
    overflow: hidden;
  }

  .marquee__track {
    display: flex;
    gap: 14px;
    width: max-content;
    align-items: center;
    animation: marquee-drift 52s linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__item {
    flex: none;
    display: block;
    width: 164px;
    height: 96px;
    overflow: hidden;
    border: 2px solid rgb(251 249 246 / 24%);
    filter: grayscale(1) brightness(1.05);
    opacity: 0.55;
    transition:
      filter var(--dur) var(--ease),
      opacity var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .marquee__item:hover {
    filter: none;
    opacity: 1;
    border-color: var(--sun);
  }

  .marquee__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @keyframes marquee-drift {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
