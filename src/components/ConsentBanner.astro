---
/**
 * Cookie consent banner — the v19 export's `Monzones-D-Cookies-V4`, rendered
 * on every page by BaseLayout.
 *
 * The answer lives in localStorage under CONSENT_STORAGE_KEY as
 * `{"analytics": bool, "v": 1, "ts": ISO}`. Analytics.astro reads only
 * `.analytics`, before gtag.js loads, so a returning visitor's choice applies
 * to their first pageview; answers stored in the older `{analytics, date}`
 * shape still count and are not re-asked.
 *
 * Two details worth not "tidying" later:
 *
 *  - **It ships `hidden` and is revealed by script**, never the reverse. A
 *    banner visible in CSS would flash for everyone who has already answered,
 *    and would stay up for good if the script failed.
 *  - **Decline deletes existing `_ga*` cookies.** `consent update` only stops
 *    new writes; without this, an earlier "accept" would keep its cookies
 *    until they expired.
 */
import { CONSENT_STORAGE_KEY } from '../config';
---

<div
  class="cc"
  id="cookie-settings"
  role="dialog"
  aria-label="Cookie consent"
  aria-live="polite"
  data-consent
  hidden
>
  <p class="cc__eyebrow"><span class="cc__slab" aria-hidden="true"></span>Cookies</p>
  <h2 class="cc__title">Only if you're <span class="cc__nowrap">comfortable with it</span></h2>
  <p class="cc__body">
    I use Google Analytics to see what people read, so I can write better. Nothing is sold, shared
    with advertisers, or used to identify you. Decline and the site works exactly the same.
  </p>

  <div class="cc__details" id="cc-details" data-consent-details hidden>
    <div class="cc__row">
      <p class="cc__row-head"><span>Essential</span><span class="cc__status">Always on</span></p>
      <p class="cc__row-body">One local entry that remembers this choice, so you aren't asked again. No tracking.</p>
    </div>
    <div class="cc__row">
      <p class="cc__row-head">
        <span>Analytics</span><span class="cc__status" data-consent-status>Off</span>
      </p>
      <p class="cc__row-body">
        Google Analytics 4 (<code>_ga</code>, <code>_ga_*</code>): page views, referrer, approximate
        region, device type. Aggregate only, kept up to two years. No advertising or remarketing tags
        run on this site.
      </p>
    </div>
  </div>

  <div class="cc__actions">
    <button type="button" class="cc__btn cc__btn--solid" data-consent-accept>Accept analytics</button>
    <button type="button" class="cc__btn cc__btn--ghost" data-consent-decline>Decline</button>
  </div>

  <button type="button" class="cc__more" aria-expanded="false" aria-controls="cc-details" data-consent-toggle>
    What exactly gets set
  </button>
</div>

<script is:inline define:vars={{ storageKey: CONSENT_STORAGE_KEY }}>
  (function () {
    var banner = document.querySelector('[data-consent]');
    if (!banner) return;

    var details = banner.querySelector('[data-consent-details]');
    var toggle = banner.querySelector('[data-consent-toggle]');
    var status = banner.querySelector('[data-consent-status]');
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var hideTimer = 0;

    /* Storage can throw outright in private mode. Every access goes through
       these two, so a throw degrades to "no answer stored". */
    function read() {
      try {
        var raw = localStorage.getItem(storageKey);
        return raw ? JSON.parse(raw) : null;
      } catch (e) {
        return null;
      }
    }
    function write(analytics) {
      try {
        localStorage.setItem(
          storageKey,
          JSON.stringify({ analytics: analytics, v: 1, ts: new Date().toISOString() }),
        );
      } catch (e) {
        /* Can't persist; the choice still applies to this pageview. */
      }
    }

    function clearAnalyticsCookies() {
      var host = location.hostname;
      var domains = ['', host, '.' + host];
      var parts = host.split('.');
      if (parts.length > 2) domains.push('.' + parts.slice(-2).join('.'));
      document.cookie.split(';').forEach(function (c) {
        var name = c.split('=')[0].trim();
        if (!/^(_ga|_gid|_gat)/.test(name)) return;
        domains.forEach(function (d) {
          document.cookie =
            name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + (d ? '; domain=' + d : '');
        });
      });
    }

    function setStatus(granted) {
      if (!status) return;
      status.textContent = granted ? 'On' : 'Off';
      status.classList.toggle('is-on', !!granted);
    }

    function show() {
      clearTimeout(hideTimer);
      banner.hidden = false;
      if (reduced) {
        banner.classList.add('is-in');
        return;
      }
      banner.classList.remove('is-in');
      /* One frame at the hidden pose, then the transition to the shown one. */
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          banner.classList.add('is-in');
        });
      });
    }
    function hide() {
      banner.classList.remove('is-in');
      hideTimer = setTimeout(function () {
        banner.hidden = true;
      }, reduced ? 0 : 340);
    }

    function answer(analytics) {
      write(analytics);
      if (!analytics) clearAnalyticsCookies();
      /* Inside the wait_for_update window set in Analytics.astro, so this
         pageview is attributed under the answer just given. */
      if (typeof window.gtag === 'function') {
        window.gtag('consent', 'update', {
          analytics_storage: analytics ? 'granted' : 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
      }
      document.dispatchEvent(new CustomEvent('mnm:consent', { detail: { analytics: analytics } }));
      setStatus(analytics);
      hide();
    }

    var stored = read();
    /* Only a stored boolean counts as an answer; anything else means ask. */
    if (!stored || typeof stored.analytics !== 'boolean') setTimeout(show, 450);
    else setStatus(stored.analytics);

    banner.querySelector('[data-consent-accept]').addEventListener('click', function () {
      answer(true);
    });
    banner.querySelector('[data-consent-decline]').addEventListener('click', function () {
      answer(false);
    });

    if (toggle && details) {
      toggle.addEventListener('click', function () {
        var open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        details.hidden = open;
        toggle.textContent = open ? 'What exactly gets set' : 'Hide the details';
      });
    }

    /* The footer link and the Privacy page's button reopen the banner. */
    document.addEventListener('click', function (event) {
      var link = event.target.closest && event.target.closest('[data-cookie-settings]');
      if (!link) return;
      event.preventDefault();
      show();
      banner.querySelector('[data-consent-accept]').focus({ preventScroll: true });
    });
  })();
</script>

<style>
  .cc {
    position: fixed;
    z-index: 9999;
    bottom: 24px;
    left: 24px;
    width: calc(100vw - 48px);
    max-width: 27rem;
    padding: 26px 28px 24px;
    background: var(--paper);
    border: 1px solid var(--ink);
    box-shadow: 0 14px 28px -14px rgba(31, 29, 43, 0.3);
    color: var(--ink);
    font-family: var(--sans);
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.3s ease,
      transform 0.34s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .cc.is-in {
    opacity: 1;
    transform: none;
  }

  .cc__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .cc__slab {
    flex: none;
    width: 26px;
    height: 12px;
    background: var(--blue);
  }
  .cc__title {
    margin-top: 14px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .cc__nowrap {
    white-space: nowrap;
  }
  .cc__body {
    margin-top: 12px;
    font-size: 0.9062rem;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }

  .cc__details {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
    display: flex;
    flex-direction: column;
    gap: 13px;
  }
  .cc__row {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cc__row-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .cc__status {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .cc__status[data-consent-status] {
    color: var(--grey);
  }
  .cc__status.is-on {
    color: var(--green);
  }
  .cc__row-body {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .cc__row-body code {
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .cc__actions {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cc__btn {
    flex: 1;
    min-width: 132px;
    padding: 15px 20px;
    border: 1px solid var(--ink);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      background 0.2s,
      color 0.2s;
  }
  /* Never narrower than its own label: two flex:1 buttons in a phone-width
     card must wrap before they clip "Accept analytics" (a bug an earlier
     export shipped). CSS can't take max(132px, max-content), so the label is
     the floor here and the design's 132px stays on Decline. */
  .cc__btn--solid {
    min-width: max-content;
    background: var(--ink);
    color: var(--paper);
  }
  .cc__btn--solid:hover {
    background: var(--blue);
    color: var(--ink);
  }
  .cc__btn--ghost {
    background: transparent;
    color: var(--ink);
  }
  .cc__btn--ghost:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .cc__more {
    margin-top: 14px;
    padding: 2px 0;
    border: 0;
    background: none;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
    transition: color 0.2s;
  }
  .cc__more:hover {
    color: var(--ink);
  }

  @media (max-width: 560px) {
    .cc {
      left: 10px;
      bottom: calc(10px + env(safe-area-inset-bottom));
      width: calc(100vw - 20px);
      max-width: none;
      padding: 22px 22px 20px;
      max-height: calc(100vh - 20px);
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }
    .cc__btn {
      padding: 14px;
      min-width: 0;
    }
    .cc__btn--solid {
      min-width: max-content;
    }
    .cc__more {
      padding: 12px 0 2px;
    }
  }
  @media (max-width: 380px) {
    .cc__title {
      font-size: 1.1875rem;
    }
    .cc__body {
      font-size: 0.875rem;
    }
  }
  @media (max-width: 359px) {
    .cc__actions {
      flex-direction: column;
      align-items: stretch;
    }
    .cc__btn {
      width: 100%;
    }
  }
</style>
