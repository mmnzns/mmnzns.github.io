---
import { SITE, CONTACT, FORM_ENDPOINT } from '../config';

/**
 * The sky contact band: a form card and a contact-routes card side by side on
 * the blue, both carrying the hard ink shadow. Home, Consulting and About all
 * end on this band with their own title and intro.
 */

interface Props {
  title: string;
  intro: string;
  /** The outlined section number — the home page passes "06". */
  number?: string;
  /** Label above the message box — the ask differs per page. */
  messageLabel?: string;
  /** The line at the bottom of the details card. */
  aside?: string;
  /** The submit button label — the home page's form says "Send it". */
  submitLabel?: string;
  /** The Vancouver box: sun on the home page, wash on the others. */
  vancouverBox?: 'sun' | 'wash';
  /**
   * Container width. The export gives this block 1320px on the home page and
   * 1120px on About, matching whatever the host page uses — hardcoding the
   * home width made the contact band 100px wider than the rest of About.
   */
  width?: 'home' | 'page';
  id?: string;
}

const {
  title,
  intro,
  number,
  messageLabel = 'What’s on your mind?',
  aside = 'If you’re in Vancouver, coffee’s on me. I’d rather hear it out loud anyway.',
  submitLabel = 'Send',
  vancouverBox = 'wash',
  width = 'home',
  id = 'contact',
} = Astro.props;

const phoneHref = `tel:${CONTACT.phone.replace(/[^+\d]/g, '')}`;

/** Strip the scheme so the LinkedIn row reads as an address, not a URL. */
const linkedinLabel = CONTACT.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const routes = [
  { label: 'Email', value: CONTACT.email, href: `mailto:${CONTACT.email}`, external: false },
  { label: 'Phone', value: CONTACT.phone, href: phoneHref, external: false },
  { label: 'LinkedIn', value: linkedinLabel, href: CONTACT.linkedin, external: true },
] as const;
---

<section class="band band--sky contact" id={id}>
  <div class:list={['contact__inner', width === 'home' ? 'wrap--home' : 'wrap']}>
    {
      number ? (
        <div class="numbered">
          <span class="numbered__n" aria-hidden="true">
            {number}
          </span>
          <h2 class="contact__title contact__title--display">{title}</h2>
        </div>
      ) : (
        <h2 class="contact__title">{title}</h2>
      )
    }
    <p class="contact__intro">{intro}</p>

    <div class="contact__grid">
      <div class="card card--raised contact__panel">
        {/*
          A plain POST to Formspree, so the form still works with JavaScript
          disabled — the visitor just lands on Formspree's own thank-you page
          instead of seeing the inline message.
        */}
        <form action={FORM_ENDPOINT} method="POST" data-contact-form>
          <label class="field">
            Your name
            <input type="text" name="name" autocomplete="name" required />
          </label>

          <label class="field">
            Email
            <input type="email" name="email" autocomplete="email" required />
          </label>

          <label class="field">
            {messageLabel}
            <textarea name="message" rows="4" required></textarea>
          </label>

          {/* Formspree discards any submission that fills this in. */}
          <input
            type="text"
            name="_gotcha"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="honeypot"
          />

          <button type="submit" class="btn contact__submit">{submitLabel}</button>

          <p class="contact__status" role="status" aria-live="polite" data-form-status></p>
        </form>
      </div>

      <div class="card card--raised contact__panel contact__details">
        {
          SITE.availability && (
            <p class="contact__status-line">
              <span class="contact__dot" aria-hidden="true" />
              {SITE.availability}
            </p>
          )
        }

        {/* Each route is a row rather than a bare link: the label says what it is
            before you read the value, which matters most for the phone number. */}
        <div class="contact__routes">
          {
            routes.map((route) => (
              <a
                class="contact__route"
                href={route.href}
                target={route.external ? '_blank' : undefined}
                rel={route.external ? 'noopener' : undefined}
              >
                <span class="contact__route-text">
                  <span class="eyebrow eyebrow--muted">{route.label}</span>
                  <span class="contact__route-value">{route.value}</span>
                </span>
                <span class="contact__route-icon" aria-hidden="true">
                  {route.external ? '↗' : '→'}
                </span>
              </a>
            ))
          }
        </div>

        <div class:list={['contact__place', `contact__place--${vancouverBox}`]}>
          <p class="eyebrow eyebrow--muted contact__place-label">{CONTACT.city}</p>
          <p class="contact__aside">{aside}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Upgrades the form to submit in place. Anything unexpected falls through to
  // a normal navigation, which is the no-JS behaviour, so a failure here can
  // never swallow someone's message.
  const forms = document.querySelectorAll<HTMLFormElement>('[data-contact-form]');

  for (const form of forms) {
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      if (!form.checkValidity()) return;
      event.preventDefault();

      const original = submit?.textContent ?? 'Send';
      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }
      if (status) {
        status.textContent = '';
        status.dataset.state = '';
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.reset();
          if (status) {
            status.textContent =
              'Thanks — that’s with me. I answer everything within a couple of days.';
            status.dataset.state = 'ok';
          }
        } else {
          throw new Error(String(response.status));
        }
      } catch {
        if (status) {
          status.textContent =
            'That didn’t send. Email me directly at miguel@mnmonzones.com and I’ll pick it up.';
          status.dataset.state = 'error';
        }
      } finally {
        if (submit) {
          submit.disabled = false;
          submit.textContent = original;
        }
      }
    });
  }
</script>

<style>
  .contact {
    /* The band's own borders carry the separation; the default band gap stays. */
  }

  /* Width comes from the `.wrap` / `.wrap--home` class the `width` prop
     picks, so this only carries what both share. */
  .contact__inner {
    margin-inline: auto;
  }

  .contact__title {
    font-size: clamp(41px, 7.1vw, 92px);
    line-height: 0.95;
    letter-spacing: -0.034em;
  }

  /* The home page's numbered variant runs bigger still. */
  .contact__title--display {
    font-size: clamp(52px, 10vw, 164px);
    line-height: 0.84;
    letter-spacing: -0.05em;
  }

  .contact__intro {
    margin-top: 24px;
    font-size: clamp(18px, 1.9vw, 23px);
    line-height: 1.45;
    font-weight: 600;
    color: var(--sky-ink);
    max-width: 700px;
  }

  .contact__grid {
    margin-top: clamp(46px, 5.8vw, 78px);
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .contact__panel {
    padding: clamp(30px, 4vw, 48px);
  }

  .contact__panel form,
  .contact__details {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .contact__details {
    gap: 26px;
  }

  .contact__submit {
    align-self: flex-start;
    margin-top: 4px;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .contact__status:empty {
    display: none;
  }

  .contact__status {
    margin-top: 4px;
    font-size: 15px;
    line-height: 1.55;
  }

  .contact__status[data-state='error'] {
    color: var(--coral);
  }

  .contact__status-line {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact__dot {
    width: 12px;
    height: 12px;
    background: var(--moss);
    flex: none;
  }

  .contact__routes {
    display: flex;
    flex-direction: column;
  }

  .contact__route {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
    border-top: var(--border);
  }

  .contact__route:last-child {
    border-bottom: var(--border);
  }

  .contact__route-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .contact__route-value {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.014em;
    overflow-wrap: anywhere;
  }

  .contact__route-icon {
    width: 38px;
    height: 38px;
    flex: none;
    border: var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
  }

  .contact__place {
    margin-top: auto;
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .contact__place--sun {
    background: var(--sun);
    border: var(--border);
  }

  .contact__place--sun .contact__place-label {
    color: var(--sun-ink);
  }

  .contact__place--wash {
    background: var(--wash);
  }

  .contact__aside {
    font-size: 19px;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: -0.014em;
  }

  @media (min-width: 900px) {
    .contact__grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }
</style>
